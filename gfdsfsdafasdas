function State.LocalSpoofs.ParseFakePlayers(Text, DefaultName)
local Result = {}
for Name in string.gmatch(tostring(Text or ''), '[^,]+') do
Name = string.match(Name, '^%s*(.-)%s*$')
if Name ~= '' then table.insert(Result, Name) end
end
if #Result == 0 then table.insert(Result, DefaultName) end
return Result
end

function State.LocalSpoofs.PatchFakeDrawRows()
local PlayerData = State.LocalSpoofs.PlayerData
local History = PlayerData and PlayerData.storedData and PlayerData.storedData.MatchHistory
if type(History) ~= 'table' then return end
local Orange=Color3.fromRGB(225,105,15); local DarkOrange=Color3.fromRGB(155,62,8)
local function RecolorRow(Row)
for _,Object in ipairs(Row:GetDescendants()) do
if Object:IsA('TextLabel') then
local Upper=string.upper(Object.Text)
if Upper=='LOSE' or Upper=='LOSS' then Object.Text='DRAW';Object.TextColor3=Orange end
local Gradient=Object:FindFirstChildOfClass('UIGradient')
if Gradient and (Upper=='LOSE' or Upper=='LOSS') then Gradient.Color=ColorSequence.new(DarkOrange,Orange) end
elseif Object:IsA('GuiObject') and Object.BackgroundTransparency<1 then
local C=Object.BackgroundColor3
if C.R>C.G*1.25 and C.R>C.B*1.15 then Object.BackgroundColor3=DarkOrange end
elseif Object:IsA('ImageLabel') or Object:IsA('ImageButton') then
local C=Object.ImageColor3
if C.R>C.G*1.25 and C.R>C.B*1.15 then Object.ImageColor3=Orange end
elseif Object:IsA('UIStroke') then
local C=Object.Color
if C.R>C.G*1.25 and C.R>C.B*1.15 then Object.Color=Orange end
end
end
end
State.LocalSpoofs.HasFakeDraws=false
for _,Match in ipairs(History) do if Match.__SilverSurferFake and Match.__DisplayResult=='Draw' then State.LocalSpoofs.HasFakeDraws=true end end
if not State.LocalSpoofs.HasFakeDraws then return end
for _,Root in ipairs(LP.PlayerGui:GetDescendants()) do
if Root.Name=='HistoryFrame' and Root:FindFirstChild('PageFrame') then
for _,Row in ipairs(Root.PageFrame:GetChildren()) do
if Row:IsA('Frame') then
local TeamA=Row:FindFirstChild('TeamA');local TeamB=Row:FindFirstChild('TeamB')
local ScoreA=Row:FindFirstChild('TeamAScore');local ScoreB=Row:FindFirstChild('TeamBScore')
for _,Match in ipairs(History) do
if Match.__SilverSurferFake and Match.__DisplayResult=='Draw' and TeamA and TeamB and ScoreA and ScoreB
and tonumber(ScoreA.Text)==tonumber(Match.HomeScore) and tonumber(ScoreB.Text)==tonumber(Match.AwayScore) then
local HomeHit=false;local AwayHit=false
for Name in pairs(Match.Home) do if string.find(TeamA.Text,Name,1,true) then HomeHit=true break end end
for Name in pairs(Match.Away) do if string.find(TeamB.Text,Name,1,true) then AwayHit=true break end end
if HomeHit and AwayHit then RecolorRow(Row) end
end
end
end
end
elseif Root.Name=='ResultLabel' and Root:IsA('TextLabel') and string.match(string.upper(Root.Text),'^LOSE') then
Root.Text=string.gsub(Root.Text,'^[Ll][Oo][Ss][Ee]','DRAW')
Root.TextColor3=Orange
local Gradient=Root:FindFirstChildOfClass('UIGradient');if Gradient then Gradient.Color=ColorSequence.new(DarkOrange,Orange) end
end
end
end

function State.LocalSpoofs.AddFakeMatch(Custom)
Custom = type(Custom)=='table' and Custom or {}
State.LocalSpoofs.PlayerData = State.LocalSpoofs.PlayerData or require(ReplicatedStorage.Util.PlayerData)
local Data = State.LocalSpoofs.PlayerData.storedData
if type(Data) ~= 'table' then return end
Data.MatchHistory = type(Data.MatchHistory) == 'table' and Data.MatchHistory or {}
local Result = tostring(Custom.Result or 'Win')
if Result=='Loss' then Result='Lose' end
if Result~='Win' and Result~='Lose' and Result~='Draw' and Result~='Protected' then Result='Win' end
local RenderResult = Result=='Draw' and 'Lose' or Result
local HomeScore = math.clamp(math.floor(tonumber(Custom.HomeScore) or 21),0,999)
local AwayScore = math.clamp(math.floor(tonumber(Custom.AwayScore) or 15),0,999)
local DefaultLocalName = State.LocalAnonymizerEnabled and State.LocalAlias or LP.Name
local HomeNames = State.LocalSpoofs.ParseFakePlayers(Custom.HomePlayers,DefaultLocalName)
local AwayNames = State.LocalSpoofs.ParseFakePlayers(Custom.AwayPlayers,'Anonymous')
local RequestedSize = math.clamp(math.floor(tonumber(Custom.TeamSize) or math.max(#HomeNames,#AwayNames)),1,4)
while #HomeNames < RequestedSize do table.insert(HomeNames,'Home Player '..tostring(#HomeNames+1)) end
while #AwayNames < RequestedSize do table.insert(AwayNames,'Away Player '..tostring(#AwayNames+1)) end
while #HomeNames > RequestedSize do table.remove(HomeNames) end
while #AwayNames > RequestedSize do table.remove(AwayNames) end
local ELO = State.LocalELOSpoofEnabled and State.LocalELO or (LP:GetAttribute('ELO') or 0)
local Wins=math.max(0,math.floor(tonumber(State.LocalWins) or 0)); local Losses=math.max(0,math.floor(tonumber(State.LocalLosses) or 0))
local Streak=math.max(0,math.floor(tonumber(State.LocalStreak) or 0)); local Highest=math.max(Streak,math.floor(tonumber(State.LocalHighestStreak) or 0))
local Shields=math.max(0,math.floor(tonumber(State.LocalShields) or 0))
local function BuildInfo(Name,HomeSide,Index)
local Player=Players:FindFirstChild(Name)
local IsLocal=Player==LP or Name==LP.Name or Name==LP.DisplayName or Name==DefaultLocalName
local UserId=IsLocal and LP.UserId or (Player and Player.UserId or 100000+Index)
local SideWon=(Result=='Win' and HomeSide) or (Result=='Lose' and not HomeSide)
local PlayerResult=(Result=='Protected' or Result=='Draw') and 'Protected' or (SideWon and 'Win' or 'Lose')
local NewELO=IsLocal and ELO or 0; local Delta=PlayerResult=='Win' and 25 or (PlayerResult=='Lose' and -15 or 0)
return {
Name=Name,UserId=UserId,ELO=NewELO,OLD=math.max(0,NewELO-Delta),NEW=NewELO,
Points=HomeSide and HomeScore or AwayScore,Assists=0,Steals=0,Turnovers=0,Result=PlayerResult,
OLDWINS=math.max(0,Wins-(PlayerResult=='Win' and 1 or 0)),NEWWINS=Wins,
OLDLOSSES=math.max(0,Losses-(PlayerResult=='Lose' and 1 or 0)),NEWLOSSES=Losses,
OLDSTREAK=math.max(0,Streak-1),NEWSTREAK=Streak,
OLDHIGHESTSTREAK=math.max(0,Highest-1),NEWHIGHESTSTREAK=Highest,OLDSHIELDS=Shields,NEWSHIELDS=Shields,
}
end
local Home={};local Away={}
for Index,Name in ipairs(HomeNames) do Home[Name]=BuildInfo(Name,true,Index) end
for Index,Name in ipairs(AwayNames) do Away[Name]=BuildInfo(Name,false,100+Index) end
local TeamSize=RequestedSize
table.insert(Data.MatchHistory,1,{
__SilverSurferFake=true,__DisplayResult=Result,Result=RenderResult,
HomeScore=HomeScore,AwayScore=AwayScore,Date=os.time(),PlayerCount=#HomeNames+#AwayNames,
Mode=tostring(TeamSize)..'v'..tostring(TeamSize),Competitive=false,
Home=Home,Away=Away,HomeIcon='',AwayIcon='',
})
State.LocalSpoofs.RefreshFakeMatchHistory()
end

