Inst.BackgroundColor3 = Color3.new(1, 1, 1)
end
Inst.Visible = false
Inst.Parent = Gui

local Props = { Thickness = 1, Transparency = 1, Visible = false }

local function ApplyLine()
local From, To = Props.From, Props.To
if typeof(From) ~= 'Vector2' or typeof(To) ~= 'Vector2' then return end
local Delta = To - From
local Center = (From + To) * 0.5
Inst.Position = UDim2.fromOffset(Center.X, Center.Y)
Inst.Size = UDim2.fromOffset(Delta.Magnitude, math.max(1, Props.Thickness or 1))
Inst.Rotation = math.deg((math.atan2 or math.atan)(Delta.Y, Delta.X))
end

local function Remove()
pcall(function() Inst:Destroy() end)
end

return setmetatable({}, {
__index = function(_, Key)
if Key == 'Remove' or Key == 'Destroy' then return Remove end
return Props[Key]
end,
__newindex = function(_, Key, Value)
Props[Key] = Value
pcall(function()
if Key == 'Visible' then
Inst.Visible = Value == true
elseif Key == 'ZIndex' then
Inst.ZIndex = math.clamp(math.floor(tonumber(Value) or 1), 1, 2000)
elseif Key == 'Color' then
if Kind == 'Text' then
Inst.TextColor3 = Value
else
Inst.BackgroundColor3 = Value
if Stroke then Stroke.Color = Value end
end
elseif Key == 'Text' then
if Kind == 'Text' then Inst.Text = tostring(Value) end
elseif Key == 'Transparency' then
local GuiAlpha = 1 - math.clamp(tonumber(Value) or 1, 0, 1)
if Kind == 'Text' then
Inst.TextTransparency = GuiAlpha
elseif Kind == 'Circle' then
if Stroke then Stroke.Transparency = GuiAlpha end
Inst.BackgroundTransparency = Props.Filled and GuiAlpha or 1
else
Inst.BackgroundTransparency = GuiAlpha
end
elseif Key == 'Thickness' then
if Stroke then
Stroke.Thickness = math.max(1, tonumber(Value) or 1)
elseif Kind ~= 'Text' then
ApplyLine()
end
elseif Key == 'From' or Key == 'To' then
ApplyLine()
elseif Key == 'Position' then
if typeof(Value) == 'Vector2' and Kind ~= 'Line' then
Inst.Position = UDim2.fromOffset(Value.X, Value.Y)
end
elseif Key == 'Radius' then
local Span = math.max(2, (tonumber(Value) or 1) * 2)
Inst.Size = UDim2.fromOffset(Span, Span)
elseif Key == 'Filled' then
if Kind == 'Circle' then
local GuiAlpha = 1 - math.clamp(tonumber(Props.Transparency) or 1, 0, 1)
Inst.BackgroundTransparency = Value and GuiAlpha or 1
end
elseif Key == 'Size' then
if Kind == 'Text' then
Inst.TextSize = math.clamp(tonumber(Value) or 13, 8, 60)
end
elseif Key == 'Center' then
if Kind == 'Text' then
Inst.AnchorPoint = Vector2.new(Value and 0.5 or 0, 0)
end
elseif Key == 'Outline' then
if Kind == 'Text' then
Inst.TextStrokeTransparency = Value and 0 or 1
end
end
end)
end,
})
end

