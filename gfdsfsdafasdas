function State.LocalSpoofs.SnapshotTopAttribute(Attribute)
if State.LocalSpoofs.OriginalTopAttributes[Attribute] then return end
local Value = LP:GetAttribute(Attribute)
State.LocalSpoofs.OriginalTopAttributes[Attribute] = { HasValue = Value ~= nil, Value = Value }
end

function State.LocalSpoofs.GetBoardValue(BoardName)
if BoardName == 'Wins' then return math.max(0, math.floor(tonumber(State.LocalWins) or 0)) end
if BoardName == 'HighestStreak' or BoardName == 'Streak' then
-- The board titled "All-Time Streak Leaderboard" lives in the HighestStreak
-- folder, so accept either streak box rather than silently reading 0.
return math.max(0, math.floor(tonumber(State.LocalHighestStreak) or 0), math.floor(tonumber(State.LocalStreak) or 0))
end
if BoardName == 'Donation' then return math.max(0, math.floor(tonumber(State.LocalDonation) or 0)) end
return math.max(0, math.floor(tonumber(State.LocalELOSpoofEnabled and State.LocalELO or LP:GetAttribute('ELO')) or 0))
end

function State.LocalSpoofs.BoardFolderMap()
return { Wins = 'Wins', ELO = 'ELO', HighestStreak = 'HighestStreak', Streak = 'Streak', Donation = 'Donation' }
end

-- Each board folder holds an all-time board and, for Wins/ELO/Streak, a weekly board.
function State.LocalSpoofs.BoardPeriodNames()
return { 'AllTime', 'Temporary' }
end

function State.LocalSpoofs.IsBoardPeriodName(Name)
return Name == 'AllTime' or Name == 'Temporary'
end

-- Boards live at Workspace.Leaderboards.<Board>.AllTime.ScreenGui.Bottom.ListFrame.
-- Identity comes from the owning folder name, never from title text.
function State.LocalSpoofs.DetectLeaderboardType(ListFrame)
if not ListFrame then return nil end
local Period, Node = nil, ListFrame
for _ = 1, 8 do
if not Node then break end
if State.LocalSpoofs.IsBoardPeriodName(Node.Name) then Period = Node end
Node = Node.Parent
end
if not Period then return nil end
local Folder = Period.Parent
if not Folder then return nil end
return State.LocalSpoofs.BoardFolderMap()[Folder.Name]
end

function State.LocalSpoofs.RegisterLeaderboardList(Object)
if not (Object and Object.Name == 'ListFrame') then return end
State.LocalSpoofs.LeaderboardCandidates[Object] = true
local BoardName = State.LocalSpoofs.DetectLeaderboardType(Object)
if BoardName then State.LocalSpoofs.LeaderboardLists[Object] = BoardName end
end

function State.LocalSpoofs.DiscoverWorldLeaderboards()
local Now = os.clock()
if Now - (State.LocalSpoofs.WorldBoardScanAt or -math.huge) < 4 then return end
State.LocalSpoofs.WorldBoardScanAt = Now
local Root = Workspace:FindFirstChild('Leaderboards')
if Root then
for FolderName in pairs(State.LocalSpoofs.BoardFolderMap()) do
local Folder = Root:FindFirstChild(FolderName)
if Folder then
for _, PeriodName in ipairs(State.LocalSpoofs.BoardPeriodNames()) do
local Period = Folder:FindFirstChild(PeriodName)
local Gui = Period and Period:FindFirstChild('ScreenGui')
local Bottom = Gui and Gui:FindFirstChild('Bottom')
local ListFrame = Bottom and Bottom:FindFirstChild('ListFrame')
if not ListFrame and Period then ListFrame = Period:FindFirstChild('ListFrame', true) end
if ListFrame then State.LocalSpoofs.RegisterLeaderboardList(ListFrame) end
end
end
end
end
if not State.LocalSpoofs.WorldBoardConnectionBound then
State.LocalSpoofs.WorldBoardConnectionBound = true
GiveSignal(Workspace.DescendantAdded:Connect(function(Object)
local ListFrame = Object.Name == 'ListFrame' and Object or Object:FindFirstAncestor('ListFrame')
if ListFrame then
task.delay(0.35, function()
if ListFrame and ListFrame.Parent then State.LocalSpoofs.RegisterLeaderboardList(ListFrame) end
end)
end
end))
end
end

function State.LocalSpoofs.ReadBoardRow(Row)
local PlayerName = Row:FindFirstChild('playername', true)
if not (PlayerName and (PlayerName:IsA('TextLabel') or PlayerName:IsA('TextButton'))) then return nil end
return {
Row = Row,
PlayerName = PlayerName,
ValueLabel = Row:FindFirstChild('value', true),
RankLabel = Row:FindFirstChild('rank', true),
Icon = (Row:FindFirstChild('Frame') and Row.Frame:FindFirstChild('playerIcon')) or Row:FindFirstChild('playerIcon', true),
Order = tonumber(Row.Name) or math.huge,
}
end

-- The native renderer also drives workspace.Map.Extra.Leaderboards[Board].Pedestals,
-- which holds the three podium dummies shown above each board.
function State.LocalSpoofs.FindBoardPedestals(BoardName)
local Map = Workspace:FindFirstChild('Map')
local Extra = Map and Map:FindFirstChild('Extra')
local Root = Extra and Extra:FindFirstChild('Leaderboards')
local Folder = Root and Root:FindFirstChild(BoardName)
return Folder and Folder:FindFirstChild('Pedestals') or nil
