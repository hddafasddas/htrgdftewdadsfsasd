function Aureate.new(options)
    options = options or {}
    local self = setmetatable({}, Aureate)
    self.Name = options.Name or "SILVER SURFER"
    self.Theme = merge(DEFAULT_THEME, options.Theme)
    self.Options = {}
    self.Windows = {}
    self.Bindings = {}
    self.Janitor = Janitor.new()
    self.MotionEnabled = options.MotionEnabled ~= false
    self.ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift
    self.ConfigFolder = options.ConfigFolder or "SilverSurferUI"
    self.Visible = true
    self.OpenDropdown = nil

    self.Gui = create("ScreenGui", {
        Name = self.Name .. "_UI",
        ResetOnSpawn = false,
        -- Inset OFF keeps AbsolutePosition in the same space as InputObject
        -- positions, so every drag (sliders, colour fields, dials) lands where
        -- the cursor actually is. Global ZIndex lets popups escape their row.
        IgnoreGuiInset = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = options.DisplayOrder or 120,
        Parent = guiParent(),
    })
    self.Janitor:Add(self.Gui)

    -- Popup layer. Dropdown menus and colour pickers are parented here rather
    -- than to the row that owns them, so they can never be clipped by a
    -- section, hidden behind a later sibling, or overlap the next control.
    self.Overlay = create("Frame", {
        Name = "Overlay", Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, ZIndex = 500, Parent = self.Gui,
    })

    self.Toasts = create("Frame", {
        Name = "Notifications",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.fromOffset(300, 460),
        BackgroundTransparency = 1,
        ZIndex = 400,
        Parent = self.Gui,
    }, {
        create("UIListLayout", {
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            HorizontalAlignment = Enum.HorizontalAlignment.Right,
            SortOrder = Enum.SortOrder.LayoutOrder,
        })
    })

    self.Janitor:Add(UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == self.ToggleKey then self:Toggle() end
    end))
    return self
end

function Aureate:_tween(obj, info, props)
    if not obj or not obj.Parent then return nil end
    if not self.MotionEnabled then
        for k, v in pairs(props) do obj[k] = v end
        return nil
    end
    local tween = TweenService:Create(obj, info or MOTION.Normal, props)
    tween:Play()
    return tween
end

function Aureate:_bind(obj, prop, token)
    obj[prop] = self.Theme[token]
    table.insert(self.Bindings, { Object = obj, Property = prop, Token = token })
    return obj
end

function Aureate:ApplyTheme(theme)
    self.Theme = merge(self.Theme, theme)
    for i = #self.Bindings, 1, -1 do
        local bind = self.Bindings[i]
        if bind.Object.Parent then
            self:_tween(bind.Object, MOTION.Normal, { [bind.Property] = self.Theme[bind.Token] })
        else
            table.remove(self.Bindings, i)
        end
    end
end

function Aureate:Register(id, control)
    assert(type(id) == "string" and id ~= "", "Control ids must be non-empty strings")
    assert(not self.Options[id], "Duplicate control id: " .. tostring(id))
    self.Options[id] = control
    return control
end

function Aureate:SetVisible(visible)
    self.Visible = visible
    for _, window in ipairs(self.Windows) do window:SetVisible(visible) end
end

function Aureate:Toggle() self:SetVisible(not self.Visible) end

function Aureate:Notify(options)
    options = type(options) == "string" and { Title = options } or (options or {})
    local duration = options.Duration or 4
    local token = options.Type == "Success" and "Success"
        or options.Type == "Warning" and "Warning"
        or options.Type == "Error" and "Danger" or "Gold"

    -- Resolve the toast's height up front. AutomaticSize plus a full-height
    -- accent child creates a circular layout dependency and can make even a
    -- two-line notification grow to the height of the notification container.
    local body = options.Content or options.Text
    body = body and tostring(body) or nil
    local contentWidth = 278 -- 300px card minus 12px/10px horizontal padding
    local bodyHeight = 0
    if body and body ~= "" then
        bodyHeight = math.min(
            TextService:GetTextSize(body, 12, FONT, Vector2.new(contentWidth, 10000)).Y,
            options.MaxBodyHeight or 144
        )
    end
    local cardHeight = 9 + 15 + (bodyHeight > 0 and 3 + bodyHeight or 0) + 10

    local card = create("Frame", {
        Size = UDim2.new(1, 0, 0, cardHeight),
        BackgroundColor3 = self.Theme.Surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 400,
        Parent = self.Toasts,
    }, { corner(2), stroke(self.Theme.BorderSoft) })
    self:_bind(card, "BackgroundColor3", "Surface")

    local accent = create("Frame", {
        Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(2, cardHeight),
        BorderSizePixel = 0, ZIndex = 402,
        BackgroundColor3 = self.Theme[token], Parent = card,
    })
    self:_bind(accent, "BackgroundColor3", token)

    -- Keep layout-managed text in its own container so the decorative accent
    -- is never treated as a UIListLayout item.
    local content = create("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        ZIndex = 401, Parent = card,
    }, {
        padding(9, 10, 10, 12),
        create("UIListLayout", {
            Padding = UDim.new(0, 3),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })

    local title = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Font = FONT, TextSize = TEXT,
        TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = self.Theme[token],
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = tostring(options.Title or "Notification"), LayoutOrder = 1, ZIndex = 402, Parent = content,
    })
    self:_bind(title, "TextColor3", token)

    if bodyHeight > 0 then
        local message = create("TextLabel", {
            Size = UDim2.new(1, 0, 0, bodyHeight),
            BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextWrapped = true,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            TextColor3 = self.Theme.TextMuted, Text = body, LayoutOrder = 2,
            ZIndex = 402, Parent = content,
        })
        self:_bind(message, "TextColor3", "TextMuted")
    end

    local scale = create("UIScale", { Scale = 0.96, Parent = card })
    self:_tween(card, MOTION.Normal, { BackgroundTransparency = 0 })
    self:_tween(scale, MOTION.Normal, { Scale = self.FitScale or 1 })

    task.delay(duration, function()
        if not card.Parent then return end
        self:_tween(card, MOTION.Fast, { BackgroundTransparency = 1 })
        self:_tween(scale, MOTION.Fast, { Scale = 0.96 })
        task.delay(0.14, function() if card.Parent then card:Destroy() end end)
    end)

    return { Close = function() if card.Parent then card:Destroy() end end }
end

