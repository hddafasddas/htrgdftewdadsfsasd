    local function readLivePower(fallback)
        local player = Players.LocalPlayer
        local character = player and player.Character
        local names = { "Power", "power", "ShotPower", "shotPower", "ShootingPower", "shootingPower" }
        local function valid(value)
            value = tonumber(value)
            if value and value >= 1 and value <= 200 then return value end
        end
        for _, source in ipairs({ player, character }) do
            if source then
                for _, name in ipairs(names) do
                    local value = valid(source:GetAttribute(name))
                    if value then return value end
                end
            end
        end
        if player then
            for _, object in ipairs(player:GetDescendants()) do
                local lower = string.lower(object.Name)
                if string.find(lower, "power", 1, true) then
                    if object:IsA("NumberValue") or object:IsA("IntValue") then
                        local value = valid(object.Value)
                        if value then return value end
                    elseif object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
                        local value = valid(string.match(object.Text, "%d+%.?%d*"))
                        if value then return value end
                    end
                end
            end
            -- Some games give the power number a generic label name. Prefer a
            -- standalone numeric label on the left side of the player's HUD.
            local gui = player:FindFirstChildOfClass("PlayerGui")
            local camera = Workspace.CurrentCamera
            local width = camera and camera.ViewportSize.X or 1920
            local best
            if gui then
                for _, object in ipairs(gui:GetDescendants()) do
                    if (object:IsA("TextLabel") or object:IsA("TextButton")) and object.Visible then
                        local text = tostring(object.Text):match("^%s*(%d+%.?%d*)%s*$")
                        local value = valid(text)
                        if value and object.AbsolutePosition.X < width * 0.3 then
                            if not best or value > best then best = value end
                        end
                    end
                end
            end
            if best then return best end
        end
        return valid(fallback) or 85
    end

    local hoopParts, nextHoopScan = {}, 0
    local function refreshRangeHoops()
        table.clear(hoopParts)
        local seen = {}
        local function add(object)
            local part = object
            if part and not part:IsA("BasePart") then part = part:FindFirstChildWhichIsA("BasePart", true) end
            if part and part:IsA("BasePart") and not seen[part] then
                seen[part] = true
                table.insert(hoopParts, part)
            end
        end
        pcall(function()
            for _, object in ipairs(CollectionService:GetTagged("FieldGoals")) do add(object) end
        end)
        for _, object in ipairs(Workspace:GetDescendants()) do
            local name = string.lower(object.Name)
            if name == "rim" or name == "mainrim" or name == "c__rim" or name == "realgo"
                or name == "realgo1" or name == "go1" or name == "go2" or name == "hoop"
                or name == "basketballhoop" then add(object) end
        end
        nextHoopScan = os.clock() + 2
    end
    local function liveHoopDistance()
        if os.clock() >= nextHoopScan or #hoopParts == 0 then refreshRangeHoops() end
        local player = Players.LocalPlayer
        local character = player and player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root then return nil end
        local closest = math.huge
        for index = #hoopParts, 1, -1 do
            local part = hoopParts[index]
            if not part or not part.Parent then table.remove(hoopParts, index)
            else closest = math.min(closest, (part.Position - root.Position).Magnitude) end
        end
        return closest < math.huge and closest or nil
    end

