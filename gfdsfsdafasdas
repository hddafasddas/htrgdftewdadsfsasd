        adaptiveDefense = false,
        adaptiveOnBallDistance = 14, -- studs; inside this, the handler wins
        adaptiveIntentSlack = 3,     -- studs the off-ball man must beat it by

        -- Head Ride: the close-range phase of adaptive off-ball defense.
        headRide = false,
        headRideEngageRange = 5,
        headRideFollowDistance = 7,
