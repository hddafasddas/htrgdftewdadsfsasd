return UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
end)
if Ok then
for _, Input in ipairs(Inputs) do
if Input.KeyCode == Enum.KeyCode.Thumbstick2
and Vector2.new(Input.Position.X, Input.Position.Y).Magnitude > 0.12 then
return true
end
end
end
return false
end

local function StartLegitAimTween()
local OriginalCamlock = CONFIG.AimMode == 'Original'
if not ((CONFIG.LegitTweenAim or OriginalCamlock) and State.Active and State.Enabled) then return false end
if State.PassInProgress or (State.AutoDunk and State.AutoDunk.InProgress) then return false end
local Character = LP.Character
local LocalHumanoid = Character and safe_find(Character, 'Humanoid')
if not Character or not LocalHumanoid or not Character:FindFirstChild('Basketball') then
return false
end

local Target = GetLegitTweenTarget()
if not Target then return false end
StopLegitAimTween()
State.LegitAimSequenceActive = true
State.LegitAimTarget = Target
State.LegitAimLastFrameAt = os.clock()
State.LegitAimLastSolveAt = State.LegitAimLastFrameAt
local StartingCamera = Workspace.CurrentCamera
State.LegitAimSmoothedDirection = StartingCamera and StartingCamera.CFrame.LookVector or nil
State.LegitAimTurnSign = 0
State.LegitAimLastFlickProgress = 0
State.LegitAimReactionDelay = math.random()
* math.max((tonumber(CONFIG.LegitAimReactionMax) or 0.11)
- (tonumber(CONFIG.LegitAimReactionMin) or 0.05), 0)
+ math.max(tonumber(CONFIG.LegitAimReactionMin) or 0.05, 0)
State.LegitAimSwaySeed = math.random() * 1000
local Generation = State.LegitAimGeneration
local StartedAt = State.LegitAimLastFrameAt
local HoldTime = math.max(CONFIG.LegitTweenHoldTime, 0)
local FadeTime = math.max(CONFIG.LegitTweenFadeTime, 0.01)
local ReleaseAt = HoldTime + FadeTime

RunService:BindToRenderStep(
LEGIT_AIM_BIND_NAME,
Enum.RenderPriority.Camera.Value + 20,
WYNF_JIT(function()
if not (State.Active and State.Enabled and State.LegitAimSequenceActive) then
StopLegitAimTween()
return
end

local Now = os.clock()
local Elapsed = Now - StartedAt
local DeltaTime = math.clamp(Now - (State.LegitAimLastFrameAt or Now), 1 / 240, 1 / 20)
State.LegitAimLastFrameAt = Now
if not OriginalCamlock
and Elapsed < (tonumber(State.LegitAimReactionDelay) or 0) then
return
end
if not OriginalCamlock and Elapsed >= ReleaseAt then
StopLegitAimTween()
return
end

-- Re-solve while the player rises so moving-shot lead, release
-- height, selected arc and assisted power remain current.
if Now - State.LegitAimLastSolveAt >= (1 / 30) then
State.LegitAimLastSolveAt = Now
local UpdatedTarget = GetLegitTweenTarget()
if UpdatedTarget then
Target = UpdatedTarget
State.LegitAimTarget = UpdatedTarget
end
end

local CurrentCamera = Workspace.CurrentCamera
local Head = Character:FindFirstChild('Head')
if not CurrentCamera or not Head then return end

-- GetFormulaTarget is a far point emitted from the head. Reuse its
-- direction from the camera position to avoid third-person parallax
-- changing the ballistic pitch.
local FormulaVector = Target - Head.Position
if FormulaVector.Magnitude <= 0.0001 then return end
local FormulaDirection = FormulaVector.Unit
local Current = CurrentCamera.CFrame
if OriginalCamlock then
local Desired = CFrame.lookAt(
Current.Position,
Current.Position + FormulaDirection,
Vector3.yAxis)
CurrentCamera.CFrame = Desired
CurrentCamera.Focus = CFrame.new(Current.Position + FormulaDirection * 1000)
return
end

-- Keep our own yaw/pitch instead of CFrame:Lerp. Quaternion lerp is
-- ambiguous near 180 degrees and can alternate between left/right
-- paths when a backwards target moves slightly, producing stutter.
local ManualInput = IsManualCameraAimActive()
local SmoothedDirection = State.LegitAimSmoothedDirection
if typeof(SmoothedDirection) ~= 'Vector3' or SmoothedDirection.Magnitude < 0.5
or ManualInput then
SmoothedDirection = Current.LookVector
else
SmoothedDirection = SmoothedDirection.Unit
end

local SwayAmp = math.rad(math.max(tonumber(CONFIG.LegitAimSwayDegrees) or 0.45, 0))
local SwaySpeed = math.max(tonumber(CONFIG.LegitAimSwaySpeed) or 5.2, 0.01)
local SwaySeed = tonumber(State.LegitAimSwaySeed) or 0
local SwayYaw = SwayAmp
* (math.sin(Elapsed * SwaySpeed + SwaySeed) * 0.65
+ math.sin(Elapsed * SwaySpeed * 0.41 + SwaySeed * 1.7) * 0.35)
local SwayPitch = SwayAmp * 0.7
* (math.sin(Elapsed * SwaySpeed * 0.83 + SwaySeed * 2.3) * 0.6
+ math.sin(Elapsed * SwaySpeed * 0.29 + SwaySeed * 0.7) * 0.4)
local CurrentYaw = math.atan2(-SmoothedDirection.X, -SmoothedDirection.Z)
local TargetYaw = math.atan2(-FormulaDirection.X, -FormulaDirection.Z) + SwayYaw
local YawError = math.atan2(
math.sin(TargetYaw - CurrentYaw),
math.cos(TargetYaw - CurrentYaw))

-- Lock the initial turn side while the target is substantially
-- behind the camera. Without this, tiny formula updates around the
-- +/-pi boundary can reverse the chosen turn direction every frame.
if math.abs(YawError) > math.rad(150) then
if State.LegitAimTurnSign == 0 then
State.LegitAimTurnSign = YawError >= 0 and 1 or -1
end
YawError = math.abs(YawError) * State.LegitAimTurnSign
elseif math.abs(YawError) < math.rad(90) then
State.LegitAimTurnSign = 0
elseif State.LegitAimTurnSign ~= 0 then
YawError = math.abs(YawError) * State.LegitAimTurnSign
end

local CurrentPitch = math.asin(math.clamp(SmoothedDirection.Y, -1, 1))
local TargetPitch = math.asin(math.clamp(FormulaDirection.Y, -1, 1)) + SwayPitch
local PitchError = TargetPitch - CurrentPitch
local ErrorAngle = math.sqrt(YawError * YawError + PitchError * PitchError)
local Deadzone = math.rad(tonumber(CONFIG.LegitAimDeadzoneDegrees) or 0.035)
if ErrorAngle <= Deadzone then
YawError = 0
PitchError = 0
ErrorAngle = Deadzone
end

-- Use an S-curve for the initial flick: it accelerates naturally,
-- moves fastest in the middle, then eases into the exact formula
-- angle. Incremental eased progress keeps the turn deterministic
-- without the constant-speed, lock-on look of a deadline snap.
local FlickTime = math.max(tonumber(CONFIG.LegitAimFlickTime) or 0.28, 0.06)
local IsInitialFlick = (tonumber(State.LegitAimLastFlickProgress) or 0) < 1
local Fade = 1
if Elapsed > HoldTime then
local FadeAlpha = math.clamp((Elapsed - HoldTime) / FadeTime, 0, 1)
Fade = 1 - FadeAlpha * FadeAlpha * (3 - 2 * FadeAlpha)
end
if Fade <= 0.0001 then return end

local StepAlpha
if IsInitialFlick then
local Progress = math.clamp(
(Elapsed - (tonumber(State.LegitAimReactionDelay) or 0)) / FlickTime, 0, 1)
local EasedProgress = Progress * Progress * (3 - 2 * Progress)
local PreviousProgress = math.clamp(
tonumber(State.LegitAimLastFlickProgress) or 0, 0, 0.999999)
StepAlpha = math.clamp(
(EasedProgress - PreviousProgress) / (1 - PreviousProgress), 0, 1)
local FlickCap = math.rad(math.max(
tonumber(CONFIG.LegitAimFlickMaxDegreesPerSecond) or 260, 1)) * DeltaTime
StepAlpha = math.min(StepAlpha, FlickCap / ErrorAngle)
State.LegitAimLastFlickProgress = EasedProgress
else
State.LegitAimLastFlickProgress = 1
-- After the eased flick, softly follow small formula changes
-- caused by movement, height, or power.
local ManualScale = ManualInput
and math.clamp(tonumber(CONFIG.LegitAimManualInputScale) or 0.22, 0, 1)
or 1
local Weight = Fade * ManualScale
local Response = math.max(tonumber(CONFIG.LegitAimResponse) or 14, 0.01)
local NaturalAlpha = 1 - math.exp(-Response * DeltaTime * Weight)
local MaxRadians = math.rad(math.max(
tonumber(CONFIG.LegitAimMaxDegreesPerSecond) or 540, 1))
* DeltaTime * Weight
StepAlpha = math.min(NaturalAlpha, MaxRadians / ErrorAngle, 1)
end
local NewYaw = CurrentYaw + YawError * StepAlpha
local NewPitch = CurrentPitch + PitchError * StepAlpha
local CosPitch = math.cos(NewPitch)
local AimedDirection = Vector3.new(
-math.sin(NewYaw) * CosPitch,
math.sin(NewPitch),
-math.cos(NewYaw) * CosPitch).Unit
State.LegitAimSmoothedDirection = AimedDirection

-- Apply after Roblox's camera update using a stable world-up axis.
-- This avoids roll changes and guarantees the visible camera follows
-- the same ballistic direction through a full backwards rotation.
local Aimed = CFrame.lookAt(
Current.Position,
Current.Position + AimedDirection,
Vector3.yAxis)
CurrentCamera.CFrame = Aimed
CurrentCamera.Focus = CFrame.new(Aimed.Position + AimedDirection * 1000)
end)
)

LegitAimLandConnection = LocalHumanoid:GetPropertyChangedSignal('FloorMaterial'):Connect(function()
if LocalHumanoid.FloorMaterial ~= Enum.Material.Air then
StopLegitAimTween()
end
end)
if not OriginalCamlock then
task.delay(ReleaseAt, function()
if Generation == State.LegitAimGeneration then StopLegitAimTween() end
end)
end
return true
end

