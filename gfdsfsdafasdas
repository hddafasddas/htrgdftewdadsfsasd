-- Head Ride is the close-range phase of Adaptive Auto Guard's off-ball mode.
-- Normal guard positioning closes the gap first; once its assigned opponent
-- enters the engage radius, this helper mounts and follows that same target.
function State.AutoHeadRide.HasManualInput()
if not CONFIG.AutoHeadRideManualOverride then return false end
for _, Key in ipairs(PerfCache.MovementOverrideKeys) do
if UserInputService:IsKeyDown(Key) then return true end
end
if not UserInputService.GamepadEnabled then return false end
local Ok, Inputs = pcall(function()
return UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
end)
if Ok then
for _, Input in ipairs(Inputs) do
if Input.KeyCode == Enum.KeyCode.Thumbstick1
and Vector2.new(Input.Position.X, Input.Position.Y).Magnitude > 0.18 then
return true
end
end
end
return false
end

function State.AutoHeadRide.GetTargetData(Player, LocalRoot)
if not Player or Player == LP or not LocalRoot then return nil end
local Character = Player.Character
local Root = Character and safe_find(Character, 'HumanoidRootPart')
local HumanoidObject = Character and safe_find(Character, 'Humanoid')
local Head = Character and safe_find(Character, 'Head')
if not (Character and Root and HumanoidObject and Head)
or HumanoidObject.Health <= 0
or safe_find(Character, 'Basketball') then
return nil
end
local Delta = Root.Position - LocalRoot.Position
local Distance = Vector3.new(Delta.X, 0, Delta.Z).Magnitude
return Character, Root, HumanoidObject, Head, Distance
end

function State.AutoHeadRide.Reset(Status)
local Ride = State.AutoHeadRide
Ride.Target = nil
Ride.TargetDistance = math.huge
Ride.Mounted = false
Ride.Engaged = false
Ride.EngagedTarget = nil
Ride.Status = Status or (Ride.Enabled and 'WAITING FOR OFF-BALL' or 'OFF')
end

function State.AutoHeadRide.IsMounted(LocalRoot, LocalHumanoid, TargetHead)
if not (LocalRoot and LocalHumanoid and TargetHead) then return false end
local FeetOffset = LocalHumanoid.RigType == Enum.HumanoidRigType.R6 and 3.5 or 3
local Feet = LocalRoot.Position - Vector3.new(0, FeetOffset, 0)
local Difference = Feet - TargetHead.Position
local Horizontal = Vector3.new(Difference.X, 0, Difference.Z).Magnitude
return math.abs(Difference.Y)
< (tonumber(CONFIG.AutoHeadRideMountVertical) or 1.5)
and Horizontal < (tonumber(CONFIG.AutoHeadRideMountHorizontal) or 1.5),
FeetOffset
end

function State.AutoHeadRide.StepOffBall(
Target, HumanoidObject, Root, DeltaTime)
local Ride = State.AutoHeadRide
if not (State.Active and Ride.Enabled and HumanoidObject and Root) then
return false
end
if Ride.EngagedTarget and Ride.EngagedTarget ~= Target then
Ride.Reset('NEW OFF-BALL ASSIGNMENT')
end
local TargetCharacter, TargetRoot, TargetHumanoid, TargetHead, Distance =
Ride.GetTargetData(Target, Root)
Ride.Target = Target
Ride.TargetDistance = Distance or math.huge
if not (TargetCharacter and TargetRoot and TargetHumanoid and TargetHead) then
Ride.Reset('WAITING FOR OFF-BALL')
return false
end
if Ride.HasManualInput() then
Ride.Status = 'MANUAL OVERRIDE'
return true
end

local Now = os.clock()
local EngageRange = math.max(
tonumber(CONFIG.AutoHeadRideEngageRange) or 5, 1.5)
if not Ride.Engaged then
if Distance > EngageRange then
Ride.Status = string.format('OFF-BALL GUARD | %.1f', Distance)
return false
end
Ride.Engaged = true
Ride.EngagedTarget = Target
end

local Mounted, FeetOffset = Ride.IsMounted(Root, HumanoidObject, TargetHead)
Ride.Mounted = Mounted
if Mounted then
local DesiredPosition = TargetHead.Position + Vector3.new(0, FeetOffset + 0.2, 0)
local DesiredCFrame = CFrame.new(DesiredPosition) * Root.CFrame.Rotation
local Smoothness = math.max(tonumber(CONFIG.AutoHeadRideMountSmoothness) or 18, 1)
local Alpha = 1 - math.exp(-Smoothness * math.clamp(DeltaTime or 1 / 60, 0, 0.1))
Root.CFrame = Root.CFrame:Lerp(DesiredCFrame, Alpha)
HumanoidObject:Move(Vector3.zero, false)
Ride.Status = 'RIDING | ' .. Target.Name
return true
end

local Offset = TargetRoot.Position - Root.Position
local FlatOffset = Vector3.new(Offset.X, 0, Offset.Z)
if FlatOffset.Magnitude < 0.01 then
HumanoidObject:Move(Vector3.zero, false)
Ride.Status = 'MOUNTING | ' .. Target.Name
return true
end

local TargetMove = Vector3.new(
TargetHumanoid.MoveDirection.X, 0, TargetHumanoid.MoveDirection.Z)
local FollowDistance = math.max(
tonumber(CONFIG.AutoHeadRideFollowDistance) or 7, 0.5)
local AutoJump = CONFIG.AutoHeadRideAutoJump == true
local ApproachDistance = AutoJump and math.min(FollowDistance, 1.4) or FollowDistance
local MoveDirection
if FlatOffset.Magnitude > ApproachDistance then
MoveDirection = FlatOffset.Unit
if TargetMove.Magnitude > 0.05 then
local Blend = TargetMove.Unit + FlatOffset.Unit
if Blend.Magnitude > 0.05 then MoveDirection = Blend.Unit end
end
elseif TargetMove.Magnitude > 0.05 then
MoveDirection = TargetMove.Unit
else
MoveDirection = Vector3.zero
end
if State.Runtime.AcquireMovement('Guard') then HumanoidObject:Move(MoveDirection, false) end

local JumpDistance = math.max(
tonumber(CONFIG.AutoHeadRideJumpDistance) or 2.8, 1)
if AutoJump and FlatOffset.Magnitude <= JumpDistance
and HumanoidObject.FloorMaterial ~= Enum.Material.Air
and Now - (Ride.LastJumpAt or 0)
>= (tonumber(CONFIG.AutoHeadRideJumpCooldown) or 0.8) then
Ride.LastJumpAt = Now
HumanoidObject.Jump = true
pcall(function()
HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)
end)
Ride.Status = 'JUMPING TO | ' .. Target.Name
else
Ride.Status = 'FOLLOWING | ' .. Target.Name
end
return true
end

