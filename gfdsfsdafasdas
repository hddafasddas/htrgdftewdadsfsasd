if typeof(KeyValue) == 'EnumItem' then return KeyValue end
if type(KeyValue) ~= 'string' or KeyValue == '' then return nil end
local Ok, Key = pcall(function() return Enum.KeyCode[KeyValue] end)
return Ok and Key or nil
end

function State.AutoBody.RequestHandSwitch(DesiredHand)
local Now = os.clock()
local Cooldown = math.clamp(
tonumber(CONFIG.AutoBodyHandSwitchCooldown) or 0.40, 0.15, 1.2)
if State.AutoBody.HandInputBusy
or Now - State.AutoBody.LastHandSwitchAt < Cooldown then
return false
end
local Key = State.AutoBody.GetSwitchHandKey()
if not Key then
State.AutoBody.HandStatus = 'NO SWITCH BIND'
return false
end

State.AutoBody.HandInputBusy = true
State.AutoBody.LastHandSwitchAt = Now
State.AutoBody.HandCandidate = nil
State.AutoBody.HandCandidateSince = 0
State.AutoBody.HandStatus = DesiredHand == 'L' and 'SWITCHING LEFT' or 'SWITCHING RIGHT'
task.spawn(function()
local Pressed = pcall(function()
VirtualInputManager:SendKeyEvent(true, Key, false, game)
end)
task.wait(0.05)
pcall(function()
VirtualInputManager:SendKeyEvent(false, Key, false, game)
end)
if Pressed then State.AutoBody.CurrentHand = DesiredHand end
State.AutoBody.HandInputBusy = false
end)
return true
end

function State.AutoBody.UpdateHand(
Character, HumanoidObject, Root, TargetRoot)
if not safe_find(Character, 'Basketball') then
State.AutoBody.CurrentHand = nil
State.AutoBody.HandStatus = 'WAITING FOR BALL'
State.AutoBody.HandCandidate = nil
return nil
end

local CurrentHand, RestingTrack, DribbleTrack =
State.AutoBody.GetCurrentHand(Character, HumanoidObject, Root)
State.AutoBody.WatchBounce(DribbleTrack)
if CurrentHand then
State.AutoBody.CurrentHand = CurrentHand
if not State.AutoBody.HandInputBusy then
State.AutoBody.HandStatus = CurrentHand == 'L' and 'LEFT' or 'RIGHT'
end
end

if not CONFIG.AutoBodyAutoHands then
State.AutoBody.HandStatus = CurrentHand
and ('MANUAL ' .. (CurrentHand == 'L' and 'LEFT' or 'RIGHT')) or 'MANUAL'
State.AutoBody.HandCandidate = nil
return CurrentHand
end

local Right = Vector3.new(
Root.CFrame.RightVector.X, 0, Root.CFrame.RightVector.Z)
if Right.Magnitude <= 0.01 then return CurrentHand end
Right = Right.Unit

if not TargetRoot then
State.AutoBody.HandCandidate = nil
State.AutoBody.HandCandidateSince = 0
return CurrentHand
end
local DefenderOffset = TargetRoot.Position - Root.Position
local FlatDefenderOffset = Vector3.new(
DefenderOffset.X, 0, DefenderOffset.Z)
if FlatDefenderOffset.Magnitude <= 0.05 then return CurrentHand end
local DefenderSide = FlatDefenderOffset.Unit:Dot(Right)
if math.abs(DefenderSide) < AUTO_BODY_HAND_DEADZONE then
State.AutoBody.HandCandidate = nil
State.AutoBody.HandCandidateSince = 0
return CurrentHand
end

local DesiredHand = DefenderSide > 0 and 'L' or 'R'
if CurrentHand == DesiredHand then
State.AutoBody.HandStatus = DesiredHand == 'L' and 'LEFT' or 'RIGHT'
State.AutoBody.HandCandidate = nil
State.AutoBody.HandCandidateSince = 0
return CurrentHand
end

local RevertDeadzone = math.clamp(
tonumber(CONFIG.AutoBodyHandRevertDeadzone) or 0.30,
AUTO_BODY_HAND_DEADZONE, 0.9)
if math.abs(DefenderSide) < RevertDeadzone then
State.AutoBody.HandCandidate = nil
State.AutoBody.HandCandidateSince = 0
return CurrentHand
end

local Now = os.clock()
if State.AutoBody.HandCandidate ~= DesiredHand then
State.AutoBody.HandCandidate = DesiredHand
State.AutoBody.HandCandidateSince = Now
State.AutoBody.HandStatus = DesiredHand == 'L' and 'READING LEFT' or 'READING RIGHT'
return CurrentHand
end

local StableTime = math.clamp(
tonumber(CONFIG.AutoBodyHandStableTime) or 0.12, 0.05, 0.4)
local FallbackReady = CurrentHand ~= nil
and not State.AutoBody.HandInputBusy
and Now - State.AutoBody.LastHandSwitchAt >= math.clamp(
tonumber(CONFIG.AutoBodyHandSwitchCooldown) or 0.40, 0.15, 1.2)
if (RestingTrack or FallbackReady)
and Now - State.AutoBody.HandCandidateSince >= StableTime
and State.AutoBody.BounceWindowOpen() then
State.AutoBody.RequestHandSwitch(DesiredHand)
elseif State.AutoBody.HandCandidate == DesiredHand
and not State.AutoBody.HandInputBusy then
State.AutoBody.HandStatus = DesiredHand == 'L'
and 'TIMING LEFT' or 'TIMING RIGHT'
end
return CurrentHand
end

function State.AutoBody.FindDefender(LocalRoot)
local MaximumRange = math.max(4, tonumber(CONFIG.AutoBodyRange) or 25)
local Stickiness = math.clamp(
tonumber(CONFIG.AutoBodyTargetHysteresis) or 2.5, 0, 8)
local CurrentTarget = State.AutoBody.Target
local CurrentDistance = math.huge
local BestPlayer
local BestScore = -math.huge
local BestDistance = math.huge

local Look = Vector3.new(
LocalRoot.CFrame.LookVector.X, 0, LocalRoot.CFrame.LookVector.Z)
Look = Look.Magnitude > 0.01 and Look.Unit or nil

local RimDirection
local RimPosition = State.AutoBody.GetRimPosition()
if RimPosition then
local ToRim = Vector3.new(
RimPosition.X - LocalRoot.Position.X,
0,
RimPosition.Z - LocalRoot.Position.Z
)
if ToRim.Magnitude > 0.05 then RimDirection = ToRim.Unit end
end

for _, Player in ipairs(Players:GetPlayers()) do
if IsGuardOpponent(Player) then
local TargetRoot = GetAutoBodyTargetRig(Player)
if TargetRoot then
local Offset = TargetRoot.Position - LocalRoot.Position
local Flat = Vector3.new(Offset.X, 0, Offset.Z)
local Distance = Flat.Magnitude
if Player == CurrentTarget then
CurrentDistance = Distance
end
if Distance <= MaximumRange and Distance > 0.01 then
local Direction = Flat.Unit
local Score = (MaximumRange - Distance) * 3

local Ok, Velocity = pcall(function()
return TargetRoot.AssemblyLinearVelocity
end)
if Ok and typeof(Velocity) == 'Vector3' then
local Closing = -Vector3.new(
Velocity.X, 0, Velocity.Z):Dot(Direction)
Score += math.clamp(Closing, -10, 30) * 1.5
end

if Look then
Score += math.clamp(Direction:Dot(Look), -1, 1) * 10
end
if RimDirection then
Score += math.clamp(
Direction:Dot(RimDirection), 0, 1) * 18
end
if Player == CurrentTarget then
Score += Stickiness * 4
end

if Score > BestScore then
BestPlayer = Player
BestScore = Score
BestDistance = Distance
end
end
end
end
end

if BestPlayer then return BestPlayer, BestDistance end
if CurrentTarget and CurrentDistance <= MaximumRange then
return CurrentTarget, CurrentDistance
end
return nil, math.huge
end

function State.AutoBody.GetDesiredFacing(Root, TargetRoot, Away, CurrentHand)
local DesiredDirection = State.AutoBody.SolveFacing(Root, TargetRoot, Away)
local SpaceAngle = math.rad(math.clamp(
tonumber(CONFIG.AutoBodySpaceAngle) or 20, 0, 45))
if CurrentHand and SpaceAngle > 0 then
local SignedAngle = CurrentHand == 'R' and SpaceAngle or -SpaceAngle
local Cosine = math.cos(SignedAngle)
local Sine = math.sin(SignedAngle)
DesiredDirection = Vector3.new(
DesiredDirection.X * Cosine + DesiredDirection.Z * Sine,
0,
-DesiredDirection.X * Sine + DesiredDirection.Z * Cosine
).Unit
end
return DesiredDirection
end

local function UpdateAutoBodyBinding()
pcall(function() RunService:UnbindFromRenderStep(AUTO_BODY_BIND_NAME) end)
State.AutoBody.ReleaseRotation()

if not State.AutoBody.Enabled then
State.AutoBody.Target = nil
State.AutoBody.TargetDistance = math.huge
State.AutoBody.Status = 'OFF'
State.AutoBody.CurrentHand = nil
State.AutoBody.HandStatus = CONFIG.AutoBodyAutoHands and 'WAITING' or 'MANUAL'
State.AutoBody.ResetRuntime()
return
end

State.AutoBody.ResetRuntime()
State.AutoBody.LastTargetScan = 0
RunService:BindToRenderStep(
AUTO_BODY_BIND_NAME,
Enum.RenderPriority.Character.Value + 1,
WYNF_JIT(function(DeltaTime)
local Character = LP.Character
local HumanoidObject = Character and Character:FindFirstChildOfClass('Humanoid')
local Root = Character and safe_find(Character, 'HumanoidRootPart')
if not (Character and HumanoidObject and Root and HumanoidObject.Health > 0) then
State.AutoBody.Target = nil
State.AutoBody.TargetDistance = math.huge
State.AutoBody.Status = 'WAITING FOR CHARACTER'
State.AutoBody.CurrentHand = nil
State.AutoBody.HandStatus = CONFIG.AutoBodyAutoHands and 'WAITING' or 'MANUAL'
State.AutoBody.ResetRuntime()
State.AutoBody.ReleaseRotation()
return
end

if CONFIG.AutoBodyRequireBall and not safe_find(Character, 'Basketball') then
State.AutoBody.Target = nil
State.AutoBody.TargetDistance = math.huge
State.AutoBody.Status = 'WAITING FOR BALL'
State.AutoBody.CurrentHand = nil
State.AutoBody.HandStatus = CONFIG.AutoBodyAutoHands and 'WAITING FOR BALL' or 'MANUAL'
State.AutoBody.ResetRuntime()
State.AutoBody.ReleaseRotation()
return
end

if (State.Movement and State.Movement.FlightEnabled)
or (State.Extras and State.Extras.SpinbotEnabled)
or (State.AutoMix and State.AutoMix.Rotating)
or (State.AutoGetOpenEnabled and not safe_find(Character, 'Basketball')) then
State.AutoBody.Status = 'PAUSED FOR MOVEMENT'
State.AutoBody.ReleaseRotation()
return
end

if State.PassInProgress or (State.AutoDunk and State.AutoDunk.InProgress) then
State.AutoBody.Status = 'PAUSED FOR ACTION'
State.AutoBody.ReleaseRotation()
return
end

local ReleasePending = State.PerfectRelease
and State.PerfectRelease.Pending
local AutoMixShotBusy = State.AutoMix and State.AutoMix.IsShotBusy
and State.AutoMix.IsShotBusy(Character, HumanoidObject, Root)
if State.silentShootActive
or (State.NoJump and State.NoJump.Active)
or (State.ClickShoot and State.ClickShoot.Armed)
or AutoMixShotBusy
or (ReleasePending
and os.clock() - (ReleasePending.At or 0) <= 0.55) then
State.AutoBody.Status = 'PAUSED FOR SHOT'
State.AutoBody.ReleaseRotation()
return
end

State.AutoBody.RuntimeIsReset = false
local Now = os.clock()
if Now - State.AutoBody.LastTargetScan >= 0.10 then
State.AutoBody.LastTargetScan = Now
State.AutoBody.Target, State.AutoBody.TargetDistance =
State.AutoBody.FindDefender(Root)
end

local TargetRoot = GetAutoBodyTargetRig(State.AutoBody.Target)
if not TargetRoot then
State.AutoBody.Target = nil
State.AutoBody.TargetDistance = math.huge
State.AutoBody.Status = 'SEARCHING'
State.AutoBody.UpdateHand(Character, HumanoidObject, Root, nil)
State.AutoBody.ReleaseRotation()
return
end

local Separation = Root.Position - TargetRoot.Position
local Away = Vector3.new(Separation.X, 0, Separation.Z)
State.AutoBody.TargetDistance = Away.Magnitude
if Away.Magnitude <= 0.05 then
State.AutoBody.Status = 'HOLDING'
State.AutoBody.ReleaseRotation()
return
end

local CurrentHand = State.AutoBody.UpdateHand(
Character, HumanoidObject, Root, TargetRoot)
State.AutoBody.TakeRotation(HumanoidObject)
State.AutoBody.Status = 'TRACKING'

local DesiredDirection = State.AutoBody.GetDesiredFacing(
Root, TargetRoot, Away, CurrentHand)

local CurrentDirection = Vector3.new(
Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
if CurrentDirection.Magnitude > 0.001
and CurrentDirection.Unit:Dot(DesiredDirection) > 0.99996 then
return
end

local Desired = CFrame.lookAt(
Root.Position,
Root.Position + DesiredDirection,
Vector3.yAxis
)
local Step = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.1)
local Rate = State.AutoBody.SolveTurnRate(
Away.Magnitude, Root, TargetRoot)
local Alpha = 1 - math.exp(-Rate * Step)
Root.CFrame = Root.CFrame:Lerp(Desired, Alpha)
end)
)
end

