State.AutoDunk = {
BindName = 'OBLITERATE_V2_AutoDunkMovement',
Target = nil,
TargetDistance = math.huge,
InProgress = false,
SendingInput = false,
HeldKey = nil,
StartedAt = 0,
LastAttempt = 0,
PlayerData = nil,
OriginalDunkLoadout = nil,
SelectedDunk = nil,
PendingLoadoutRestore = false,
ApplyingLoadout = false,
ResolvedTarget = nil,
TargetResolvedAt = 0,
LaneCheckAt = 0,
LaneTarget = nil,
LaneOpenCached = true,
}

function State.AutoDunk.GetKeyCode()
local PlayerData = State.AutoDunk.GetPlayerData()
local Stored = PlayerData and PlayerData.storedData
local Controls = Stored and Stored.Config and Stored.Config[UserInputService.GamepadEnabled and 'Controls_Controller' or 'Controls_Keyboard']
local Bind = Controls and Controls.Dunk
if typeof(Bind) == 'EnumItem' then return Bind end
if type(Bind) == 'string' and Enum.KeyCode[Bind] then return Enum.KeyCode[Bind] end
return UserInputService.GamepadEnabled and Enum.KeyCode.ButtonX or Enum.KeyCode.T
end

function State.AutoDunk.GetPlayerData()
if State.AutoDunk.PlayerData then return State.AutoDunk.PlayerData end
local Success, PlayerData = pcall(function()
return require(ReplicatedStorage.Util.PlayerData)
end)
if Success and type(PlayerData) == 'table' then
State.AutoDunk.PlayerData = PlayerData
return PlayerData
end
return nil
end

function State.AutoDunk.GetOwnedDunks()
local PlayerData = State.AutoDunk.GetPlayerData()
local ShopItems = safe_find(ReplicatedStorage, 'ShopItems')
local DunkFolder = ShopItems and safe_find(ShopItems, 'Dunk')
if not (PlayerData and DunkFolder) then return {} end

local Inventory = PlayerData.storedData and PlayerData.storedData.Inventory
if type(Inventory) ~= 'table' then
local Success, Value = pcall(PlayerData.Get, 'Inventory')
Inventory = Success and Value or nil
end

local Owned, Seen = {}, {}
if type(Inventory) == 'table' then
for ItemName, Amount in pairs(Inventory) do
local Item = type(ItemName) == 'string' and safe_find(DunkFolder, ItemName)
if Item and (tonumber(Amount) or 0) > 0 and ItemName ~= 'Dunk_Default'
and not Seen[ItemName] then
Seen[ItemName] = true
table.insert(Owned, ItemName)
end
end
end

for Index = 1, 5 do
local Ok, ItemName = pcall(PlayerData.Get, 'Equipping', 'Dunk' .. Index)
local Item = Ok and type(ItemName) == 'string' and safe_find(DunkFolder, ItemName)
if Item and ItemName ~= 'Dunk_Default' and not Seen[ItemName] then
Seen[ItemName] = true
table.insert(Owned, ItemName)
end
end

if #Owned == 0 and safe_find(DunkFolder, 'Dunk_Default') then
table.insert(Owned, 'Dunk_Default')
end
table.sort(Owned)
return Owned
end

function State.AutoDunk.WriteDunkLoadout(Loadout)
local PlayerData = State.AutoDunk.GetPlayerData()
if not PlayerData or type(Loadout) ~= 'table' then return false end

local StoredData = PlayerData.storedData
if type(StoredData) == 'table' then
StoredData.Equipping = StoredData.Equipping or {}
for Index = 1, 5 do
StoredData.Equipping['Dunk' .. Index] = Loadout[Index] or 'Dunk_Default'
end
end

local Updated = false
if type(PlayerData.updateData) == 'function' then
for Index = 1, 5 do
local Ok = pcall(PlayerData.updateData, 'Equipping', 'Dunk' .. Index,
Loadout[Index] or 'Dunk_Default')
Updated = Updated or Ok
end
end
return Updated or type(StoredData) == 'table'
end

function State.AutoDunk.CaptureDunkLoadout()
if State.AutoDunk.OriginalDunkLoadout then return true end
local PlayerData = State.AutoDunk.GetPlayerData()
if not PlayerData then return false end
local Loadout = {}
for Index = 1, 5 do
local Success, ItemName = pcall(PlayerData.Get, 'Equipping', 'Dunk' .. Index)
Loadout[Index] = Success and ItemName or 'Dunk_Default'
end
State.AutoDunk.OriginalDunkLoadout = Loadout
return true
end

function State.AutoDunk.RestoreDunkLoadout()
local PlayerData = State.AutoDunk.GetPlayerData()
local Loadout = State.AutoDunk.OriginalDunkLoadout
State.AutoDunk.PendingLoadoutRestore = false
if not (PlayerData and Loadout) then
State.AutoDunk.OriginalDunkLoadout = nil
State.AutoDunk.SelectedDunk = nil
return
end

State.AutoDunk.ApplyingLoadout = true
State.AutoDunk.WriteDunkLoadout(Loadout)
State.AutoDunk.ApplyingLoadout = false
State.AutoDunk.OriginalDunkLoadout = nil
State.AutoDunk.SelectedDunk = nil
end

function State.AutoDunk.PrepareRandomOwnedDunk()
if not State.AutoDunkRandomOwned then return true end
local PlayerData = State.AutoDunk.GetPlayerData()
local Owned = State.AutoDunk.GetOwnedDunks()
if not (PlayerData and #Owned > 0 and State.AutoDunk.CaptureDunkLoadout()) then
State.AutoDunkStatus = 'NO OWNED DUNKS'
return false
end

local Candidates = Owned
if #Owned > 1 and State.AutoDunk.SelectedDunk then
Candidates = {}
for _, ItemName in ipairs(Owned) do
if ItemName ~= State.AutoDunk.SelectedDunk then table.insert(Candidates, ItemName) end
end
if #Candidates == 0 then Candidates = Owned end
end
local Selected = Candidates[math.random(1, #Candidates)]

State.AutoDunk.ApplyingLoadout = true
local Applied = State.AutoDunk.WriteDunkLoadout({
Selected, Selected, Selected, Selected, Selected,
})
State.AutoDunk.ApplyingLoadout = false
if not Applied then
State.AutoDunkStatus = 'DUNK LOADOUT FAILED'
return false
end
State.AutoDunk.SelectedDunk = Selected
return true
end

function State.AutoDunk.SetRandomOwned(Enabled)
State.AutoDunkRandomOwned = Enabled == true
CONFIG.AutoDunkRandomOwned = State.AutoDunkRandomOwned
if not State.AutoDunkRandomOwned then
if State.AutoDunk.InProgress then
State.AutoDunk.PendingLoadoutRestore = true
else
State.AutoDunk.RestoreDunkLoadout()
end
end
if HubUI.Sync then HubUI.Sync() end
end

function State.AutoDunk.HasManualInput()
if not CONFIG.AutoDunkManualOverride then return false end
for _, Key in ipairs(PerfCache.MovementOverrideKeys) do
if UserInputService:IsKeyDown(Key) then return true end
end
if not UserInputService.GamepadEnabled then return false end
local Ok, Inputs = pcall(function()
return UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
end)
if Ok then
for _, Input in ipairs(Inputs) do
if Input.KeyCode == Enum.KeyCode.Thumbstick1
and Vector2.new(Input.Position.X, Input.Position.Y).Magnitude > 0.18 then
return true
end
end
end
return false
end

function State.AutoDunk.ResolveTarget()
local Root = LP.Character and safe_find(LP.Character, 'HumanoidRootPart')
if not Root then return nil, math.huge end

local Now = os.clock()
if Now - (State.AutoDunk.TargetResolvedAt or 0) < 0.15 then
local Cached = State.AutoDunk.ResolvedTarget
if not Cached or Cached.Parent then
if not Cached then return nil, math.huge end
local Delta = Cached.Position - Root.Position
return Cached, Vector3.new(Delta.X, 0, Delta.Z).Magnitude
end
end

local Goal = FindPlayerScoringGoal(LP)
local Hitboxes = Goal and Goal.Parent
if not Hitboxes then
State.AutoDunk.ResolvedTarget = nil
State.AutoDunk.TargetResolvedAt = Now
return nil, math.huge
end

local Target
for _, FieldGoal in ipairs(CollectionService:GetTagged('FieldGoals')) do
if FieldGoal.Parent == Hitboxes and safe_is_a(FieldGoal, 'BasePart')
and safe_find(FieldGoal, 'dunkFunction') then
Target = FieldGoal
break
end
end
if not Target then
for _, Name in ipairs({ 'FieldGoal', 'FieldGoalHome', 'FieldGoalAway' }) do
local Candidate = safe_find(Hitboxes, Name)
if Candidate and safe_is_a(Candidate, 'BasePart') and safe_find(Candidate, 'dunkFunction') then
Target = Candidate
break
end
end
end

State.AutoDunk.ResolvedTarget = Target
State.AutoDunk.TargetResolvedAt = Now
if not Target then return nil, math.huge end
local Delta = Target.Position - Root.Position
return Target, Vector3.new(Delta.X, 0, Delta.Z).Magnitude
end

function State.AutoDunk.LaneOpen(Root, Target)
if not CONFIG.AutoDunkLaneCheck or State.AutoDunkMode == 'Aggressive' then return true end
local Now = os.clock()
if State.AutoDunk.LaneTarget == Target
and Now - State.AutoDunk.LaneCheckAt < 0.1 then
return State.AutoDunk.LaneOpenCached
end
local Open = true
for _, Player in ipairs(Players:GetPlayers()) do
if IsGuardOpponent(Player) then
local OpponentRoot, OpponentHumanoid = GetPlayerRoot(Player)
if OpponentRoot and OpponentHumanoid then
local LaneDistance = State.AutoGetOpen.DistanceToSegmentXZ(
OpponentRoot.Position,
Root.Position,
Target.Position
)
local TargetDistance = Vector3.new(
OpponentRoot.Position.X - Target.Position.X,
0,
OpponentRoot.Position.Z - Target.Position.Z
).Magnitude
if LaneDistance < 2.7 or TargetDistance < 4.1 then
Open = false
break
end
end
end
end
State.AutoDunk.LaneCheckAt = Now
State.AutoDunk.LaneTarget = Target
State.AutoDunk.LaneOpenCached = Open
return Open
end

