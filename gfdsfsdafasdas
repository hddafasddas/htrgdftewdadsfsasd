function State.BallStudio.StyleTrail(Trail)
if not Trail then return end
pcall(function()
Trail.Color = ColorSequence.new(
State.BallStudio.Shade('BallTrailStartR', 'BallTrailStartG', 'BallTrailStartB'),
State.BallStudio.Shade('BallTrailEndR', 'BallTrailEndG', 'BallTrailEndB'))
local Fade = math.clamp(tonumber(CONFIG.BallTrailFade) or 0.15, 0, 0.99)
Trail.Transparency = NumberSequence.new({
NumberSequenceKeypoint.new(0, Fade),
NumberSequenceKeypoint.new(1, 1),
})
Trail.Lifetime = math.clamp(tonumber(CONFIG.BallTrailLifetime) or 0.55, 0.05, 8)
Trail.WidthScale = NumberSequence.new(
math.clamp(tonumber(CONFIG.BallTrailWidth) or 1.7, 0.1, 12))
Trail.MinLength = 0
Trail.FaceCamera = true
Trail.LightEmission = 0.45
local Texture = State.BallStudio.ResolveTexture(CONFIG.BallTrailTextureId)
Trail.Texture = Texture or ''
