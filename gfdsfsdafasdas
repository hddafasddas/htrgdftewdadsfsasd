local Section = {}
Section.__index = Section

function Tab:AddSection(title, side)
    local lib = self.Library
    local section = setmetatable({}, Section)
    section.Tab, section.Library, section.Janitor = self, lib, Janitor.new()

    local parent = self.Left
    if side == "Right" or side == "right" then
        parent = self.Right or self.Left
    elseif side == "Middle" or side == "middle" then
        parent = self.Middle or self.Left
    end

    local frame = create("Frame", {
        Name = title, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = lib.Theme.Surface, BorderSizePixel = 0, Parent = parent,
    }, {
        corner(2),
        stroke(lib.Theme.BorderSoft),
        create("UIGradient", {
            Rotation = 110,
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(246, 249, 252)),
                ColorSequenceKeypoint.new(0.52, Color3.fromRGB(215, 222, 229)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(237, 241, 245)),
            }),
        }),
    })
    lib:_bind(frame, "BackgroundColor3", "Surface")

    local accent = create("Frame", {
        Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = lib.Theme.Gold,
        BorderSizePixel = 0, ZIndex = 2, Parent = frame,
    }, {
        create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromRGB(99, 108, 119)),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(230, 235, 240)),
                ColorSequenceKeypoint.new(1, Color3.fromRGB(95, 104, 115)),
            }),
        }),
    })
    lib:_bind(accent, "BackgroundColor3", "Gold")

    -- Everything lives inside one vertical list, so nothing can overlap.
    local inner = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = frame,
    }, { padding(8, 9, 9, 9), list(6) })

    -- Header is a real list item with its own rule, so the title can never
    -- collide with the first control underneath it.
    local header = create("Frame", {
        Size = UDim2.new(1, 0, 0, 21), BackgroundTransparency = 1,
        LayoutOrder = 0, Parent = inner,
    })
    local heading = create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Font = FONT,
        TextSize = TEXT, TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = lib.Theme.Text, Text = title, Parent = header,
    })
    lib:_bind(heading, "TextColor3", "Text")

    local headerRule = create("Frame", {
        AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
        Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = lib.Theme.BorderSoft,
        BorderSizePixel = 0, Parent = header,
    })
    lib:_bind(headerRule, "BackgroundColor3", "BorderSoft")

    section.Frame, section.Body, section.Order = frame, inner, 0
    section.Title = title
    table.insert(self.Sections, section)
    return section
end

function Section:_next()
    self.Order = self.Order + 1
    return self.Order
end

function Section:_row(height)
    return create("Frame", {
        Size = UDim2.new(1, 0, 0, height or 18), BackgroundTransparency = 1,
        LayoutOrder = self:_next(), Parent = self.Body,
    })
end

function Section:_text(parent, text, size, color)
    local label = create("TextLabel", {
        Size = size or UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = FONT,
        TextSize = TEXT, TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = self.Library.Theme[color or "Text"], Text = text, Parent = parent,
    })
    self.Library:_bind(label, "TextColor3", color or "Text")
    return label
end

local function newControl(lib, id, default, callback)
    local control = { Value = default, Changed = {}, Callback = callback }
    function control:OnChanged(fn) table.insert(self.Changed, fn) return self end
    function control:GetValue() return self.Value end
    function control:_emit(value)
        safeCall(self.Callback, value)
        for _, fn in ipairs(self.Changed) do safeCall(fn, value) end
    end
    lib:Register(id, control)
    return control
end

