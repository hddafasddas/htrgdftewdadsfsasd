local PowerSupportsDistance
PowerSupportsDistance = WYNF_JIT_MAX(function(power, distance)
local Minimum = MinRangeForPower[power]
local Maximum = MaxRangeForPower[power]
return type(distance) == 'number' and Minimum ~= nil and Maximum ~= nil
and distance >= Minimum and distance <= Maximum
end)

local GetArcSettings
GetArcSettings = WYNF_JIT_MAX(function(Dist, DesiredPower)
local Below, Above = nil, nil
for _, Entry in ipairs(ArcTable) do
if Entry[3] == DesiredPower then
local EntryDistance = Entry[1]
if EntryDistance <= Dist and (Below == nil or EntryDistance > Below[1]) then
Below = Entry
end
if EntryDistance >= Dist and (Above == nil or EntryDistance < Above[1]) then
Above = Entry
end
end
end

if Below and Above then
local Span = Above[1] - Below[1]
if math.abs(Span) < 0.0001 then
return Below[2], DesiredPower
end
local Alpha = (Dist - Below[1]) / Span
return Below[2] + (Above[2] - Below[2]) * Alpha, DesiredPower
end

local Endpoint = Below or Above
if Endpoint then return Endpoint[2], DesiredPower end
return 0, DesiredPower or 0
end)

