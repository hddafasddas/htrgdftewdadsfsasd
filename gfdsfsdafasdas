HumanoidRootPart = true,
Basketball = true,
}

function State.Movement.IsBodyColliderPart(Object, Character)
if not (Object and Object.Parent == Character and safe_is_a(Object, 'BasePart')) then
return false
end
return not State.Movement.BodyColliderSkipNames[Object.Name]
end

function State.Movement.RestoreBodyColliders()
for Object, Original in pairs(State.Movement.BodyColliderOriginals) do
if Object and Object.Parent then
pcall(function() Object.CanCollide = Original end)
end
end
State.Movement.BodyColliderOriginals = setmetatable({}, { __mode = 'k' })
State.Movement.BodyColliderManagedCount = 0
State.Movement.BodyColliderStatus =
State.Movement.BodyCollidersEnabled and 'SCANNING' or 'OFF'
end

function State.Movement.RestoreOwnBodyColliders()
local Character = LP.Character
if not Character then return end
for _, Object in ipairs(Character:GetChildren()) do
local Original = State.Movement.BodyColliderOriginals[Object]
if Original ~= nil then
pcall(function() Object.CanCollide = Original end)
State.Movement.BodyColliderOriginals[Object] = nil
end
end
end

function State.Movement.ForceCharacterColliders(Character)
local Count = 0
for _, Object in ipairs(Character:GetChildren()) do
if State.Movement.IsBodyColliderPart(Object, Character) then
if State.Movement.BodyColliderOriginals[Object] == nil then
State.Movement.BodyColliderOriginals[Object] = Object.CanCollide
end
if not Object.CanCollide then Object.CanCollide = true end
Count = Count + 1
end
end
return Count
end

function State.Movement.StepBodyColliders(ForceScan)
if not State.Movement.BodyCollidersEnabled then
if next(State.Movement.BodyColliderOriginals) ~= nil then
State.Movement.RestoreBodyColliders()
end
return
end

local Interval = math.clamp(
tonumber(CONFIG.BodyColliderScanInterval) or 0.35, 0.10, 2.00)
local Now = os.clock()
if not ForceScan and Now - State.Movement.BodyColliderLastScanAt < Interval then
return
end
State.Movement.BodyColliderLastScanAt = Now

local Managed, Bodies = 0, 0
for _, Player in ipairs(Players:GetPlayers()) do
local Character = Player.Character
local Allowed = Player ~= LP
or (State.Movement.BodyColliderIncludeSelf
and not State.Movement.NoclipEnabled)
if Character and Allowed then
local Added = State.Movement.ForceCharacterColliders(Character)
if Added > 0 then
Managed = Managed + Added
Bodies = Bodies + 1
end
end
end

State.Movement.BodyColliderManagedCount = Managed
State.Movement.BodyColliderStatus = Bodies > 0
and string.format('SOLID | %d bodies', Bodies)
or 'NO BODIES'
end

function State.Movement.SetBodyColliders(Enabled)
State.Movement.BodyCollidersEnabled = Enabled == true
CONFIG.BodyColliders = State.Movement.BodyCollidersEnabled
State.Movement.BodyColliderLastScanAt = 0
if State.Movement.BodyCollidersEnabled then
State.Movement.BodyColliderStatus = 'SCANNING'
pcall(State.Movement.StepBodyColliders, true)
else
State.Movement.RestoreBodyColliders()
end
end

function State.Movement.SetBodyColliderIncludeSelf(Enabled)
State.Movement.BodyColliderIncludeSelf = Enabled == true
CONFIG.BodyColliderIncludeSelf = State.Movement.BodyColliderIncludeSelf
if not State.Movement.BodyColliderIncludeSelf then
pcall(State.Movement.RestoreOwnBodyColliders)
end
State.Movement.BodyColliderLastScanAt = 0
if State.Movement.BodyCollidersEnabled then
pcall(State.Movement.StepBodyColliders, true)
end
end

function State.Movement.DisableNoclipCollision(Object)
if not (Object and Object:IsA('BasePart')) then return end
if State.Movement.NoclipOriginals[Object] == nil then
State.Movement.NoclipOriginals[Object] = Object.CanCollide
end
if Object.CanCollide then Object.CanCollide = false end
end

function State.Movement.ApplyNoclip(ForceScan)
if not State.Movement.NoclipEnabled then return end
local Method = State.Movement.NoclipMethod or 'CanCollide Off'
local Now = os.clock()
if ForceScan or Now - State.Movement.NoclipLastScanAt >= 0.5 then
State.Movement.NoclipLastScanAt = Now
local Character = State.Movement.GetRig()
if Character then
for _, Object in ipairs(Character:GetDescendants()) do
if Method == 'Collision Group' then
if Object:IsA('BasePart') then
if State.Movement.NoclipOriginals[Object] == nil then
State.Movement.NoclipOriginals[Object] = Object.CanCollide
end
pcall(function() Object.CollisionGroup = 'Default' end)
if Object.CanCollide then Object.CanCollide = false end
end
else
State.Movement.DisableNoclipCollision(Object)
end
end
end

local BallAssist = State.BallAssist
if BallAssist and type(BallAssist.CollectColliderParts) == 'function' then
local Ok, Parts = pcall(BallAssist.CollectColliderParts)
if Ok and type(Parts) == 'table' then
for Part in pairs(Parts) do
State.Movement.DisableNoclipCollision(Part)
end
end
end
end
for Object in pairs(State.Movement.NoclipOriginals) do
if Object and Object.Parent then
if Object.CanCollide then Object.CanCollide = false end
else
State.Movement.NoclipOriginals[Object] = nil
end
end
end

function State.Movement.RestoreNoclip()
for Object, Original in pairs(State.Movement.NoclipOriginals) do
if Object and Object.Parent then
pcall(function() Object.CanCollide = Original end)
