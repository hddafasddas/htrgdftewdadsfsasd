function State.Watch.NearestPlayerRoot(Position, Court)
local Watch = State.Watch
local Participants = (Watch.CachedCourt == Court and Watch.CachedParticipants)
or Watch.LivePlayers[Court and Court.Name or '']
or State.Watch.GetPlayersForCourt(Court)
local Nearest, Minimum = nil, math.huge
for _, Entry in ipairs(Participants) do
local Player = Entry.Player
local Character = Player and Player.Character
local Root = Character and Character:FindFirstChild('HumanoidRootPart')
if Root then
local Distance = (Root.Position - Position).Magnitude
if Distance < Minimum then Nearest, Minimum = Root, Distance end
end
end
return Nearest
end

function State.Watch.CameraForMode(Mode, FocusPosition, Court, DeltaTime)
local Shot = State.Watch.Shots[Mode] or State.Watch.Shots['2K CAM']
local LookTarget = FocusPosition
if Shot.Type == 'Player' or Shot.Type == 'OrbitPlayer' then
local Nearest = State.Watch.NearestPlayerRoot(FocusPosition, Court)
if Nearest then LookTarget = Nearest.Position end
end
local CourtFrame = State.Watch.GetCourtFrame(Court)
local CameraPosition
if Shot.Type == 'OrbitBall' or Shot.Type == 'OrbitPlayer' then
local Radius = Shot.Radius or 20
local Height = Shot.Height or 10
local Time = os.clock() * (Shot.Speed or 0.5)
local OrbitOffset = Vector3.new(math.cos(Time) * Radius, Height, math.sin(Time) * Radius)
CameraPosition = LookTarget + (CourtFrame and CourtFrame:VectorToWorldSpace(OrbitOffset) or OrbitOffset)
else
local Offset = Shot.Offset or Vector3.new(0, 10, 20)
CameraPosition = LookTarget + (CourtFrame and CourtFrame:VectorToWorldSpace(Offset) or Offset)
end
local TargetCFrame = CFrame.new(CameraPosition, LookTarget + Vector3.new(0, 1.5, 0))
if Shot.Roll and Shot.Roll ~= 0 then
TargetCFrame = TargetCFrame * CFrame.Angles(0, 0, math.rad(Shot.Roll))
end
return TargetCFrame, 1 - math.exp(-8 * DeltaTime), Shot.Filter
end

function State.Watch.Update(DeltaTime)
local Watch = State.Watch
if not (Watch.Active and State.Active) then return end
local Camera = Workspace.CurrentCamera
if not Camera then return end

local Now = os.clock()
local Court = Watch.Court
if Now - Watch.RosterAt >= 0.5 or not (Court and Court.Parent) then
Watch.RosterAt = Now
Court = State.Watch.GetCourt()
Watch.Court = Court
if not Court then
State.Watch.SetActive(false)
Watch.Status = 'MATCH ENDED / EMPTY'
Watch.PlayerSummary = '--'
return
end
local Participants = Watch.LivePlayers[Court.Name] or State.Watch.GetPlayersForCourt(Court)
if not State.Watch.IsLiveMatch(Court, Participants) then
State.Watch.SetActive(false)
Watch.Status = 'MATCH ENDED / EMPTY'
Watch.PlayerSummary = '--'
return
end
Watch.CachedCourt = Court
Watch.CachedParticipants = Participants
Watch.PlayerSummary = State.Watch.FormatPlayers(Participants)
end

local Frame = State.Watch.GetCourtFrame(Court)
if not Frame then
Watch.Status = 'COURT UNAVAILABLE'
State.Watch.ApplyFilter(nil)
return
end
local Ball = State.Watch.FindBall(Court)
local FocusPosition = Ball and Ball.Position or (Frame.Position + Vector3.new(0, 3, 0))
local Desired, Smooth, Filter = State.Watch.CameraForMode(
Watch.Mode, FocusPosition, Court, DeltaTime or 1 / 60
)
if Camera.CameraType ~= Enum.CameraType.Scriptable then Camera.CameraType = Enum.CameraType.Scriptable end
if Camera.CameraSubject ~= nil then Camera.CameraSubject = nil end
Camera.CFrame = Camera.CFrame:Lerp(Desired, Smooth)
State.Watch.ApplyFilter(Filter)
local Status = Ball and 'WATCHING LIVE MATCH' or 'WATCHING COURT'
if Watch.Status ~= Status then Watch.Status = Status end
end


