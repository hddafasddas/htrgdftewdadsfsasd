MouseDown = false
if Attempt == 1 then
for _ = 1, 10 do task.wait(0.02); if GetHeldBasketballModel(LP) ~= Possession then break end end
if GetHeldBasketballModel(LP) ~= Possession then break end
end
end
end)

if MouseDown then
