function State.NoJump.Fire()
local CanFire, Reason = State.NoJump.CanFire()
if not CanFire then
Notify('NO JUMP SHOT', Reason or 'Shot is unavailable.')
return false
end
State.NoJump.Generation += 1
local Generation = State.NoJump.Generation

if State.Enabled ~= true or SilentAim.ActorAimReady ~= true then
SilentAim.HookNewActors()
local Ready = SilentAim.EnsureActorAim() == true
State.Enabled = Ready
if Ready then
UpdateSilentAimController()
if HubUI.Sync then HubUI.Sync() end
else
Notify('NO JUMP SHOT', 'Silent Aim is on, but its actor hooks are still unavailable.')
return false
end
end

local Character = LP.Character
local HumanoidObject = Character and safe_find(Character, 'Humanoid')
local Root = Character and safe_find(Character, 'HumanoidRootPart')
if not (HumanoidObject and Root) then
Notify('NO JUMP SHOT', 'Character is not ready.')
return false
end

local Rim, Distance = FindConfiguredGoal()
if not Rim then
Notify('NO JUMP SHOT', 'No valid scoring goal was found.')
return false
end

local AimDistance = State.Backboard.GetConfiguredAimDistance(Rim, Distance)
local AdjustedDistance = AdjustAimDistance(AimDistance)
local Power = State.PowerBypass.GetEffectivePower()

if CONFIG.AutoPower and not PowerSupportsDistance(Power, AdjustedDistance)
and State.SelectBestAutoPower then
local BestPower = State.SelectBestAutoPower(AdjustedDistance, Power)
if BestPower then
Power = State.PowerBypass.SyncChannels(BestPower)
State.LastAutoPowerPick = { Power = BestPower, At = os.clock() }
end
end

local Target, YOffset = BuildSilentAimTarget(Rim, AimDistance, Power)
if not Target then
Notify('NO JUMP SHOT', 'No ballistic solution exists at the current power and distance.')
return false
end

State.NoJump.Active = true
State.NoJump.SyntheticInput = true
State.NoJump.LockToGround(Root, HumanoidObject, Generation)
SilentAim.FireActorAim(Target)

local InputOk = pcall(function()
VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
RunService.RenderStepped:Wait()
HumanoidObject.Jump = true
HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)

local HoldUntil = os.clock() + math.max(
tonumber(CONFIG.NoJumpJumpKeyHoldTime) or 0.05, 0.02)
local ArmFrames = math.max(
math.floor(tonumber(CONFIG.NoJumpArmFrames) or 4), 2)
for _ = 1, ArmFrames do
RunService.RenderStepped:Wait()
end
while os.clock() < HoldUntil do
RunService.RenderStepped:Wait()
end
VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end)
if not InputOk then
pcall(function()
VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end)
end

if not (State.Active and State.NoJump.Generation == Generation) then
State.NoJump.Active = false
State.NoJump.SyntheticInput = false
SilentAim.ClearActorAim()
return false
end

local ShotOk = SilentShoot(Rim, YOffset or 0, Target, Target)
pcall(function()
VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end)
task.delay(0.08, function()
if State.NoJump.Generation == Generation then
State.NoJump.SyntheticInput = false
end
end)
if not ShotOk then
Notify('NO JUMP SHOT', 'Native shot input was not accepted.')
end
return ShotOk
end

