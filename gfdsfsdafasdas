function State.AutoMix.ChooseOpenDirection(Root, TargetRoot)
local Away = TargetRoot and Vector3.new(Root.Position.X - TargetRoot.Position.X, 0, Root.Position.Z - TargetRoot.Position.Z) or Vector3.new()
if Away.Magnitude > 0.05 then Away = Away.Unit else Away = -Root.CFrame.LookVector end
Away = Vector3.new(Away.X, 0, Away.Z)
local Left = Vector3.new(-Away.Z, 0, Away.X)
local Right = -Left
local RimPosition = State.AutoBody.GetRimPosition()
local ToRim = RimPosition and Vector3.new(RimPosition.X - Root.Position.X, 0, RimPosition.Z - Root.Position.Z) or Root.CFrame.LookVector
if ToRim.Magnitude > 0.05 then ToRim = ToRim.Unit end
local Candidates = { Away, (Away * 0.65 + Left * 0.76).Unit, (Away * 0.65 + Right * 0.76).Unit, Left, Right, (ToRim * 0.65 + Away * 0.35).Unit }
local Best, BestScore = Away, -math.huge
for _, Direction in ipairs(Candidates) do
local Probe = Root.Position + Direction * 5.5
local MinimumRoom = 40
for _, Player in ipairs(State.AutoMix.GetOpponents()) do
if Player ~= LP and IsGuardOpponent(Player) then
local TheirRoot = GetAutoBodyTargetRig(Player)
if TheirRoot then
local Predicted = TheirRoot.Position + TheirRoot.AssemblyLinearVelocity * 0.18
local Room = (Vector3.new(Probe.X, 0, Probe.Z) - Vector3.new(Predicted.X, 0, Predicted.Z)).Magnitude
MinimumRoom = math.min(MinimumRoom, Room)
end
end
end
local Score = MinimumRoom + Direction:Dot(Away) * 2.4 + Direction:Dot(ToRim) * 0.8
if Score > BestScore then Best, BestScore = Direction, Score end
end
return Best.Magnitude > 0.05 and Best.Unit or Away
end

function State.AutoMix.GetCrabDirection(Root, Threat)
if not Root or not Threat or not Threat.Root then return nil, 'NO DEFENDER' end
local Offset = Root.Position - Threat.Root.Position
local Away = Vector3.new(Offset.X, 0, Offset.Z)
if Away.Magnitude <= 0.05 then return nil, 'OVERLAP' end
Away = Away.Unit
local Distance = Threat.Distance or Offset.Magnitude
local Preferred = math.clamp(
tonumber(CONFIG.AutoMixPreferredDistance) or 7.5, 5, 12)
local Deadzone = 1.0
local OpenDirection = State.AutoMix.ChooseOpenDirection(Root, Threat.Root)

if Distance < Preferred - Deadzone then
local Escape = Away * 0.78 + OpenDirection * 0.22
return Escape.Magnitude > 0.05 and Escape.Unit or Away, 'CREATING GAP'
end
if Distance > Preferred + 1.75 then return nil, 'GAP SET' end

local Progress = State.AutoMix.ManualDirection or Vector3.zero
if Progress.Magnitude > 0.05 then
Progress = Progress.Unit
else
local RimPosition = State.AutoBody.GetRimPosition()
if RimPosition then
Progress = Vector3.new(
RimPosition.X - Root.Position.X, 0,
RimPosition.Z - Root.Position.Z)
end
if Progress.Magnitude <= 0.05 then Progress = OpenDirection end
Progress = Progress.Unit
end

-- Do not crab directly into the defender. Preserve the user's drive direction
-- when safe, then blend enough open-lane pressure to maintain separation.
local TowardDefender = -Away
if Progress:Dot(TowardDefender) > 0.45 then Progress = OpenDirection end
local Strength = math.clamp(
tonumber(CONFIG.AutoMixCrabStrength) or 0.70, 0, 1)
local OpenWeight = Threat.Sector == 'REAR'
and 0.28 or (0.32 + Strength * 0.23)
local Crab = Progress * (1 - OpenWeight) + OpenDirection * OpenWeight
if Crab.Magnitude <= 0.05 then Crab = Away end
return Crab.Unit, Threat.Sector == 'REAR'
and 'CRABBING TRAIL' or 'BODYING'
end

function State.AutoMix.ShouldSpendMove(Threat)
if not CONFIG.AutoMixBodyFirst then return true, 'LEGACY ACTION' end
if not Threat then return false, 'NO THREAT' end
local Preferred = math.clamp(
tonumber(CONFIG.AutoMixPreferredDistance) or 7.5, 5, 12)
local ActionDistance = math.min(
math.clamp(tonumber(CONFIG.AutoMixActionDistance) or 5.5, 3.5, 8),
Preferred - 0.5)
local ReachDistance = Threat.ReachDistance or math.huge
local ActualReach = ReachDistance <= 3.35
or (ReachDistance <= 4.2 and (Threat.ReachClosing or 0) >= 0.35)

if Threat.Sector == 'REAR' then
return ActualReach, ActualReach and 'REAR REACH' or 'TRAIL - BODY ONLY'
end
if Threat.DefenseType == 'RETREAT' or Threat.DefenseType == 'GAP'
or Threat.DefenseType == 'TRAIL' then
return false, Threat.DefenseType
end
if ActualReach then return true, 'ACTIVE REACH' end
if Threat.DefenseType == 'DOUBLE TEAM'
and Threat.Distance <= ActionDistance then
return true, 'DOUBLE TEAM'
end
if Threat.Distance > ActionDistance then
return false, 'OUTSIDE ACTION DISTANCE'
end
if Threat.DefenseType == 'HARD CLOSE'
and Threat.Closing >= 4.5
and (Threat.FrontDot or 0) > -0.05 then
return true, 'FRONT CUTOFF'
end
if State.AutoMix.CurrentBallClearance < 0.25
and Threat.Distance <= ActionDistance then
return true, 'BALL EXPOSED'
end
return false, 'BODY POSITION FIRST'
end

function State.AutoMix.SetMovement(Direction, Duration, Status)
if not CONFIG.AutoMixMovement or not Direction or Direction.Magnitude <= 0.05 then State.AutoMix.StopMovement(); return end
State.AutoMix.DesiredMovement = Vector3.new(Direction.X, 0, Direction.Z).Unit
State.AutoMix.MovementUntil = os.clock() + math.max(0.08, Duration or 0.25)
State.AutoMix.MovementStatus = Status or 'ESCAPING'
end

function State.AutoMix.ReleaseBodyControl()
if not (State.AutoBody and State.AutoBody.Enabled) then
pcall(State.AutoBody.ReleaseRotation)
end
State.AutoMix.BodyStatus = 'IDLE'
end

function State.AutoMix.ApplyBodyFirst(Root, HumanoidObject, Threat, DeltaTime)
if not CONFIG.AutoMixBodyFirst or not Root or not HumanoidObject
or not Threat or not Threat.Root or State.AutoMix.Rotating then
State.AutoMix.ReleaseBodyControl()
return false
end
if State.AutoBody.Enabled then
State.AutoMix.BodyStatus = 'AUTO BODY'
return true
end
local Character = LP.Character
if not Character or not safe_find(Character, 'Basketball')
or State.AutoMix.IsShotBusy(Character, HumanoidObject, Root) then
State.AutoMix.ReleaseBodyControl()
State.AutoMix.BodyStatus = 'SHOT LOCK'
return false
end
local Separation = Root.Position - Threat.Root.Position
local Away = Vector3.new(Separation.X, 0, Separation.Z)
if Away.Magnitude <= 0.05 then return false end
local CurrentHand = State.AutoBody.GetCurrentHand(
Character, HumanoidObject, Root)
if CurrentHand then State.AutoBody.CurrentHand = CurrentHand end
State.AutoBody.TakeRotation(HumanoidObject)
local DesiredDirection = State.AutoBody.GetDesiredFacing(
Root, Threat.Root, Away, CurrentHand)
local Desired = CFrame.lookAt(
Root.Position, Root.Position + DesiredDirection, Vector3.yAxis)
local Step = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.1)
local Rate = State.AutoBody.SolveTurnRate(
Away.Magnitude, Root, Threat.Root)
local Alpha = 1 - math.exp(-Rate * Step)
Root.CFrame = Root.CFrame:Lerp(Desired, Alpha)
State.AutoMix.BodyStatus = Threat.Sector == 'REAR'
and 'CRABBING' or 'SHIELDING'
return true
end

function State.AutoMix.GetReachDistance(Threat)
local Character = LP.Character
local Ball = Character and safe_find(Character, 'Basketball')
local BallPart = Ball and (safe_find(Ball, 'Ball') or Ball.PrimaryPart or Ball:FindFirstChildWhichIsA('BasePart'))
local DefenderCharacter = Threat and Threat.Player and Threat.Player.Character
if not BallPart or not DefenderCharacter then return math.huge, 0 end
local Minimum, LimbClosing = math.huge, 0
for _, Name in ipairs({ 'LeftHand','RightHand','Left Arm','Right Arm','LeftLowerArm','RightLowerArm' }) do
local Limb = safe_find(DefenderCharacter, Name)
if Limb and Limb:IsA('BasePart') then
local Offset = Limb.Position - BallPart.Position
local Distance = Offset.Magnitude
if Distance < Minimum then
Minimum = Distance
if Distance > 0.05 then
LimbClosing = (Limb.AssemblyLinearVelocity - BallPart.AssemblyLinearVelocity):Dot(-Offset.Unit)
end
end
end
end
return Minimum, LimbClosing
end

function State.AutoMix.AnalyzeDefense(Root, Hand, Threat)
if not Threat or not Threat.Root then return Threat end
local LocalVelocity = Root.CFrame:VectorToObjectSpace(Threat.Root.AssemblyLinearVelocity - Root.AssemblyLinearVelocity)
local Nearby = 0
local DefenderRoots = {}
for _, Player in ipairs(State.AutoMix.GetOpponents()) do
if Player ~= LP and IsGuardOpponent(Player) then
local TheirRoot = GetAutoBodyTargetRig(Player)
if TheirRoot and (TheirRoot.Position - Root.Position).Magnitude <= 9 then
Nearby += 1
table.insert(DefenderRoots, TheirRoot)
end
end
end
Threat.DefenderRoots = DefenderRoots
Threat.RearClearance = State.AutoMix.GetRearClearance(Root, Threat)
local ReachDistance, ReachClosing = State.AutoMix.GetReachDistance(Threat)
local Defense
if Nearby >= 2 and Threat.Distance <= 8.5 then
Defense = 'DOUBLE TEAM'
elseif ReachDistance <= 3.8 and Threat.Distance <= 7.5 then
Defense = 'REACH'
elseif CONFIG.AutoMixPredictiveReach and ReachDistance <= 6.5 and ReachClosing >= 7 and Threat.Distance <= 9 then
Defense = 'REACH'
elseif Threat.Closing >= 6 then
Defense = 'HARD CLOSE'
elseif Threat.Closing <= -2.2 then
Defense = 'RETREAT'
elseif math.abs(LocalVelocity.X) >= 3.5 then
Defense = LocalVelocity.X > 0 and 'CUT RIGHT' or 'CUT LEFT'
elseif Threat.SameSide and math.abs(Threat.Relative.X) >= 1.0 then
Defense = 'SHADE BALL'
elseif math.abs(Threat.Relative.X) < 1.5 then
Defense = 'CONTAIN MIDDLE'
else
Defense = 'GAP'
end

-- A defender trailing the player's body is usually not threatening the ball,
-- which rests in front. Body/crab forward; spend a move only on an actual rear
-- hand reach. Rear-arc moves are prohibited separately by IsMoveAllowed.
if Threat.Sector == 'REAR' then
if ReachDistance <= 4.1 and ReachClosing >= 0.75 then
Defense = 'REAR REACH'
Threat.Level = 'PRESSURE'
Threat.Risk += 0.12
else
Defense = 'TRAIL'
Threat.Level = 'WATCH'
Threat.Risk *= 0.25
end
end
Threat.DefenseType = Defense
Threat.LateralSpeed = LocalVelocity.X
Threat.ReachDistance = ReachDistance
Threat.ReachClosing = ReachClosing
Threat.NearbyDefenders = Nearby
if Defense == 'REACH' or Defense == 'DOUBLE TEAM' then
Threat.Level = 'EMERGENCY'
Threat.Risk += Defense == 'DOUBLE TEAM' and 0.42 or 0.32
elseif Defense == 'HARD CLOSE' and Threat.Level == 'WATCH' then
Threat.Level = 'PRESSURE'
Threat.Risk += 0.18
end
State.AutoMix.DefenseType = Defense
State.AutoMix.DefenseSide = Threat.Side
State.AutoMix.DefenseLateralSpeed = LocalVelocity.X
State.AutoMix.DefenseReachDistance = ReachDistance
State.AutoMix.ReachClosing = ReachClosing
State.AutoMix.NearbyDefenders = Nearby
if CONFIG.AutoMixAdaptive and Threat.Player then
local Profile = State.AutoMix.DefenderProfiles[Threat.Player.Name]
if not Profile then
Profile = { Reach = 0, HardClose = 0, CutLeft = 0, CutRight = 0, LastDefense = nil, LastSeen = 0 }
State.AutoMix.DefenderProfiles[Threat.Player.Name] = Profile
end
Profile.LastSeen = os.clock()
if Defense ~= Profile.LastDefense then
Profile.LastDefense = Defense
if Defense == 'REACH' then Profile.Reach += 1
elseif Defense == 'HARD CLOSE' then Profile.HardClose += 1
elseif Defense == 'CUT LEFT' then Profile.CutLeft += 1
elseif Defense == 'CUT RIGHT' then Profile.CutRight += 1
end
end
local Read = {}
if Profile.Reach >= 2 then table.insert(Read, 'REACHY x' .. Profile.Reach) end
if Profile.HardClose >= 2 then table.insert(Read, 'AGGRO x' .. Profile.HardClose) end
if Profile.CutLeft - Profile.CutRight >= 2 then table.insert(Read, 'SHADES L')
elseif Profile.CutRight - Profile.CutLeft >= 2 then table.insert(Read, 'SHADES R') end
State.AutoMix.DefenderRead = #Read > 0 and table.concat(Read, ' | ') or 'NEUTRAL'
Threat.Profile = Profile
else
State.AutoMix.DefenderRead = '--'
end
return Threat
end

function State.AutoMix.ReadThreat(Root, Hand)
local Player, TargetRoot, Distance = State.AutoMix.GetDefender(Root)
State.AutoMix.LastDefender = Player
if not TargetRoot then
State.AutoMix.RiskScore, State.AutoMix.ClosingSpeed,
State.AutoMix.ThreatLevel = 0, 0, 'CLEAR'
State.AutoMix.PredictedBallClearance = 0
State.AutoMix.PredictedBallEndClearance = 0
State.AutoMix.PredictedBallSide = Hand or '--'
State.AutoMix.SafestMove = '--'
State.AutoMix.DefenseType = 'NONE'
State.AutoMix.DefenseSide = '--'
State.AutoMix.DefenseLateralSpeed = 0
State.AutoMix.DefenseReachDistance = math.huge
State.AutoMix.NearbyDefenders = 0
State.AutoMix.ThreatSector = 'NONE'
State.AutoMix.RearClearance = math.huge
State.AutoMix.LastThreat = nil
return nil
end

local Relative = Root.CFrame:PointToObjectSpace(TargetRoot.Position)
local Sector, FrontDot, SideDot = State.AutoMix.ClassifyDefender(Relative)
local Horizontal = Vector3.new(
TargetRoot.Position.X - Root.Position.X, 0,
TargetRoot.Position.Z - Root.Position.Z)
local RelativeVelocity = TargetRoot.AssemblyLinearVelocity
- Root.AssemblyLinearVelocity
local Closing = Horizontal.Magnitude > 0.05
and -RelativeVelocity:Dot(Horizontal.Unit) or 0
local Side = Relative.X >= 0 and 'R' or 'L'
local SameSide = Side == Hand
local Protect = math.max(5,
tonumber(CONFIG.AutoMixRange)
or tonumber(CONFIG.AutoMixProtectDistance) or 10)
local SideRisk = Sector ~= 'REAR' and SameSide and 0.20 or 0
local MiddleRisk = Sector ~= 'REAR' and math.abs(Relative.X) < 1.35
and 0.08 or 0
local Risk = math.clamp((Protect - Distance) / Protect, 0, 1)
+ math.clamp(Closing / 14, 0, 0.7) + SideRisk + MiddleRisk
local Emergency = math.max(3.5,
tonumber(CONFIG.AutoMixEmergencyDistance) or 4.8)
local Level = (Distance <= Emergency or Closing >= 8) and 'EMERGENCY'
or (Risk >= 0.48 and 'PRESSURE'
or (Risk >= 0.20 and 'WATCH' or 'CLEAR'))
local Threat = {
Player=Player, Root=TargetRoot, Distance=Distance, Relative=Relative,
Sector=Sector, FrontDot=FrontDot, SideDot=SideDot,
Side=Side, SameSide=SameSide, Closing=Closing, Risk=Risk, Level=Level
}
State.AutoMix.AnalyzeDefense(Root, Hand, Threat)
State.AutoMix.RiskScore = Threat.Risk
State.AutoMix.ClosingSpeed = Closing
State.AutoMix.ThreatLevel = Threat.Level
State.AutoMix.ThreatSector = Threat.Sector
State.AutoMix.RearClearance = Threat.RearClearance or math.huge
State.AutoMix.LastThreat = Threat
return Threat
end

function State.AutoMix.Perform(Name)
local Move = State.AutoMix.Moves[Name]
if not Move or State.AutoMix.Busy then return false end
local Character = LP.Character
local HumanoidObject = Character and safe_find(Character, 'Humanoid')
local Root = Character and safe_find(Character, 'HumanoidRootPart')
if not Character or not HumanoidObject or not Root
or not safe_find(Character, 'Basketball') then
State.AutoMix.Status = 'MOVE CANCELLED - NO BALL'
return false
end
if State.AutoMix.IsShotBusy(Character, HumanoidObject, Root) then
State.AutoMix.Status = 'MOVE CANCELLED - SHOT LOCK'
State.AutoMix.SetSequence({})
return false
end
local Allowed, BlockReason = State.AutoMix.IsMoveAllowed(
Name, Root, State.AutoMix.LastThreat)
if not Allowed then
State.AutoMix.Status = 'MOVE BLOCKED - ' .. tostring(BlockReason)
State.AutoMix.SetSequence({})
return false
end
local Key, Conflict = State.AutoMix.ResolveKey(Move.Action)
if not Key then
State.AutoMix.Status = Conflict and ('BIND CONFLICT: ' .. Conflict) or ('NO BIND: ' .. Move.Action)
State.AutoMix.NextAt = os.clock() + 0.25
return false
end
State.AutoMix.Generation += 1
local Generation = State.AutoMix.Generation
local PressedAt = os.clock()
local ExpectedEndHand = State.AutoMix.GetExpectedHand(Name, State.AutoMix.CurrentHand or 'R')
State.AutoMix.Busy = true
State.AutoMix.LastMove = Move.Label
State.AutoMix.LastMoveName = Name
State.AutoMix.MoveLastUsed[Name] = os.clock()
State.AutoMix.Status = Move.Label
State.AutoMix.SendingInput = true
if State.AutoMix.DesiredMovement then
State.AutoMix.MovementUntil = os.clock() + (Move.Timeout or 0.42)
+ math.max(0.08, tonumber(CONFIG.AutoMixPostMoveCooldown) or 0.24)
end
State.AutoMix.StartSpin(Move)
local Pressed = pcall(function() VirtualInputManager:SendKeyEvent(true, Key, false, game) end)
task.delay(0.03, function()
pcall(function() VirtualInputManager:SendKeyEvent(false, Key, false, game) end)
State.AutoMix.SendingInput = false
end)
if not Pressed then State.AutoMix.StopSpin() end
task.delay(Move.Timeout or 0.42, function()
if State.Active and State.AutoMix.Generation == Generation and State.AutoMix.Busy then
State.AutoMix.Busy = false
if ExpectedEndHand then State.AutoMix.CurrentHand = ExpectedEndHand end
if Name ~= 'SwitchHandles' and (State.AutoMix.MoveConfirmedAt[Name] or 0) < PressedAt then
State.AutoMix.MoveCooldownUntil[Name] = os.clock() + 2.5
State.AutoMix.Status = 'MOVE DEAD: ' .. tostring(Move.Label)
end
State.AutoMix.StopSpin()
State.AutoMix.ScheduleNext()
end
end)
return Pressed
end

function State.AutoMix.SetSequence(Names)
State.AutoMix.Sequence = Names or {}
State.AutoMix.SequenceIndex = 1
end

function State.AutoMix.BuildSpinSequence(Mode, Hand)
if Mode == 'All Moves' then
local Order = { 'SwitchHandles','FakeOut','CrossUp','FakeBehindLeft','FakeBehindRight','BehindLeft','BehindRight' }
State.AutoMix.AllMoveIndex = (State.AutoMix.AllMoveIndex % #Order) + 1
return { Order[State.AutoMix.AllMoveIndex] }
end
if Mode == 'Spin Left' then return { 'BehindLeft' } end
if Mode == 'Spin Right' then return { 'BehindRight' } end
if Mode == 'Spin Chain' then
State.AutoMix.SpinDirection = State.AutoMix.SpinDirection == 'L' and 'R' or 'L'
return State.AutoMix.SpinDirection == 'L'
and { 'BehindLeft', 'BehindRight', 'SwitchHandles', 'CrossUp' }
or { 'BehindRight', 'BehindLeft', 'SwitchHandles', 'CrossUp' }
end
if Mode == 'Spin Fake' then
return Hand == 'R' and { 'BehindRight', 'FakeOut' }
or { 'BehindLeft', 'FakeOut' }
end
return nil
end

function State.AutoMix.AvoidRepeat(Primary, Alternate)
if State.AutoMix.LastMoveName == Primary and Alternate then return Alternate end
return Primary
end

function State.AutoMix.GetCurrentBallClearance(Root, Hand, Threat)
if not Threat or not Threat.Root then return math.huge end
local Side = Hand == 'L' and -1 or 1
local BallWorld = Root.CFrame:PointToWorldSpace(Vector3.new(Side * 1.45, 0, -1.85))
local Margin = math.max(1.5, tonumber(CONFIG.AutoMixBallSafetyMargin) or 3)
local Clearance = math.huge
local DefenderRoots = Threat.DefenderRoots and #Threat.DefenderRoots > 0 and Threat.DefenderRoots or { Threat.Root }
for _, DefenderRoot in ipairs(DefenderRoots) do
if DefenderRoot and DefenderRoot.Parent then
local Offset = Vector3.new(BallWorld.X - DefenderRoot.Position.X, 0, BallWorld.Z - DefenderRoot.Position.Z)
Clearance = math.min(Clearance, Offset.Magnitude - Margin)
end
end
return Clearance
end

function State.AutoMix.SelectSmartMove(Root, Hand)
local Threat = State.AutoMix.ReadThreat(Root, Hand)
State.AutoMix.LastDecisionAt = os.clock()
if not Threat then
State.AutoMix.Plan = 'HOLD - NO THREAT'
State.AutoMix.Status = 'NO ACTION NEEDED'
State.AutoMix.LastNecessaryReason = 'NONE'
State.AutoMix.StopMovement()
State.AutoMix.NextAt = os.clock() + 0.22
return nil
end

local OpenDirection = State.AutoMix.ChooseOpenDirection(Root, Threat.Root)
local CrabDirection, CrabStatus = State.AutoMix.GetCrabDirection(Root, Threat)
State.AutoMix.CurrentBallClearance =
State.AutoMix.GetCurrentBallClearance(Root, Hand, Threat)

if Threat.DefenseType == 'RETREAT' or Threat.DefenseType == 'GAP' then
State.AutoMix.Plan = 'READ ' .. Threat.DefenseType .. ' - HOLD'
State.AutoMix.Status = 'DEFENSE GAVE SPACE'
State.AutoMix.LastNecessaryReason = Threat.DefenseType
State.AutoMix.StopMovement()
State.AutoMix.NextAt = os.clock() + 0.16
State.AutoMix.PressureSince = 0
return nil
end

if Threat.Level == 'CLEAR' then
State.AutoMix.Plan = 'HOLD - BALL SAFE'
State.AutoMix.Status = 'NO ACTION NEEDED'
State.AutoMix.LastNecessaryReason = 'CLEAR'
State.AutoMix.StopMovement()
State.AutoMix.NextAt = os.clock() + 0.18
State.AutoMix.ThreatSince, State.AutoMix.ThreatKey,
State.AutoMix.PressureSince = 0, nil, 0
return nil
end

if Threat.Level == 'WATCH' then
State.AutoMix.Plan = 'BODY ' .. tostring(Threat.DefenseType)
State.AutoMix.Status = CrabStatus or 'BODYING'
State.AutoMix.LastNecessaryReason = 'POSITIONING'
if CrabDirection then
State.AutoMix.SetMovement(CrabDirection, 0.20, CrabStatus)
else
State.AutoMix.StopMovement()
end
State.AutoMix.NextAt = os.clock() + 0.08
State.AutoMix.PressureSince = 0
return nil
end

local SpendMove, SpendReason = State.AutoMix.ShouldSpendMove(Threat)
if not SpendMove then
State.AutoMix.Plan = 'BODY FIRST - ' .. tostring(SpendReason)
State.AutoMix.Status = CrabStatus or 'PROTECTING BALL'
State.AutoMix.LastNecessaryReason = SpendReason
if CrabDirection then
State.AutoMix.SetMovement(CrabDirection, 0.22, CrabStatus)
else
State.AutoMix.StopMovement()
end
State.AutoMix.NextAt = os.clock() + 0.06
State.AutoMix.PressureSince = 0
return nil
end

local ThreatKey = Threat.Level .. ':' .. tostring(Threat.Sector)
.. ':' .. Threat.Side .. ':' .. tostring(Threat.DefenseType)
if State.AutoMix.ThreatKey ~= ThreatKey then
State.AutoMix.ThreatKey, State.AutoMix.ThreatSince = ThreatKey, os.clock()
end
local StableFor = os.clock() - (State.AutoMix.ThreatSince or 0)
local Hold = math.max(0.04,
tonumber(CONFIG.AutoMixDecisionHold) or 0.14)
if Threat.Level ~= 'EMERGENCY' and StableFor < Hold then
State.AutoMix.Plan = 'CONFIRMING ' .. tostring(SpendReason)
State.AutoMix.Status = 'BODYING BEFORE MOVE'
State.AutoMix.LastNecessaryReason = 'UNCONFIRMED'
State.AutoMix.SetMovement(
CrabDirection or OpenDirection,
Hold - StableFor + 0.04,
CrabStatus or 'POSITION FIRST')
State.AutoMix.NextAt = os.clock() + 0.03
return nil
end

if Threat.Level == 'PRESSURE' then
if State.AutoMix.PressureSince <= 0 then
State.AutoMix.PressureSince = os.clock()
end
local Grace = math.max(0.08,
tonumber(CONFIG.AutoMixPressureGrace) or 0.28)
local ActionRisk = math.clamp(
tonumber(CONFIG.AutoMixActionRisk) or 0.72, 0.3, 1.5)
if Threat.Risk < ActionRisk
or os.clock() - State.AutoMix.PressureSince < Grace then
State.AutoMix.Plan = 'CRAB BEFORE MOVE'
State.AutoMix.Status = 'BODYING / CREATING SPACE'
State.AutoMix.LastNecessaryReason = 'POSITIONING'
State.AutoMix.SetMovement(
CrabDirection or OpenDirection,
Grace + 0.08,
CrabStatus or 'PROTECTIVE CRAB')
State.AutoMix.NextAt = os.clock() + 0.05
return nil
end
else
State.AutoMix.PressureSince = 0
end

State.AutoMix.SetMovement(
CrabDirection or OpenDirection,
0.45,
Threat.Level == 'EMERGENCY' and 'EMERGENCY ESCAPE'
or (CrabStatus or 'NECESSARY ESCAPE'))
local Safest = State.AutoMix.ChooseSafestMove(Root, Hand, Threat)
if not Safest then
State.AutoMix.Plan = 'NO SAFE MOVE - BODY ONLY'
State.AutoMix.Status = 'PROTECTING BALL'
State.AutoMix.LastNecessaryReason = 'NO SAFE MOVE'
State.AutoMix.NextAt = os.clock() + 0.18
return nil
end

local MinimumGain = math.max(0,
tonumber(CONFIG.AutoMixMinimumClearanceGain) or 0.85)
local Gain = State.AutoMix.PredictedBallEndClearance
- State.AutoMix.CurrentBallClearance
local RequiredGain = Threat.DefenseType == 'REAR REACH'
and MinimumGain * 0.35
or (Threat.Level == 'EMERGENCY' and MinimumGain * 0.50 or MinimumGain)
if Gain < RequiredGain then
State.AutoMix.Plan = string.format(
'BODY - GAIN %.1f BELOW %.1f', Gain, RequiredGain)
State.AutoMix.Status = 'MOVE REJECTED'
State.AutoMix.LastNecessaryReason = 'LOW GAIN'
State.AutoMix.SetMovement(
CrabDirection or OpenDirection, 0.18,
CrabStatus or 'BODY ONLY')
State.AutoMix.NextAt = os.clock() + 0.12
return nil
end

State.AutoMix.PressureSince = 0
State.AutoMix.LastNecessaryReason = tostring(SpendReason)
State.AutoMix.Plan = string.format(
'COUNTER %s: %s | GAIN %.1f',
tostring(Threat.DefenseType), Safest, Gain)
return { Safest }
end

function State.AutoMix.SetEnabled(Enabled)
Enabled = Enabled == true
if Enabled and not State.Active then return end
State.AutoMix.Enabled = Enabled
State.AutoMixEnabled = Enabled
CONFIG.AutoMix = Enabled
State.AutoMix.Generation += 1
State.AutoMix.Busy = false
State.AutoMix.StopSpin()
State.AutoMix.StopMovement()
State.AutoMix.ReleaseBodyControl()
State.AutoMix.LastThreat = nil
State.AutoMix.ThreatSector = 'NONE'
State.AutoMix.RearClearance = math.huge
State.AutoMix.ShotLockUntil = 0
State.AutoMix.BodyPauseUntil = 0
if Enabled and CONFIG.AutoMixUseAntiReach and State.BallAssist then
if State.AutoMix.AntiReachWasEnabled == nil then
State.AutoMix.AntiReachWasEnabled =
State.BallAssist.AntiReachEnabled == true
end
if not State.BallAssist.AntiReachEnabled then
State.BallAssist.SetAntiReach(true)
end
elseif not Enabled and State.AutoMix.AntiReachWasEnabled ~= nil
and State.BallAssist then
State.BallAssist.SetAntiReach(State.AutoMix.AntiReachWasEnabled)
State.AutoMix.AntiReachWasEnabled = nil
end
State.AutoMix.Sequence = {}
State.AutoMix.SequenceIndex = 1
table.clear(State.AutoMix.MoveCooldownUntil)
table.clear(State.AutoMix.MoveConfirmedAt)
State.AutoMix.NextAt = os.clock() + 0.15
if Enabled then
State.AutoMix.SessionStartedAt = os.clock()
State.AutoMix.SessionGames = 0
State.AutoMix.SessionGameTime = 0
State.AutoMix.SessionGameStartedAt = nil
State.AutoMix.SessionInGame = LP:GetAttribute('Ingame') == true
State.AutoMix.SessionSummary = nil
end
State.AutoMix.Status = Enabled and 'READY - BODY FIRST' or 'OFF'
if HubUI.Sync then HubUI.Sync() end
end

GiveSignal(RunService.Heartbeat:Connect(function(DeltaTime)
local Now = os.clock()
if State.AutoMix.Rotating then
local Root = State.AutoMix.SpinRoot
if not State.Active or not State.AutoMix.Enabled
or not Root or not Root.Parent then
State.AutoMix.StopSpin()
else
local Progress = math.clamp(
(Now - State.AutoMix.SpinStartedAt)
/ State.AutoMix.SpinDuration, 0, 1)
local Smoothed = Progress * Progress * (3 - 2 * Progress)
local Target = State.AutoMix.SpinRadians * Smoothed
local Delta = Target - State.AutoMix.SpinApplied
State.AutoMix.SpinTarget = Target
State.AutoMix.ShiftLockActive = State.AutoMix.IsShiftLockActive()
if State.AutoMix.ShiftLockActive then
State.AutoMix.ApplyShiftLockSpin(Root, Target)
elseif math.abs(Delta) > 0.0001 then
Root.CFrame = Root.CFrame * CFrame.Angles(0, Delta, 0)
end
State.AutoMix.SpinApplied = Target
if Progress >= 1 then State.AutoMix.StopSpin() end
end
end

local Character = LP.Character
local HumanoidObject = Character and safe_find(Character, 'Humanoid')
local Root = Character and safe_find(Character, 'HumanoidRootPart')
local ShotBusy = State.AutoMix.Enabled and Character and HumanoidObject
and State.AutoMix.IsShotBusy(Character, HumanoidObject, Root)
if ShotBusy then State.AutoMix.StopMovement() end

if State.AutoMix.Enabled and CONFIG.AutoMixBodyFirst
and Character and safe_find(Character, 'Basketball')
and Root and HumanoidObject and HumanoidObject.Health > 0
and State.AutoMix.LastThreat and not ShotBusy
and Now >= (State.AutoMix.BodyPauseUntil or 0)
and not State.AutoMix.Rotating then
State.AutoMix.ApplyBodyFirst(
Root, HumanoidObject, State.AutoMix.LastThreat, DeltaTime)
else
State.AutoMix.ReleaseBodyControl()
if ShotBusy then State.AutoMix.BodyStatus = 'SHOT LOCK' end
end

local ThreatDirection = State.AutoMix.DesiredMovement
if State.AutoMix.Enabled and CONFIG.AutoMixMovement and ThreatDirection
and not ShotBusy and Now >= (State.AutoMix.BodyPauseUntil or 0)
and Now < State.AutoMix.MovementUntil
and Now - (State.AutoMix.LastSteerRefreshAt or 0) >= 0.12 then
State.AutoMix.LastSteerRefreshAt = Now
local SteerDefender = State.AutoMix.LastDefender
local SteerDefenderRoot = SteerDefender
and GetAutoBodyTargetRig(SteerDefender)
if Root and SteerDefenderRoot then
local FreshThreat = State.AutoMix.LastThreat
local Fresh = FreshThreat
and select(1, State.AutoMix.GetCrabDirection(Root, FreshThreat))
or State.AutoMix.ChooseOpenDirection(Root, SteerDefenderRoot)
if Fresh and Fresh.Magnitude > 0.05 then
State.AutoMix.DesiredMovement = Fresh.Unit
ThreatDirection = State.AutoMix.DesiredMovement
end
end
end

local ManualDirection = State.AutoMix.GetManualDirection(HumanoidObject)
State.AutoMix.ManualDirection = ManualDirection
local HasManual = ManualDirection.Magnitude > 0.05
if State.AutoMix.Enabled and CONFIG.AutoMixMovement and ThreatDirection
and not ShotBusy and Now >= (State.AutoMix.BodyPauseUntil or 0)
and Now < State.AutoMix.MovementUntil
and HumanoidObject and HumanoidObject.Health > 0 then
local ThreatWeight = State.AutoMix.GetThreatSteerWeight(HasManual)
local ManualWeight = HasManual
and math.clamp(tonumber(CONFIG.AutoMixManualInfluence) or 0.72, 0.1, 1)
or 0
local Blended = ThreatDirection * ThreatWeight
+ ManualDirection * ManualWeight
if Blended.Magnitude > 0.05 then
Blended = Blended.Unit
State.AutoMix.BlendedDirection = Blended
State.AutoMix.BlendPercent = math.floor(ThreatWeight * 100 + 0.5)
State.AutoMix.MovementStatus = HasManual
and string.format('MANUAL + CRAB %d%%', State.AutoMix.BlendPercent)
or 'BODY / CRAB CONTROL'
if State.Runtime.AcquireMovement('AutoMix', 0.08) then
HumanoidObject:Move(Blended, false)
end
end
else
State.Runtime.ReleaseMovement('AutoMix')
State.AutoMix.BlendedDirection = ManualDirection
State.AutoMix.BlendPercent = 0
if Now >= State.AutoMix.MovementUntil then
State.AutoMix.DesiredMovement = nil
State.AutoMix.MovementStatus = HasManual and 'MANUAL' or 'IDLE'
end
end
end))

pcall(function() RunService:UnbindFromRenderStep(State.AutoMix.ShiftLockBindName) end)
