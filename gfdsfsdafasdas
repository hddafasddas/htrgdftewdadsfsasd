function Section:AddButton(text, callback)
    local lib = self.Library
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 23), AutoButtonColor = false,
        BackgroundColor3 = lib.Theme.SurfaceAlt, BorderSizePixel = 0, Font = FONT,
        TextSize = TEXT, TextColor3 = lib.Theme.Text, Text = text,
        LayoutOrder = self:_next(), Parent = self.Body,
    }, { corner(2), stroke(lib.Theme.BorderSoft) })
    lib:_bind(button, "BackgroundColor3", "SurfaceAlt")
    lib:_bind(button, "TextColor3", "Text")

    local glow = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0),
