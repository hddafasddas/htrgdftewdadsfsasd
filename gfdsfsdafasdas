        local colour = Color3.fromHSV(h, sat, val)
        control.Value = colour
        field.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        cursor.Position = UDim2.fromScale(sat, 1 - val)
        hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
        swatch.BackgroundColor3 = colour
        if not hex:IsFocused() then hex.Text = "#" .. string.upper(colour:ToHex()) end
        if not silent then control:_emit(colour) end
    end

    function control:SetValue(value, silent)
        if type(value) == "string" then
            local ok, parsed = pcall(Color3.fromHex, value)
            if not ok then return self end
            value = parsed
        end
        if typeof(value) ~= "Color3" then return self end
        h, sat, val = value:ToHSV()
        paint(silent)
        return self
    end

    bindDrag(self.Janitor, fieldHit, field, function(x, y)
        sat, val = x, 1 - y
        paint()
    end)
    bindDrag(self.Janitor, hueHit, hueBar, function(x)
        h = x
        paint()
    end)

    self.Janitor:Add(hex.FocusLost:Connect(function()
        control:SetValue((hex.Text:gsub("^#", "")))
        paint(true)
    end))
    self.Janitor:Add(swatch.MouseButton1Click:Connect(function() popup:Toggle() end))
    self.Janitor:Add(swatch.MouseEnter:Connect(function()
        lib:_tween(swatch, MOTION.Fast, { Size = UDim2.fromOffset(50, 17) })
    end))
    self.Janitor:Add(swatch.MouseLeave:Connect(function()
        lib:_tween(swatch, MOTION.Fast, { Size = UDim2.fromOffset(46, 16) })
    end))

    paint(true)
    return control
end

-- Rotary wheel/dial for numeric values, with a ticked bezel.
function Section:AddDial(id, options)
    options = merge({ Min = 0, Max = 100, Default = 50, Rounding = 0, Diameter = 64 }, options)
    local lib = self.Library
    local size = options.Diameter
    local row = self:_row(size + 21)

    self:_text(row, options.Text or id, UDim2.new(1, 0, 0, 15), "TextMuted")

    local dial = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 19),
        Size = UDim2.fromOffset(size, size), BackgroundColor3 = lib.Theme.SurfaceAlt,
        BorderSizePixel = 0, Parent = row,
    }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }), stroke(lib.Theme.BorderSoft) })
    lib:_bind(dial, "BackgroundColor3", "SurfaceAlt")

    local TICKS = 16
    local ticks, radius = {}, size / 2 - 6
    for i = 0, TICKS - 1 do
        local degrees = -135 + i * (270 / (TICKS - 1))
        local radians = math.rad(degrees)
        ticks[i] = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(
                size / 2 + math.sin(radians) * radius,
                size / 2 - math.cos(radians) * radius
            ),
            Size = UDim2.fromOffset(2, 6), Rotation = degrees,
            BackgroundColor3 = lib.Theme.BorderSoft, BorderSizePixel = 0, Parent = dial,
        })
    end

    local needleHolder = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(size - 18, size - 18), BackgroundTransparency = 1, Parent = dial,
    })
    local needle = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0),
        Size = UDim2.fromOffset(2, 13), BackgroundColor3 = lib.Theme.GoldBright,
        BorderSizePixel = 0, Parent = needleHolder,
    }, { corner(1) })
    lib:_bind(needle, "BackgroundColor3", "GoldBright")

    local readout = create("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(size - 20, 14), BackgroundTransparency = 1, Font = FONT,
        TextSize = 12, TextColor3 = lib.Theme.Text, Text = "", Parent = dial,
    })
    lib:_bind(readout, "TextColor3", "Text")

    local hit = create("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, Parent = dial,
    })

    local control = newControl(lib, id, options.Default, options.Callback)

    function control:SetValue(value, silent)
        value = round(clamp(tonumber(value) or options.Min, options.Min, options.Max), options.Rounding)
        self.Value = value
        local span = options.Max - options.Min
        local alpha = span ~= 0 and (value - options.Min) / span or 0
        readout.Text = (options.Prefix or "") .. tostring(value) .. (options.Suffix or "")
        lib:_tween(needleHolder, MOTION.Fast, { Rotation = -135 + alpha * 270 })
        for i = 0, TICKS - 1 do
            local lit = (i / (TICKS - 1)) <= alpha + 0.001
            lib:_tween(ticks[i], MOTION.Fast, {
                BackgroundColor3 = lit and lib.Theme.Gold or lib.Theme.BorderSoft,
            })
        end
        if not silent then self:_emit(value) end
        return self
    end

    -- Vertical drag is far more precise than chasing the cursor around a
    -- circle, and it is what hardware knobs in audio software use.
    local dragging, anchorY, anchorValue = false, 0, 0
    self.Janitor:Add(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, anchorY, anchorValue = true, input.Position.Y, control.Value
            lib:_tween(dial, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceRaised })
        end
    end))
    self.Janitor:Add(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = (anchorY - input.Position.Y) / 140
            control:SetValue(anchorValue + delta * (options.Max - options.Min))
        end
    end))
    self.Janitor:Add(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then lib:_tween(dial, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceAlt }) end
            dragging = false
        end
    end))

    control:SetValue(control.Value, true)
    return control
end

-- Segmented control: a compact one-of-N picker with a sliding gold underline.
function Section:AddSegmented(id, options)
    options = options or {}
    local values = options.Values or {}
    local lib = self.Library
    local row = self:_row(40)

    self:_text(row, options.Text or id, UDim2.new(1, 0, 0, 15), "TextMuted")

    local strip = create("Frame", {
        Position = UDim2.fromOffset(0, 19), Size = UDim2.new(1, 0, 0, 21),
        BackgroundColor3 = lib.Theme.SurfaceAlt, BorderSizePixel = 0, Parent = row,
    }, { corner(2), stroke(lib.Theme.BorderSoft) })
    lib:_bind(strip, "BackgroundColor3", "SurfaceAlt")

    local count = math.max(#values, 1)
    local highlight = create("Frame", {
        Size = UDim2.new(1 / count, -4, 1, -4), Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = lib.Theme.GoldDark, BorderSizePixel = 0, Parent = strip,
    }, { corner(2) })
    lib:_bind(highlight, "BackgroundColor3", "GoldDark")

    local control = newControl(lib, id, options.Default or values[1], options.Callback)
    local buttons = {}

    function control:SetValue(value, silent)
        self.Value = value
        for index, entry in ipairs(values) do
            local active = entry == value
            if active then
                lib:_tween(highlight, MOTION.Normal, {
                    Position = UDim2.new((index - 1) / count, 2, 0, 2),
                })
            end
            lib:_tween(buttons[index], MOTION.Fast, {
                TextColor3 = active and lib.Theme.GoldBright or lib.Theme.TextMuted,
            })
        end
        if not silent then self:_emit(value) end
        return self
    end

    for index, entry in ipairs(values) do
        local button = create("TextButton", {
            Size = UDim2.new(1 / count, 0, 1, 0),
            Position = UDim2.new((index - 1) / count, 0, 0, 0),
            BackgroundTransparency = 1, AutoButtonColor = false, Font = FONT,
            TextSize = 12, TextColor3 = lib.Theme.TextMuted, Text = tostring(entry),
            ZIndex = 2, Parent = strip,
        })
        buttons[index] = button
        self.Janitor:Add(button.MouseButton1Click:Connect(function()
            control:SetValue(entry)
        end))
    end

    control:SetValue(control.Value, true)
    return control
end

