function State.Cosmetics.ApplyLocalCosmetics(ForceBall)
if not State.LocalCosmeticSpoofEnabled then return end
local Now = os.clock()
local Ball = GetLocalBallHandle()
-- Immediately restore any previously selected handle. This also cleans up
-- balls that older target detection accidentally treated as local.
for TrackedBall, Original in pairs(State.Cosmetics.Runtime.BallOriginals) do
if TrackedBall ~= Ball then
if TrackedBall and TrackedBall.Parent then
State.ApplyBallCosmeticCategory(TrackedBall, 'Aura', Original.Aura)
State.ApplyBallCosmeticCategory(TrackedBall, 'Trail', Original.Trail)
State.ApplyBallCosmeticCategory(TrackedBall, 'Ball', Original.Ball)
end
State.Cosmetics.Runtime.BallOriginals[TrackedBall] = nil
end
end
if Ball and State.Cosmetics.Replicator then
if not State.Cosmetics.Runtime.BallOriginals[Ball] then
State.Cosmetics.Runtime.BallOriginals[Ball] = {
Aura = Ball:GetAttribute('Aura'),
Trail = Ball:GetAttribute('Trail'),
Ball = Ball:GetAttribute('Ball'),
}
end
local Aura = State.LocalAura ~= 'None' and State.LocalAura or nil
local Trail = State.LocalTrail ~= 'None' and State.LocalTrail or nil
local BallSkin = State.LocalBall ~= 'None' and State.LocalBall or nil
local Signature = table.concat({
tostring(State.LocalAura),
tostring(State.LocalTrail),
tostring(State.LocalBall),
}, '\0')
local NeedsBallApply = ForceBall == true
or State.Cosmetics.Runtime.AppliedBall ~= Ball
or State.Cosmetics.Runtime.AppliedSignature ~= Signature
or State.Cosmetics.Runtime.LastError ~= nil
or Now - State.Cosmetics.Runtime.LastBallApplyAt >= 5
if NeedsBallApply then
local AuraOk, TrailOk, BallOk = true, true, true
if Aura then
AuraOk = State.ApplyBallCosmeticCategory(Ball, 'Aura', Aura)
else
State.BallStudio.HardUnequip(Ball, 'Aura')
end
if Trail then
TrailOk = State.ApplyBallCosmeticCategory(Ball, 'Trail', Trail)
else
State.BallStudio.HardUnequip(Ball, 'Trail')
end
if BallSkin then
BallOk = State.ApplyBallCosmeticCategory(Ball, 'Ball', BallSkin)
else
State.BallStudio.HardUnequip(Ball, 'Ball')
end
State.Cosmetics.Runtime.LastError = (AuraOk and TrailOk and BallOk) and nil or 'BALL COSMETIC APPLY PARTIAL'
State.Cosmetics.Runtime.AppliedBall = Ball
State.Cosmetics.Runtime.AppliedSignature = Signature
State.Cosmetics.Runtime.LastBallApplyAt = Now
ForceBallCosmeticsVisible(Ball)
if CONFIG.BallStudioEnabled then pcall(State.BallStudio.Refresh) end
end
end

