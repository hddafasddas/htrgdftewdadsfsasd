task.delay(OutTime + 0.02, function()
if RangeScreenTint.Serial ~= Serial or RangeScreenTint.TargetVisible then return end
if Group and Group.Parent then Group.Visible = false end
if Correction and Correction.Parent then Correction.Enabled = false end
end)
end
