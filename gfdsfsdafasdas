        cutoffDepth = 4, -- studs up the drive line, on the basket side
        cutoffLead = 25, -- percent of a second of carrier momentum to lead
        cutoffBias = 45, -- percent momentum vs hoop line when blending
        cutoffClampCourt = true, -- keep the anchor inside the court bounds
        cutoffCourtInset = 6, -- studs of margin held off the court edge
        autoBody = false,
        autoBodyOnlyHolding = false,
