end
State.AutoDunkStatus = 'WAITING'

RunService:BindToRenderStep(
State.AutoDunk.BindName,
Enum.RenderPriority.Input.Value + 3,
WYNF_JIT(function()
if not (State.Active and State.AutoDunkEnabled) then
State.AutoDunk.ReleaseKey()
return
end

local Character = LP.Character
local LocalHumanoid = Character and safe_find(Character, 'Humanoid')
local Root = Character and safe_find(Character, 'HumanoidRootPart')
local Basketball = GetHeldBasketballModel(LP)
if not LocalHumanoid or not Root or LocalHumanoid.Health <= 0 then
State.AutoDunkStatus = 'WAITING FOR CHARACTER'
State.AutoDunk.ReleaseKey()
return
end

local Target, Distance = State.AutoDunk.ResolveTarget()
State.AutoDunk.Target = Target
State.AutoDunk.TargetDistance = Distance

if State.AutoDunk.InProgress then
local Elapsed = os.clock() - State.AutoDunk.StartedAt
if not Basketball or Elapsed >= CONFIG.AutoDunkHoldTime then
State.AutoDunk.ReleaseKey()
State.AutoDunkStatus = Basketball and 'COOLDOWN' or 'COMPLETE'
return
end
if Target then
local Delta = Target.Position - Root.Position
local Horizontal = Vector3.new(Delta.X, 0, Delta.Z)
if Horizontal.Magnitude > 1 then if State.Runtime.AcquireMovement('Dunk') then LocalHumanoid:Move(Horizontal.Unit, false) end end
end
State.AutoDunkStatus = 'HOLDING ' .. tostring(State.AutoDunk.HeldKey or State.AutoDunk.GetKeyCode())
return
end

if not Basketball then
State.AutoDunkStatus = 'NEED BALL'
return
end
if safe_find(Root, 'BodyVelocity_Dunk') or safe_find(Root, 'BodyPosition_Dunk') then
State.AutoDunkStatus = 'NATIVE DUNK ACTIVE'
return
end
local DunkKey = State.AutoDunk.GetKeyCode()
if DunkKey and UserInputService:IsKeyDown(DunkKey) then
State.AutoDunkStatus = 'MANUAL DUNK'
return
end
local CanStart, BlockReason = State.AutoDunk.CanStart(Basketball)
if not CanStart then
State.AutoDunkStatus = BlockReason
return
end
if State.PassInProgress or State.silentShootActive then
State.AutoDunkStatus = 'BUSY'
return
end
if not Target then
State.AutoDunkStatus = 'NO SCORING RIM'
return
end
if State.AutoDunk.HasManualInput() then
State.AutoDunkStatus = 'MANUAL OVERRIDE'
return
end

local LaneOpen = State.AutoDunk.LaneOpen(Root, Target)
if not LaneOpen then
State.AutoDunkStatus = 'LANE BLOCKED'
return
end

local TriggerDistance = math.clamp(tonumber(CONFIG.AutoDunkTriggerDistance) or 11, 5, 20)
local Now = os.clock()
if Distance <= TriggerDistance then
if LocalHumanoid.PlatformStand or LocalHumanoid.FloorMaterial == Enum.Material.Air then
State.AutoDunkStatus = 'WAITING FOR GROUND'
return
end
if Now - State.AutoDunk.LastAttempt < CONFIG.AutoDunkRetryDelay then
State.AutoDunkStatus = 'COOLDOWN'
return
end
local Delta = Target.Position - Root.Position
local Horizontal = Vector3.new(Delta.X, 0, Delta.Z)
if Horizontal.Magnitude > 0.1 then if State.Runtime.AcquireMovement('Dunk') then LocalHumanoid:Move(Horizontal.Unit, false) end end
State.AutoDunk.Begin(Target)
return
end

if State.AutoDunkMode == 'Trigger Only' then
State.AutoDunkStatus = string.format('MOVE CLOSER | %.1f', Distance)
return
end

local ApproachDistance = CONFIG.AutoDunkApproachDistance
if State.AutoDunkMode == 'Aggressive' then ApproachDistance += 8 end
if Distance <= ApproachDistance then
local Delta = Target.Position - Root.Position
local Horizontal = Vector3.new(Delta.X, 0, Delta.Z)
if Horizontal.Magnitude > TriggerDistance then
if State.Runtime.AcquireMovement('Dunk') then LocalHumanoid:Move(Horizontal.Unit, false) end
State.AutoDunkStatus = string.format('APPROACHING | %.1f', Distance)
end
else
State.AutoDunkStatus = string.format('OUT OF RANGE | %.1f', Distance)
end
end)
)
end

