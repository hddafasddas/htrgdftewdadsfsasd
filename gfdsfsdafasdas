function State.AutoOffense.UpdatePathVisual(Root, Points, Mode)
if not State.AutoOffense.PathVisualEnabled
or not State.AutoOffense.Enabled or not Root or not Points or #Points == 0 then
State.AutoOffense.ClearPathVisual()
return
end
local Now = os.clock()
if Now - (State.AutoOffense.PathUpdatedAt or 0) < 0.05 then return end
State.AutoOffense.PathUpdatedAt = Now
local Color = Color3.fromRGB(255, 205, 55)
if Mode == 'INBOUND' then Color = Color3.fromRGB(70, 215, 255)
elseif Mode == 'PROTECT' then Color = Color3.fromRGB(255, 125, 45)
elseif Mode == 'RECENTER' then Color = Color3.fromRGB(255, 70, 70)
end
local Samples = {}
for Segment = 1, #Points - 1 do
local A, B = Points[Segment], Points[Segment + 1]
if typeof(A) == 'Vector3' and typeof(B) == 'Vector3' then
local Delta = B - A
local Steps = math.max(1, math.ceil(Delta.Magnitude / 2.5))
for Index = 0, Steps - 1 do
if #Samples >= 28 then break end
Samples[#Samples + 1] = A:Lerp(B, Index / Steps)
end
end
if #Samples >= 28 then break end
end
if #Samples < 28 and typeof(Points[#Points]) == 'Vector3' then
Samples[#Samples + 1] = Points[#Points]
end
local GroundY = Root.Position.Y - 2.55
for Index, Position in ipairs(Samples) do
local Part = State.AutoOffense.GetPathPart(Index)
Part.Color = Color
Part.Size = Index == #Samples
and Vector3.new(0.72, 0.72, 0.72)
or Vector3.new(0.48, 0.48, 0.48)
Part.Transparency = 0.18
Part.CFrame = CFrame.new(Position.X, GroundY, Position.Z)
end
for Index = #Samples + 1, #State.AutoOffense.PathParts do
local Part = State.AutoOffense.PathParts[Index]
if Part and Part.Parent then Part.Transparency = 1 end
end
end

function State.AutoOffense.GetLineRouteTarget(Origin, Rim, Court)
if not Origin or not Rim then return Origin end
local Delta = Rim.Position - Origin
local Flat = Vector3.new(Delta.X, 0, Delta.Z)
if Flat.Magnitude <= 0.05 then return Origin end
local Target = Origin + Flat.Unit * math.max(0, Flat.Magnitude - 70)
local _, SafeTarget = State.AutoOffense.GetSafeCourtBounds(Target, Court)
return SafeTarget or Target
end

function State.AutoOffense.ChooseInboundSide(Root, Forward, Right, Court, DefenderRoot)
local BestSign, BestTarget, BestScore = 1, nil, -math.huge
for _, Sign in ipairs({ -1, 1 }) do
local Direction = Right * Sign
local Target = Root.Position + Direction * 9
local Inside, SafeTarget, Clearance =
State.AutoOffense.GetSafeCourtBounds(Target, Court)
Target = SafeTarget or Target
local Room = State.AutoOffense.LaneRoom(
Root.Position, Direction, Court, 14,
Sign < 0 and 'inbound-left' or 'inbound-right')
local Score = Room * 2 + math.clamp(tonumber(Clearance) or 0, -20, 20)
if Inside then Score += 30 else Score -= 50 end
if DefenderRoot then
local Predicted = DefenderRoot.Position
+ DefenderRoot.AssemblyLinearVelocity * 0.20
Score += (Target - Predicted).Magnitude * 1.8
end
if Score > BestScore then
BestSign, BestTarget, BestScore = Sign, Target, Score
end
end
return BestSign, BestTarget
end

function State.AutoOffense.BeginInboundEscape(
Root, Forward, Right, Court, DefenderRoot)
local Sign, Target = State.AutoOffense.ChooseInboundSide(
Root, Forward, Right, Court, DefenderRoot)
State.AutoOffense.InboundActive = true
State.AutoOffense.InboundStartedAt = os.clock()
State.AutoOffense.InboundUntil = State.AutoOffense.InboundStartedAt + 0.72
State.AutoOffense.InboundSide = Sign
State.AutoOffense.InboundStartPosition = Root.Position
State.AutoOffense.InboundTarget = Target
State.AutoOffense.DriveStatus = Sign < 0
and 'INBOUND LEFT' or 'INBOUND RIGHT'
end

function State.AutoOffense.Step(DeltaTime)
if not (State.Active and State.AutoOffense.Enabled) then return end

local Character = LP.Character
local Root = Character and Character:FindFirstChild('HumanoidRootPart')
local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
if not Root or not Humanoid then
State.AutoOffense.Status = 'WAITING FOR CHARACTER'
State.AutoOffense.ClearPathVisual()
return
end

if State.Movement and State.Movement.FlightEnabled then
State.AutoOffense.ResetMovement(Humanoid, true)
State.AutoOffense.Status = 'FLIGHT OVERRIDE'
State.AutoOffense.ClearPathVisual()
return
end

local HeldBall = GetHeldBasketballModel(LP)
if not HeldBall then
State.AutoOffense.HadBall = false
State.AutoOffense.InboundActive = false
State.AutoOffense.InboundStartPosition = nil
State.AutoOffense.InboundTarget = nil
State.AutoOffense.ResetMovement(Humanoid, true)
State.AutoOffense.Status = 'NEED BALL'
State.AutoOffense.ActionType = nil
State.AutoOffense.Target = nil
State.AutoOffense.TargetDistance = math.huge
State.AutoOffense.ClearPathVisual()
return
end
local NewPossession = not State.AutoOffense.HadBall
if NewPossession then
State.AutoOffense.HadBall = true
State.AutoOffense.PossessionAt = os.clock()
end
if State.AutoOffense.InProgress then return end
local ManualDirection = State.AutoOffense.GetManualDirection(Humanoid, Root)
local HasManual = ManualDirection.Magnitude > 0.05
State.AutoOffense.ManualBlendActive = HasManual

State.AutoOffense.MovementIsReset = false
local Rim, Distance = State.AutoOffense.GetScoringGoal()
State.AutoOffense.Target = Rim
State.AutoOffense.TargetDistance = Distance or math.huge
if not Rim then
State.AutoOffense.ResetMovement(Humanoid)
State.AutoOffense.Status = 'NO SCORING GOAL'
State.AutoOffense.ClearPathVisual()
return
end

local Delta = Rim.Position - Root.Position
local Horizontal = Vector3.new(Delta.X, 0, Delta.Z)
if Horizontal.Magnitude < 0.1 then
State.AutoOffense.StopSmoothMovement(Humanoid)
State.AutoOffense.ClearPathVisual()
return
end
local Forward = Horizontal.Unit
local Right = Vector3.new(-Forward.Z, 0, Forward.X)
local Now = os.clock()
local RefreshStatus = Now - State.AutoOffense.StatusUpdatedAt >= 0.08
if RefreshStatus then State.AutoOffense.StatusUpdatedAt = Now end
local Court = State.AutoOffense.GetCourt()
local Defender, DefenderDistance = State.AutoOffense.GetDefender()
local DefenderRoot = Defender and Defender.Character
and Defender.Character:FindFirstChild('HumanoidRootPart')
State.AutoOffense.LastDefenderDistance = DefenderDistance
local BallThreat, EscapeSign, BallClearance =
State.AutoOffense.EvaluateBallThreat(Root, DefenderRoot, Right)
local ImmediateThreat = BallThreat
or (DefenderRoot and DefenderDistance <= 8.5)
local ShieldThreat = BallThreat
or State.AutoOffense.StealLaneAligned
or Now < (State.AutoOffense.ShieldTurnUntil or 0)
if DefenderRoot then
State.AutoOffense.ApplyBackToDefender(
Root, Humanoid, DefenderRoot, DeltaTime, true,
ShieldThreat, BallClearance)
State.AutoOffense.DriveStatus = ShieldThreat
and 'SHIELD TURN | FAST TO 85 LINE'
or 'BACK TURNED | FAST TO 85 LINE'
else
State.AutoOffense.ReleaseBackdown()
end

-- A new far-court possession is treated as the inbound catch. The first route
-- segment is strictly lateral; forward progress resumes immediately afterward.
if NewPossession and Distance > 76 then
State.AutoOffense.BeginInboundEscape(
Root, Forward, Right, Court, DefenderRoot)
end

-- The 85-power line remains the hard finish: stop, set 85, and jump-shoot.
if Distance <= 70.75 then
State.AutoOffense.InboundActive = false
State.AutoOffense.LineShotDistance = Distance
State.AutoOffense.ActionType = 'SHOOT'
State.AutoOffense.DriveStatus = 'BACK TURNED | AT 85 LINE'
State.AutoOffense.BoundaryStatus = '85 LINE'
State.AutoOffense.StopSmoothMovement(Humanoid)
State.AutoOffense.ClearPathVisual()
safe_set_attribute(LP, 'Power', 85)
if Now - (State.AutoOffense.LastLineAttempt or 0) >= 0.06 then
State.AutoOffense.LastLineAttempt = Now
if State.AutoOffense.PerformShoot() then
State.AutoOffense.Status = string.format(
'JUMP SHOT | 85 POWER | %.1f', Distance)
else
State.AutoOffense.Status = 'HOLDING 85 LINE | '
.. tostring(State.AutoOffense.Status or 'WAITING')
end
end
return
end
State.AutoOffense.LineShotDistance = math.huge

local InsideSafe, RecoveryTarget, EdgeClearance =
State.AutoOffense.GetSafeCourtBounds(Root.Position, Court)
State.AutoOffense.EdgeClearance = EdgeClearance or math.huge
if not InsideSafe and RecoveryTarget then
local Recovery = Vector3.new(
RecoveryTarget.X - Root.Position.X, 0,
RecoveryTarget.Z - Root.Position.Z)
if Recovery.Magnitude <= 0.05 then
local Floor = State.AutoOffense.GetCourtFloor(Court)
local Center = Floor and Floor.Position
if not Center and Court then pcall(function() Center = Court:GetPivot().Position end) end
if Center then
Recovery = Vector3.new(
Center.X - Root.Position.X, 0,
Center.Z - Root.Position.Z)
end
end
local RecoveryManual = false
if Recovery.Magnitude > 0.05 then
Recovery, RecoveryManual = State.AutoOffense.BlendManualDirection(
Recovery, ManualDirection, true)
State.AutoOffense.MoveSmooth(Humanoid, Root, Recovery, DeltaTime, Court)
else
State.AutoOffense.StopSmoothMovement(Humanoid)
end
State.AutoOffense.ManualBlendActive = RecoveryManual
State.AutoOffense.ActionType = 'RECENTER'
State.AutoOffense.DriveStatus = DefenderRoot
and 'BACK TURNED | COURT RECENTER' or 'COURT RECENTER'
local LineTarget = State.AutoOffense.GetLineRouteTarget(
RecoveryTarget, Rim, Court)
State.AutoOffense.UpdatePathVisual(
Root, { Root.Position, RecoveryTarget, LineTarget }, 'RECENTER')
if RefreshStatus then
State.AutoOffense.Status = string.format(
RecoveryManual and 'MANUAL + RECENTER | %.1f TO 85 LINE'
or 'RECENTERING | %.1f TO 85 LINE', Distance - 70)
end
return
end

if State.AutoOffense.InboundActive then
local Start = State.AutoOffense.InboundStartPosition or Root.Position
local Travel = Vector3.new(
Root.Position.X - Start.X, 0, Root.Position.Z - Start.Z).Magnitude
if Now >= State.AutoOffense.InboundUntil or Travel >= 8 then
State.AutoOffense.InboundActive = false
else
if ImmediateThreat then
local Ok, Result = pcall(State.BallAssist.StepNoStealKeeper, Root)
State.AutoOffense.ProtectStatus = Ok and tostring(Result) or 'KEEPER ERROR'
if EscapeSign then
local SafeSign = State.AutoOffense.GetSafeStrafeSign(
Root.Position, Forward, Right, EscapeSign, Court)
if SafeSign then State.AutoOffense.InboundSide = SafeSign end
end
end
local Sign = State.AutoOffense.InboundSide or 1
local Direction = Right * Sign
local ManualLateral = Right * ManualDirection:Dot(Right)
local ManualInbound = ManualLateral.Magnitude > 0.05
if ManualInbound then
Direction = ManualLateral.Unit
Sign = Direction:Dot(Right) >= 0 and 1 or -1
State.AutoOffense.InboundSide = Sign
end
State.AutoOffense.ManualBlendActive = ManualInbound
local Actual, BoundaryAvoiding = State.AutoOffense.MoveSmooth(
Humanoid, Root, Direction, DeltaTime, Court)
local Target = State.AutoOffense.InboundTarget
or (Root.Position + Direction * math.max(2, 8 - Travel))
local LineTarget = State.AutoOffense.GetLineRouteTarget(Target, Rim, Court)
State.AutoOffense.UpdatePathVisual(
Root, { Root.Position, Target, LineTarget }, 'INBOUND')
State.AutoOffense.ActionType = 'INBOUND'
State.AutoOffense.DriveStatus = string.format(
'BACK TURNED | INBOUND %s', Sign < 0 and 'LEFT' or 'RIGHT')
if RefreshStatus then
State.AutoOffense.Status = string.format(
'%s%s%s | THEN %.1f TO 85 LINE',
BoundaryAvoiding and 'COURT GUARD + ' or '',
ManualInbound and 'MANUAL + ' or '',
Sign < 0 and 'INBOUND LEFT' or 'INBOUND RIGHT',
Distance - 70)
end
return
end
end

local Direction = Forward
local Protecting = false
if ImmediateThreat and DefenderRoot then
Protecting = true
local Ok, Result = pcall(State.BallAssist.StepNoStealKeeper, Root)
State.AutoOffense.ProtectStatus = Ok and tostring(Result) or 'KEEPER ERROR'
local Offset = DefenderRoot.Position - Root.Position
local FlatOffset = Vector3.new(Offset.X, 0, Offset.Z)
local DefenderSide = FlatOffset:Dot(Right)
local Sign = EscapeSign or (DefenderSide >= 0 and -1 or 1)
local SafeSign = State.AutoOffense.GetSafeStrafeSign(
Root.Position, Forward, Right, Sign, Court)
if SafeSign then Sign = SafeSign end
State.AutoOffense.BackdownStrafeSign = Sign
State.AutoOffense.BackdownHasCommittedSide = true
local Away = Root.Position - DefenderRoot.Position
Away = Vector3.new(Away.X, 0, Away.Z)
if Away.Magnitude > 0.05 then Away = Away.Unit else Away = -Forward end
local Side = Right * Sign
local Cutoff = FlatOffset.Magnitude > 0.05
and FlatOffset.Unit:Dot(Forward) >= 0.15
local ForwardWeight = Cutoff and 0.35 or 0.68
Direction = Forward * ForwardWeight + Side * 0.82 + Away * 0.30
if Direction:Dot(Forward) < 0.12 then Direction += Forward * 0.45 end
if Direction.Magnitude > 0.05 then Direction = Direction.Unit else Direction = Forward end
State.AutoOffense.ActionType = 'PROTECT'
State.AutoOffense.DriveStatus = ShieldThreat
and 'SHIELD TURN | PROTECT + SPRINT'
or 'BACK TURNED | PROTECT + SPRINT'
else
State.AutoOffense.ProtectStatus = 'CLEAR'
State.AutoOffense.ActionType = 'SPRINT'
State.AutoOffense.DriveStatus = DefenderRoot
and 'BACK TURNED | FAST TO 85 LINE' or 'FAST TO 85 LINE'
end

local ManualBlended
Direction, ManualBlended = State.AutoOffense.BlendManualDirection(
Direction, ManualDirection, Protecting)
State.AutoOffense.ManualBlendActive = ManualBlended
local Actual, BoundaryAvoiding = State.AutoOffense.MoveSmooth(
Humanoid, Root, Direction, DeltaTime, Court)
local PreviewDirection = Actual and Actual.Magnitude > 0.05
and Actual.Unit or Direction
local Mid = Root.Position + PreviewDirection * math.min(10, Distance - 70)
local LineTarget = State.AutoOffense.GetLineRouteTarget(Root.Position, Rim, Court)
State.AutoOffense.UpdatePathVisual(
Root, { Root.Position, Mid, LineTarget },
Protecting and 'PROTECT' or 'SPRINT')
if RefreshStatus then
if BoundaryAvoiding then
State.AutoOffense.Status = string.format(
ManualBlended and 'MANUAL + COURT GUARD | %.1f TO 85 LINE'
or 'COURT GUARD | %.1f TO 85 LINE', Distance - 70)
elseif Protecting then
State.AutoOffense.Status = string.format(
ManualBlended
and 'MANUAL + PROTECT | %.1f TO LINE | %.1f CLEAR'
or 'BACK TURNED | PROTECT + SPRINT | %.1f TO LINE | %.1f CLEAR',
Distance - 70, BallClearance or math.huge)
else
State.AutoOffense.Status = string.format(
ManualBlended and 'MANUAL + ROUTE | %.1f TO 85 LINE'
or (DefenderRoot and 'BACK TURNED | FULL SPEED | %.1f TO 85 LINE'
or 'FULL SPEED | %.1f TO 85 LINE'), Distance - 70)
end
end
end

function State.AutoOffense.UpdateBinding()
pcall(function() RunService:UnbindFromRenderStep(State.AutoOffense.BindName) end)

if not State.AutoOffense.Enabled then
State.AutoOffense.ClearPathVisual()
State.AutoOffense.Generation += 1
State.AutoOffense.InProgress = false
State.AutoOffense.Status = 'OFF'
State.AutoOffense.Target = nil
State.AutoOffense.TargetDistance = math.huge
local Character = LP.Character
local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
State.AutoOffense.ResetMovement(Humanoid)
if State.AutoDunk.InProgress then State.AutoDunk.ReleaseKey() end
return
end

State.AutoOffense.Status = 'READY'
RunService:BindToRenderStep(
State.AutoOffense.BindName,
Enum.RenderPriority.Input.Value + 4,
WYNF_JIT(function(DeltaTime)
if not (State.Active and State.AutoOffense.Enabled) then return end
State.AutoOffense.Step(DeltaTime)
end)
)
end

