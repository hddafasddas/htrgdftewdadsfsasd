function State.Outline.RemoveRecord(Player)
local Record = State.Outline.Records[Player]
if not Record then return end
for Name, Object in pairs(Record) do
if Name ~= 'Seen' and Name ~= 'ClientWorld' then
pcall(function() Object.Visible = false end)
pcall(function() Object:Remove() end)
end
end
State.Outline.Records[Player] = nil
end

function State.Outline.Clear()
for Player in pairs(State.Outline.Records) do
State.Outline.RemoveRecord(Player)
end
table.clear(State.Outline.Objects)
end

function State.Outline.HideRecord(Record)
if not Record then return end
for Name, Object in pairs(Record) do
if Name ~= 'Seen' and Name ~= 'ClientWorld' then
pcall(function() Object.Visible = false end)
end
end
end

function State.Outline.EnsureRecord(Player, IsSelf)
local Record = State.Outline.Records[Player]
if Record or not DrawingApi then return Record end
Record = {
Server = DrawingApi.new('Circle'),
Client = DrawingApi.new('Circle'),
Line = DrawingApi.new('Line'),
}
for _, Circle in ipairs({ Record.Server, Record.Client }) do
Circle.Radius = 3.5
Circle.Filled = false
Circle.Thickness = 2
Circle.Transparency = 0.2
Circle.NumSides = 32
Circle.Visible = false
end
Record.Line.Thickness = 1.5
Record.Line.Transparency = 0.3
Record.Line.Visible = false
if IsSelf then
Record.ServerLabel = DrawingApi.new('Text')
Record.ClientLabel = DrawingApi.new('Text')
for _, Label in ipairs({ Record.ServerLabel, Record.ClientLabel }) do
Label.Size = 10
Label.Center = true
Label.Outline = true
Label.Visible = false
end
Record.ServerLabel.Text = 'server'
Record.ClientLabel.Text = 'client'
end
State.Outline.Records[Player] = Record
return Record
end

function State.Outline.Add(Player, IsSelf, Generation, Root, DeltaTime)
local Camera = Workspace.CurrentCamera
if not (Root and Root.Parent) or not Camera or not DrawingApi then
State.Outline.HideRecord(State.Outline.Records[Player])
return false
end
local Record = State.Outline.EnsureRecord(Player, IsSelf)
if not Record then return false end
Record.Seen = Generation
local ServerPos = Root.Position
local ClientPos = IsSelf and State.Desync.GetClientPosition()
or (State.Desync.Enabled and State.Desync.CompensatePosition(ServerPos) or ServerPos)
if IsSelf and ClientPos then
local Previous = Record.ClientWorld
if Previous then
local Alpha = 1 - math.exp(-32 * math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.1))
ClientPos = Previous:Lerp(ClientPos, Alpha)
end
Record.ClientWorld = ClientPos
else
Record.ClientWorld = nil
end
local ServerScreen, ServerOn = Camera:WorldToViewportPoint(ServerPos)
local ServerColor = IsSelf and State.Outline.SelfServerColor or State.Outline.EnemyServerColor
Record.Server.Position = Vector2.new(ServerScreen.X, ServerScreen.Y)
if Record.Server.Color ~= ServerColor then Record.Server.Color = ServerColor end
if Record.Server.Visible ~= ServerOn then Record.Server.Visible = ServerOn end
if Record.ServerLabel then
Record.ServerLabel.Position = Vector2.new(ServerScreen.X, ServerScreen.Y - 16)
if Record.ServerLabel.Color ~= ServerColor then Record.ServerLabel.Color = ServerColor end
if Record.ServerLabel.Visible ~= ServerOn then Record.ServerLabel.Visible = ServerOn end
end
if ClientPos then
local ClientScreen, ClientOn = Camera:WorldToViewportPoint(ClientPos)
local ClientColor = IsSelf and State.Outline.Color or State.Outline.EnemyClientColor
Record.Client.Position = Vector2.new(ClientScreen.X, ClientScreen.Y)
if Record.Client.Color ~= ClientColor then Record.Client.Color = ClientColor end
if Record.Client.Visible ~= ClientOn then Record.Client.Visible = ClientOn end
if Record.ClientLabel then
Record.ClientLabel.Position = Vector2.new(ClientScreen.X, ClientScreen.Y - 16)
if Record.ClientLabel.Color ~= ClientColor then Record.ClientLabel.Color = ClientColor end
if Record.ClientLabel.Visible ~= ClientOn then Record.ClientLabel.Visible = ClientOn end
end
Record.Line.From = Vector2.new(ServerScreen.X, ServerScreen.Y)
Record.Line.To = Vector2.new(ClientScreen.X, ClientScreen.Y)
if Record.Line.Color ~= State.Outline.Color then Record.Line.Color = State.Outline.Color end
local LineVisible = (ServerPos - ClientPos).Magnitude > 0.5 and ServerOn and ClientOn
if Record.Line.Visible ~= LineVisible then Record.Line.Visible = LineVisible end
else
if Record.Client.Visible then Record.Client.Visible = false end
if Record.Line.Visible then Record.Line.Visible = false end
if Record.ClientLabel and Record.ClientLabel.Visible then Record.ClientLabel.Visible = false end
end
return true
end

function State.Outline.Update(DeltaTime)
local Now = os.clock()
if not State.Outline.Enabled then return end
State.Outline.LastUpdate = Now
State.Outline.Generation += 1
local Generation = State.Outline.Generation
if Now - State.Outline.LastMembershipAt >= 0.2 then
State.Outline.LastMembershipAt = Now
if Now - State.Outline.LastPlayerListAt >= 0.5 then
State.Outline.LastPlayerListAt = Now
State.Outline.PlayerList = Players:GetPlayers()
end
local VisiblePlayers = {}
local Root = LP.Character and safe_find(LP.Character, 'HumanoidRootPart')
if State.Outline.Mode == 'self' or State.Outline.Mode == 'both' then
if Root then
VisiblePlayers[#VisiblePlayers + 1] = { Player = LP, IsSelf = true, Root = Root }
end
end
if State.Outline.Mode == 'enemies' or State.Outline.Mode == 'both' then
for _, Player in ipairs(State.Outline.PlayerList) do
local Other = Player ~= LP and Player.Character and safe_find(Player.Character, 'HumanoidRootPart')
if Root and Other and (Other.Position - Root.Position).Magnitude < 100 then
VisiblePlayers[#VisiblePlayers + 1] = { Player = Player, IsSelf = false, Root = Other }
end
end
end
State.Outline.VisiblePlayers = VisiblePlayers
end
for _, Entry in ipairs(State.Outline.VisiblePlayers) do
State.Outline.Add(
Entry.Player, Entry.IsSelf, Generation, Entry.Root, DeltaTime)
end
for Player, Record in pairs(State.Outline.Records) do
if Record.Seen ~= Generation then State.Outline.HideRecord(Record) end
if not Player.Parent then State.Outline.RemoveRecord(Player) end
end
end

function State.Outline.SetEnabled(Enabled)
State.Outline.Enabled = Enabled == true; State.OutlineEnabled = State.Outline.Enabled; CONFIG.Outline = State.Outline.Enabled
if State.Outline.Enabled then State.Outline.LastMembershipAt = 0 end
State.Outline.UpdateBinding(); if HubUI.Sync then HubUI.Sync() end
end
function State.Outline.SetMode(Mode)
State.Outline.Mode = table.find({'both','self','enemies'},Mode) and Mode or 'both'; State.OutlineMode = State.Outline.Mode; CONFIG.OutlineMode = State.Outline.Mode
State.Outline.LastUpdate = 0
State.Outline.LastMembershipAt = 0
end
function State.Outline.UpdateBinding()
pcall(function() RunService:UnbindFromRenderStep(State.Outline.BindName) end)
if not State.Outline.Enabled then State.Outline.Clear(); return end
RunService:BindToRenderStep(State.Outline.BindName, Enum.RenderPriority.Camera.Value + 50, WYNF_JIT(function(DeltaTime)
if State.Active and State.Outline.Enabled then State.Outline.Update(DeltaTime) else State.Outline.Clear() end
end))
end

