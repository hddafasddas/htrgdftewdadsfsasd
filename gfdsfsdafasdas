function State.NoJump.LockToGround(Root, HumanoidObject, Generation)
local GroundY = Root.Position.Y
local EndsAt = os.clock() + math.max(
tonumber(CONFIG.NoJumpGroundLockTime) or 0.30, 0.08)

task.spawn(function()
while State.Active and State.NoJump.Active
and State.NoJump.Generation == Generation and os.clock() < EndsAt
and Root and Root.Parent and HumanoidObject and HumanoidObject.Parent do
local Velocity = Root.AssemblyLinearVelocity
Root.AssemblyLinearVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
local Position = Root.Position
if math.abs(Position.Y - GroundY) > 0.01 then
local Rotation = Root.CFrame - Position
Root.CFrame = CFrame.new(Position.X, GroundY, Position.Z) * Rotation
end
RunService.Heartbeat:Wait()
end

if HumanoidObject and HumanoidObject.Parent then
HumanoidObject.Jump = false
pcall(function()
if HumanoidObject.FloorMaterial ~= Enum.Material.Air then
HumanoidObject:ChangeState(Enum.HumanoidStateType.Running)
end
end)
end
if State.NoJump.Generation == Generation then
State.NoJump.Active = false
end
