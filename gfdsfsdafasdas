-- ---------------------------------------------------------------------
-- Autoguard
--
-- Walks the character toward the live ball in all four games.
-- Humanoid:Move(direction, false) takes a WORLD-space direction, so it never
-- fights shiftlock: shiftlock keeps controlling where you face, autoguard only
-- controls where you walk. It is re-issued immediately after Roblox's default
-- control step so keyboard input cannot overwrite the autoguard direction.
-- ---------------------------------------------------------------------
local function createAutoguard(getGame, notify)
    local PlayersService = game:GetService("Players")
    local RunServiceLocal = game:GetService("RunService")
    local CollectionServiceLocal = game:GetService("CollectionService")
    local LocalPlayer = PlayersService.LocalPlayer

    local cfg = {
