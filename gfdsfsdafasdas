State.AutoOffense.SmoothedMoveDirection = Vector3.zero
State.AutoOffense.LastIssuedDirection = Vector3.zero
State.AutoOffense.ManualBlendActive = false
State.AutoOffense.BoundaryStatus = 'CLEAR'
