local ArcTable = {}
local MaxRangeForPower = {}
local MinRangeForPower = {}
local MaxRange = 0

local function NormalizeArcTable(Source)
local Clean = {}
if type(Source) ~= 'table' then return Clean end

for _, Entry in ipairs(Source) do
if type(Entry) == 'table' then
local Distance = tonumber(Entry[1])
local Arc = tonumber(Entry[2])
local Power = tonumber(Entry[3])
if Distance and Arc and Power and Distance > 0
and Distance == Distance and Arc == Arc and Power == Power
and math.abs(Distance) < math.huge and math.abs(Arc) < math.huge
and math.abs(Power) < math.huge then
table.insert(Clean, { Distance, Arc, math.floor(Power + 0.5) })
end
end
end
table.sort(Clean, function(A, B)
if A[3] == B[3] then return A[1] > B[1] end
return A[3] < B[3]
end)
return Clean
end

local function MergeArcTables(BaseRows, OverrideRows)
local Base = NormalizeArcTable(BaseRows)
local Override = NormalizeArcTable(OverrideRows)
local ReplacedPowers = {}
local Merged = {}

for _, Entry in ipairs(Override) do
ReplacedPowers[Entry[3]] = true
end
for _, Entry in ipairs(Base) do
if not ReplacedPowers[Entry[3]] then
table.insert(Merged, Entry)
end
end
for _, Entry in ipairs(Override) do
table.insert(Merged, Entry)
end

return NormalizeArcTable(Merged)
end

local function InstallArcTable(Source)
local Clean = NormalizeArcTable(Source)
if #Clean == 0 then
return false, 'table contained no valid rows'
end

local NewMaxRangeForPower = {}
local NewMinRangeForPower = {}
local NewMaxRange = 0
for _, Entry in ipairs(Clean) do
local Distance, Power = Entry[1], Entry[3]
if not NewMaxRangeForPower[Power] or Distance > NewMaxRangeForPower[Power] then
NewMaxRangeForPower[Power] = Distance
end
if not NewMinRangeForPower[Power] or Distance < NewMinRangeForPower[Power] then
NewMinRangeForPower[Power] = Distance
end
if Distance > NewMaxRange then NewMaxRange = Distance end
end

ArcTable = Clean
MaxRangeForPower = NewMaxRangeForPower
MinRangeForPower = NewMinRangeForPower
MaxRange = NewMaxRange
return true, #Clean
end

local ExternalArcTable = {}
if GlobalEnv.__HOOPZ_ARC_TABLE_VERSION == CONFIG.ArcTableVersion then
ExternalArcTable = NormalizeArcTable(GlobalEnv.__HOOPZ_ARC_TABLE)
end
if #ExternalArcTable == 0 and type(CONFIG.ArcTableFile) == 'string'
and type(isfile) == 'function' and type(readfile) == 'function'
and type(loadstring) == 'function' then
local Ok, Loaded = pcall(function()
if not isfile(CONFIG.ArcTableFile) then return nil end
local Chunk, CompileError = loadstring(readfile(CONFIG.ArcTableFile))
if not Chunk then error(CompileError or 'arc table compile failed') end
return Chunk()
end)
if Ok then ExternalArcTable = NormalizeArcTable(Loaded) end
end

local LoadedExternalArcTable = #ExternalArcTable > 0
InstallArcTable(LoadedExternalArcTable
and MergeArcTables(BuiltInArcTable, ExternalArcTable)
or BuiltInArcTable)
GlobalEnv.__HOOPZ_ARC_TABLE = ArcTable
GlobalEnv.__HOOPZ_ARC_TABLE_VERSION = CONFIG.ArcTableVersion

