function State.BallStudio.Cleanup()
local Ball = State.BallStudio.Tracked or GetLocalBallHandle()
if State.BallStudio.SkinWatch then
pcall(function() State.BallStudio.SkinWatch:Disconnect() end)
State.BallStudio.SkinWatch = nil
end
for Part in pairs(State.BallStudio.Proxies) do
