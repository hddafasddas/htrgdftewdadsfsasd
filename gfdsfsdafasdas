if type(History) ~= 'table' then return end
for Index=#History,1,-1 do if type(History[Index])=='table' and History[Index].__SilverSurferFake then table.remove(History,Index) end end
State.LocalSpoofs.HasFakeDraws=false
State.LocalSpoofs.RefreshFakeMatchHistory()
end

