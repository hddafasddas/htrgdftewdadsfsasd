function State.AutoOffense.GetCourtFloor(Court)
if not Court then return nil end
local Resolver = State.AutoGetOpen and State.AutoGetOpen.GetAutoGetOpenFloor
if Resolver then
local Ok, Floor = pcall(Resolver, Court)
if Ok and Floor and safe_is_a(Floor, 'BasePart') then return Floor end
end
local Others = safe_find(Court, 'Others')
local Floor = (Others and safe_find(Others, 'CourtFloor'))
or safe_find(Court, 'CourtFloor')
if Floor and safe_is_a(Floor, 'BasePart') then return Floor end
for _, Descendant in ipairs(Court:GetDescendants()) do
if safe_is_a(Descendant, 'BasePart') and Descendant.Name == 'CourtFloor' then
return Descendant
end
end
return nil
end

-- Treat the configured edge-room as a true inset from every sideline/baseline.
-- This works even on courts that do not replicate an OOB folder.
function State.AutoOffense.GetSafeCourtBounds(Position, Court)
if not Position or not Court then return true, Position, math.huge, nil end
local Floor = State.AutoOffense.GetCourtFloor(Court)
if not Floor then
local Parts = State.AutoOffense.GetOOBParts(Court)
local OOB = #Parts > 0 and State.AutoOffense.PositionOOB(Position, Parts)
return not OOB, Position, OOB and -1 or math.huge, nil
end

local LocalPoint = Floor.CFrame:PointToObjectSpace(Position)
local Margin = 11
local SafeHalfX = math.max(2, Floor.Size.X * 0.5 - Margin)
local SafeHalfZ = math.max(2, Floor.Size.Z * 0.5 - Margin)
local Inside = math.abs(LocalPoint.X) <= SafeHalfX
and math.abs(LocalPoint.Z) <= SafeHalfZ
local Clearance = math.min(
SafeHalfX - math.abs(LocalPoint.X),
SafeHalfZ - math.abs(LocalPoint.Z))
local RecoveryLocal = Vector3.new(
math.clamp(LocalPoint.X, -SafeHalfX, SafeHalfX),
LocalPoint.Y,
math.clamp(LocalPoint.Z, -SafeHalfZ, SafeHalfZ))
local RecoveryWorld = Floor.CFrame:PointToWorldSpace(RecoveryLocal)
return Inside, Vector3.new(
RecoveryWorld.X, Position.Y, RecoveryWorld.Z), Clearance, Floor
end

function State.AutoOffense.EvaluateBallThreat(Root, DefenderRoot, CourtRight)
if not (Root and DefenderRoot and CourtRight) then
State.AutoOffense.LastBallClearance = math.huge
State.AutoOffense.StealLaneAligned = false
State.AutoOffense.StealLaneAlignment = -1
State.AutoOffense.StealLaneWidth = math.huge
return false, nil, math.huge
end

local Basketball = GetHeldBasketballModel(LP)
local Ball = Basketball and safe_find(Basketball, 'Ball')
if not Ball then
State.AutoOffense.LastBallClearance = math.huge
State.AutoOffense.StealLaneAligned = false
State.AutoOffense.StealLaneAlignment = -1
State.AutoOffense.StealLaneWidth = math.huge
return false, nil, math.huge
end

local DefenderVelocity = Vector3.new(
DefenderRoot.AssemblyLinearVelocity.X,
0,
DefenderRoot.AssemblyLinearVelocity.Z)
local PredictedDefender = DefenderRoot.Position
+ DefenderVelocity * State.AutoOffense.DefenderPredictionTime
local FlatPredictedDefender = Vector3.new(
PredictedDefender.X, Root.Position.Y, PredictedDefender.Z)
local FlatBall = Vector3.new(Ball.Position.X, Root.Position.Y, Ball.Position.Z)
local BallOffset = FlatBall - Root.Position
local DefenderOffset = FlatPredictedDefender - Root.Position
local CurrentClearance = (FlatPredictedDefender - FlatBall).Magnitude
local DefenderDistance = DefenderOffset.Magnitude
State.AutoOffense.LastBallClearance = CurrentClearance

local Alignment = -1
local LaneWidth = math.huge
if BallOffset.Magnitude > 0.05 and DefenderOffset.Magnitude > 0.05 then
local BallDirection = BallOffset.Unit
Alignment = DefenderOffset.Unit:Dot(BallDirection)
local AlongLane = DefenderOffset:Dot(BallDirection)
LaneWidth = (DefenderOffset - BallDirection * AlongLane).Magnitude
end
-- Congruent means the defender, player, and held ball occupy the same steal
-- lane: the defender is facing the ball-side ray and is close enough to reach.
local Congruent = Alignment >= 0.58
and LaneWidth <= 3.75
and CurrentClearance <= 8.5
State.AutoOffense.StealLaneAligned = Congruent
State.AutoOffense.StealLaneAlignment = Alignment
State.AutoOffense.StealLaneWidth = LaneWidth

local DirectReach = CurrentClearance <= State.AutoOffense.BallThreatDistance
if Congruent or DirectReach then
State.AutoOffense.ShieldTurnUntil = os.clock() + 0.30
end
local DefenderSide = DefenderOffset:Dot(CourtRight)
local EscapeSign = DefenderSide >= 0 and -1 or 1
local Threatened = DirectReach or Congruent
or DefenderDistance <= State.AutoOffense.EmergencyDefenderDistance
return Threatened, EscapeSign, CurrentClearance
end

function State.AutoOffense.GetOOBParts(Court)
local Now = os.clock()
if State.AutoOffense.OOBPartsCourt == Court
and State.AutoOffense.OOBParts
and Now - State.AutoOffense.OOBPartsAt < 2 then
return State.AutoOffense.OOBParts
end

local Parts = {}
local OOB = Court and safe_find(Court, 'OOB')
if OOB then
for _, ContainerName in ipairs({ 'Floor', 'Lines' }) do
local Container = safe_find(OOB, ContainerName)
if Container then
for _, Part in ipairs(Container:GetDescendants()) do
if safe_is_a(Part, 'BasePart') then
Parts[#Parts + 1] = {
Part = Part,
CFrame = Part.CFrame,
HalfSize = Part.Size * 0.5,
}
end
end
end
end
end

State.AutoOffense.OOBParts = Parts
State.AutoOffense.OOBPartsAt = Now
State.AutoOffense.OOBPartsCourt = Court
return Parts
end

function State.AutoOffense.PositionOOB(Position, Parts)
local Margin = State.AutoOffense.OOBSafetyMargin
for _, Entry in ipairs(Parts) do
local IsRecord = type(Entry) == 'table'
local Part = IsRecord and Entry.Part or Entry
if Part.Parent then
local Frame = IsRecord and Entry.CFrame or Part.CFrame
local HalfSize = IsRecord and Entry.HalfSize or (Part.Size * 0.5)
local LocalPosition = Frame:PointToObjectSpace(Position)
if math.abs(LocalPosition.X) <= HalfSize.X + Margin
and math.abs(LocalPosition.Z) <= HalfSize.Z + Margin
and math.abs(LocalPosition.Y) <= HalfSize.Y + 12 then
return true, Part
end
end
end
return false
end

function State.AutoOffense.IsPositionOutOfBounds(Position, Court)
if not (Position and Court) then return false end
local Parts = State.AutoOffense.GetOOBParts(Court)
if #Parts > 0 and State.AutoOffense.PositionOOB(Position, Parts) then
return true
end
local Inside = State.AutoOffense.GetSafeCourtBounds(Position, Court)
return not Inside
end

function State.AutoOffense.LaneRoom(
Origin, Direction, Court, MaxDistance, CacheKey)
MaxDistance = MaxDistance or State.AutoOffense.KeepInDistance
if not (Origin and Direction and Court) then return MaxDistance end
if Direction.Magnitude <= 0.001 then return MaxDistance end

local Now = os.clock()
if CacheKey then
local Cached = State.AutoOffense.LaneRoomCache[CacheKey]
if Cached and Cached.Court == Court
and Cached.MaxDistance == MaxDistance
and Now - Cached.At < 0.08 then
return Cached.Value
end
end

local Parts = State.AutoOffense.GetOOBParts(Court)
local HasFloor = State.AutoOffense.GetCourtFloor(Court) ~= nil
if #Parts == 0 and not HasFloor then
if CacheKey then
State.AutoOffense.LaneRoomCache[CacheKey] = {
At = Now,
Court = Court,
MaxDistance = MaxDistance,
Value = MaxDistance,
}
end
return MaxDistance
end

local Unit = Direction.Unit
local Step = math.max(1, State.AutoOffense.OOBSampleStep)
local Travelled = Step
while Travelled <= MaxDistance do
local Probe = Origin + Unit * Travelled
local ExplicitOOB = #Parts > 0
and State.AutoOffense.PositionOOB(Probe, Parts)
local InsideCourt = State.AutoOffense.GetSafeCourtBounds(Probe, Court)
if ExplicitOOB or not InsideCourt then
local Room = math.max(0, Travelled - Step)
if CacheKey then
State.AutoOffense.LaneRoomCache[CacheKey] = {
At = Now,
Court = Court,
MaxDistance = MaxDistance,
Value = Room,
}
end
return Room
end
Travelled = Travelled + Step
end
if CacheKey then
State.AutoOffense.LaneRoomCache[CacheKey] = {
At = Now,
Court = Court,
MaxDistance = MaxDistance,
Value = MaxDistance,
}
end
return MaxDistance
end

function State.AutoOffense.GetSafeStrafeSign(RootPosition, Forward, Right, PreferredSign, Court)
if not Court then return PreferredSign, false end

local Now = os.clock()
if State.AutoOffense.SafeStrafeCourt == Court
and State.AutoOffense.SafeStrafePreferred == PreferredSign
and Now - State.AutoOffense.SafeStrafeAt < 0.08 then
return State.AutoOffense.SafeStrafeResult,
State.AutoOffense.SafeStrafeAvoiding
end

local SideDistance = State.AutoOffense.OOBProbeDistance
local ForwardOffset = Forward * State.AutoOffense.OOBProbeForward
local LeftProbe = RootPosition - Right * SideDistance + ForwardOffset
local RightProbe = RootPosition + Right * SideDistance + ForwardOffset
local LeftOOB = State.AutoOffense.IsPositionOutOfBounds(LeftProbe, Court)
local RightOOB = State.AutoOffense.IsPositionOutOfBounds(RightProbe, Court)

local Result = PreferredSign
local Avoiding = false
if PreferredSign < 0 then
if LeftOOB and not RightOOB then Result, Avoiding = 1, true end
elseif RightOOB and not LeftOOB then
Result, Avoiding = -1, true
end

if LeftOOB and RightOOB then Result, Avoiding = nil, true end
State.AutoOffense.SafeStrafeAt = Now
State.AutoOffense.SafeStrafeCourt = Court
State.AutoOffense.SafeStrafePreferred = PreferredSign
State.AutoOffense.SafeStrafeResult = Result
State.AutoOffense.SafeStrafeAvoiding = Avoiding
return Result, Avoiding
end

function State.AutoOffense.CanShoot()
if not State.RequestedEnabled or not State.Enabled then
return false, 'SILENT AIM OFF'
end
if SilentAim.ActorAimReady ~= true then
return false, 'HOOKS NOT READY'
end

local Character = LP.Character
local Ball = GetHeldBasketballModel(LP)
if not Character or not Ball then return false, 'NEED BALL' end

local Rim, Distance = FindConfiguredGoal()
if not Rim then return false, 'NO GOAL' end

local Power = safe_get_attribute(LP, 'Power') or 85
local AdjustedDistance = AdjustAimDistance(Distance)
if not PowerSupportsDistance(Power, AdjustedDistance) then
if CONFIG.AutoPower then
local BestPower = State.SelectBestAutoPower(AdjustedDistance, Power)
if BestPower then
safe_set_attribute(LP, 'Power', BestPower)
Power = BestPower
else
return false, 'NO POWER BAND'
end
else
return false, 'OUT OF RANGE'
end
end

return true, Rim, Distance
end

function State.AutoOffense.CanDunk()
local Character = LP.Character
local Root = Character and Character:FindFirstChild('HumanoidRootPart')
local Ball = GetHeldBasketballModel(LP)
if not Root or not Ball then return false, 'NEED BALL' end

local Target, Distance = State.AutoDunk.ResolveTarget()
if not Target then return false, 'NO DUNK TARGET' end
if Distance > State.AutoOffense.DunkDistance then return false, 'TOO FAR' end

if CONFIG.AutoDunkLaneCheck and not State.AutoDunk.LaneOpen(Root, Target) then
return false, 'LANE BLOCKED'
end

local Humanoid = Character:FindFirstChildOfClass('Humanoid')
if Humanoid and (Humanoid.PlatformStand or Humanoid.FloorMaterial == Enum.Material.Air) then
return false, 'WAITING FOR GROUND'
end

return true, Target, Distance
end

function State.AutoOffense.FinishAction(Generation, Status)
if Generation ~= State.AutoOffense.Generation then return end
State.AutoOffense.InProgress = false
State.AutoOffense.LastAction = os.clock()
State.AutoOffense.Status = Status or 'READY'
end

function State.AutoOffense.PerformShoot()
if State.AutoOffense.InProgress then return false end
local CanShoot, RimOrReason, Distance = State.AutoOffense.CanShoot()
if not CanShoot then
State.AutoOffense.Status = tostring(RimOrReason or 'CANNOT SHOOT')
return false
end

State.AutoOffense.Generation += 1
local Generation = State.AutoOffense.Generation
State.AutoOffense.InProgress = true
State.AutoOffense.ActionType = 'SHOOT'
State.AutoOffense.Status = 'SHOOTING'
State.AutoOffense.Target = RimOrReason
State.AutoOffense.TargetDistance = Distance or math.huge

local Character = LP.Character
local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
if not Humanoid then
State.AutoOffense.FinishAction(Generation, 'NO HUMANOID')
return false
end

State.AutoOffense.ReleaseBackdown()
State.AutoOffense.StopSmoothMovement(Humanoid)
Humanoid.Jump = true
pcall(function() Humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)

task.delay(1.2, function()
State.AutoOffense.FinishAction(Generation, 'READY')
end)
return true
end

function State.AutoOffense.PerformDunk()
if State.AutoOffense.InProgress then return false end
local CanDunk, TargetOrReason, Distance = State.AutoOffense.CanDunk()
if not CanDunk then
State.AutoOffense.Status = tostring(TargetOrReason or 'CANNOT DUNK')
return false
end

State.AutoOffense.Generation += 1
local Generation = State.AutoOffense.Generation
State.AutoOffense.InProgress = true
State.AutoOffense.ActionType = 'DUNK'
State.AutoOffense.Status = 'DUNKING'
State.AutoOffense.Target = TargetOrReason
State.AutoOffense.TargetDistance = Distance or math.huge

local Character = LP.Character
local Root = Character and Character:FindFirstChild('HumanoidRootPart')
local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
State.AutoOffense.ReleaseBackdown()
if Root and Humanoid and TargetOrReason then
local Delta = TargetOrReason.Position - Root.Position
local Horizontal = Vector3.new(Delta.X, 0, Delta.Z)
if Horizontal.Magnitude > 0.1 then Humanoid:Move(Horizontal.Unit, false) end
end

local Began = State.AutoDunk.Begin(TargetOrReason)
if not Began then
State.AutoOffense.FinishAction(Generation, 'DUNK INPUT FAILED')
return false
end

task.delay(math.max(0.35, tonumber(CONFIG.AutoDunkHoldTime) or 1.45), function()
if Generation ~= State.AutoOffense.Generation then return end
State.AutoDunk.ReleaseKey()
State.AutoOffense.FinishAction(Generation, 'READY')
end)
return true
end

function State.AutoOffense.TryAction(Distance)
local Now = os.clock()
if State.AutoOffense.InProgress
or Now - State.AutoOffense.LastAction < State.AutoOffense.ActionCooldown then
return false
end

if State.OffensePolicy then
local Allowed, Reason = State.OffensePolicy.AllowShot()
State.AutoOffense.PolicyReason = Reason
if not Allowed then
State.AutoOffense.Status = 'LEARNED ' .. tostring(Reason)
return false
end
end

local CanShoot = false
local CanDunk = false
if Distance <= State.AutoOffense.ShootDistance then
CanShoot = State.AutoOffense.CanShoot() == true
end
if Distance <= State.AutoOffense.DunkDistance then
CanDunk = State.AutoOffense.CanDunk() == true
end

if CanShoot and CanDunk then
local Prefer = State.OffensePolicy and State.OffensePolicy.PreferredFinish()
if Prefer == 'dunk' then return State.AutoOffense.PerformDunk() end
if Prefer == 'shoot' then return State.AutoOffense.PerformShoot() end
if math.random() < State.AutoOffense.ShootChance then
return State.AutoOffense.PerformShoot()
end
return State.AutoOffense.PerformDunk()
elseif CanDunk then
return State.AutoOffense.PerformDunk()
elseif CanShoot then
return State.AutoOffense.PerformShoot()
end
return false
end

function State.AutoOffense.UpdateRecenter(Root, Right, Sign, Court)
if not (Root and Right) then return false end
if not Sign or Sign == 0 then Sign = 1 end

local Max = State.AutoOffense.KeepInDistance
local Room = State.AutoOffense.LaneRoom(
Root.Position, Right * Sign, Court, Max,
Sign < 0 and 'recenter-left' or 'recenter-right')
local Opposite = State.AutoOffense.LaneRoom(
Root.Position, Right * -Sign, Court, Max,
Sign < 0 and 'recenter-right' or 'recenter-left')
State.AutoOffense.RecenterSign = Sign
State.AutoOffense.LastRoom = Room
State.AutoOffense.LastOppositeRoom = Opposite

if State.AutoOffense.Recentering then
if Room >= State.AutoOffense.MinLaneRoom + State.AutoOffense.RecenterExit then
State.AutoOffense.Recentering = false
end
elseif Room <= State.AutoOffense.MinLaneRoom then
State.AutoOffense.Recentering = true
end

return State.AutoOffense.Recentering
end

function State.AutoOffense.FaceDirection(Root, Direction, DeltaTime, Rate)
if not (Root and Direction) then return end
if Direction.Magnitude <= 0.001 then return end

local Desired = Direction.Unit
local Current = Vector3.new(
Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
if Current.Magnitude > 0.001
and Current.Unit:Dot(Desired) > 0.99996 then
return
end

local Target = CFrame.lookAt(
Root.Position, Root.Position + Desired, Vector3.yAxis)
local StepTime = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.1)
local Alpha = 1 - math.exp(-(tonumber(Rate) or 26) * StepTime)
Root.CFrame = Root.CFrame:Lerp(Target, Alpha)
end

function State.AutoOffense.StopSmoothMovement(Humanoid)
local Owned = State.Runtime.MovementOwner == 'Offense'
State.Runtime.ReleaseMovement('Offense')
State.AutoOffense.SmoothedMoveDirection = Vector3.zero
State.AutoOffense.LastIssuedDirection = Vector3.zero
if Owned and Humanoid and Humanoid.Parent then Humanoid:Move(Vector3.zero, false) end
end

function State.AutoOffense.GetBoundarySafeDirection(Root, Direction, Court)
if not Root or not Direction or Direction.Magnitude <= 0.001 or not Court then
return Direction, false
end
local Desired = Vector3.new(Direction.X, 0, Direction.Z)
if Desired.Magnitude <= 0.001 then return Direction, false end
Desired = Desired.Unit

local CurrentInside, RecoveryTarget, CurrentClearance, Floor =
State.AutoOffense.GetSafeCourtBounds(Root.Position, Court)
State.AutoOffense.EdgeClearance = CurrentClearance or math.huge
local Center = Floor and Floor.Position
if not Center and State.AutoGetOpen and State.AutoGetOpen.GetAutoGetOpenCourtCenter then
local Ok, Result = pcall(State.AutoGetOpen.GetAutoGetOpenCourtCenter, Court)
if Ok then Center = Result end
end
if not Center then
pcall(function() Center = Court:GetPivot().Position end)
end

local Inward = Center and Vector3.new(
Center.X - Root.Position.X, 0, Center.Z - Root.Position.Z)
or -Desired
if Inward.Magnitude <= 0.001 then Inward = -Desired else Inward = Inward.Unit end
if not CurrentInside then
local Recovery = RecoveryTarget and Vector3.new(
RecoveryTarget.X - Root.Position.X, 0,
RecoveryTarget.Z - Root.Position.Z) or Inward
if Recovery.Magnitude <= 0.05 then Recovery = Inward end
State.AutoOffense.BoundaryStatus = 'RECENTERING'
return Recovery.Unit, true
end

local Velocity = Vector3.new(
Root.AssemblyLinearVelocity.X, 0, Root.AssemblyLinearVelocity.Z)
local LookAhead = 8
local VelocityLook = 0.22
local function Predict(Candidate)
return Root.Position + Candidate * LookAhead + Velocity * VelocityLook
end
local DesiredProbe = Predict(Desired)
local DesiredInside, _, DesiredClearance =
State.AutoOffense.GetSafeCourtBounds(DesiredProbe, Court)
local DesiredOOB = State.AutoOffense.PositionOOB(
DesiredProbe, State.AutoOffense.GetOOBParts(Court))
if DesiredInside and not DesiredOOB and (DesiredClearance or 0) >= 1.5 then
State.AutoOffense.BoundaryStatus = 'CLEAR'
return Desired, false
end

local Tangent = Vector3.new(-Inward.Z, 0, Inward.X)
local Candidates = {
Desired,
(Desired * 0.62 + Inward * 0.38),
(Desired * 0.30 + Inward * 0.70),
Inward,
(Tangent * 0.72 + Inward * 0.28),
(-Tangent * 0.72 + Inward * 0.28),
}
local Best, BestScore = Inward, -math.huge
for _, Candidate in ipairs(Candidates) do
if Candidate.Magnitude > 0.001 then
Candidate = Candidate.Unit
local Probe = Predict(Candidate)
local Inside, _, Clearance = State.AutoOffense.GetSafeCourtBounds(Probe, Court)
local ExplicitOOB = State.AutoOffense.PositionOOB(
Probe, State.AutoOffense.GetOOBParts(Court))
local Score = (Inside and not ExplicitOOB) and 100 or -100
Score += math.clamp(tonumber(Clearance) or -30, -30, 30) * 3
Score += Candidate:Dot(Desired) * 6
Score += Candidate:Dot(Inward) * 2
if Score > BestScore then Best, BestScore = Candidate, Score end
end
end
State.AutoOffense.BoundaryStatus = 'EDGE GUARD'
return Best, true
end

function State.AutoOffense.MoveSmooth(
Humanoid, Root, Direction, DeltaTime, Court)
if not Humanoid or not Root or not Direction or Direction.Magnitude <= 0.001 then
State.AutoOffense.StopSmoothMovement(Humanoid)
return Vector3.zero, false
end
local Target, Avoiding = State.AutoOffense.GetBoundarySafeDirection(
Root, Direction, Court)
if not Target or Target.Magnitude <= 0.001 then
State.AutoOffense.StopSmoothMovement(Humanoid)
return Vector3.zero, true
end
Target = Target.Unit
local Current = State.AutoOffense.SmoothedMoveDirection or Vector3.zero
local Step = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.1)
local Response = 14
local Alpha = 1 - math.exp(-Response * Step)
if Avoiding then Alpha = math.max(Alpha, 0.55) end
local Smoothed = Current:Lerp(Target, Alpha)
if Smoothed.Magnitude > 1 then Smoothed = Smoothed.Unit end
-- Re-check the blended vector so smoothing inertia cannot carry an old outward
-- direction through the safety inset while the new target points inward.
local FinalSafe, FinalAvoiding = State.AutoOffense.GetBoundarySafeDirection(
Root, Smoothed, Court)
if FinalAvoiding and FinalSafe and FinalSafe.Magnitude > 0.001 then
local Speed = math.clamp(Smoothed.Magnitude, 0.35, 1)
Smoothed = FinalSafe.Unit * Speed
Avoiding = true
end
State.AutoOffense.SmoothedMoveDirection = Smoothed
if State.Runtime.AcquireMovement('Offense') then
Humanoid:Move(Smoothed, false)
State.AutoOffense.LastIssuedDirection = Smoothed
end
return Smoothed, Avoiding
end

function State.AutoOffense.LaneOpen(Root, DefenderRoot, Forward, Court, Rim)
if not (Root and Forward) then return false end

local Room = State.AutoOffense.LaneRoom(
Root.Position, Forward, Court, State.AutoOffense.DriveForwardRoom,
'drive-forward')
if Room < State.AutoOffense.DriveForwardRoom then return false end

if DefenderRoot then
local Offset = DefenderRoot.Position - Root.Position
local Flat = Vector3.new(Offset.X, 0, Offset.Z)
local Distance = Flat.Magnitude
if Distance < 0.05 then return false end
if Distance <= State.AutoOffense.DriveLaneDistance
and Flat.Unit:Dot(Forward) >= State.AutoOffense.DriveLaneDot then
return false
end
end

if State.AutoOffense.DriveRequireLaneCheck and Rim then
local Ok, Open = pcall(State.AutoDunk.LaneOpen, Root, Rim)
if Ok and Open == false then return false end
end

return true
end

function State.AutoOffense.DefenderIsRisk(
Root, DefenderRoot, BallThreat, BallClearance, DefenderDistance)
if BallThreat then return true end
if not (Root and DefenderRoot) then return false end

if (tonumber(DefenderDistance) or math.huge)
< State.AutoOffense.DriveSafeDefenderDistance then
return true
end
if (tonumber(BallClearance) or math.huge)
< State.AutoOffense.DriveSafeClearance then
return true
end

local Offset = DefenderRoot.Position - Root.Position
local Flat = Vector3.new(Offset.X, 0, Offset.Z)
if Flat.Magnitude < 0.05 then return true end

local Ok, Velocity = pcall(function()
return DefenderRoot.AssemblyLinearVelocity
end)
if Ok and typeof(Velocity) == 'Vector3' then
local Closing = Vector3.new(Velocity.X, 0, Velocity.Z):Dot(-Flat.Unit)
if Closing >= State.AutoOffense.DriveSafeClosingSpeed then return true end
end

return false
end

function State.AutoOffense.UpdateDriveState(
Root, DefenderRoot, Forward, Court, Rim, TurnAround,
BallThreat, BallClearance, DefenderDistance)
local Now = os.clock()

local Risk = State.AutoOffense.DefenderIsRisk(
Root, DefenderRoot, BallThreat, BallClearance, DefenderDistance)
local Open = (not Risk) and (not TurnAround)
and State.AutoOffense.LaneOpen(Root, DefenderRoot, Forward, Court, Rim)

if State.AutoOffense.DriveActive then
if Open then
State.AutoOffense.DriveUntil = Now + State.AutoOffense.DriveMinHold
State.AutoOffense.DriveStatus = 'DRIVE'
return true
end
if not Risk and Now < State.AutoOffense.DriveUntil then
State.AutoOffense.DriveStatus = 'DRIVE HOLD'
return true
end
State.AutoOffense.DriveActive = false
State.AutoOffense.BodyingSince = Now
end

if State.AutoOffense.BodyingSince <= 0 then
State.AutoOffense.BodyingSince = Now
end

if Risk or TurnAround then
State.AutoOffense.BodyingSince = Now
State.AutoOffense.DriveStatus = TurnAround and 'BODY CUTOFF' or 'BODY RISK'
return false
end

if not Open then
State.AutoOffense.DriveStatus = 'BODY NO LANE'
return false
end

local Bodied = Now - State.AutoOffense.BodyingSince
if Bodied < State.AutoOffense.DriveBodyMinTime then
State.AutoOffense.DriveStatus = string.format('BODY %.2fs', Bodied)
return false
end

State.AutoOffense.DriveActive = true
State.AutoOffense.DriveUntil = Now + State.AutoOffense.DriveMinHold
State.AutoOffense.DriveStatus = 'DRIVE'
return true
end

