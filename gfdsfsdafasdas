State.AutoOffense.ApplyMode(Mode)
State.AutoOffense.LastAction = 0
if HubUI.Sync then HubUI.Sync() end
end

function State.AutoOffense.SetEnabled(Enabled, ShouldNotify)
if not State.Active then return end
Enabled = Enabled == true
if State.AutoOffense.Enabled == Enabled then return end

State.AutoOffense.Enabled = Enabled
CONFIG.AutoOffense = Enabled
State.AutoOffense.LastAction = 0
State.AutoOffense.LastLineAttempt = 0
State.AutoOffense.LineShotDistance = math.huge
State.AutoOffense.HadBall = false
State.AutoOffense.PossessionAt = 0
State.AutoOffense.InboundActive = false
State.AutoOffense.InboundStartPosition = nil
State.AutoOffense.InboundTarget = nil
State.AutoOffense.SmoothedMoveDirection = Vector3.zero
if not Enabled then State.AutoOffense.ClearPathVisual() end
State.AutoOffense.Generation += 1
State.AutoOffense.InProgress = false
State.AutoOffense.ActionType = nil

if Enabled then
if State.AutoDunkEnabled then State.AutoDunk.SetEnabled(false, false) end
if State.AutoBody.Enabled then State.AutoBody.SetEnabled(false) end
State.AutoOffense.ResetMovement(LP.Character and LP.Character:FindFirstChildOfClass('Humanoid'))

State.AutoOffense.OriginalAimTargetMode = CONFIG.AimTargetMode
CONFIG.AimTargetMode = 'Scoring Goal'
if not State.RequestedEnabled then SetSilentAimEnabled(true, false) end
State.AutoOffense.Status = 'STARTING'
else
if State.AutoOffense.OriginalAimTargetMode then
CONFIG.AimTargetMode = State.AutoOffense.OriginalAimTargetMode
State.AutoOffense.OriginalAimTargetMode = nil
end
end

State.AutoOffense.UpdateBinding()
if HubUI.Sync then HubUI.Sync() end
if ShouldNotify and Enabled then
Notify('SILVER SURFER', 'Auto Offense enabled')
end
end

