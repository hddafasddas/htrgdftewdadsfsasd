Bottom:SetAttribute(State.BallStudio.Tag, 'Trail')
Bottom.Parent = Ball
local Trail = Instance.new('Trail')
Trail.Name = 'SilverSurferTrail'
Trail.Attachment0 = Top
Trail.Attachment1 = Bottom
Trail.Enabled = false
Trail:SetAttribute(State.BallStudio.Tag, 'Trail')
Trail.Parent = Ball
Made = Trail
end)
