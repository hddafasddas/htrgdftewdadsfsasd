local Busy = State.silentShootActive == true
or (State.NoJump and State.NoJump.Active == true)
or (State.ClickShoot and State.ClickShoot.Armed == true)
local Pending = State.PerfectRelease and State.PerfectRelease.Pending
if Pending and Now - (Pending.At or 0) <= 0.55 then Busy = true end

local ShootKey = State.AutoMix.RawKey('Shoot_ball')
if ShootKey then
pcall(function()
if UserInputService:IsKeyDown(ShootKey)
or UserInputService:IsGamepadButtonDown(
Enum.UserInputType.Gamepad1, ShootKey)
or UserInputService:IsGamepadButtonDown(
Enum.UserInputType.Gamepad2, ShootKey) then
Busy = true
end
end)
end

if Character and safe_find(Character, 'Basketball') and HumanoidObject then
local HumanoidState = HumanoidObject:GetState()
if HumanoidState == Enum.HumanoidStateType.Jumping
or HumanoidState == Enum.HumanoidStateType.Freefall then
Busy = true
end
end

if Busy then
State.AutoMix.ShotLockUntil = Now
+ math.max(0.15, tonumber(CONFIG.AutoMixShotPauseTime) or 0.65)
return true
end
return Now < (State.AutoMix.ShotLockUntil or 0)
end

