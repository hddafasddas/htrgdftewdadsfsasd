local TheirSide = TheirCourt and ResolvePlayerCourtTeam(Player, TheirCourt, TheirSlotName, TheirSlot) or nil
if Side and TheirSide and Side == TheirSide then table.insert(Teammates, Player) else table.insert(Opponents, Player) end
end
end
