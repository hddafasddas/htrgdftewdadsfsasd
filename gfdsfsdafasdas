State.AutoGetOpenPracticeGoal = Goal
return Goal
end

function State.AutoGetOpen.KeepAutoGetOpenOnOffensiveHalf(Context, Position)
local Relative = Position - Context.Center
local Depth = Relative:Dot(Context.ToOffense)
local MinimumDepth = CONFIG.AutoGetOpenFrontcourtDepth
if Depth >= MinimumDepth then return Position end
local Lateral = Relative:Dot(Context.Right)
return Context.Center + Context.ToOffense * MinimumDepth + Context.Right * Lateral
end

function State.AutoGetOpen.ClampAutoGetOpenToGoalRange(Context, Position)
local GoalPosition = Context.Goal.Position
local FromGoal = Vector3.new(
Position.X - GoalPosition.X, 0, Position.Z - GoalPosition.Z)
if FromGoal.Magnitude < 0.01 then
FromGoal = -Context.ToOffense
else
FromGoal = FromGoal.Unit
end
local CurrentDistance = Vector3.new(
Position.X - GoalPosition.X, 0, Position.Z - GoalPosition.Z).Magnitude
local GoalDistance = math.clamp(
CurrentDistance,
CONFIG.AutoGetOpenMinimumGoalDistance,
CONFIG.AutoGetOpenMaximumGoalDistance
)
return Vector3.new(
GoalPosition.X + FromGoal.X * GoalDistance,
Position.Y,
GoalPosition.Z + FromGoal.Z * GoalDistance
)
end

