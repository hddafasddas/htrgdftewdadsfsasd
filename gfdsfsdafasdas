end

function State.AutoMix.ClassifyDefender(Relative)
local Flat = Vector3.new(Relative.X, 0, Relative.Z)
if Flat.Magnitude < 0.05 then return 'OVERLAP', 0, 0 end
local FrontDot = -Flat.Z / Flat.Magnitude
local SideDot = Flat.X / Flat.Magnitude
if FrontDot <= -0.55 then return 'REAR', FrontDot, SideDot end
if FrontDot >= 0.55 then
if math.abs(SideDot) < 0.25 then return 'FRONT', FrontDot, SideDot end
return SideDot > 0 and 'FRONT RIGHT' or 'FRONT LEFT', FrontDot, SideDot
end
return SideDot > 0 and 'RIGHT' or 'LEFT', FrontDot, SideDot
end

function State.AutoMix.GetRearClearance(Root, Threat)
if not Root or not Threat then return math.huge end
local Minimum = math.huge
local Roots = Threat.DefenderRoots and #Threat.DefenderRoots > 0
and Threat.DefenderRoots or { Threat.Root }
for _, DefenderRoot in ipairs(Roots) do
if DefenderRoot and DefenderRoot.Parent then
local LocalPosition = Root.CFrame:PointToObjectSpace(DefenderRoot.Position)
if LocalPosition.Z > 0.25 then
local Distance = Vector2.new(LocalPosition.X, LocalPosition.Z).Magnitude
Minimum = math.min(Minimum, Distance)
end
end
end
return Minimum
end

function State.AutoMix.IsMoveAllowed(Name, Root, Threat)
local Move = State.AutoMix.Moves[Name]
if not Move or not Threat then return false, 'INVALID MOVE' end
if not Move.RearArc or not CONFIG.AutoMixRearSpinBlock then return true end
local RearClearance = Threat.RearClearance
or State.AutoMix.GetRearClearance(Root, Threat)
if Threat.Sector == 'REAR' then return false, 'DEFENDER BEHIND' end
if RearClearance < 7 then return false, 'REAR PATH BLOCKED' end
return true
end

function State.AutoMix.EvaluateBallSafety(Name, Root, Hand, Threat)
local Move = State.AutoMix.Moves[Name]
if not Move or not Threat or not Threat.Root then return -math.huge, 0, Hand end
local Key = State.AutoMix.ResolveKey(Move.Action)
if not Key then return -math.huge, 0, Hand end
if (State.AutoMix.MoveCooldownUntil[Name] or 0) > os.clock() then
return -math.huge, 0, Hand
end
local Allowed = State.AutoMix.IsMoveAllowed(Name, Root, Threat)
if not Allowed then return -math.huge, 0, Hand end

local Duration = Move.Timeout or 0.42
local Margin = math.max(1.5, tonumber(CONFIG.AutoMixBallSafetyMargin) or 3)
local MinimumClearance, EndClearance = math.huge, 0
local DefenderRoots = Threat.DefenderRoots and #Threat.DefenderRoots > 0
and Threat.DefenderRoots or { Threat.Root }
local Path = State.AutoMix.GetMovePath(Name, Hand)
for Index, Point in ipairs(Path) do
local T, X, Z = Point[1], Point[2], Point[3]
local BallWorld = Root.CFrame:PointToWorldSpace(Vector3.new(X, 0, Z))
local PointClearance = math.huge
for _, DefenderRoot in ipairs(DefenderRoots) do
if DefenderRoot and DefenderRoot.Parent then
local RelativeVelocity = DefenderRoot.AssemblyLinearVelocity
- Root.AssemblyLinearVelocity
local PredictedDefender = DefenderRoot.Position
+ RelativeVelocity * (T * Duration)
local Offset = Vector3.new(
BallWorld.X - PredictedDefender.X, 0,
BallWorld.Z - PredictedDefender.Z)
PointClearance = math.min(PointClearance, Offset.Magnitude - Margin)
end
end
MinimumClearance = math.min(MinimumClearance, PointClearance)
if Index == #Path then EndClearance = PointClearance end
end

local ExpectedHand = State.AutoMix.GetExpectedHand(Name, Hand)
local Score = MinimumClearance * 2.5 + EndClearance * 1.15
- Duration * 0.75
local RearClearance = Threat.RearClearance or math.huge
local FrontThreat = (Threat.FrontDot or 0) > 0.05

-- Hand-side scoring matters only for front/side defenders. A trailing defender
-- should not make the mixer throw the ball behind the player's body.
if Threat.Sector ~= 'REAR' then
if ExpectedHand ~= Threat.Side then Score += 2.2 else Score -= 2.3 end
end
if State.AutoMix.LastMoveName == Name then Score -= 3.4 end

if Threat.Level == 'EMERGENCY' then
if Name == 'SwitchHandles' then Score += 1.25 end
if Name == 'FakeOut' then Score += 0.9 end
if Move.RearArc and FrontThreat and RearClearance >= 7 then Score += 0.55 end
end

local Defense = Threat.DefenseType
if Defense == 'REACH' then
if Name == 'SwitchHandles' then Score += 1.8 end
if Name == 'FakeOut' then Score += 1.2 end
if Name == 'CrossUp' and FrontThreat then Score += 0.35 end
if Move.RearArc and FrontThreat and RearClearance >= 7 then Score += 0.5 end
elseif Defense == 'REAR REACH' then
if Name == 'SwitchHandles' then Score += 2.1 end
if Name == 'FakeOut' then Score += 1.4 end
if Name == 'CrossUp' then Score += 0.2 end
elseif Defense == 'HARD CLOSE' then
if Name == 'FakeOut' then Score += 1.3 end
if Name == 'SwitchHandles' then Score += 0.9 end
if Name == 'CrossUp' then Score += 0.7 end
if Move.RearArc and FrontThreat and RearClearance >= 7 then Score += 0.45 end
elseif Defense == 'CONTAIN MIDDLE' then
if Name == 'FakeOut' then Score += 1.1 end
if Name == 'CrossUp' then Score += 0.7 end
elseif Defense == 'DOUBLE TEAM' then
if Name == 'SwitchHandles' then Score += 1.0 end
if Name == 'FakeOut' then Score += 0.8 end
elseif Defense == 'CUT LEFT' then
if ExpectedHand == 'R' then Score += 1.1 end
elseif Defense == 'CUT RIGHT' then
if ExpectedHand == 'L' then Score += 1.1 end
end

if CONFIG.AutoMixAdaptive and Threat.Profile then
local Profile = Threat.Profile
if Profile.Reach >= 2 then
if Name == 'SwitchHandles' or Name == 'FakeOut' then Score += 0.65 end
if Move.RearArc and FrontThreat and RearClearance >= 7 then Score += 0.25 end
if Name == 'CrossUp' then Score -= 0.3 end
end
if Profile.CutLeft - Profile.CutRight >= 2 and ExpectedHand == 'R' then
Score += 0.8
end
if Profile.CutRight - Profile.CutLeft >= 2 and ExpectedHand == 'L' then
Score += 0.8
end
end

local LastUsed = State.AutoMix.MoveLastUsed[Name] or 0
if CONFIG.AutoMixMoveVariety then
Score += math.clamp((os.clock() - LastUsed) / 9, 0, 1.4)
end
return Score, MinimumClearance, ExpectedHand, EndClearance
end

function State.AutoMix.ChooseSafestMove(Root, Hand, Threat)
local Candidates = { 'BehindLeft','BehindRight','CrossUp','FakeBehindLeft','FakeBehindRight','FakeOut','SwitchHandles' }
local Ranked = {}
State.AutoMix.MoveScores = {}
for _, Name in ipairs(Candidates) do
local Score, Clearance, EndHand, EndClearance = State.AutoMix.EvaluateBallSafety(Name, Root, Hand, Threat)
State.AutoMix.MoveScores[Name] = Score
if Score > -math.huge then table.insert(Ranked, { Name=Name, Score=Score, Clearance=Clearance, EndHand=EndHand, EndClearance=EndClearance }) end
end
table.sort(Ranked, function(A,B) return A.Score > B.Score end)
if #Ranked == 0 then return nil end
local Choice = Ranked[1]
-- Variety is allowed only inside the near-best safety tier, so it never picks
-- a clearly exposed animation just to cycle moves.
if CONFIG.AutoMixMoveVariety then
local SafeTier = {}
for _, Item in ipairs(Ranked) do if Item.Score >= Ranked[1].Score - 1.25 then table.insert(SafeTier, Item) end end
table.sort(SafeTier, function(A,B)
return (State.AutoMix.MoveLastUsed[A.Name] or 0) < (State.AutoMix.MoveLastUsed[B.Name] or 0)
end)
Choice = SafeTier[1] or Choice
end
State.AutoMix.PredictedBallClearance = Choice.Clearance
State.AutoMix.PredictedBallEndClearance = Choice.EndClearance or Choice.Clearance
State.AutoMix.PredictedBallSide = Choice.EndHand
State.AutoMix.SafestMove = Choice.Name
return Choice.Name
end

function State.AutoMix.RawKey(Action)
local Value
local Controls = safe_find(LP, 'Controls1')
if Controls then pcall(function() Value = safe_get_attribute(Controls, Action) end) end
if Value == nil then
local PlayerData = State.ClientSettings.PlayerData
if PlayerData and type(PlayerData.Get) == 'function' then
pcall(function() Value = PlayerData.Get('Controls_Keyboard', Action) end)
end
end
if typeof(Value) == 'EnumItem' then return Value end
if type(Value) ~= 'string' or Value == '' then return nil end
Value = Value:gsub('Enum%.KeyCode%.', '')
local Ok, Key = pcall(function() return Enum.KeyCode[Value] end)
return Ok and Key or nil
end

function State.AutoMix.GetKeyConflict(Action, Key)
if not Key then return 'UNBOUND' end
local Token = 'KC:' .. Key.Name
local Manager = HubUI and HubUI.KeybindManager
if Manager and Manager.Ordered then
for _, Entry in ipairs(Manager.Ordered) do
if Entry.Id ~= 'AutoMix' and Entry.Key == Token then
return 'HUB: ' .. tostring(Entry.Label or Entry.Id)
end
end
end
local Controls = safe_find(LP, 'Controls1')
if Controls then
local Ok, Attributes = pcall(function() return Controls:GetAttributes() end)
if Ok and type(Attributes) == 'table' then
for OtherAction, Value in pairs(Attributes) do
if OtherAction ~= Action then
local Name = typeof(Value) == 'EnumItem' and Value.Name
or tostring(Value or ''):gsub('Enum%.KeyCode%.', '')
if Name == Key.Name then return 'GAME: ' .. tostring(OtherAction) end
end
end
end
end
local PlayerData = State.ClientSettings.PlayerData
if PlayerData and type(PlayerData.Get) == 'function' then
for _, OtherAction in ipairs(State.AutoMix.ProtectedGameActions) do
if OtherAction ~= Action then
local OtherValue
pcall(function() OtherValue = PlayerData.Get('Controls_Keyboard', OtherAction) end)
local OtherName = typeof(OtherValue) == 'EnumItem' and OtherValue.Name
or tostring(OtherValue or ''):gsub('Enum%.KeyCode%.', '')
if OtherName == Key.Name then return 'GAME: ' .. OtherAction end
end
end
end
return nil
end

function State.AutoMix.ResolveKey(Action)
local Key = State.AutoMix.RawKey(Action)
local Conflict = State.AutoMix.GetKeyConflict(Action, Key)
return Conflict and nil or Key, Conflict
end

function State.AutoMix.IsShotBusy(Character, HumanoidObject, Root)
