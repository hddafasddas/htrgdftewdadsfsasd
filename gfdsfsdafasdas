        offenseLocalRadius = 6,

        -- Ball security and defender reading.
        offenseProtect = true,
        offenseStealRadius = 6.75,
        offenseProtectWeight = 1.2,
        offenseReadWeight = 1.0,
        offensePredict = 0.28,
