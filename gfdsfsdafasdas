function State.AutoGetOpen.GetAutoGetOpenContext()
local Character = LP.Character
local Root = Character and safe_find(Character, 'HumanoidRootPart')
local LocalHumanoid = Character and safe_find(Character, 'Humanoid')
if not Root or not LocalHumanoid or LocalHumanoid.Health <= 0 then
return nil, 'NO CHARACTER'
end
if Character:FindFirstChild('Basketball') then return nil, 'YOU HAVE BALL' end

local Court, SlotName, Slot = ResolvePlayerCourt(LP)
local IsPractice = false
if not Court then
local PracticeCourt, PracticeDistance =
FindNearestPracticeCourtFromPosition(Root.Position)
if PracticeCourt and PracticeDistance <= 150 then
Court = PracticeCourt
IsPractice = true
end
end
if not Court and IsArenaMode then Court = safe_find(Workspace, 'Court') end
if not Court then return nil, 'NO COURT' end
local GameSize = State.AutoGetOpen.GetAutoGetOpenGameSize(Court)
if not IsArenaMode and not IsPractice then
if GameSize == 1 then return nil, 'DISABLED IN 1S' end
if not GameSize or GameSize < 2 or GameSize > 4 then return nil, '2S-4S ONLY' end
end

local MyTeam = ResolvePlayerCourtTeam(LP, Court, SlotName, Slot)
if not MyTeam and not IsPractice then return nil, 'NO TEAM' end
local Goal = IsPractice
and State.AutoGetOpen.GetPracticeGetOpenGoal(Court, Root.Position)
or FindPlayerScoringGoal(LP)
local Center = State.AutoGetOpen.GetAutoGetOpenCourtCenter(Court)
if not Goal or not Center then return nil, 'COURT LANDMARKS MISSING' end
local GoalOffset = Vector3.new(
Root.Position.X - Goal.Position.X, 0, Root.Position.Z - Goal.Position.Z)
local GoalDistance = GoalOffset.Magnitude
local ToOffense = Vector3.new(Goal.Position.X - Center.X, 0, Goal.Position.Z - Center.Z)
if ToOffense.Magnitude < 0.01 then return nil, 'INVALID COURT AXIS' end
ToOffense = ToOffense.Unit
local Right = Vector3.new(-ToOffense.Z, 0, ToOffense.X)

local Teammates, Opponents = State.AutoGetOpen.GetAutoGetOpenRoster(
Court, MyTeam, IsPractice)
local BallHandler = State.AutoGetOpen.GetAutoGetOpenBallHandler(Teammates, Court)
local TeamHasBall = BallHandler ~= nil
if not BallHandler and CONFIG.AutoGetOpenAlwaysActive then
BallHandler = State.AutoGetOpen.GetAnyBallHandler(Court, Teammates, Opponents)
end
local BallHandlerRoot = GetPlayerRoot(BallHandler)
local BallPosition, BallVelocity = State.AutoGetOpen.GetAutoGetOpenBallPosition(
Court, BallHandler)
-- Never nil. Downstream scoring reads this instead of a possibly absent
-- ball-handler root, so a loose or opponent-held ball cannot stall us.
local BallAnchor = BallPosition
or (BallHandlerRoot and BallHandlerRoot.Position)
or Vector3.new(Center.X, Root.Position.Y, Center.Z)

-- Where each teammate will BE, not just where they are. Built once per frame
-- because scoring runs for every candidate spot and must stay cheap.
local TeammateCuts = {}
if CONFIG.AutoGetOpenTeammateAwareness then
local Horizon = CONFIG.AutoGetOpenTeammateCutHorizon
for _, Teammate in ipairs(Teammates) do
if Teammate ~= LP and Teammate ~= BallHandler then
local MateRoot = GetPlayerRoot(Teammate)
if MateRoot then
local MateVelocity = MateRoot.AssemblyLinearVelocity
local FlatMate = Vector3.new(MateVelocity.X, 0, MateVelocity.Z)
local MateSpeed = FlatMate.Magnitude
local MateRelative = MateRoot.Position - Center
TeammateCuts[#TeammateCuts + 1] = {
Position = MateRoot.Position,
Destination = MateRoot.Position + FlatMate * Horizon,
Direction = MateSpeed > 0.01 and FlatMate.Unit or nil,
Speed = MateSpeed,
Lateral = MateRelative:Dot(Right),
Depth = MateRelative:Dot(ToOffense),
}
end
end
end
end

return {
Character = Character,
Root = Root,
Humanoid = LocalHumanoid,
TeammateCuts = TeammateCuts,
Court = Court,
IsPractice = IsPractice,
Center = Vector3.new(Center.X, Root.Position.Y, Center.Z),
Goal = Goal,
GoalDistance = GoalDistance,
ToOffense = ToOffense,
Right = Right,
Teammates = Teammates,
Opponents = Opponents,
BallHandler = BallHandler,
BallHandlerRoot = BallHandlerRoot,
BallAnchor = BallAnchor,
TeamHasBall = TeamHasBall,
BallPosition = BallPosition,
BallVelocity = BallVelocity,
}, nil
end

function State.AutoGetOpen.GetNearestGetOpenDefender(Context)
local ClosestPlayer, ClosestPosition, ClosestDistance
for _, Opponent in ipairs(Context.Opponents) do
local Position = State.AutoGetOpen.GetPredictedPlayerPosition(
Opponent, Context.Root.Position)
if Position then
local Distance = (Position - Context.Root.Position).Magnitude
if not ClosestDistance or Distance < ClosestDistance then
ClosestPlayer, ClosestPosition, ClosestDistance = Opponent, Position, Distance
end
end
end
return ClosestPlayer, ClosestPosition, ClosestDistance or 40
end

function State.AutoGetOpen.ScoreGetOpenPosition(Context, Position)
local DefenderSpace = 40
local PassingLane = 40
local RunLane = 40
local DefenderReadPenalty = 0
local DefenderFacingAwayBonus = 0
local DefenderHoopLeveragePenalty = 0
local PassOrigin = Context.BallPosition or Context.BallAnchor
for _, Opponent in ipairs(Context.Opponents) do
local Predicted = State.AutoGetOpen.GetPredictedPlayerPosition(Opponent, Position)
if Predicted then
DefenderSpace = math.min(DefenderSpace, (Predicted - Position).Magnitude)
PassingLane = math.min(PassingLane,
State.AutoGetOpen.DistanceToSegmentXZ(Predicted, PassOrigin, Position))
RunLane = math.min(RunLane,
State.AutoGetOpen.DistanceToSegmentXZ(Predicted, Context.Root.Position, Position))

local OpponentRoot = GetPlayerRoot(Opponent)
if OpponentRoot then
local ToCandidate = Vector3.new(
Position.X - OpponentRoot.Position.X, 0,
Position.Z - OpponentRoot.Position.Z)
local OpponentFacing = Vector3.new(
OpponentRoot.CFrame.LookVector.X, 0,
OpponentRoot.CFrame.LookVector.Z)
if ToCandidate.Magnitude > 0.01 and OpponentFacing.Magnitude > 0.01 then
local ReadDot = OpponentFacing.Unit:Dot(ToCandidate.Unit)
DefenderReadPenalty = math.max(DefenderReadPenalty,
math.max(ReadDot, 0) * 5.5)
DefenderFacingAwayBonus = math.max(DefenderFacingAwayBonus,
math.max(-ReadDot, 0) * 3.5)
end

local CandidateGoalDistance = Vector3.new(
Position.X - Context.Goal.Position.X, 0,
Position.Z - Context.Goal.Position.Z).Magnitude
local OpponentGoalDistance = Vector3.new(
OpponentRoot.Position.X - Context.Goal.Position.X, 0,
OpponentRoot.Position.Z - Context.Goal.Position.Z).Magnitude
DefenderHoopLeveragePenalty = math.max(
DefenderHoopLeveragePenalty,
math.max(0, CandidateGoalDistance - OpponentGoalDistance) * 0.42)
end
end
end

local TeammateSpacing = 40
local TeammateRunLane = 40
for _, Teammate in ipairs(Context.Teammates) do
if Teammate ~= Context.BallHandler then
local TeammatePosition = State.AutoGetOpen.GetPredictedTeammatePosition(Teammate)
if TeammatePosition then
TeammateSpacing = math.min(TeammateSpacing,
(TeammatePosition - Position).Magnitude)
TeammateRunLane = math.min(TeammateRunLane,
State.AutoGetOpen.DistanceToSegmentXZ(
TeammatePosition, Context.Root.Position, Position))
end
end
end

-- Teammate awareness: avoid spots a teammate is already heading to, avoid
-- doubling up in the same side/depth zone, and avoid running into their cut.
local CutOverlapPenalty = 0
local ClaimedZonePenalty = 0
local ConvergencePenalty = 0
local CutClearance = 40
if CONFIG.AutoGetOpenTeammateAwareness and Context.TeammateCuts then
local ZoneRelative = Position - Context.Center
local ZoneLateral = ZoneRelative:Dot(Context.Right)
local ZoneDepth = ZoneRelative:Dot(Context.ToOffense)
for _, Cut in ipairs(Context.TeammateCuts) do
local ToSpot = Vector3.new(
Position.X - Cut.Destination.X, 0, Position.Z - Cut.Destination.Z)
local SpotDistance = ToSpot.Magnitude
if SpotDistance < CutClearance then CutClearance = SpotDistance end
CutOverlapPenalty = math.max(CutOverlapPenalty,
math.max(0, CONFIG.AutoGetOpenCutOverlapRadius - SpotDistance)
* CONFIG.AutoGetOpenCutOverlapWeight)

if Cut.Lateral * ZoneLateral > 0
and math.abs(Cut.Depth - ZoneDepth) <= CONFIG.AutoGetOpenZoneDepthBand
and math.abs(Cut.Lateral - ZoneLateral)
<= CONFIG.AutoGetOpenZoneWidthBand then
ClaimedZonePenalty = math.max(ClaimedZonePenalty,
CONFIG.AutoGetOpenSameZonePenalty)
end

if Cut.Direction
and Cut.Speed >= CONFIG.AutoGetOpenMinimumTeammateSpeed then
local ToCandidate = Vector3.new(
Position.X - Cut.Position.X, 0, Position.Z - Cut.Position.Z)
if ToCandidate.Magnitude > 0.01 then
local Alignment = Cut.Direction:Dot(ToCandidate.Unit)
if Alignment > 0.55 then
ConvergencePenalty = math.max(ConvergencePenalty,
Alignment * Cut.Speed * CONFIG.AutoGetOpenConvergeWeight)
end
end
end
end
end

local TravelDistance = (Position - Context.Root.Position).Magnitude
local PassDistance = (Position - PassOrigin).Magnitude
local _, _, EdgeClearance = State.AutoGetOpen.GetAutoGetOpenBounds(
Context.Court, Position, Context.Root.Position.Y)
local PGSpacingBonus = math.min(PassDistance, CONFIG.AutoGetOpenPreferredPGSpacing) * 1.35
local TooCloseToPGPenalty = math.max(
0, CONFIG.AutoGetOpenMinimumPGSpacing - PassDistance) * 5
local PositionDepth = (Position - Context.Center):Dot(Context.ToOffense)
local HandlerDepth = (Context.BallAnchor - Context.Center):Dot(Context.ToOffense)
local AheadMargin = PositionDepth - HandlerDepth
local BehindPGPenalty = math.max(
0, CONFIG.AutoGetOpenAheadOfPGDistance - AheadMargin) * 8
local AheadPGBonus = math.clamp(AheadMargin, 0, 10) * 1.2
local BallVelocity = Context.BallVelocity or Vector3.zero
local BallFlowBonus = 0
if BallVelocity.Magnitude > 1 then
local BallToCandidate = Vector3.new(
Position.X - PassOrigin.X, 0, Position.Z - PassOrigin.Z)
if BallToCandidate.Magnitude > 0.01 then
BallFlowBonus = BallVelocity.Unit:Dot(BallToCandidate.Unit) * 3
end
end
local Score = math.min(DefenderSpace, 20) * 4.1
+ math.min(PassingLane, 16) * 3.25
+ math.min(RunLane, 10) * 1.1
+ math.min(TeammateSpacing, 16) * 1.55
+ math.min(TeammateRunLane, 10) * 1.7
+ PGSpacingBonus
+ AheadPGBonus
+ BallFlowBonus
+ DefenderFacingAwayBonus
- DefenderReadPenalty
- DefenderHoopLeveragePenalty
- TooCloseToPGPenalty
- BehindPGPenalty
- math.max(0, CONFIG.AutoGetOpenMinimumSpacing - TeammateSpacing) * 8
- math.max(0, CONFIG.AutoGetOpenTeammateLane - TeammateRunLane) * 7
- math.max(0, CONFIG.AutoGetOpenOpponentLane - RunLane) * 5
- TravelDistance * 0.34
- math.max(0, PassDistance - 42) * 0.7
+ math.clamp(EdgeClearance, -12, 10) * 1.35
+ math.min(CutClearance, 14) * 1.25
- CutOverlapPenalty
- ClaimedZonePenalty
- ConvergencePenalty

local Open = DefenderSpace >= CONFIG.AutoGetOpenWideOpenDefenderSpace
and PassingLane >= CONFIG.AutoGetOpenMinimumLane
and TeammateSpacing >= CONFIG.AutoGetOpenMinimumSpacing
and TeammateRunLane >= CONFIG.AutoGetOpenTeammateLane
and RunLane >= CONFIG.AutoGetOpenOpponentLane
and PassDistance >= CONFIG.AutoGetOpenMinimumPGSpacing
and AheadMargin >= CONFIG.AutoGetOpenAheadOfPGDistance
and ClaimedZonePenalty <= 0
and CutClearance >= CONFIG.AutoGetOpenCutOverlapRadius * 0.75
return Score, DefenderSpace, PassingLane, TeammateSpacing, RunLane, Open,
EdgeClearance, TravelDistance, TeammateRunLane, CutClearance
end

function State.AutoGetOpen.GetCutAxis(Context)
local Axis = Context.Right
local Camera = Workspace.CurrentCamera
if Camera then
local CameraRight = Vector3.new(
Camera.CFrame.RightVector.X, 0, Camera.CFrame.RightVector.Z)
if CameraRight.Magnitude > 0.01 then
CameraRight = CameraRight.Unit
if CameraRight:Dot(Context.Right) < 0 then CameraRight = -CameraRight end
Axis = (Context.Right * 0.35 + CameraRight * 0.65)
if Axis.Magnitude > 0.01 then Axis = Axis.Unit else Axis = Context.Right end
end
end
return Axis
end

function State.AutoGetOpen.ClampToPGBand(Context, Position)
local HandlerDepth = (Context.BallAnchor - Context.Center):Dot(Context.ToOffense)
local Relative = Position - Context.Center
local Lateral = Relative:Dot(Context.Right)
local Depth = Relative:Dot(Context.ToOffense)
local MinimumDepth = math.max(
CONFIG.AutoGetOpenFrontcourtDepth,
HandlerDepth + CONFIG.AutoGetOpenAheadOfPGDistance)
local MaximumDepth = math.max(MinimumDepth + 0.5,
HandlerDepth + CONFIG.AutoGetOpenLeadPGDistance)
Depth = math.clamp(Depth, MinimumDepth, MaximumDepth)
return Context.Center + Context.ToOffense * Depth + Context.Right * Lateral
end

function State.AutoGetOpen.GetCourtLateralHalfWidth(Context)
local Floor = State.AutoGetOpen.GetAutoGetOpenFloor(Context.Court)
if not Floor then return 26 end
local FloorRight = Floor.CFrame.RightVector
local FloorLook = Floor.CFrame.LookVector
local Half =
math.abs(Context.Right:Dot(Vector3.new(FloorRight.X, 0, FloorRight.Z)))
* Floor.Size.X * 0.5
+ math.abs(Context.Right:Dot(Vector3.new(FloorLook.X, 0, FloorLook.Z)))
* Floor.Size.Z * 0.5
return math.max(8, Half - 7)
end

function State.AutoGetOpen.BuildGetOpenCandidates(Context, RequestedSpot)
local Candidates = {}
local RootPosition = Context.Root.Position
local Y = RootPosition.Y
RequestedSpot = State.AutoGetOpen.NormalizeSpot(
RequestedSpot or CONFIG.AutoGetOpenPreferredSpot)
local UseSmartSelection = RequestedSpot == 'Best Available'
local _, DefenderPosition, DefenderDistance = State.AutoGetOpen.GetNearestGetOpenDefender(Context)
local CutAxis = State.AutoGetOpen.GetCutAxis(Context)
local CutDistance = CONFIG.AutoGetOpenCutDistance
if CONFIG.AutoGetOpenMode == 'Aggressive' then CutDistance += 1.5 end
if CONFIG.AutoGetOpenMode == 'Perimeter' then CutDistance += 2.5 end

local DefenderSide = 0
local DefenderAhead = false
if DefenderPosition then
local DefenderOffset = Vector3.new(
DefenderPosition.X - RootPosition.X, 0, DefenderPosition.Z - RootPosition.Z)
if DefenderOffset.Magnitude > 0.01 then
DefenderSide = DefenderOffset.Unit:Dot(CutAxis)
DefenderAhead = DefenderOffset.Unit:Dot(Context.ToOffense) > 0.32
end
end

local function Finalize(Name, Position, Bonus, SideSign, Anchored, SpotName)
Position = State.AutoGetOpen.ClampAutoGetOpenToCourt(Context.Court, Position, Y)
Position = State.AutoGetOpen.KeepAutoGetOpenOnOffensiveHalf(Context, Position)
Position = State.AutoGetOpen.ClampAutoGetOpenToGoalRange(Context, Position)
-- Fixed court landmarks must remain basket-relative. Dynamic cuts still follow
-- the ball handler's depth band so their original spacing behavior is preserved.
if not Anchored then
Position = State.AutoGetOpen.ClampToPGBand(Context, Position)
end
Position = State.AutoGetOpen.ClampAutoGetOpenToCourt(Context.Court, Position, Y)
table.insert(Candidates, {
Name = Name,
SpotName = SpotName,
Side = SideSign,
Position = Position,
Bonus = Bonus or 0,
Anchored = Anchored == true,
DefenderAhead = DefenderAhead,
DefenderSide = DefenderSide,
})
end

local HalfWidth = State.AutoGetOpen.GetCourtLateralHalfWidth(Context)
* math.clamp(tonumber(CONFIG.AutoGetOpenSpotSpread) or 0.9, 0.2, 1)
local ConfiguredMinimumGoalDistance =
tonumber(CONFIG.AutoGetOpenMinimumGoalDistance) or 60
local ConfiguredMaximumGoalDistance =
tonumber(CONFIG.AutoGetOpenMaximumGoalDistance) or 90
local MinimumGoalDistance = math.min(
ConfiguredMinimumGoalDistance, ConfiguredMaximumGoalDistance)
local MaximumGoalDistance = math.max(
ConfiguredMinimumGoalDistance, ConfiguredMaximumGoalDistance)
for _, Spot in ipairs(State.AutoGetOpen.FixedSpots) do
if UseSmartSelection or Spot.Name == RequestedSpot then
local GoalDistance = MinimumGoalDistance
+ (MaximumGoalDistance - MinimumGoalDistance) * Spot.GoalDistanceAlpha
local Position = Context.Goal.Position
- Context.ToOffense * GoalDistance
+ Context.Right * (HalfWidth * Spot.Lateral)
Finalize(Spot.Name, Position, 0, Spot.Side, true, Spot.Name)
end
end

if UseSmartSelection then
for _, SideSign in ipairs({ -1, 1 }) do
local OppositeSideBonus = 0
if math.abs(DefenderSide) > 0.08 and SideSign == -math.sign(DefenderSide) then
OppositeSideBonus = math.clamp(DefenderDistance, 0, 12) < 9 and 17 or 9
end
Finalize(
SideSign < 0 and 'Cut Left' or 'Cut Right',
RootPosition + CutAxis * (CutDistance * SideSign),
OppositeSideBonus + (DefenderAhead and 12 or 0),
SideSign, false, nil)
end
end

if (UseSmartSelection or RequestedSpot == 'Backdoor')
and DefenderAhead
and DefenderDistance <= CONFIG.AutoGetOpenJumpCutDefenderRange + 4 then
local Away = math.abs(DefenderSide) > 0.08 and -math.sign(DefenderSide) or 1
Finalize('Backdoor Cut',
RootPosition
+ Context.ToOffense * CONFIG.AutoGetOpenBackdoorDistance
+ CutAxis * (Away * 4),
14, Away, false, 'Backdoor')
end

return Candidates
end

function State.AutoGetOpen.SelectGetOpenTarget(Context)
local Best, BestScore
local _, _, CurrentDefenderDistance = State.AutoGetOpen.GetNearestGetOpenDefender(Context)
local RequestedSpot = State.AutoGetOpen.NormalizeSpot(
CONFIG.AutoGetOpenPreferredSpot)
local Candidates = State.AutoGetOpen.BuildGetOpenCandidates(Context, RequestedSpot)
local UsedFallback = false
if #Candidates == 0 and RequestedSpot ~= 'Best Available' then
Candidates = State.AutoGetOpen.BuildGetOpenCandidates(Context, 'Best Available')
UsedFallback = true
end
for _, Candidate in ipairs(Candidates) do
local Score, DefenderSpace, PassingLane, TeammateSpacing, RunLane, Open,
EdgeClearance, TravelDistance, TeammateRunLane =
State.AutoGetOpen.ScoreGetOpenPosition(Context, Candidate.Position)

local MoveDelta = Candidate.Position - Context.Root.Position
local MoveHorizontal = Vector3.new(MoveDelta.X, 0, MoveDelta.Z)
local SharpCutBonus = 0
if State.AutoGetOpenLastDirection and MoveHorizontal.Magnitude > 0.01 then
local DirectionDot = MoveHorizontal.Unit:Dot(State.AutoGetOpenLastDirection)
if CurrentDefenderDistance < CONFIG.AutoGetOpenJumpCutDefenderRange
and DirectionDot < CONFIG.AutoGetOpenSharpCutAngle then
SharpCutBonus = (CONFIG.AutoGetOpenSharpCutAngle - DirectionDot) * 18
end
end

local RepeatPenalty = 0
local Cooldowns = State.AutoGetOpenRouteCooldowns
local AbandonedAt = Cooldowns and Cooldowns[Candidate.Name]
if AbandonedAt and os.clock() - AbandonedAt
< (tonumber(CONFIG.AutoGetOpenRouteRepeatWindow) or 2.5) then
RepeatPenalty = CONFIG.AutoGetOpenRouteRepeatPenalty
end
Candidate.Score = Score + Candidate.Bonus + SharpCutBonus
+ (Open and (tonumber(CONFIG.AutoGetOpenOpenBonus) or 34) or 0)
- RepeatPenalty
Candidate.DefenderSpace = DefenderSpace
Candidate.PassingLane = PassingLane
Candidate.TeammateSpacing = TeammateSpacing
Candidate.RunLane = RunLane
Candidate.TeammateRunLane = TeammateRunLane
Candidate.SharpCutBonus = SharpCutBonus
Candidate.Open = Open
Candidate.EdgeClearance = EdgeClearance
Candidate.TravelDistance = TravelDistance
Candidate.PreferenceFallback = UsedFallback
if not BestScore or Candidate.Score > BestScore then
Best, BestScore = Candidate, Candidate.Score
end
end
return Best
end

function State.AutoGetOpen.ResolveGetOpenTarget(Context, Now)
Now = Now or os.clock()
local Root = Context.Root
local _, _, DefenderDistance = State.AutoGetOpen.GetNearestGetOpenDefender(Context)
local Current = State.AutoGetOpenTarget
local CurrentScore, CurrentOpen
if Current then
local Score, _, _, _, _, Open =
State.AutoGetOpen.ScoreGetOpenPosition(Context, Current)
CurrentScore, CurrentOpen = Score, Open == true
end

local Distance = math.huge
if Current then
Distance = Vector3.new(
Current.X - Root.Position.X, 0, Current.Z - Root.Position.Z).Magnitude
end
local Arrived = Distance <= (tonumber(CONFIG.AutoGetOpenArriveDistance) or 2.4)
if Arrived then
if State.AutoGetOpenReachedAt == 0 then State.AutoGetOpenReachedAt = Now end
else
State.AutoGetOpenReachedAt = 0
end

local MustReselect = false
if not Current then
MustReselect = true
elseif State.AutoGetOpenPreferenceFallback then
MustReselect = Now - State.AutoGetOpenLastSelectAt
>= State.AutoGetOpen.GetAutoGetOpenRetargetDelay()
elseif not CurrentOpen then
MustReselect = Now - State.AutoGetOpenLastSelectAt
>= State.AutoGetOpen.GetAutoGetOpenRetargetDelay()
elseif Arrived then
local HeldFor = State.AutoGetOpenReachedAt > 0
and Now - State.AutoGetOpenReachedAt or 0
MustReselect = DefenderDistance <= CONFIG.AutoGetOpenHoldDefenderRange
or HeldFor >= CONFIG.AutoGetOpenMaximumHoldTime
end

local Committed = Now - (State.AutoGetOpenCommitAt or 0)
< (tonumber(CONFIG.AutoGetOpenCommitTime) or 0.9)
if Current and Committed and not MustReselect then
State.AutoGetOpenOpenScore = CurrentScore or 0
return Current, State.AutoGetOpenRoute or 'Holding spot',
CurrentOpen, Arrived, nil
end

local Best = State.AutoGetOpen.SelectGetOpenTarget(Context)
if not Best then
if Current then
State.AutoGetOpenOpenScore = CurrentScore or 0
return Current, State.AutoGetOpenRoute or 'Holding spot',
CurrentOpen, Arrived, nil
end
return nil
end

local Margin = MustReselect and 0
or (tonumber(CONFIG.AutoGetOpenSwitchMargin) or 14)
local ReplacingPreferenceFallback =
State.AutoGetOpenPreferenceFallback and not Best.PreferenceFallback
if Current and CurrentScore and not ReplacingPreferenceFallback
and Best.Score <= CurrentScore + Margin then
State.AutoGetOpenOpenScore = CurrentScore
return Current, State.AutoGetOpenRoute or 'Holding spot',
CurrentOpen, Arrived, nil
end

local PreviousSide = State.AutoGetOpenLastSide
if State.AutoGetOpenRoute and State.AutoGetOpenRoute ~= Best.Name then
State.AutoGetOpenRouteCooldowns = State.AutoGetOpenRouteCooldowns or {}
State.AutoGetOpenRouteCooldowns[State.AutoGetOpenRoute] = Now
end
State.AutoGetOpenLastSelectAt = Now
State.AutoGetOpenCommitAt = Now
State.AutoGetOpenReachedAt = 0
State.AutoGetOpenLastRoute = Best.Name
State.AutoGetOpenLastSide = Best.Side
State.AutoGetOpenOpenScore = Best.Score
State.AutoGetOpenPreferenceFallback = Best.PreferenceFallback == true
Best.JumpCut = (PreviousSide and Best.Side and PreviousSide ~= Best.Side)
or Best.DefenderAhead == true
return Best.Position, Best.Name, Best.Open == true, false, Best
end

State.AutoGetOpenShuffleSign = 1
State.AutoGetOpenShuffleAt = 0

-- Collapses a requested move vector onto the allowed axes: downcourt (toward our
-- scoring goal) plus lateral (left/right) for cuts. Any component pointing back
-- away from the goal is discarded, so it never retreats into the backcourt.
function State.AutoGetOpen.RestrictMoveAxis(Context, Direction)
if not (CONFIG.AutoGetOpenLateralOnly or CONFIG.AutoGetOpenNoBackcourt) then
return Direction
end
if not (Context and Direction) then return Direction end
local Flat = Vector3.new(Direction.X, 0, Direction.Z)
if Flat.Magnitude < 0.0001 then return Flat end
local Lateral = Flat:Dot(Context.Right)
local Depth = Flat:Dot(Context.ToOffense)
if Depth < 0 then Depth = 0 end
return Context.Right * Lateral + Context.ToOffense * Depth
end

-- A never-idle sideline shuffle. Flips direction on a timer and is forced back
-- inward before it can walk itself out of bounds.
function State.AutoGetOpen.ShuffleMove(Context, Scale)
if not Context then return Vector3.zero end
if not CONFIG.AutoGetOpenNeverStop then return Vector3.zero end
Scale = Scale or 1
local Now = os.clock()
local Sign = State.AutoGetOpenShuffleSign or 1
local Ok, HalfWidth = pcall(State.AutoGetOpen.GetCourtLateralHalfWidth, Context)
if not Ok or type(HalfWidth) ~= 'number' then HalfWidth = 26 end
local Lateral = (Context.Root.Position - Context.Center):Dot(Context.Right)
local Limit = HalfWidth * 0.82
if Lateral > Limit then
Sign = -1
State.AutoGetOpenShuffleAt = Now
elseif Lateral < -Limit then
Sign = 1
State.AutoGetOpenShuffleAt = Now
elseif Now - (State.AutoGetOpenShuffleAt or 0)
>= CONFIG.AutoGetOpenShufflePeriod then
State.AutoGetOpenShuffleAt = Now
Sign = -Sign
end
State.AutoGetOpenShuffleSign = Sign
return Context.Right * Sign * Scale
end

function State.AutoGetOpen.IsFixedSpotRequested()
local Spot = State.AutoGetOpen.NormalizeSpot(CONFIG.AutoGetOpenPreferredSpot)
return Spot ~= 'Best Available' and Spot ~= 'Backdoor'
end

-- Final axis lock: every automatic movement is exactly one court-cardinal
-- direction. Smart cuts remain forward/lateral only. A fixed landmark may step
-- back toward center court so a player already near the rim can reach a wing,
-- slot, or top target; the target clamp still keeps that movement in frontcourt.
function State.AutoGetOpen.EnforceCardinalOnly(Context, Direction)
if not Context or not CONFIG.AutoGetOpenCardinalOnly then return Direction end
local Flat = Direction and Vector3.new(Direction.X, 0, Direction.Z)
or Vector3.zero
local Forward = Flat:Dot(Context.ToOffense)
local Lateral = Flat:Dot(Context.Right)
local AllowFixedSpotRetreat = State.AutoGetOpen.IsFixedSpotRequested()

if math.abs(Forward) > 0.05
and Forward >= math.abs(Lateral) * CONFIG.AutoGetOpenForwardSnapRatio then
return Context.ToOffense
end
if AllowFixedSpotRetreat and Forward < -0.05
and -Forward >= math.abs(Lateral) * CONFIG.AutoGetOpenForwardSnapRatio then
return -Context.ToOffense
end
if math.abs(Lateral) >= 0.05 then
return Context.Right * (Lateral >= 0 and 1 or -1)
end
if Forward > 0.05 then return Context.ToOffense end
if AllowFixedSpotRetreat and Forward < -0.05 then return -Context.ToOffense end

local Previous = State.AutoGetOpenLastDirection
if Previous and Previous.Magnitude > 0.05 then
local PreviousForward = Previous:Dot(Context.ToOffense)
local PreviousLateral = Previous:Dot(Context.Right)
if PreviousForward > math.abs(PreviousLateral) then
return Context.ToOffense
end
if AllowFixedSpotRetreat
and -PreviousForward > math.abs(PreviousLateral) then
return -Context.ToOffense
end
if math.abs(PreviousLateral) >= 0.05 then
return Context.Right * (PreviousLateral >= 0 and 1 or -1)
end
end
local Side = State.AutoGetOpenShuffleSign or State.AutoGetOpenLastSide or 1
return Context.Right * (Side >= 0 and 1 or -1)
end

-- Enforces separation while traveling between candidate spots. Instead of
-- adding an ambiguous force, test legal movement options and pick the one whose
-- predicted position is farthest from the moving handler.
function State.AutoGetOpen.ApplyBallHandlerSpacing(Context, Desired)
if not Context or not Context.Root or not Context.BallHandlerRoot then
return Desired, false
end
local RootPosition = Context.Root.Position
local HandlerRoot = Context.BallHandlerRoot
local HandlerVelocity = HandlerRoot.AssemblyLinearVelocity
local PredictedHandler = HandlerRoot.Position + Vector3.new(
HandlerVelocity.X, 0, HandlerVelocity.Z) * 0.18
local Separation = Vector3.new(
RootPosition.X - PredictedHandler.X, 0,
RootPosition.Z - PredictedHandler.Z)
if Separation.Magnitude >= CONFIG.AutoGetOpenHandlerRepelDistance then
return Desired, false
end

local Forward = Context.ToOffense
local Right = Context.Right
local Options = { Forward, Right, -Right }
local Requested = Desired and Vector3.new(Desired.X, 0, Desired.Z)
or Vector3.zero
Requested = State.AutoGetOpen.EnforceCardinalOnly(Context, Requested)
if Requested.Magnitude > 0.05 then
Options[#Options + 1] = Requested
end

local BestDirection, BestDistance = nil, -math.huge
local Projection = 5
for _, Option in ipairs(Options) do
local Allowed = State.AutoGetOpen.EnforceCardinalOnly(Context, Option)
if Allowed.Magnitude > 0.05 then
Allowed = Allowed.Unit
local PredictedSelf = RootPosition + Allowed * Projection
local FutureDistance = Vector3.new(
PredictedSelf.X - PredictedHandler.X, 0,
PredictedSelf.Z - PredictedHandler.Z).Magnitude
if FutureDistance > BestDistance then
BestDistance = FutureDistance
BestDirection = Allowed
end
end
end

-- Forward/left/right always provide at least one valid option. Preserve a
-- deterministic lateral fallback if malformed court data slips through.
if not BestDirection then
local Side = Separation:Dot(Right) >= 0 and 1 or -1
BestDirection = Right * Side
end
return BestDirection, true
end

-- Predicts the next position before movement and selects the safest legal axis
-- whenever the requested direction would cross or crowd a court boundary.
function State.AutoGetOpen.AvoidOutOfBounds(Context, Direction)
if not Context or not Context.Root or not Context.Court then
return Direction, false
end
local Requested = State.AutoGetOpen.EnforceCardinalOnly(Context, Direction)
local Root = Context.Root
local Velocity = Root.AssemblyLinearVelocity
local FlatVelocity = Vector3.new(Velocity.X, 0, Velocity.Z)
local Options = {
Requested,
Context.ToOffense,
Context.Right,
-Context.Right,
}
if State.AutoGetOpen.IsFixedSpotRequested() then
Options[#Options + 1] = -Context.ToOffense
end

local function Evaluate(Option)
local Legal = State.AutoGetOpen.EnforceCardinalOnly(Context, Option)
local Predicted = Root.Position
+ Legal * CONFIG.AutoGetOpenOOBPredictionDistance
+ FlatVelocity * CONFIG.AutoGetOpenOOBVelocityLookAhead
local Inside, _, Clearance = State.AutoGetOpen.GetAutoGetOpenBounds(
Context.Court, Predicted, Root.Position.Y)
return Legal, Inside, Clearance or -math.huge
end

local RequestedLegal, RequestedInside, RequestedClearance = Evaluate(Requested)
if RequestedInside
and RequestedClearance >= CONFIG.AutoGetOpenOOBMinimumClearance then
return RequestedLegal, false
end

local BestDirection, BestScore
for _, Option in ipairs(Options) do
local Legal, Inside, Clearance = Evaluate(Option)
local Score = Clearance
+ (Inside and 100 or 0)
+ (Clearance >= CONFIG.AutoGetOpenOOBMinimumClearance and 1000 or 0)
+ Legal:Dot(RequestedLegal) * 0.25
if not BestScore or Score > BestScore then
BestScore, BestDirection = Score, Legal
end
end
return BestDirection or RequestedLegal, true
end

-- Picks the better side to break toward while advancing out of the backcourt.
function State.AutoGetOpen.ChooseBackcourtCutSide(Context)
local Root = Context.Root
if not Root then return 1 end
local Last = State.AutoGetOpenBackcourtCutSign or -1
local BestSign, BestScore = -Last, nil
for _, Sign in ipairs({ 1, -1 }) do
local Predicted = Root.Position
+ Context.Right * Sign * CONFIG.AutoGetOpenBackcourtCutDistance
local Inside, _, Clearance = State.AutoGetOpen.GetAutoGetOpenBounds(
Context.Court, Predicted, Root.Position.Y)
local Score = (Clearance or 0) + (Inside and 25 or -60)
if Sign ~= Last then Score = Score + 6 end
if Context.BallAnchor then
local Flat = Vector3.new(
Predicted.X - Context.BallAnchor.X,
0,
Predicted.Z - Context.BallAnchor.Z)
Score = Score + math.min(Flat.Magnitude, 30) * 0.35
end
if not BestScore or Score > BestScore then
BestScore, BestSign = Score, Sign
end
end
return BestSign
end

-- Defender pressure is evaluated immediately after the half-court advance and
-- before fixed-destination travel. This creates a sharp escape cut as soon as a
-- frontcourt defender crowds us, then returns to the requested court spot.
function State.AutoGetOpen.GetPressureCut(Context, Now)
Now = Now or os.clock()
local Root = Context and Context.Root
if not Root then return nil end

local ActiveTarget = State.AutoGetOpenPressureCutTarget
if ActiveTarget and Now < (State.AutoGetOpenPressureCutUntil or 0) then
local ActiveDelta = Vector3.new(
ActiveTarget.X - Root.Position.X, 0, ActiveTarget.Z - Root.Position.Z)
if ActiveDelta.Magnitude > (tonumber(CONFIG.AutoGetOpenArriveDistance) or 2.4) then
return ActiveTarget, State.AutoGetOpenPressureCutSide,
State.AutoGetOpenPressureCutDistance, true
end
end
if ActiveTarget then
State.AutoGetOpenPressureAdvanceUntil = math.max(
State.AutoGetOpenPressureAdvanceUntil or 0,
Now + (tonumber(CONFIG.AutoGetOpenPressureAdvanceTime) or 0.68))
end
State.AutoGetOpenPressureCutTarget = nil
State.AutoGetOpenPressureCutUntil = 0
if ActiveTarget then
return nil, nil, State.AutoGetOpenPressureCutDistance, false
end

local _, DefenderPosition, DefenderDistance =
State.AutoGetOpen.GetNearestGetOpenDefender(Context)
local TriggerRange = tonumber(CONFIG.AutoGetOpenPressureCutRange) or 10.5
local Cooldown = tonumber(CONFIG.AutoGetOpenPressureCutCooldown) or 0.48
if not DefenderPosition or DefenderDistance > TriggerRange
or Now - (State.AutoGetOpenPressureCutAt or 0) < Cooldown then
return nil, nil, DefenderDistance, false
end

local DefenderOffset = Vector3.new(
DefenderPosition.X - Root.Position.X, 0,
DefenderPosition.Z - Root.Position.Z)
local DefenderSide = DefenderOffset:Dot(Context.Right)
local AwaySide = math.abs(DefenderSide) > 0.35
and -math.sign(DefenderSide) or nil
local CutDistance = tonumber(CONFIG.AutoGetOpenPressureCutDistance) or 11
local BestTarget, BestSide, BestScore

for _, SideSign in ipairs({ -1, 1 }) do
local Candidate = Root.Position + Context.Right * (CutDistance * SideSign)
Candidate = State.AutoGetOpen.ClampAutoGetOpenToCourt(
Context.Court, Candidate, Root.Position.Y)
local CandidateDelta = Vector3.new(
Candidate.X - Root.Position.X, 0,
Candidate.Z - Root.Position.Z)
if CandidateDelta.Magnitude > 1 then
local Score = State.AutoGetOpen.ScoreGetOpenPosition(Context, Candidate)
if AwaySide and SideSign == AwaySide then Score += 30 end
if not BestScore or Score > BestScore then
BestTarget, BestSide, BestScore = Candidate, SideSign, Score
end
end
end

if not BestTarget then
return nil, nil, DefenderDistance, false
end

State.AutoGetOpenPressureCutTarget = BestTarget
State.AutoGetOpenPressureCutSide = BestSide
State.AutoGetOpenPressureCutAt = Now
State.AutoGetOpenPressureCutUntil = Now
+ (tonumber(CONFIG.AutoGetOpenPressureCutCommitTime) or 0.42)
State.AutoGetOpenPressureCutDistance = DefenderDistance
State.AutoGetOpenPressureAdvanceUntil = 0
-- Remove forward-direction smoothing so the first pressure frame is a real cut.
State.AutoGetOpenLastDirection = nil
State.AutoGetOpenPendingFlipAt = nil
return BestTarget, BestSide, DefenderDistance, false
end

-- Backcourt behavior: walk toward the frontcourt, breaking left and right on a
-- timed cycle so the defender cannot sit on a straight line and deny the pass.
function State.AutoGetOpen.BackcourtAdvance(Context)
local Now = os.clock()
local Phase = State.AutoGetOpenBackcourtPhase or 'advance'
local PhaseAt = State.AutoGetOpenBackcourtPhaseAt or Now
local Duration = (Phase == 'cut')
and CONFIG.AutoGetOpenBackcourtCutDuration
or CONFIG.AutoGetOpenBackcourtAdvanceDuration
if Now - PhaseAt >= Duration then
Phase = (Phase == 'cut') and 'advance' or 'cut'
State.AutoGetOpenBackcourtPhaseAt = Now
if Phase == 'cut' then
State.AutoGetOpenBackcourtCutSign =
State.AutoGetOpen.ChooseBackcourtCutSide(Context)
end
end
State.AutoGetOpenBackcourtPhase = Phase
if Phase == 'cut' then
local Sign = State.AutoGetOpenBackcourtCutSign or 1
return Context.Right * Sign, 'cut'
end
return Context.ToOffense, 'advance'
end

function State.AutoGetOpen.DriveContinuous(Context, HumanoidObject, Desired, Scale, BypassAxis, ForceForward)
if not HumanoidObject then return Vector3.zero end
Scale = math.max(tonumber(Scale) or 1, CONFIG.AutoGetOpenMinimumMoveInput)
local Direction = Desired and Vector3.new(Desired.X, 0, Desired.Z) or Vector3.zero
local HandlerEmergency = false
local OOBGuard = false
-- Backcourt advance is authoritative. Smoothing, shuffling, and handler
-- spacing must not convert the walk to the frontcourt into a lateral drift.
if ForceForward and Context then
local Commit = Direction
if Commit.Magnitude < 0.05 then Commit = Context.ToOffense end
Direction = State.AutoGetOpen.EnforceCardinalOnly(Context, Commit)
BypassAxis = true
State.AutoGetOpenPendingFlipAt = nil
end
if Context and not BypassAxis then
Direction, HandlerEmergency = State.AutoGetOpen.ApplyBallHandlerSpacing(
Context, Direction)
Direction = State.AutoGetOpen.EnforceCardinalOnly(Context, Direction)
end
if Direction.Magnitude < 0.05 and Context then
Direction = State.AutoGetOpen.ShuffleMove(Context, 1)
end
if Direction.Magnitude < 0.05 then
Direction = State.AutoGetOpenLastDirection or Vector3.new(1, 0, 0)
end
Direction = Direction.Unit

local Previous = State.AutoGetOpenLastDirection
local Now = os.clock()
if Previous and Previous.Magnitude > 0.05 and not HandlerEmergency
and not ForceForward then
Previous = Previous.Unit
local Dot = math.clamp(Previous:Dot(Direction), -1, 1)
if Dot < -0.50 then
if not State.AutoGetOpenPendingFlipAt then
State.AutoGetOpenPendingFlipAt = Now
end
if Now - State.AutoGetOpenPendingFlipAt
< CONFIG.AutoGetOpenFlipCommitDelay then
Direction = Previous
else
State.AutoGetOpenPendingFlipAt = nil
end
else
State.AutoGetOpenPendingFlipAt = nil
local Alpha = CONFIG.AutoGetOpenDirectionSmoothing
local Blended = Previous * (1 - Alpha) + Direction * Alpha
if Blended.Magnitude > 0.05 then Direction = Blended.Unit end
end
end

-- Final safety pass after smoothing. This guarantees the vector actually
-- sent to Humanoid:Move is the legal option maximizing handler separation.
if Context and not BypassAxis and not ForceForward then
local SafeDirection, Forced = State.AutoGetOpen.ApplyBallHandlerSpacing(
Context, Direction)
if Forced and SafeDirection.Magnitude > 0.05 then
Direction = SafeDirection.Unit
HandlerEmergency = true
end
end

if Context then
Direction = State.AutoGetOpen.EnforceCardinalOnly(Context, Direction)
Direction, OOBGuard = State.AutoGetOpen.AvoidOutOfBounds(
Context, Direction)
end
State.AutoGetOpenOOBGuard = OOBGuard
State.AutoGetOpenHandlerSpacing = HandlerEmergency
State.AutoGetOpenLastDirection = Direction
State.AutoGetOpenLastMoveAt = Now
if State.Runtime.AcquireMovement('GetOpen') then HumanoidObject:Move(Direction * Scale, false) end
return Direction
end

-- Every lateral escape is followed by a committed downcourt burst. Without
-- this phase a nearby defender can repeatedly retrigger cuts at half court and
-- make the player hover on the decision line.
function State.AutoGetOpen.DrivePressureAdvance(Context, HumanoidObject, Now)
Now = Now or os.clock()
if Now >= (State.AutoGetOpenPressureAdvanceUntil or 0) then return false end
if not Context or not Context.Root or not HumanoidObject then return false end
local AdvanceDirection = Context.ToOffense
State.AutoGetOpenTarget = Context.Root.Position + AdvanceDirection * 8
State.AutoGetOpenRoute = 'Advance after pressure cut'
State.AutoGetOpenStatus = 'ESCAPED PRESSURE | ADVANCING'
State.AutoGetOpen.DriveContinuous(
Context, HumanoidObject, AdvanceDirection, 1, true, true)
return true
end

-- Jump only for an already-selected sharp escape, and only when the defender
-- is close enough for the extra separation to matter. Ground and cooldown
-- checks keep this from turning normal route movement into constant hopping.
function State.AutoGetOpen.TryJumpCut(
Context, HumanoidObject, Now, DefenderDistance)
Now = Now or os.clock()
if not Context or not HumanoidObject or HumanoidObject.Health <= 0
or HumanoidObject.Sit
or HumanoidObject.FloorMaterial == Enum.Material.Air then
return false
end
if DefenderDistance == nil then
local _, _, NearestDistance =
State.AutoGetOpen.GetNearestGetOpenDefender(Context)
DefenderDistance = NearestDistance
end
if (tonumber(DefenderDistance) or math.huge)
> (tonumber(CONFIG.AutoGetOpenJumpCutDefenderRange) or 8.5) then
return false
end
if Now - (State.AutoGetOpenLastJumpCutAt or 0)
< (tonumber(CONFIG.AutoGetOpenJumpCutCooldown) or 0.85) then
return false
end
State.AutoGetOpenLastJumpCutAt = Now
HumanoidObject.Jump = true
pcall(function()
HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)
end)
return true
end

function State.AutoGetOpen.GetIncomingPassTarget(Context)
local BallPosition = Context.BallPosition
local BallVelocity = Context.BallVelocity or Vector3.zero
local FlatVelocity = Vector3.new(BallVelocity.X, 0, BallVelocity.Z)
if not BallPosition or FlatVelocity.Magnitude < 6 then return nil end

local ToReceiver = Vector3.new(
Context.Root.Position.X - BallPosition.X, 0,
Context.Root.Position.Z - BallPosition.Z)
if ToReceiver.Magnitude < 0.01
or FlatVelocity.Unit:Dot(ToReceiver.Unit) < 0.35 then return nil end

local Relative = Vector3.new(
BallPosition.X - Context.Root.Position.X, 0,
BallPosition.Z - Context.Root.Position.Z)
local TimeToClosest = math.clamp(
-Relative:Dot(FlatVelocity) / math.max(FlatVelocity:Dot(FlatVelocity), 0.01),
0, CONFIG.AutoGetOpenPassCatchLookAhead)
local Predicted = BallPosition + FlatVelocity * TimeToClosest
local CatchTarget = Vector3.new(Predicted.X, Context.Root.Position.Y, Predicted.Z)
local MissDistance = Vector3.new(
CatchTarget.X - Context.Root.Position.X, 0,
CatchTarget.Z - Context.Root.Position.Z).Magnitude
if MissDistance > CONFIG.AutoGetOpenPassCatchRadius then return nil end

local Blocked, BlockerPosition, BestLane = false, nil, math.huge
for _, Opponent in ipairs(Context.Opponents) do
local OpponentPosition = State.AutoGetOpen.GetPredictedPlayerPosition(Opponent, CatchTarget)
if OpponentPosition then
local Lane = State.AutoGetOpen.DistanceToSegmentXZ(
OpponentPosition, BallPosition, CatchTarget)
local FromBall = (OpponentPosition - BallPosition).Magnitude
if Lane < BestLane and FromBall < ToReceiver.Magnitude + 2 then
BestLane, BlockerPosition = Lane, OpponentPosition
end
end
end
if BlockerPosition and BestLane < CONFIG.AutoGetOpenPassBlockLane then
Blocked = true
local PassDirection = Vector3.new(FlatVelocity.X, 0, FlatVelocity.Z).Unit
CatchTarget = BlockerPosition - PassDirection * 2.4
CatchTarget = Vector3.new(CatchTarget.X, Context.Root.Position.Y, CatchTarget.Z)
end
CatchTarget = State.AutoGetOpen.ClampAutoGetOpenToCourt(
Context.Court, CatchTarget, Context.Root.Position.Y)
return CatchTarget, Blocked, (BallPosition - Context.Root.Position).Magnitude
end

-- Auto Get Open never owns character orientation. Movement is automated, but
-- facing remains entirely under the player's normal Roblox controls.
function State.AutoGetOpen.FaceBallHandler(Context)
return
end

function State.AutoGetOpen.GetAutoGetOpenRetargetDelay()
if CONFIG.AutoGetOpenTempo == 'Conservative' then return 0.16 end
if CONFIG.AutoGetOpenTempo == 'Aggressive' then return 0.045 end
return CONFIG.AutoGetOpenRetargetDelay
end

function State.AutoGetOpen.GetLandmarkAnchors(Context)
local Shared = State.CourtContext.Get()
local Anchors = {}
for _, Part in ipairs({ Shared.PaintHome, Shared.PaintAway, Shared.Paint, Shared.Center, Shared.ScoringRim }) do if Part and Part:IsA('BasePart') then table.insert(Anchors, Part.Position) end end
return Anchors
end

local function UpdateAutoGetOpenBinding()
pcall(function() RunService:UnbindFromRenderStep(AUTO_GET_OPEN_BIND_NAME) end)

if not State.AutoGetOpenEnabled then
State.AutoGetOpenTarget = nil
State.AutoGetOpenRoute = 'Waiting'
State.AutoGetOpenStatus = 'OFF'
State.AutoGetOpenLastDirection = nil
State.AutoGetOpenLastSide = nil
State.AutoGetOpenPlanAt = 0
State.AutoGetOpenPreferenceFallback = false
State.AutoGetOpenPracticeCourt = nil
State.AutoGetOpenPracticeGoal = nil
State.AutoGetOpenPressureCutTarget = nil
State.AutoGetOpenPressureCutUntil = 0
State.AutoGetOpenPressureCutAt = 0
State.AutoGetOpenPressureCutSide = nil
State.AutoGetOpenPressureCutDistance = nil
State.AutoGetOpenPressureAdvanceUntil = 0
return
end

RunService:BindToRenderStep(
AUTO_GET_OPEN_BIND_NAME,
Enum.RenderPriority.Last.Value,
WYNF_JIT(function()
if State.AutoGetOpen.IsAutoGetOpenManualInput() then
State.AutoGetOpenStatus = 'MANUAL OVERRIDE'
State.AutoGetOpenRoute = 'Manual movement'
State.AutoGetOpenPlanAt = 0
return
end

local PlanNow = os.clock()
local PlanInterval = 1 / 12
if PlanNow - (State.AutoGetOpenPlanAt or 0) < PlanInterval then
local Character = LP.Character
local HumanoidObject = Character and Character:FindFirstChildOfClass('Humanoid')
if HumanoidObject and HumanoidObject.Health > 0
and not safe_find(Character, 'Basketball')
and State.AutoGetOpenLastDirection then
if State.Runtime.AcquireMovement('GetOpen') then HumanoidObject:Move(State.AutoGetOpenLastDirection, false) end
end
return
end
State.AutoGetOpenPlanAt = PlanNow

local Context, Reason = State.AutoGetOpen.GetAutoGetOpenContext()
if not Context or not Context.BallAnchor then
local Character = LP.Character
local LocalHumanoid = Character and Character:FindFirstChild('Humanoid')
if LocalHumanoid then
if Reason ~= 'YOU HAVE BALL' then
State.AutoGetOpen.DriveContinuous(
nil, LocalHumanoid, State.AutoGetOpenLastDirection, 1, true)
end
end
State.AutoGetOpenTarget = nil
State.AutoGetOpenRoute = 'Waiting'
State.AutoGetOpenStatus = Reason or 'WAITING FOR PG'
return
end

local Root = Context.Root
local HumanoidObject = Context.Humanoid
local InsideBounds, RecoveryTarget = State.AutoGetOpen.GetAutoGetOpenBounds(
Context.Court, Root.Position, Root.Position.Y)
if not InsideBounds then
RecoveryTarget = State.AutoGetOpen.ClampAutoGetOpenToCourt(
Context.Court, RecoveryTarget, Root.Position.Y)
local Direction = Vector3.new(
RecoveryTarget.X - Root.Position.X, 0,
RecoveryTarget.Z - Root.Position.Z)
State.AutoGetOpenTarget = RecoveryTarget
State.AutoGetOpenRoute = 'Return inbounds'
State.AutoGetOpenStatus = 'RECOVERING INBOUNDS'
State.AutoGetOpen.DriveContinuous(
Context, HumanoidObject, Direction, 1, true)
return
end

local CatchTarget, PassBlocked, BallDistance =
State.AutoGetOpen.GetIncomingPassTarget(Context)
if CatchTarget then
local CatchDirection = Vector3.new(
CatchTarget.X - Root.Position.X, 0,
CatchTarget.Z - Root.Position.Z)
State.AutoGetOpenTarget = CatchTarget
State.AutoGetOpenRoute = PassBlocked and 'Attack blocked pass' or 'Align to catch pass'
State.AutoGetOpenStatus = PassBlocked and 'PASS BLOCKED | ATTACKING BALL'
or 'INCOMING PASS | ALIGNING'
State.AutoGetOpen.FaceBallHandler(Context)
if CONFIG.AutoGetOpenNoBackcourt then
local MyDepth = (Root.Position - Context.Center):Dot(Context.ToOffense)
local CatchDepth = (CatchTarget - Context.Center):Dot(Context.ToOffense)
-- Coming back a little for the ball is fine, but anything past the
-- allowance gets flattened so it never retreats to meet a pass.
if MyDepth - CatchDepth > CONFIG.AutoGetOpenCatchBackcourtAllowance then
CatchDirection = State.AutoGetOpen.RestrictMoveAxis(
Context, CatchDirection)
State.AutoGetOpenStatus = 'INCOMING PASS | NO RETREAT'
end
end
State.AutoGetOpen.DriveContinuous(
Context, HumanoidObject, CatchDirection, 1, true)
if PassBlocked and BallDistance <= CONFIG.AutoGetOpenPassJumpDistance
and os.clock() - State.AutoGetOpenLastJumpCutAt
>= CONFIG.AutoGetOpenJumpCutCooldown * 0.55 then
State.AutoGetOpenLastJumpCutAt = os.clock()
HumanoidObject.Jump = true
pcall(function()
HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)
end)
end
return
end

local CurrentOffset = Root.Position - Context.Center
local OffensiveDepth = CurrentOffset:Dot(Context.ToOffense)
State.AutoGetOpenPhase = OffensiveDepth < 0 and 'Backcourt advance' or (OffensiveDepth < 8 and 'Cross half court' or 'Read defender')
local DecisionDepth = tonumber(CONFIG.AutoGetOpenDecisionDepth) or 1.5
if OffensiveDepth < DecisionDepth then
State.AutoGetOpenPressureCutTarget = nil
State.AutoGetOpenPressureCutUntil = 0
State.AutoGetOpenPressureCutAt = 0
State.AutoGetOpenPressureCutSide = nil
State.AutoGetOpenPressureCutDistance = nil
State.AutoGetOpenPressureAdvanceUntil = 0
local DowncourtDirection = Context.ToOffense
State.AutoGetOpenTarget = Root.Position + DowncourtDirection * 8
State.AutoGetOpenRoute = 'Backcourt to frontcourt'
State.AutoGetOpenStatus = 'ADVANCING TO FRONTCOURT'
State.AutoGetOpen.DriveContinuous(
Context, HumanoidObject, DowncourtDirection, 1, true, true)
return
end

-- Half court is the decision gate: never abandon the advance while behind it.
-- As soon as we establish the frontcourt, pressure can trigger an escape cut
-- before fixed-spot travel carries us deeper. Each escape is followed by a
-- forced downcourt burst so repeated pressure reads cannot pin us to the line.
local PressureNow = os.clock()
if State.AutoGetOpen.DrivePressureAdvance(
Context, HumanoidObject, PressureNow) then return end
local PressureTarget, PressureSide, PressureDistance =
State.AutoGetOpen.GetPressureCut(Context, PressureNow)
if PressureTarget then
local PressureDirection = Vector3.new(
PressureTarget.X - Root.Position.X, 0,
PressureTarget.Z - Root.Position.Z)
State.AutoGetOpenTarget = PressureTarget
State.AutoGetOpenPhase = 'Hash/bottom/paint cut'
State.AutoGetOpenRoute =
(PressureSide or 1) < 0 and 'Pressure cut left' or 'Pressure cut right'
State.AutoGetOpenStatus = string.format(
'DEFENDER %.1f | %s',
tonumber(PressureDistance) or 0,
string.upper(State.AutoGetOpenRoute))
if State.AutoGetOpen.TryJumpCut(
Context, HumanoidObject, PressureNow, PressureDistance) then
State.AutoGetOpenStatus ..= ' | JUMP CUT'
end
State.AutoGetOpen.DriveContinuous(
Context, HumanoidObject, PressureDirection, 1, true)
return
end
if State.AutoGetOpen.DrivePressureAdvance(
Context, HumanoidObject, PressureNow) then return end

State.AutoGetOpen.FaceBallHandler(Context)
local Now = os.clock()
local Target, RouteName, IsOpen, Arrived, Candidate =
State.AutoGetOpen.ResolveGetOpenTarget(Context, Now)
if not Target then
Target = Root.Position + State.AutoGetOpen.GetCutAxis(Context) * 5
RouteName = 'Fallback lateral cut'
IsOpen, Arrived = false, false
end
State.AutoGetOpenTarget = Target
State.AutoGetOpenPhase = 'Re-space'
State.AutoGetOpenRoute = RouteName or 'Holding spot'

if Candidate and Candidate.JumpCut then
State.AutoGetOpen.TryJumpCut(Context, HumanoidObject, Now)
end

local MoveDirection = Vector3.new(
Target.X - Root.Position.X, 0,
Target.Z - Root.Position.Z)

if Arrived and IsOpen and CONFIG.AutoGetOpenHoldWhenOpen then
State.AutoGetOpenStatus = string.format(
'OPEN | LATERAL CUT %s | SCORE %.1f',
State.AutoGetOpenRoute, State.AutoGetOpenOpenScore or 0)
State.AutoGetOpen.DriveContinuous(
Context, HumanoidObject,
State.AutoGetOpen.ShuffleMove(Context, 1), 1, false)
return
end

if MoveDirection.Magnitude < 0.08 then
State.AutoGetOpenStatus = string.format(
'LATERAL CUT | %s | SCORE %.1f',
State.AutoGetOpenRoute, State.AutoGetOpenOpenScore or 0)
State.AutoGetOpen.DriveContinuous(
Context, HumanoidObject,
State.AutoGetOpen.ShuffleMove(Context, 1), 1, false)
return
end

State.AutoGetOpenStatus = string.format(
'%s | %s | SCORE %.1f',
IsOpen and 'RUNNING TO OPEN SPOT'
or (Context.TeamHasBall and 'CREATING SPACE' or 'NO POSSESSION | SPACING'),
State.AutoGetOpenRoute, State.AutoGetOpenOpenScore or 0)
State.AutoGetOpen.DriveContinuous(
Context, HumanoidObject, MoveDirection, 1, false)
end)
)
end

