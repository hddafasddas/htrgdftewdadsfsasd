-- rather than tiling only part of the decal or leaving uncovered segments.
Trail.TextureMode = Enum.TextureMode.Stretch
Trail.TextureLength = math.max(0.01, Trail.Lifetime)
if Texture then
task.defer(function()
if not Trail.Parent then return end
pcall(function()
game:GetService('ContentProvider'):PreloadAsync({ Trail })
end)
end)
end
end)
