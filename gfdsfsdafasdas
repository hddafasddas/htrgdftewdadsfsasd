ActiveUntil = 0,
Origin = nil,
LastScanAt = 0,
LastLockAt = 0,
CachedColorKey = nil,
CachedColor = nil,
CachedSequence = nil,
Objects = setmetatable({}, { __mode = 'k' }),
ColorWatches = setmetatable({}, { __mode = 'k' }),
}

function State.PerfectShotStyle.Color()
local R = math.clamp(math.floor(tonumber(CONFIG.PerfectShotColorR) or 80), 0, 255)
local G = math.clamp(math.floor(tonumber(CONFIG.PerfectShotColorG) or 255), 0, 255)
local B = math.clamp(math.floor(tonumber(CONFIG.PerfectShotColorB) or 120), 0, 255)
local Key = R * 65536 + G * 256 + B
if State.PerfectShotStyle.CachedColorKey ~= Key then
State.PerfectShotStyle.CachedColorKey = Key
State.PerfectShotStyle.CachedColor = Color3.fromRGB(R, G, B)
State.PerfectShotStyle.CachedSequence = nil
end
return State.PerfectShotStyle.CachedColor
end

function State.PerfectShotStyle.Sequence()
local Color = State.PerfectShotStyle.Color()
if State.PerfectShotStyle.CachedSequence then return State.PerfectShotStyle.CachedSequence end
State.PerfectShotStyle.CachedSequence = ColorSequence.new({
ColorSequenceKeypoint.new(0, Color:Lerp(Color3.new(1, 1, 1), 0.3)),
ColorSequenceKeypoint.new(0.5, Color),
ColorSequenceKeypoint.new(1, Color:Lerp(Color3.new(0, 0, 0), 0.28)),
})
return State.PerfectShotStyle.CachedSequence
end

function State.PerfectShotStyle.ApplyText()
