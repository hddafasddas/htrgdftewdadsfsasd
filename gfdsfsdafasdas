function State.Utility.StepAntiFall()
if not (State.Active and State.AntiFallEnabled) then return end
local Now = os.clock()
if Now - State.Utility.AntiFallAt < 0.05 then return end
State.Utility.AntiFallAt = Now
local Character, HumanoidObject, Root = State.Movement.GetRig()
if not (Character and HumanoidObject and Root) or HumanoidObject.Health <= 0 then return end
if State.Movement.FlightEnabled or State.Movement.NoclipEnabled or State.Movement.AirWalkEnabled
or (State.AutoDunk and State.AutoDunk.SendingInput) then
State.Utility.FallDangerSince = nil
State.Utility.FallStatus = 'PAUSED'
return
end
if State.Utility.AntiFallCharacter ~= Character or not State.Utility.AntiFallParams then
local Params = RaycastParams.new()
Params.FilterType = Enum.RaycastFilterType.Exclude
Params.FilterDescendantsInstances = { Character }
State.Utility.AntiFallCharacter = Character
State.Utility.AntiFallParams = Params
end
local Params = State.Utility.AntiFallParams
local FloorHit = Workspace:Raycast(Root.Position, Vector3.new(0, -12, 0), Params)
local Grounded = HumanoidObject.FloorMaterial ~= Enum.Material.Air and FloorHit ~= nil
if Grounded and math.abs(Root.AssemblyLinearVelocity.Y) < 35 then
State.Utility.SafeCFrame = Root.CFrame
State.Utility.FallDangerSince = nil
State.Utility.FallStatus = 'SAFE'
return
end
local VoidLine = Workspace.FallenPartsDestroyHeight + CONFIG.AntiFallVoidBuffer
local FallingFast = Root.AssemblyLinearVelocity.Y <= CONFIG.AntiFallMinimumVelocity
local NoFloor = Workspace:Raycast(Root.Position, Vector3.new(0, -120, 0), Params) == nil
local Dangerous = Root.Position.Y <= VoidLine or (FallingFast and NoFloor)
if not Dangerous then
State.Utility.FallDangerSince = nil
State.Utility.FallStatus = 'ARMED'
return
end
State.Utility.FallDangerSince = State.Utility.FallDangerSince or Now
State.Utility.FallStatus = 'DANGER'
local ImmediateVoid = Root.Position.Y <= VoidLine
if not ImmediateVoid and Now - State.Utility.FallDangerSince < CONFIG.AntiFallMaximumDuration then return end
