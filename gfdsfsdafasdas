function State.LocalSpoofs.UpdateLeaderboardGradients()
local Mode = tostring(CONFIG.LeaderboardColorMode or 'Solid')
local Primary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LeaderboardPrimaryColor, Color3.fromRGB(255, 59, 213))
local Speed = math.clamp(tonumber(CONFIG.LeaderboardGradientSpeed) or 0.65, 0.05, 5)
local Rotation = (os.clock() * Speed * 90) % 360
for Label in pairs(State.LocalSpoofs.LeaderboardStyledLabels) do
if not (Label and Label.Parent) then
State.LocalSpoofs.LeaderboardStyledLabels[Label] = nil
else
-- The native Playerlist script resets this color on player attribute changes.
-- Reassert it after that renderer each frame; UIGradient labels stay white.
Label.TextColor3 = Mode == 'Solid' and Primary or Color3.new(1, 1, 1)
end
end
for Gradient in pairs(State.LocalSpoofs.LeaderboardGradients) do
if not (Gradient and Gradient.Parent) then
State.LocalSpoofs.LeaderboardGradients[Gradient] = nil
else
Gradient.Enabled = Mode ~= 'Solid'
Gradient.Offset = Vector2.zero
Gradient.Rotation = Mode == 'Animated Gradient' and Rotation or 0
end
end
end

