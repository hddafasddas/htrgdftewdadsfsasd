        pauseWhenHolding = true,
        jumpBlock = true, -- mirror the guarded carrier's jump to contest shots
        mirrorDistance = 5, -- spacing used by Mirror defense
        spinSpeed = 720, -- degrees per second in 360 mode
        jitterSpeed = 14, -- left/right oscillations per second
        jitterAngle = 65, -- maximum yaw offset in either direction
        manualMovementOverride = false,
        airCatch = true,
