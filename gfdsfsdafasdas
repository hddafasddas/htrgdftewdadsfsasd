            local wave = math.sin(t * math.pi * 4 + index) * 0.035
            particle.Object.Visible = showParticles
            particle.Object.Position = UDim2.new((index * 0.173) % 1 + wave, 0, t, 0)
            particle.Object.BackgroundTransparency = 0.25 + math.abs(t - 0.5) * 0.7
        end

        if rtxBloom.Enabled then
            local intensity = optionValue("rtx_intensity", 72) / 100
            local animated = optionValue("rtx_animate", true)
            local shimmer = animated and math.sin(visualClock * 1.35) * 0.07 or 0
            local bloom = optionValue("rtx_bloom", 82) / 100
            local contrast = optionValue("rtx_contrast", 58) / 100
            local saturation = optionValue("rtx_saturation", -8) / 100
            local exposure = optionValue("rtx_exposure", 12) / 100
            local rays = optionValue("rtx_sunrays", 55) / 100
            rtxBloom.Intensity = 0.15 + bloom * 1.55 + shimmer
            rtxBloom.Size = 18 + bloom * 38
            rtxBloom.Threshold = math.clamp(1.35 - intensity * 0.72, 0.45, 1.35)
            rtxColor.Contrast = contrast * 0.48
            rtxColor.Saturation = saturation * 0.75
            rtxColor.Brightness = exposure * 0.22
            rtxColor.TintColor = optionValue("rtx_tint", Color3.fromRGB(214, 232, 250))
            rtxRays.Intensity = rays * 0.16
            rtxRays.Spread = 0.65 + intensity * 0.3
            rtxDepth.Enabled = optionValue("rtx_dof", true)
            Lighting.EnvironmentDiffuseScale = math.clamp(0.45 + intensity * 0.65, 0, 1)
            Lighting.EnvironmentSpecularScale = math.clamp(0.65 + intensity * 0.45, 0, 1)
            Lighting.ShadowSoftness = math.clamp(0.18 + (1 - intensity) * 0.42, 0, 1)
            if not fullbrightEnabled then Lighting.ExposureCompensation = exposure * 0.8 end
        end
    end)
