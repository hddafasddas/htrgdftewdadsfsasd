local Allowed = Preferred and State.AutoMix.IsMoveAllowed(
Preferred, Root, State.AutoMix.LastThreat)
-- Style is only a near-best preference. It can never bypass body/rear safety.
if Allowed and PreferredScore and SmartScore
and PreferredScore >= SmartScore - 0.60 then
