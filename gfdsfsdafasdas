Visuals.StatusShadow.Position = TextPoint + Vector2.new(1, 2)
Visuals.StatusShadow.Color = Background
Visuals.StatusShadow.Visible = TextVisible
Visuals.StatusText.Text = Stats
Visuals.StatusText.Position = TextPoint
Visuals.StatusText.Color = Data.Supported
and Accent or Muted
Visuals.StatusText.Visible = TextVisible
else
