-- OnIncomingMessage is write-only in this executor. Set a self-contained
-- callback instead of reading/chaining the game's callback. RichText is parsed
-- correctly through TextChatMessageProperties (unlike direct GUI label edits).
-- Creates real TextLabels over the local tag. Unlike RichText, these labels
-- can be recolored after a message has already been sent.
function State.LocalCosmeticExtras.InstallChatTagAnimation()
local Extras = State.LocalCosmeticExtras
if Extras.ChatTagAnimationInstalled then return end
Extras.ChatTagAnimationInstalled = true
local RunService = game:GetService('RunService')
local TextService = game:GetService('TextService')
local function Attach(Label, Tag)
local Overlay = Label:FindFirstChild('SilverSurferAnimatedChatTag')
if Overlay then return Overlay end
Overlay = Instance.new('Frame')
Overlay.Name = 'SilverSurferAnimatedChatTag'
Overlay.BackgroundTransparency = 1
Overlay.BorderSizePixel = 0
Overlay.Size = UDim2.new(1, 0, 1, 0)
Overlay.Position = UDim2.new(0, 0, 0, 0)
Overlay.ZIndex = Label.ZIndex + 2
Overlay.Parent = Label
local X = 0
for Index = 1, #Tag do
local Letter = Instance.new('TextLabel')
Letter.Name = 'Letter' .. Index
Letter.BackgroundTransparency = 1
Letter.BorderSizePixel = 0
Letter.RichText = false
Letter.Font = Label.Font
Letter.TextSize = Label.TextSize
Letter.TextStrokeTransparency = Label.TextStrokeTransparency
Letter.TextStrokeColor3 = Label.TextStrokeColor3
Letter.TextTransparency = Label.TextTransparency
Letter.TextYAlignment = Label.TextYAlignment
Letter.TextXAlignment = Enum.TextXAlignment.Left
Letter.Text = Tag:sub(Index, Index)
local Width = TextService:GetTextSize(Letter.Text, Label.TextSize, Label.Font, Vector2.new(1000, Label.AbsoluteSize.Y)).X
Letter.Size = UDim2.new(0, Width + 1, 1, 0)
Letter.Position = UDim2.new(0, X, 0, 0)
Letter.ZIndex = Overlay.ZIndex + 1
Letter.Parent = Overlay
X = X + Width
end
return Overlay
end
RunService.RenderStepped:Connect(function()
if not Extras.IsChatTagStyleActive('Custom tag') then return end
local Root = Extras.GetChatRoot()
if not Root then return end
local Tag = Extras.SanitizeClanTag(State.LocalClanTag)
if Tag == '' then return end
local Name = (LP:GetAttribute('DisguiseName') or LP.Name) .. ':'
local Primary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LocalChatTagPrimaryColor, Color3.fromRGB(255, 80, 220))
local Secondary = State.LocalSpoofs.ParseLeaderboardColor(CONFIG.LocalChatTagSecondaryColor, Color3.fromRGB(55, 220, 255))
local Mode = tostring(CONFIG.LocalChatTagColorMode or 'Solid')
local Speed = math.max(0.05, tonumber(CONFIG.LocalChatTagGradientSpeed) or 0.65)
for _, Label in ipairs(Root:GetDescendants()) do
if (Label:IsA('TextLabel') or Label:IsA('TextButton')) then
local Text = Label.Text
if type(Text) == 'string' and Text:find(Tag .. Name, 1, true) then
local Overlay = Attach(Label, Tag)
for Index = 1, #Tag do
local Letter = Overlay:FindFirstChild('Letter' .. Index)
if Letter then
local Phase = #Tag <= 1 and 0 or (Index - 1) / (#Tag - 1)
if Mode == 'Animated Gradient' then
local Cycle = (Phase + os.clock() * Speed) % 2
Phase = Cycle <= 1 and Cycle or 2 - Cycle
end
Letter.TextColor3 = Mode == 'Solid' and Primary or Primary:Lerp(Secondary, Phase)
end
end
end
end
end
end)
end

function State.LocalCosmeticExtras.InstallChatTagHook()
