-- Universal shot variants. Every game-specific silent-aim engine calls this
-- resolver instead of maintaining a separate bank/custom-angle implementation.
local UniversalShotVariants = {}

function UniversalShotVariants.IsBank()
    return CONFIG.BackboardEnabled == true
end

function UniversalShotVariants.CustomAngle()
    if CONFIG.MatchArcEnabled ~= true then return nil end
    return math.rad(math.clamp(tonumber(CONFIG.MatchArcAngle) or 62, 5, 88))
end

function UniversalShotVariants.ResolveTarget(rimPart, releaseOrigin, fallback)
    fallback = fallback or (rimPart and rimPart.Position)
    if not UniversalShotVariants.IsBank() then return fallback, false end
    if rimPart and releaseOrigin and State.Backboard
        and State.Backboard.GetMirrorTarget then
        local ok, target = pcall(State.Backboard.GetMirrorTarget, rimPart, releaseOrigin, 1.25)
        if ok and typeof(target) == 'Vector3' then return target, true end
    end
    if CONFIG.BackboardFallbackToNormal == false then return nil, true end
    return fallback, false
end

function UniversalShotVariants.ResolveAimPoint(rimPart, releaseOrigin, fallback, length)
    local target, bank = UniversalShotVariants.ResolveTarget(rimPart, releaseOrigin, fallback)
    if typeof(target) ~= 'Vector3' then return nil, bank end
    local angle = UniversalShotVariants.CustomAngle()
    if angle and releaseOrigin then
        local delta = target - releaseOrigin
        local flat = Vector3.new(delta.X, 0, delta.Z)
        if flat.Magnitude > 0.001 then
            local direction = flat.Unit * math.cos(angle) + Vector3.new(0, math.sin(angle), 0)
            return releaseOrigin + direction * (length or math.max(delta.Magnitude, 1000)), bank
        end
    end
    return target, bank
end

local runtimeTelemetryBlockInstalled = false

local function installRuntimeTelemetryBlock(notify)
    if runtimeTelemetryBlockInstalled then return true end
    -- Swish's anti-detection preamble: drop RuntimeTelemetry remote traffic and
    -- scrub executor identifiers out of stack environments so game scripts that
    -- walk getfenv() cannot fingerprint the executor.
    local remoteInstalled = false
    local okRemote = pcall(function()
        -- These objects only exist in Swish. Use non-yielding lookups so the
        -- shared installer remains safe when Aureate is launched in Hoopz.
        local replicatedStorage = game:GetService("ReplicatedStorage")
        local sharedFolder = replicatedStorage:FindFirstChild("Shared")
        local servicesFolder = sharedFolder and sharedFolder:FindFirstChild("Services")
        local remoteModule = servicesFolder and servicesFolder:FindFirstChild("RemoteService")
        if not remoteModule then return end

        local remoteService = require(remoteModule)
        local oldFire = remoteService.fireServer
        if type(oldFire) ~= "function" then return end
        remoteService.fireServer = function(name, ...)
            if name == "RuntimeTelemetry" then
                return
            end
            return oldFire(name, ...)
        end
        remoteInstalled = true
    end)

    local okScrub = pcall(function()
        if type(getfenv) ~= "function" or type(rawget) ~= "function" or type(rawset) ~= "function" then
            return
        end
        local dirty = {
            "hookfunction", "getgenv", "getgc", "getrenv", "getsenv",
            "checkcaller", "newcclosure", "islclosure", "iscclosure",
            "isexecutorclosure", "syn", "fluxus", "KRNL_LOADED",
        }
        for level = 0, 30 do
            local ok, env = pcall(getfenv, level)
            if ok and type(env) == "table" then
                for _, key in ipairs(dirty) do
                    if rawget(env, key) ~= nil then
                        rawset(env, key, nil)
                    end
                end
                local mtOk, mt = pcall(getmetatable, env)
                if mtOk and type(mt) == "table" then
                    local index = rawget(mt, "__index")
                    if type(index) == "table" then
                        for _, key in ipairs(dirty) do
                            if rawget(index, key) ~= nil then
                                rawset(index, key, nil)
                            end
                        end
                    end
                end
            end
        end
    end)

    if notify then
        if okRemote and remoteInstalled then
            notify("RuntimeTelemetry blocked")
        end
        if not remoteInstalled and not okScrub then
            notify("Telemetry scrub unavailable in this environment")
        end
    end
    runtimeTelemetryBlockInstalled = remoteInstalled or okScrub
    return runtimeTelemetryBlockInstalled
end

local function createHoopzSilentAim(notify)
    -- Hoopz standalone engine: intentionally isolated from the Swish scrub.
    local Players = game:GetService('Players')
    local RunService = game:GetService('RunService')
    local UserInputService = game:GetService('UserInputService')
    local CollectionService = game:GetService('CollectionService')
    local StarterGui = game:GetService('StarterGui')
    local SharedTableRegistry = game:GetService('SharedTableRegistry')
    local Workspace = game:GetService('Workspace')

    local LP = Players.LocalPlayer

    local CONFIG = {
        Enabled = false,
        ArcMode = 'High', -- High = lobbed root, Low = flat bullet root
        ShootMode = 'Click', -- Click = manual release; Jump apex = automatic release
        Power = 85,
        VerticalBoost = 55, -- FormulaVerticalBoost
        HighAimYOffset = -1.6, -- applied only in High mode
        SolverSegments = 360,
        SolverIterations = 36,
        MaxDistance = 220,
        RehookInterval = 2.0,
    }

    local Notify = notify or function(Text)
        print('[SILENT AIM] ' .. tostring(Text))
    end

    ----------------------------------------------------------------------
    -- executor capability gate
    ----------------------------------------------------------------------

    local Required = {
        hookfunction = EXECUTOR_CAPABILITIES.hookfunction,
        newcclosure = EXECUTOR_CAPABILITIES.newcclosure,
        getrawmetatable = EXECUTOR_CAPABILITIES.getrawmetatable,
        getactors = EXECUTOR_CAPABILITIES.getactors,
        run_on_actor = EXECUTOR_CAPABILITIES.run_on_actor,
        isfunctionhooked = EXECUTOR_CAPABILITIES.isfunctionhooked,
        restorefunction = EXECUTOR_CAPABILITIES.restorefunction,
    }

    local Missing = {}
    for Name, Reference in pairs(Required) do
        if type(Reference) ~= 'function' then
            table.insert(Missing, Name)
        end
    end
    table.sort(Missing)

    if #Missing > 0 then
        Notify('Unsupported executor, missing: ' .. table.concat(Missing, ', '))
        return
    end

    ----------------------------------------------------------------------
    -- shared state the actors read
    ----------------------------------------------------------------------

    local StateName = 'HZ_SA_' .. tostring(math.random(100000, 999999))
    local St = SharedTableRegistry:GetSharedTable(StateName)
    St.T = nil
    St.Acks = 0
    St.VerifyFails = 0

    local Runtime = {
        HookedActors = setmetatable({}, { __mode = 'k' }),
        HookCount = 0,
        Ready = false,
        Unloaded = false,
        Target = nil,
        JumpArmed = false,
        ShotThisJump = false,
    }

    ----------------------------------------------------------------------
    -- actor payload: this is the code that actually does the spoofing
    ----------------------------------------------------------------------

    local ACTOR_CODE = [==[
        local St = game:GetService('SharedTableRegistry'):GetSharedTable(__HZ_SilentAimSt)

        local function StBump(Key)
            if not pcall(function() SharedTable.increment(St, Key, 1) end) then
                pcall(function() St[Key] = (St[Key] or 0) + 1 end)
            end
        end

        if type(shared) == 'table' and shared.__HZ_SilentAimSt == __HZ_SilentAimSt then
            StBump('Acks')
            return
        end

        local Players = game:GetService('Players')
        local Client = Players.LocalPlayer
        local Camera = workspace.CurrentCamera

        local function GetTarget()
            local T = St.T
            if typeof(T) == 'Vector3' then return T end
            return nil
        end

        local function GetHead()
            local Character = Client.Character
            return Character and Character:FindFirstChild('Head')
        end

        local function GetAimCFrame()
            local TargetPosition = GetTarget()
            if not TargetPosition then return nil end
            local Head = GetHead()
            if not Head then return nil end
            return CFrame.new(Head.Position, TargetPosition)
        end

        local ok = pcall(function()
            if isfunctionhooked(Camera.GetRenderCFrame) then
                restorefunction(Camera.GetRenderCFrame)
            end
            local Old; Old = hookfunction(Camera.GetRenderCFrame, function(Self, ...)
                local AimCFrame = GetAimCFrame()
                if AimCFrame then return AimCFrame end
                return Old(Self, ...)
            end)

            if isfunctionhooked(Camera.ScreenPointToRay) then
                restorefunction(Camera.ScreenPointToRay)
            end
            local OldScreen; OldScreen = hookfunction(Camera.ScreenPointToRay, function(Self, ...)
                local AimCFrame = GetAimCFrame()
                if AimCFrame then
                    return Ray.new(AimCFrame.Position, AimCFrame.LookVector)
                end
                return OldScreen(Self, ...)
            end)

            if isfunctionhooked(Camera.ViewportPointToRay) then
                restorefunction(Camera.ViewportPointToRay)
            end
            local OldViewport; OldViewport = hookfunction(Camera.ViewportPointToRay, function(Self, ...)
                local AimCFrame = GetAimCFrame()
                if AimCFrame then
                    return Ray.new(AimCFrame.Position, AimCFrame.LookVector)
                end
                return OldViewport(Self, ...)
            end)

            local GameMeta = getrawmetatable(game)
            if isfunctionhooked(GameMeta.__index) then
                restorefunction(GameMeta.__index)
            end
            local OldIndex; OldIndex = hookfunction(GameMeta.__index, function(...)
                local ReadObject, PropertyName = ...
                local TargetPosition = GetTarget()

                if PropertyName == 'Position' and typeof(ReadObject) == 'Instance'
                    and ReadObject:IsA('InputObject') and TargetPosition then
                    local GuiInset = game:GetService('GuiService'):GetGuiInset()
                    return Vector3.new(
                        Camera.ViewportSize.X / 2 - GuiInset.X,
                        Camera.ViewportSize.Y / 2 - GuiInset.Y,
                        0
                    )
                end

                if TargetPosition and (PropertyName == 'CFrame' or PropertyName == 'CoordinateFrame')
                    and typeof(ReadObject) == 'Instance' and ReadObject:IsA('Camera') then
                    local AimCFrame = GetAimCFrame()
                    if AimCFrame then return AimCFrame end
                end

                if TargetPosition and PropertyName == 'Focus'
                    and typeof(ReadObject) == 'Instance' and ReadObject:IsA('Camera') then
                    return CFrame.new(TargetPosition)
                end

                return OldIndex(...)
            end)

            local CameraDataTable = game:GetService('SharedTableRegistry'):GetSharedTable('CameraData')
            local CameraHistoryTable = CameraDataTable.CameraHistory
            local SharedTableMeta = getrawmetatable(CameraDataTable)

            local function CloseToRealCamera(WrittenCFrame)
                if typeof(WrittenCFrame) ~= 'CFrame' then return false end
                local RealCameraCFrame = OldIndex(Camera, 'CFrame')
                return typeof(RealCameraCFrame) == 'CFrame'
                    and (WrittenCFrame.Position - RealCameraCFrame.Position).Magnitude < 10
            end

            if isfunctionhooked(SharedTableMeta.__newindex) then
                restorefunction(SharedTableMeta.__newindex)
            end
            local OldNewIndex; OldNewIndex = hookfunction(SharedTableMeta.__newindex, newcclosure(function(Table, Key, Value)
                local IsCurrentCamera = Table == CameraDataTable and Key == 'CameraCFrame'
                local IsCameraHistory = CameraHistoryTable ~= nil and Table == CameraHistoryTable
                    and type(Key) == 'number'
                if (IsCurrentCamera or IsCameraHistory) and CloseToRealCamera(Value) then
                    local AimCFrame = GetAimCFrame()
                    if AimCFrame then
                        return OldNewIndex(Table, Key, AimCFrame)
                    end
                end
                return OldNewIndex(Table, Key, Value)
            end))
        end)

        -- verify the hooks pass values through cleanly before trusting them
        local VerifyOk = false
        if ok then
            for _ = 1, 3 do
                VerifyOk = pcall(function()
                    assert(typeof(Camera:GetRenderCFrame()) == 'CFrame', 'render pose')
                    assert(typeof(Camera:ScreenPointToRay(0, 0)) == 'Ray', 'screen ray')
                    assert(typeof(Camera:ViewportPointToRay(0, 0)) == 'Ray', 'viewport ray')
                    assert(typeof(Camera.CFrame) == 'CFrame', 'game index')
                    local CameraDataTable = game:GetService('SharedTableRegistry'):GetSharedTable('CameraData')
                    local Probe = CameraDataTable.CameraCFrame
                    if typeof(Probe) ~= 'CFrame' then Probe = Camera.CFrame end
                    local Marked = Probe + Vector3.new(0, 0.001, 0)
                    CameraDataTable.CameraCFrame = Marked
                    local ReadBack = CameraDataTable.CameraCFrame
                    CameraDataTable.CameraCFrame = Probe
                    assert(typeof(ReadBack) == 'CFrame'
                        and (ReadBack.Position - Marked.Position).Magnitude < 0.0005,
                        'shared table newindex')
                end)
                if VerifyOk then break end
            end
        end

        if VerifyOk then
            if type(shared) == 'table' then
                shared.__HZ_SilentAimSt = __HZ_SilentAimSt
            end
            StBump('Acks')
        else
            pcall(function()
                if isfunctionhooked(Camera.GetRenderCFrame) then restorefunction(Camera.GetRenderCFrame) end
                if isfunctionhooked(Camera.ScreenPointToRay) then restorefunction(Camera.ScreenPointToRay) end
                if isfunctionhooked(Camera.ViewportPointToRay) then restorefunction(Camera.ViewportPointToRay) end
                local GameMeta = getrawmetatable(game)
                if isfunctionhooked(GameMeta.__index) then restorefunction(GameMeta.__index) end
                local SharedTableMeta = getrawmetatable(
                    game:GetService('SharedTableRegistry'):GetSharedTable('CameraData')
                )
                if isfunctionhooked(SharedTableMeta.__newindex) then restorefunction(SharedTableMeta.__newindex) end
            end)
            if ok then StBump('VerifyFails') end
        end
    ]==]

    local CLEANUP_CODE = [==[
        local Camera = workspace.CurrentCamera
        pcall(function()
            if Camera and isfunctionhooked(Camera.GetRenderCFrame) then restorefunction(Camera.GetRenderCFrame) end
            if Camera and isfunctionhooked(Camera.ScreenPointToRay) then restorefunction(Camera.ScreenPointToRay) end
            if Camera and isfunctionhooked(Camera.ViewportPointToRay) then restorefunction(Camera.ViewportPointToRay) end
            local GameMeta = getrawmetatable(game)
            if isfunctionhooked(GameMeta.__index) then restorefunction(GameMeta.__index) end
            local CameraData = game:GetService('SharedTableRegistry'):GetSharedTable('CameraData')
            local SharedMeta = getrawmetatable(CameraData)
            if isfunctionhooked(SharedMeta.__newindex) then restorefunction(SharedMeta.__newindex) end
        end)
        if type(shared) == 'table' then shared.__HZ_SilentAimSt = nil end
    ]==]

    local BUILT_ACTOR_CODE = ('local __HZ_SilentAimSt = %q '):format(StateName) .. ACTOR_CODE

    ----------------------------------------------------------------------
    -- actor hook dispatch
    ----------------------------------------------------------------------

    local function HookNewActors()
        local ok, Actors = pcall(EXECUTOR_CAPABILITIES.getactors)
        if not ok or type(Actors) ~= 'table' then return 0 end
        local Dispatched = 0
        for _, Actor in ipairs(Actors) do
            if not Runtime.HookedActors[Actor] then
                if pcall(EXECUTOR_CAPABILITIES.run_on_actor, Actor, BUILT_ACTOR_CODE) then
                    Runtime.HookedActors[Actor] = true
                    Runtime.HookCount = Runtime.HookCount + 1
                    Dispatched = Dispatched + 1
                end
            end
        end
        return Dispatched
    end

    local function WaitForAcks()
        local Deadline = os.clock() + 1
        while os.clock() < Deadline and (St.Acks or 0) < Runtime.HookCount do
            task.wait()
        end
        Runtime.Ready = (St.Acks or 0) > 0
        return Runtime.Ready
    end

    ----------------------------------------------------------------------
    -- the formula: projectile solve with a constant vertical boost
    ----------------------------------------------------------------------

    local function EvaluateHeight(Angle, Distance, Power, Gravity)
        local HorizontalVelocity = Power * math.cos(Angle)
        if HorizontalVelocity <= 0.000001 then return -math.huge, nil end
        local FlightTime = Distance / HorizontalVelocity
        local VerticalVelocity = Power * math.sin(Angle) + CONFIG.VerticalBoost
        return VerticalVelocity * FlightTime
            - 0.5 * Gravity * FlightTime * FlightTime, FlightTime
    end

    -- Scans -89 to 89 degrees for sign changes in the height error, bisects each
    -- bracket, and returns the requested root. There is no closed form because the
    -- vertical boost is added independent of angle.
    local function SolveArc(Distance, HeightDifference, Power, RootMode)
        local Gravity = Workspace.Gravity
        if Distance <= 0.0001 or Power <= 0 or Gravity <= 0 then return nil end

        local Minimum, Maximum = math.rad(-89), math.rad(89)
        local PreviousAngle = Minimum
        local PreviousHeight = EvaluateHeight(PreviousAngle, Distance, Power, Gravity)
        local PreviousError = PreviousHeight - HeightDifference
        local Roots = {}

        for Index = 1, CONFIG.SolverSegments do
            local Angle = Minimum + (Maximum - Minimum) * (Index / CONFIG.SolverSegments)
            local Height = EvaluateHeight(Angle, Distance, Power, Gravity)
            local Error = Height - HeightDifference

            if PreviousError == 0 or Error == 0
                or (PreviousError < 0 and Error > 0)
                or (PreviousError > 0 and Error < 0) then
                local Low, High = PreviousAngle, Angle
                local LowError = PreviousError
                for _ = 1, CONFIG.SolverIterations do
                    local Middle = (Low + High) * 0.5
                    local MiddleHeight = EvaluateHeight(Middle, Distance, Power, Gravity)
                    local MiddleError = MiddleHeight - HeightDifference
                    if LowError == 0
                        or (LowError < 0 and MiddleError >= 0)
                        or (LowError > 0 and MiddleError <= 0) then
                        High = Middle
                    else
                        Low = Middle
                        LowError = MiddleError
                    end
                end
                local Root = (Low + High) * 0.5
                if #Roots == 0 or math.abs(Root - Roots[#Roots]) > 0.00001 then
                    table.insert(Roots, Root)
                end
            end

            PreviousAngle = Angle
            PreviousError = Error
        end

        -- Low takes the flat root, High takes the lobbed root.
        local Angle = (RootMode == 'Low') and Roots[1] or Roots[#Roots]
        if not Angle then return nil end
        local _, FlightTime = EvaluateHeight(Angle, Distance, Power, Gravity)
        return Angle, FlightTime
    end

    ----------------------------------------------------------------------
    -- target selection
    ----------------------------------------------------------------------

    local function FindNearestRim(Head)
        local Best, BestDistance = nil, nil
        for _, FieldGoal in ipairs(CollectionService:GetTagged('FieldGoals')) do
            local Ok, IsPart = pcall(function() return FieldGoal:IsA('BasePart') end)
            if Ok and IsPart then
                local Distance = (FieldGoal.Position - Head.Position).Magnitude
                if Distance <= CONFIG.MaxDistance
                    and (BestDistance == nil or Distance < BestDistance) then
                    Best, BestDistance = FieldGoal, Distance
                end
            end
        end
        return Best, BestDistance
    end

    local function BuildAimPoint()
        local Character = LP.Character
        if not Character then return nil end
        local Head = Character:FindFirstChild('Head')
        if not Head then return nil end

        local Rim = FindNearestRim(Head)
        if not Rim then return nil end

        -- Horizontal origin comes from the head, release height comes from the held
        -- ball so the solve matches the real launch point.
        local Basketball = Character:FindFirstChild('Basketball')
        local Ball = Basketball and Basketball:FindFirstChild('Ball', true)
        local ReleaseY = (Ball and Ball:IsA('BasePart')) and Ball.Position.Y or Head.Position.Y
        local ReleaseOrigin = Vector3.new(Head.Position.X, ReleaseY, Head.Position.Z)

        local AimPosition, BankShot = UniversalShotVariants.ResolveTarget(Rim, ReleaseOrigin, Rim.Position)
        if not AimPosition then return nil end
        if not BankShot and CONFIG.ArcMode ~= 'Low' then
            AimPosition = AimPosition + Vector3.new(0, CONFIG.HighAimYOffset, 0)
        end

        local Delta = AimPosition - ReleaseOrigin
        local Flat = Vector3.new(Delta.X, 0, Delta.Z)
        local Distance = Flat.Magnitude
        if Distance <= 0.0001 then return nil end

        local Angle = UniversalShotVariants.CustomAngle()
            or SolveArc(Distance, Delta.Y, CONFIG.Power, CONFIG.ArcMode)
        if not Angle then return nil end

        local Direction = Flat.Unit * math.cos(Angle) + Vector3.new(0, math.sin(Angle), 0)
        return Head.Position + Direction * 1000
    end

    ----------------------------------------------------------------------
    -- arm / disarm
    ----------------------------------------------------------------------

    local function SetTarget(Position)
        Runtime.Target = Position
        pcall(function() St.T = Position end)
    end

    local function ClearTarget()
        if Runtime.Target == nil then return end
        Runtime.Target = nil
        pcall(function() St.T = nil end)
    end

    local function HoldingBall()
        local Character = LP.Character
        return Character ~= nil and Character:FindFirstChild('Basketball') ~= nil
    end


    local function ResetJumpShot()
        Runtime.JumpArmed = false
        Runtime.ShotThisJump = false
    end

    local function FireShot()
        -- Use only the executor's native click helper. Avoid requesting
        -- restricted input services that trigger environment warnings.
        local Fired = false
        if type(mouse1click) == 'function' then
            Fired = pcall(mouse1click)
        end
        return Fired
    end

    local function UpdateApexShot()
        if CONFIG.ShootMode ~= 'Jump apex' then
            ResetJumpShot()
            return
        end

        local Character = LP.Character
        local Humanoid = Character and Character:FindFirstChildOfClass('Humanoid')
        local Root = Character and Character:FindFirstChild('HumanoidRootPart')
        if not Humanoid or not Root then
            ResetJumpShot()
            return
        end

        if Humanoid.FloorMaterial ~= Enum.Material.Air then
            ResetJumpShot()
            return
        end

        local VerticalVelocity = Root.AssemblyLinearVelocity.Y
        if VerticalVelocity > 1 then
            Runtime.JumpArmed = true
        end
        if Runtime.JumpArmed and not Runtime.ShotThisJump and VerticalVelocity <= 0.5 then
            Runtime.ShotThisJump = true
            if not FireShot() then
                Notify('Apex reached, but click input is unavailable')
            end
        end
    end

    ----------------------------------------------------------------------
    -- unload
    ----------------------------------------------------------------------

    local Connections = {}

    local function Unload()
        if Runtime.Unloaded then return end
        Runtime.Unloaded = true
        ClearTarget()
        pcall(function() St.T = nil end)

        local ok, Actors = pcall(EXECUTOR_CAPABILITIES.getactors)
        if ok and type(Actors) == 'table' then
            for _, Actor in ipairs(Actors) do
                pcall(EXECUTOR_CAPABILITIES.run_on_actor, Actor, CLEANUP_CODE)
            end
        end

        for _, Connection in ipairs(Connections) do
            pcall(function() Connection:Disconnect() end)
        end

        Runtime.Ready = false
        Notify('Unloaded, hooks restored')
    end

    ----------------------------------------------------------------------
    -- boot
    ----------------------------------------------------------------------

    HookNewActors()

    if Runtime.HookCount == 0 then
        Notify('No actors found, this executor cannot run actor hooks here')
        return
    end

    if not WaitForAcks() then
        if (St.VerifyFails or 0) > 0 then
            Notify('Hooks failed live verification, aborting')
        else
            Notify('No actor acknowledged the hooks, aborting')
        end
        Unload()
        return
    end

    Notify(('Loaded  %d actors  arc %s'):format(Runtime.HookCount, CONFIG.ArcMode))

    -- Late actors need the payload too, so keep sweeping.
    task.spawn(function()
        while not Runtime.Unloaded do
            task.wait(CONFIG.RehookInterval)
            if not Runtime.Unloaded and HookNewActors() > 0 then
                WaitForAcks()
            end
        end
    end)

    -- Keep the ballistic target current. Click mode waits for the user's normal
    -- shot input; Jump apex mode emits exactly one shot as upward velocity
    -- crosses the apex threshold during each manually initiated jump.
    table.insert(Connections, RunService.RenderStepped:Connect(function()
        if Runtime.Unloaded then return end
        if not (CONFIG.Enabled and Runtime.Ready and HoldingBall()) then
            ClearTarget()
            ResetJumpShot()
            return
        end
        local Point = BuildAimPoint()
        if Point then
            SetTarget(Point)
            UpdateApexShot()
        else
            ClearTarget()
            ResetJumpShot()
        end
    end))

    table.insert(Connections, LP.CharacterRemoving:Connect(ClearTarget))

    local API = {}
    function API:IsReady()
        return Runtime.Ready and not Runtime.Unloaded
    end
    function API:SetEnabled(Value)
        if Runtime.Unloaded then return false end
        CONFIG.Enabled = Value == true
        if not CONFIG.Enabled then
            ClearTarget()
            ResetJumpShot()
        end
        Notify(CONFIG.Enabled and 'Silent aim ON' or 'Silent aim OFF')
        return Runtime.Ready
    end
    function API:SetArcMode(Value)
        CONFIG.ArcMode = Value == 'Low' and 'Low' or 'High'
        Notify('Arc: ' .. CONFIG.ArcMode
            .. ((CONFIG.ArcMode == 'Low') and '  (flat)' or '  (lobbed)'))
    end
    function API:SetShootMode(Value)
        CONFIG.ShootMode = Value == 'Jump apex' and 'Jump apex' or 'Click'
        ResetJumpShot()
        Notify('Shoot mode: ' .. CONFIG.ShootMode)
    end
    function API:SetPower(Value)
        CONFIG.Power = math.clamp(tonumber(Value) or 85, 1, 200)
    end
    function API:SetVerticalBoost(Value)
        CONFIG.VerticalBoost = math.clamp(tonumber(Value) or 55, -100, 200)
    end
    function API:SetMaxDistance(Value)
        CONFIG.MaxDistance = math.clamp(tonumber(Value) or 220, 1, 1000)
    end
    function API:RefreshVariants()
        ClearTarget()
    end
    function API:Destroy()
        Unload()
    end
    return API
end

local function createSwishSilentAim(externalNotify)
    installRuntimeTelemetryBlock(externalNotify)
    local players = game:GetService("Players")
    local rs = game:GetService("ReplicatedStorage")
    local run = game:GetService("RunService")
    local uis = game:GetService("UserInputService")
    local sg = game:GetService("StarterGui")
    local virtualUser = game:GetService("VirtualUser")

    local lp = players.LocalPlayer

    local function notify(msg)
        if type(externalNotify) == "function" then
            externalNotify(tostring(msg))
            return
        end
        pcall(function()
            sg:SetCore("SendNotification", { Title = "Swish Silent Aim", Text = msg, Duration = 2 })
        end)
    end

    local packetsOk, packets = pcall(function()
        local sharedFolder = rs:FindFirstChild("Shared") or rs:WaitForChild("Shared", 2)
        if not sharedFolder then error("Shared folder unavailable") end
        local packetsModule = sharedFolder:FindFirstChild("BasketballPackets")
            or sharedFolder:WaitForChild("BasketballPackets", 2)
        if not packetsModule then error("BasketballPackets unavailable") end
        return require(packetsModule)
    end)
    if not packetsOk or type(packets) ~= "table" then
        notify("Swish packets unavailable in this place")
        return nil
    end

    local cfg = {
        on = false,
        autoApex = false,
        autoPower = true,
        autoPowerPreference = "Lowest",
        highArc = true,
        minPower = 10,
        powerStep = 5,
        targetHoop = "Auto",       -- Goal targeting mode: "Auto", "Go1", "Go2", "Own", "Opponent"
        fullcourtBypass = true,    -- Fullcourt vector spoofing when physics trajectory cannot reach
        hitDist = 5000,
        scanStep = 0.01,
        bisectIter = 36,
        refineStep = 0.01,
        refineCount = 8,
        maxFlight = 10,
        apexArmVel = 0.75,
        apexFireVel = 0.5,
        forceScore = false,
        forceScoreInterval = 0.35,
    }

    local st = {
        unloaded = false,
        shotKey = nil,
        releasing = false,
        jumpRose = false,
        shotFired = false,
        origSend = nil,
        connections = {},
        aimTarget = nil,
        aimUntil = 0,
        actorTarget = nil,
        cameraSpoofInstalled = false,
        actorSpoofInstalled = false,
        actorCode = nil,
        actorInjected = setmetatable({}, { __mode = "k" }),
        lastActorScanAt = 0,
        lastArmAt = 0,
        lastFireAttempt = 0,
        forceScoreBusy = false,
        forceSpamT = 0,
    }

    local function conn(c)
        table.insert(st.connections, c)
        return c
    end

    local function getChar()
        local c = lp.Character
        if not c then return end
        local r = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
        local h = c:FindFirstChild("Head")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if r and h and hum then return c, r, h, hum end
    end

    local function getActiveAimTarget()
        if not cfg.on or os.clock() > st.aimUntil then return nil end
        return st.aimTarget
    end

    local function clearAimTarget()
        st.aimTarget = nil
        st.aimUntil = 0
        if st.actorTarget then pcall(function() st.actorTarget.T = nil end) end
    end

    local function setAimTarget(target)
        if typeof(target) ~= "Vector3" then return end
        st.aimTarget = target
        st.aimUntil = os.clock() + 0.45
        if st.actorTarget then pcall(function() st.actorTarget.T = target end) end
    end

    -- Public-court shots calculate their hit from Mouse.UnitRay before sending
    -- BasketballPackets.shoot.  The packet hook below is therefore too late for
    -- that path.  Arm this ray hook before release, as the reference silent aim
    -- does, while retaining the packet edit for private-arena compatibility.
    local function installCameraSpoof()
        if st.cameraSpoofInstalled then return true end
        if type(hookmetamethod) ~= "function" then return false end
        local mouse = lp:GetMouse()
        if not mouse then return false end

        local oldIndex
        local ok = pcall(function()
            oldIndex = hookmetamethod(game, "__index", function(self, key)
                if self == mouse and key == "UnitRay" then
                    local target = getActiveAimTarget()
                    local _, _, head = getChar()
                    if target and head then
                        local direction = target - head.Position
                        if direction.Magnitude > 0.001 then
                            return Ray.new(head.Position, direction.Unit)
                        end
                    end
                end
                return oldIndex(self, key)
            end)
        end)
        st.cameraSpoofInstalled = ok
        return ok
    end

    -- The public shooter can run under an Actor, where the main-VM metamethod
    -- hook is not visible.  Share only the already-solved target and install the
    -- same Mouse.UnitRay redirect inside each available Actor.
    local function installActorCameraSpoof()
        if type(getactors) ~= "function" or type(run_on_actor) ~= "function"
            or type(hookmetamethod) ~= "function" then
            return false
        end

        if not st.actorTarget then
            local stateName = ("SwishAim%d%d"):format(math.floor(os.clock() * 1000) % 1000000, math.random(100000, 999999))
            local ok, sharedTarget = pcall(function()
                local registry = game:GetService("SharedTableRegistry")
                local state = registry:GetSharedTable(stateName)
                state.T = nil
                return state
            end)
            if not ok or not sharedTarget then return false end
            st.actorTarget = sharedTarget

            st.actorCode = string.format([=[
    local State = game:GetService("SharedTableRegistry"):GetSharedTable(%q)
    local Client = game:GetService("Players").LocalPlayer
    local Mouse = Client:GetMouse()
    local OldIndex
    OldIndex = hookmetamethod(game, "__index", function(self, key)
        if self == Mouse and key == "UnitRay" then
            local target = State.T
            local character = Client.Character
            local head = character and character:FindFirstChild("Head")
            if typeof(target) == "Vector3" and head then
                local direction = target - head.Position
                if direction.Magnitude > 0.001 then
                    return Ray.new(head.Position, direction.Unit)
                end
            end
        end
        return OldIndex(self, key)
    end)
    ]=], stateName)
        end

        local sent = 0
        local actorsOk, actors = pcall(getactors)
        if actorsOk and type(actors) == "table" then
            for _, actor in ipairs(actors) do
                if not st.actorInjected[actor]
                    and pcall(run_on_actor, actor, st.actorCode) then
                    st.actorInjected[actor] = true
                    sent += 1
                end
            end
        end
        st.actorSpoofInstalled = st.actorSpoofInstalled or sent > 0
        return sent > 0
    end

    local function getBall(given)
        local c = lp.Character
        if not c then return end
        if given and typeof(given) == "Instance" and given.Parent == c then
            return given
        end

        -- Public and private Swish courts do not use consistent capitalization.
        -- Apex mode calls getBall() without a packet-provided instance, so the
        -- old exact lowercase lookup could prevent the state machine from arming.
        for _, child in ipairs(c:GetChildren()) do
            local name = string.lower(child.Name)
            if name == "basketball" or name == "ball" then
                if child:IsA("BasePart") or child:IsA("Model") then return child end
            end
        end
    end

    local function getTeam(court)
        if not court then return "team1" end
        local stats = court:FindFirstChild("stats")
        local uid = tostring(lp.UserId)
        if stats then
            -- Park/public courts expose team1/team2; private arenas expose
            -- home/away.  Accept both layouts rather than silently assuming team1.
            if stats:FindFirstChild("team1") and stats.team1:FindFirstChild(uid) then return "team1" end
            if stats:FindFirstChild("team2") and stats.team2:FindFirstChild(uid) then return "team2" end
            if stats:FindFirstChild("home") and stats.home:FindFirstChild(uid) then return "team1" end
            if stats:FindFirstChild("away") and stats.away:FindFirstChild(uid) then return "team2" end
        end
        return "team1"
    end

    -- Private arenas expose a BasePart named go1/go2.  Park courts use a
    -- hoop1/hoop2 container with the real scoring target nested below it.  The
    -- solver only needs that perf hitbox, so normalize every layout to it here.
    local function getPerf(goal)
        if not goal then return end
        if goal:IsA("BasePart") then
            local ownName = goal.Name:lower()
            if ownName == "perf" or ownName == "perfbot" or ownName == "mainrim"
                or ownName == "realgo1" or ownName == "realgo" then
                return goal
            end
        end

        -- The four 1v1 half courts do not all parent their client target in the
        -- same place. Prefer the real perfect volume, then use hoop-center geometry
        -- instead of returning nil and disabling the shot entirely.
        for _, name in ipairs({ "perf", "Perf", "PERF", "mainrim", "MainRim", "realgo1", "realgo" }) do
            local target = goal:FindFirstChild(name, true)
            if target and target:IsA("BasePart") then return target end
        end
    end

    local function getGoal(ball, rootPos, requestedTarget)
        local targetMode = requestedTarget or cfg.targetHoop
        local courtValue = ball:FindFirstChild("court")
        local court = courtValue and courtValue.Value
        local isPractice = ball:GetAttribute("practice") == true
        local goals, seen = {}, {}

        local function addPart(part)
            if part and part:IsA("BasePart") and not seen[part] then
                seen[part] = true
                table.insert(goals, part)
            end
        end

        local function addGoal(candidate)
            addPart(getPerf(candidate))
        end

        local function collectNamed(container, names)
            if not container then return end
            if names[container.Name:lower()] then addGoal(container) end
            for _, object in ipairs(container:GetDescendants()) do
                if names[object.Name:lower()] then addGoal(object) end
            end
        end

        local function collectDirectTargets(container)
            if not container then return end
            for _, object in ipairs(container:GetDescendants()) do
                if object:IsA("BasePart") then
                    local name = object.Name:lower()
                    if name == "perf" then addPart(object) end
                end
            end
        end

        if isPractice then
            local practice = workspace:FindFirstChild("practice")
            if targetMode == "Go1" then
                collectNamed(practice, { go1 = true, hoop1 = true })
            elseif targetMode == "Go2" then
                collectNamed(practice, { go2 = true, hoop2 = true })
            else
                collectDirectTargets(practice)
                if #goals == 0 then
                    collectNamed(practice, { go1 = true, go2 = true, hoop1 = true, hoop2 = true })
                end
            end
        elseif court and court ~= workspace then
            local halfCourt = court.Name:lower():find("half", 1, true) ~= nil
            local team = getTeam(court)
            
            local goalIndex = halfCourt and 1 or (team == "team2" and 2 or 1)
            if targetMode == "Go1" then
                goalIndex = 1
            elseif targetMode == "Go2" then
                goalIndex = 2
            elseif targetMode == "Own" then
                goalIndex = (team == "team1") and 1 or 2
            elseif targetMode == "Opponent" then
                goalIndex = (team == "team1") and 2 or 1
            end

            local gameParts = court:FindFirstChild("game_parts")
            local goalContainer = gameParts and gameParts:FindFirstChild("go" .. goalIndex)
            local hoopContainer = court:FindFirstChild("hoop" .. goalIndex)

            collectDirectTargets(goalContainer)
            if halfCourt and #goals == 0 then collectDirectTargets(court) end
            if #goals == 0 then addGoal(goalContainer) end
            if #goals == 0 then addGoal(hoopContainer) end
            if #goals == 0 then
                collectNamed(court, {
                    ["go" .. goalIndex] = true,
                    ["hoop" .. goalIndex] = true,
                })
            end
            if #goals == 0 and halfCourt then
                collectDirectTargets(court)
            end
        end

        table.sort(goals, function(a, b)
            local af = Vector3.new(a.Position.X - rootPos.X, 0, a.Position.Z - rootPos.Z).Magnitude
            local bf = Vector3.new(b.Position.X - rootPos.X, 0, b.Position.Z - rootPos.Z).Magnitude
            return af < bf
        end)
        return goals[1]
    end

    local function asForceScorePart(instance)
        if not instance then return nil end
        if instance:IsA("BasePart") then return instance end
        if instance:IsA("Model") then
            local named = instance:FindFirstChild("Ball", true)
                or instance:FindFirstChild("Handle", true)
            if named and named:IsA("BasePart") then return named end
            if instance.PrimaryPart then return instance.PrimaryPart end
            return instance:FindFirstChildWhichIsA("BasePart", true)
        end
        return nil
    end

    local function getBallCourt(container, part)
        for _, source in ipairs({ container, part }) do
            if source then
                local courtValue = source:FindFirstChild("court")
                    or source:FindFirstChild("Court")
                if courtValue and courtValue:IsA("ObjectValue")
                    and courtValue.Value then
                    return courtValue.Value
                end
                local attribute = source:GetAttribute("court")
                    or source:GetAttribute("Court")
                if typeof(attribute) == "Instance" then return attribute end
            end
        end
    end

    local function stampForceScoreBall(ball, court)
        local userId = lp.UserId
        local commonKeys = {
            "userId", "UserId", "userid", "owner", "Owner",
            "shooter", "Shooter", "player", "Player",
            "lastTouch", "LastTouch", "lastTouchedBy", "LastTouchedBy",
        }
        for _, key in ipairs(commonKeys) do
            local current = ball:GetAttribute(key)
            if current ~= nil then
                local value = type(current) == "string" and tostring(userId) or userId
                pcall(function() ball:SetAttribute(key, value) end)
            end
        end
        pcall(function() ball:SetAttribute("rebound", "") end)
        pcall(function() ball:SetAttribute("userId", userId) end)
        pcall(function() ball:SetAttribute("shooter", userId) end)
        if court then
            local courtValue = ball:FindFirstChild("court")
            if courtValue and courtValue:IsA("ObjectValue") then
                pcall(function() courtValue.Value = court end)
            end
        end
    end

    local function forceScoreTouchFunction()
        if type(firetouchinterest) == "function" then return firetouchinterest end
        if type(getgenv) == "function" then
            local ok, environment = pcall(getgenv)
            if ok and type(environment) == "table"
                and type(environment.firetouchinterest) == "function" then
                return environment.firetouchinterest
            end
        end
        return nil
    end

    local function getOpponentGoalParts(ballContainer, rootPosition)
        local primary = getGoal(ballContainer, rootPosition, "Opponent")
        if not primary then return nil, nil, nil end

        local scope = primary.Parent
        local cursor = primary.Parent
        while cursor and cursor ~= workspace do
            local name = string.lower(cursor.Name)
            if name == "go1" or name == "go2"
                or name == "hoop1" or name == "hoop2" then
                scope = cursor
                break
            end
            cursor = cursor.Parent
        end

        local smoother, realgo
        local function inspect(object)
            if not object:IsA("BasePart") then return end
            local name = string.lower(object.Name)
            if not smoother and (name == "smoother" or name == "smooth") then
                smoother = object
            elseif not realgo and (name == "realgo1" or name == "realgo") then
                realgo = object
            end
        end
        inspect(primary)
        if scope then
            for _, object in ipairs(scope:GetDescendants()) do inspect(object) end
        end
        return smoother, realgo, primary
    end

    local function forceScoreOnce()
        if st.forceScoreBusy or st.unloaded or not cfg.forceScore then return end
        st.forceScoreBusy = true
        pcall(function()
            local character, root = getChar()
            local ballContainer = getBall()
            local ball = asForceScorePart(ballContainer)
            if not character or not root or not ball then return end

            local court = getBallCourt(ballContainer, ball)
            local smoother, realgo, primary = getOpponentGoalParts(
                ballContainer,
                root.Position
            )
            local target = smoother or realgo or primary
            if not target then return end

            local originCFrame = ball.CFrame
            local originParent = ball.Parent
            local originLinearVelocity = ball.AssemblyLinearVelocity
            local originAngularVelocity = ball.AssemblyAngularVelocity

            stampForceScoreBall(ball, court)
            ball.Parent = workspace
            ball.CFrame = CFrame.new(target.Position + Vector3.new(0, 1.5, 0))
            ball.AssemblyLinearVelocity = Vector3.new(0, -40, 0)
            ball.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            task.wait(0.02)

            local fireTouch = forceScoreTouchFunction()
            if fireTouch then
                local touched = {}
                for _, scorePart in ipairs({ smoother, realgo, primary }) do
                    if scorePart and not touched[scorePart] then
                        touched[scorePart] = true
                        pcall(function()
                            fireTouch(ball, scorePart, 0)
                            task.wait(0.02)
                            fireTouch(ball, scorePart, 1)
                        end)
                    end
                end
            end

            task.wait(0.12)
            local restoreDeadline = os.clock() + 1
            repeat
                pcall(function() ball:SetNetworkOwner(lp) end)
                local restored = pcall(function()
                    if not ball or not ball.Parent then return end
                    if ball.Parent ~= workspace then ball.Parent = workspace end
                    stampForceScoreBall(ball, court)
                    ball.CFrame = originCFrame
                    ball.AssemblyLinearVelocity = originLinearVelocity
                    ball.AssemblyAngularVelocity = originAngularVelocity
                    if originParent and originParent.Parent then
                        ball.Parent = originParent
                    end
                end)
                if restored and (not originParent or ball.Parent == originParent) then
                    break
                end
                task.wait(0.05)
            until st.unloaded or os.clock() >= restoreDeadline
        end)
        st.forceScoreBusy = false
    end

    local function getBoost(power)
        power = power or 85
        if power >= 85 then return Vector3.new(0, 57, 0) end
        if power >= 75 then return Vector3.new(0, 56.3, 0) end
        if power >= 65 then return Vector3.new(0, 55.4, 0) end
        if power >= 50 then return Vector3.new(0, 53.5, 0) end
        return Vector3.new(0, 50, 0)
    end

    local function closestPt(pt, a, b)
        local ab = b - a
        local l2 = ab:Dot(ab)
        if l2 <= 0 then return a end
        return a + ab * math.clamp((pt - a):Dot(ab) / l2, 0, 1)
    end

    local function checkRay(goal, spawnPos, vel)
        local perf = getPerf(goal)
        if not perf then return false end

        local grav = Vector3.new(0, -workspace.Gravity * 0.99, 0)
        local pos = spawnPos
        local above = false

        local filter = { perf }
        local goalContainer = perf.Parent
        for _, n in next, { "perfbot", "realgo1" } do
            local o = goalContainer and goalContainer:FindFirstChild(n, true)
            if o then table.insert(filter, o) end
        end
        local funnel = goalContainer and goalContainer:FindFirstChild("funnel1", true)
        if funnel then
            for _, d in ipairs(funnel:GetDescendants()) do table.insert(filter, d) end
        end

        local par = RaycastParams.new()
        par.FilterType = Enum.RaycastFilterType.Include
        par.FilterDescendantsInstances = filter

        for _ = 1, math.floor(cfg.maxFlight / 0.05) do
            local np = pos + vel * 0.05 + grav * 0.5 * 0.0025
            if np.Y > perf.Position.Y + 5 then above = true end

            local hit = workspace:Raycast(pos, np - pos, par)
            if hit and above then
                return hit.Instance == perf or hit.Instance:IsDescendantOf(perf)
            end

            if above then
                local cp = closestPt(perf.Position, pos, np)
                local rad = math.max(perf.Size.X, perf.Size.Y, perf.Size.Z) * 0.5 + 0.35
                if (cp - perf.Position).Magnitude <= rad then return true end
            end

            vel = vel + grav * 0.05
            pos = np
        end
        return false
    end

    local function dirAtTime(goal, power, rootPos, t)
        local perf = getPerf(goal)
        if not perf then return nil end
        local grav = Vector3.new(0, -workspace.Gravity * 0.99, 0)
        local boost = getBoost(power)
        local targetPosition = UniversalShotVariants.ResolveTarget(perf, rootPos, perf.Position)
        if not targetPosition then return nil end
        local q = targetPosition - rootPos + Vector3.new(0, 2.25, 0) - boost * t - grav * 0.5 * t * t
        local denom = 0.5 + power * t
        if denom <= 0.0001 or q.Magnitude <= 0.0001 then return nil end
        return q / denom, q.Magnitude - denom
    end

    local function bisect(goal, power, rootPos, lo, hi)
        local _, loErr = dirAtTime(goal, power, rootPos, lo)
        if not loErr then return nil end
        for _ = 1, cfg.bisectIter do
            local mid = (lo + hi) * 0.5
            local _, midErr = dirAtTime(goal, power, rootPos, mid)
            if not midErr then return nil end
            if loErr == 0 or (loErr < 0 and midErr >= 0) or (loErr > 0 and midErr <= 0) then
                hi = mid
            else
                lo = mid
                loErr = midErr
            end
        end
        return (lo + hi) * 0.5
    end

    local function findRoots(goal, power, rootPos)
        local roots = {}
        local prevT = 0.05
        local _, prevErr = dirAtTime(goal, power, rootPos, prevT)
        local t = prevT + cfg.scanStep

        while t <= cfg.maxFlight do
            local _, curErr = dirAtTime(goal, power, rootPos, t)
            if curErr and prevErr then
                if prevErr == 0 or curErr == 0
                    or (prevErr < 0 and curErr > 0)
                    or (prevErr > 0 and curErr < 0) then
                    local rt = bisect(goal, power, rootPos, prevT, t)
                    if rt and (#roots == 0 or math.abs(rt - roots[#roots]) > 0.001) then
                        table.insert(roots, rt)
                    end
                end
            end
            prevT, prevErr = t, curErr
            t = t + cfg.scanStep
        end
        return roots
    end

    -- The reference silent aim treats the two projectile roots as two distinct
    -- arcs at one power: root 1 is the flat shot and the last root is the lob.
    -- Do not compare flight times across every power here.  That made "High Arc"
    -- choose the highest possible rainbow even when the player's current power
    -- already had a valid high root, which is why its arc did not match Silent.
    local function quantizePower(power, maxPower)
        local step = math.max(1, tonumber(cfg.powerStep) or 5)
        local minimum = math.min(math.max(step, tonumber(cfg.minPower) or 10), maxPower)
        local snapped = minimum + math.floor(((power - minimum) / step) + 0.5) * step
        return math.clamp(snapped, minimum, maxPower)
    end

    local function getPowerCandidates(selectedPower, maxPower)
        local candidates, seen = {}, {}
        local function add(power)
            power = quantizePower(power, maxPower)
            if not seen[power] then
                seen[power] = true
                table.insert(candidates, power)
            end
        end

        -- The active power is always tried first, exactly like the reference
        -- formula solver.  Auto power must never change a makeable current arc.
        add(selectedPower)
        if not cfg.autoPower then return candidates end

        local minimum = math.min(math.max(1, tonumber(cfg.minPower) or 10), maxPower)
        local step = math.max(1, tonumber(cfg.powerStep) or 5)
        if cfg.autoPowerPreference == "Highest" then
            for power = maxPower, minimum, -step do add(power) end
        else
            -- "Lowest" also intentionally covers the default/fallback case.
            for power = minimum, maxPower, step do add(power) end
        end
        return candidates
    end

    local function solve(ball, selPower)
        local _, root, head = getChar()
        if not root or not head then return end

        local goal = getGoal(ball, root.Position)
        if not goal then return end
        local perf = getPerf(goal)
        if not perf then return end

        -- Do not reject by perf.LookVector. The 1v1 half courts use rotated and
        -- mirrored target parts, so that full-court facing heuristic discarded a
        -- valid hoop before the ballistic solver could run.

        local maxP = tonumber(workspace:GetAttribute("MAXPOWER")) or 85
        local p = lp:GetAttribute("power") or selPower or maxP
        p = math.clamp(p, 5, maxP)

        p = quantizePower(p, maxP)
        local powers = getPowerCandidates(p, maxP)
        local offsets = { 0 }
        for i = 1, cfg.refineCount do
            table.insert(offsets, i * cfg.refineStep)
            table.insert(offsets, -i * cfg.refineStep)
        end

        for _, pv in ipairs(powers) do
            local roots = findRoots(goal, pv, root.Position)
            local boost = getBoost(pv)
            local rt = cfg.highArc and roots[#roots] or roots[1]
            local desiredAngle = UniversalShotVariants.CustomAngle()
            if desiredAngle and #roots > 0 then
                local bestDifference
                for _, candidate in ipairs(roots) do
                    local raw = dirAtTime(goal, pv, root.Position, candidate)
                    if raw and raw.Magnitude > 0.001 then
                        local candidateAngle = math.asin(math.clamp(raw.Unit.Y, -1, 1))
                        local difference = math.abs(candidateAngle - desiredAngle)
                        if not bestDifference or difference < bestDifference then
                            bestDifference, rt = difference, candidate
                        end
                    end
                end
            end
            if rt then
                for _, off in ipairs(offsets) do
                    local t = rt + off
                    if t > 0 then
                        local raw = dirAtTime(goal, pv, root.Position, t)
                        if raw and raw.Magnitude > 0.0001 then
                            local dir = raw.Unit
                            local sp = root.Position + dir * 0.5 + Vector3.new(0, -2.25, 0)
                            local vel = dir * pv + boost
                            if UniversalShotVariants.IsBank() or checkRay(goal, sp, vel) then
                                return {
                                    dir = dir,
                                    power = pv,
                                    flightTime = t,
                                    hit = head.Position + dir * cfg.hitDist,
                                    rootPos = root.Position,
                                    headPos = head.Position
                                }
                            end
                        end
                    end
                end
            end
        end

        -- Full-Court Vector Spoofing Fallback:
        -- If out of physics trajectory range, spoof root and head position vectors right at the target hoop
        if cfg.fullcourtBypass then
            local spoofedRoot = perf.Position + Vector3.new(0, -6, 10)
            local spoofedHead = spoofedRoot + Vector3.new(0, 5, 0)
            local spoofedHit = perf.Position
            return {
                dir = (perf.Position - head.Position).Unit,
                power = maxP,
                flightTime = 1,
                hit = spoofedHit,
                rootPos = spoofedRoot,
                headPos = spoofedHead
            }
        end
    end

    installCameraSpoof()
    installActorCameraSpoof()

    local function getKey()
        if st.shotKey ~= nil then return st.shotKey end
        local attr = lp:GetAttribute("RuntimeShotKey")
        if attr ~= nil and tostring(attr) ~= "" then return attr end
        local ok, ms = pcall(function()
            local scripts = lp:FindFirstChild("PlayerScripts")
            local loader = scripts and scripts:FindFirstChild("ClientLoader")
            local runtime = loader and loader:FindFirstChild("Runtime")
            local motion = runtime and runtime:FindFirstChild("MotionState")
            return motion and require(motion)
        end)
        if ok and ms and type(ms.get) == "function" then
            local got, state = pcall(ms.get)
            if got then
                if type(state) == "table" then
                    return state.shotKey or state.key or state.runtimeKey
                elseif state ~= nil then
                    return state
                end
            end
        end
    end

    local function nativeRelease()
        local camera = workspace.CurrentCamera
        if not camera then return false end
        local x = 12
        local y = math.max(48, math.floor(camera.ViewportSize.Y) - 48)
        local point = Vector2.new(x, y)
        local sent = pcall(function()
            virtualUser:Button1Down(point, camera.CFrame)
            task.wait()
            virtualUser:Button1Up(point, camera.CFrame)
        end)
        local click = EXECUTOR_CAPABILITIES.mouse1click
        if type(click) == "function" then sent = pcall(click) or sent end
        return sent
    end

    local function fire()
        if not cfg.on or st.releasing then return false end
        local ball = getBall()
        if not ball then return false end

        local data = solve(ball)
        if not data then return false end
        setAimTarget(data.hit)
        st.releasing = true

        local key = getKey()
        if key ~= nil and st.origSend then
            pcall(function() packets.pointer.send({ ball = ball }) end)
            local sent = pcall(st.origSend, {
                ball = ball,
                key = key,
                hit = data.hit,
                power = data.power,
                rootPosition = data.rootPos,
                headPosition = data.headPos
            })
            task.delay(0.2, function() st.releasing = false end)
            return sent
        end

        -- Before the first manual shot there may be no cached runtime key.
        -- Ask the game's shooter to prepare/release, then emit native input so
        -- the hooked packet path captures the real key and rewrites the shot.
        local assisted = pcall(function()
            local client = ball:FindFirstChild("client")
            local loader = client and client:FindFirstChild("ClientLoader")
            local shootModule = loader and loader:FindFirstChild("shoot")
            if not shootModule then error("shoot module unavailable") end
            local shooter = require(shootModule)
            if type(shooter.shootassist) ~= "function" then error("shootassist unavailable") end
            shooter:shootassist()
        end)
        local released = nativeRelease()
        task.delay(0.2, function() st.releasing = false end)
        return assisted or released
    end

    local function hook(pkt, ...)
        if type(pkt) == "table" and pkt.key ~= nil then
            st.shotKey = pkt.key
        end

        if cfg.on and type(pkt) == "table" then
            local ball = getBall(pkt.ball)
            if ball then
                local data = solve(ball, pkt.power)
                if data then
                    setAimTarget(data.hit)
                    pkt = table.clone(pkt)
                    pkt.hit = data.hit
                    pkt.power = data.power
                    pkt.rootPosition = data.rootPos
                    pkt.headPosition = data.headPos
                end
            end
        end

        return st.origSend(pkt, ...)
    end

    local orig = packets.shoot and packets.shoot.send
    if type(orig) == "function" then
        st.origSend = orig
        packets.shoot.send = hook
    end

    conn(run.Heartbeat:Connect(function()
        local now = os.clock()
        if cfg.on and now - st.lastActorScanAt >= 1 then
            st.lastActorScanAt = now
            installActorCameraSpoof()
        end
        if not cfg.on or not cfg.autoApex then return end
        local _, root, _, hum = getChar()
        if not root or not hum or not getBall() then
            clearAimTarget()
            st.jumpRose = false
            st.shotFired = false
            return
        end

        if hum.FloorMaterial == Enum.Material.Air then
            if now - st.lastArmAt >= 0.08 then
                st.lastArmAt = now
                local data = solve(getBall())
                if data then setAimTarget(data.hit) end
            end
            local vy = root.AssemblyLinearVelocity.Y
            if vy > cfg.apexArmVel then
                st.jumpRose = true
            elseif st.jumpRose and vy <= cfg.apexFireVel and not st.shotFired then
                -- Only consume this jump after a release path was actually
                -- dispatched. Failed key/ball/solver lookups retry briefly at
                -- the apex instead of permanently setting shotFired.
                if now - st.lastFireAttempt >= 0.06 then
                    st.lastFireAttempt = now
                    st.shotFired = fire() == true
                end
            end
        else
            clearAimTarget()
            st.jumpRose = false
            st.shotFired = false
        end
    end))

    conn(run.Heartbeat:Connect(function()
        if st.unloaded or not cfg.forceScore or st.forceScoreBusy then return end
        local now = os.clock()
        if now - st.forceSpamT < cfg.forceScoreInterval then return end
        st.forceSpamT = now
        task.spawn(forceScoreOnce)
    end))

    local API = {}
    function API:IsReady()
        return st.origSend ~= nil and not st.unloaded
    end
    function API:SetEnabled(value)
        if st.unloaded then return false end
        cfg.on = value == true
        if not cfg.on then
            clearAimTarget()
            st.jumpRose = false
            st.shotFired = false
        end
        notify(cfg.on and "Silent aim ON" or "Silent aim OFF")
        return st.origSend ~= nil
    end
    function API:SetShootMode(value)
        -- Click = packet rewrite only on user release; Jump apex = auto release.
        cfg.autoApex = value == "Jump apex"
        st.jumpRose = false
        st.shotFired = false
        st.lastFireAttempt = 0
        notify("Shoot mode: " .. (cfg.autoApex and "Jump apex" or "Click"))
    end
    function API:SetArcMode(value)
        cfg.highArc = value ~= "Low"
        notify(cfg.highArc and "High Arc" or "Low Arc")
    end
    function API:SetTargetHoop(value)
        local allowed = { Auto = true, Go1 = true, Go2 = true, Own = true, Opponent = true }
        if allowed[value] then
            cfg.targetHoop = value
            notify("Target hoop: " .. value)
        end
    end
    function API:SetAutoPower(value)
        cfg.autoPower = value == true
    end
    function API:SetAutoPowerPreference(value)
        cfg.autoPowerPreference = value == "Highest" and "Highest" or "Lowest"
    end
    function API:SetFullcourtBypass(value)
        cfg.fullcourtBypass = value == true
    end
    function API:SetMinPower(value)
        cfg.minPower = math.clamp(tonumber(value) or 10, 1, 85)
    end
    function API:SetForceScore(value)
        cfg.forceScore = value == true
        st.forceSpamT = 0
        notify(cfg.forceScore and "Force Score ON" or "Force Score OFF")
    end
    function API:RefreshVariants()
        clearAimTarget()
    end
    function API:Destroy()
        if st.unloaded then return end
        st.unloaded = true
        cfg.on = false
        cfg.forceScore = false
        clearAimTarget()
        for _, c in ipairs(st.connections) do
            pcall(function() c:Disconnect() end)
        end
        if st.origSend and packets.shoot then
            packets.shoot.send = st.origSend
        end
        notify("Unloaded")
    end
    return API
end



local function createRooftop2SilentAim(externalNotify)
    local PlayersService = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunServiceService = game:GetService("RunService")
    local LocalPlayer = PlayersService.LocalPlayer

    local function notify(message)
        if type(externalNotify) == "function" then
            externalNotify(tostring(message))
        end
    end

    local sharedHandler = ReplicatedStorage:FindFirstChild("SharedHandler")
    local remoteModule = sharedHandler and sharedHandler:FindFirstChild("RemoteMod")
    local okRemote, remote = pcall(function()
        return remoteModule and require(remoteModule)
    end)
    if not okRemote or type(remote) ~= "table" or type(remote.SendServer) ~= "function" then
        notify("Rooftop 2 RemoteMod unavailable")
        return nil
    end

    local cfg = {
        enabled = false,
        shootMode = "Click",
        targetHoop = "Auto",
        -- Same model as the Hoopz engine: a tunable launch speed plus a
        -- constant vertical boost, solved numerically for the launch angle.
        arcMode = "High",
        power = 85,
        verticalBoost = 55,
        highAimYOffset = -1.6,
        solverSegments = 360,
        solverIterations = 36,
        maxDistance = 220,
        arcTrim = 0,
        apexArmVelocity = 0.75,
        apexFireVelocity = 0.5,
    }

    local st = {
        unloaded = false,
        jumpArmed = false,
        shotFired = false,
        connections = {},
        originalSend = remote.SendServer,
        hookedSend = nil,
        speedPerPower = nil,
        gravity = nil,
        calibrated = false,
        sampling = false,
    }

    local function connect(connection)
        table.insert(st.connections, connection)
        return connection
    end

    local function getCharacter()
        local character = LocalPlayer.Character
        if not character then return nil end
        local root = character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("Torso")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then return nil end
        return character, root, humanoid
    end

    local function holdingBall()
        local character = LocalPlayer.Character
        if character then
            local ball = character:FindFirstChild("Ball")
            if ball and (ball:GetAttribute("ID") ~= nil or ball:IsA("BasePart")) then
                return true
            end
        end
        local value = LocalPlayer:GetAttribute("Ball")
        return value ~= nil and value ~= "" and value ~= false
    end

    local function rimTarget(hoopContainer)
        if not hoopContainer then return nil end
        local rim = hoopContainer:FindFirstChild("C__Rim", true)
        local exact = rim and rim:FindFirstChild("Hoop")
        if exact and exact:IsA("BasePart") then return exact end

        for _, object in ipairs(hoopContainer:GetDescendants()) do
            if object:IsA("BasePart") then
                local name = string.lower(object.Name)
                if name == "hoop" or name == "rim" or name == "mainrim"
                    or name == "perfect" or name == "perf" then
                    return object
                end
            end
        end
    end

    local function collectCourtTargets(court)
        local targets = {}
        local hoops = court and court:FindFirstChild("Hoops")
        if not hoops then return targets end
        for _, container in ipairs(hoops:GetChildren()) do
            local target = rimTarget(container)
            if target then
                table.insert(targets, { part = target, name = container.Name })
            end
        end
        table.sort(targets, function(a, b) return a.name < b.name end)
        return targets
    end

    local function activeCourtTargets(rootPosition)
        local courts = workspace:FindFirstChild("Courts")
        if not courts then return {} end
        local matchId = tostring(LocalPlayer:GetAttribute("Match") or "")
        local bestTargets, bestDistance

        for _, court in ipairs(courts:GetChildren()) do
            local targets = collectCourtTargets(court)
            if #targets > 0 then
                local exactMatch = matchId ~= "" and (
                    court.Name == matchId
                    or tostring(court:GetAttribute("ID") or "") == matchId
                    or tostring(court:GetAttribute("Match") or "") == matchId
                )
                local distance = math.huge
                for _, target in ipairs(targets) do
                    distance = math.min(distance, (target.part.Position - rootPosition).Magnitude)
                end
                if exactMatch then return targets end
                if not bestDistance or distance < bestDistance then
                    bestTargets, bestDistance = targets, distance
                end
            end
        end
        return bestTargets or {}
    end

    local function chooseTarget()
        local _, root = getCharacter()
        if not root then return nil end
        local targets = activeCourtTargets(root.Position)
        if #targets == 0 then return nil end
        if cfg.targetHoop == "Go1" then return targets[1].part end
        if cfg.targetHoop == "Go2" then return (targets[2] or targets[1]).part end

        table.sort(targets, function(a, b)
            return (a.part.Position - root.Position).Magnitude
                < (b.part.Position - root.Position).Magnitude
        end)
        if cfg.targetHoop == "Own" and #targets > 1 then
            return targets[#targets].part
        end
        -- Auto/Opponent select the basket the ball-handler is attacking.
        return targets[1].part
    end

    local function ballPart()
        local character = LocalPlayer.Character
        local held = character and character:FindFirstChild("Ball")
        if not held then return nil end
        if held:IsA("BasePart") then return held end
        return held:FindFirstChildWhichIsA("BasePart")
    end

    -- BallShared.AddGravityModifier cancels part of world gravity with a
    -- VectorForce, so the ball does not fall at workspace.Gravity. Recover the
    -- real value from the force actually applied to the ball.
    local function measureGravity(part)
        local gravity = workspace.Gravity
        if not part then return gravity end
        local force = part:FindFirstChild("GravityForce")
        if force and force:IsA("VectorForce") then
            local ok, mass = pcall(function() return part.AssemblyMass end)
            if not ok or not mass or mass <= 0 then
                ok, mass = pcall(function() return part:GetMass() end)
            end
            if ok and mass and mass > 0 then
                gravity = workspace.Gravity - force.Force.Y / mass
            end
        end
        return math.clamp(gravity, 1, 1000)
    end

    -- Measures the real release speed so you know what to set Shot power to.
    local function calibrate(part)
        if not part or st.sampling then return end
        st.sampling = true
        task.spawn(function()
            local best, gravity = 0, nil
            local deadline = os.clock() + 0.5
            while os.clock() < deadline and not st.unloaded do
                if not part.Parent then break end
                local ok, speed = pcall(function()
                    return part.AssemblyLinearVelocity.Magnitude
                end)
                if not ok then break end
                if speed > best then
                    best = speed
                    gravity = measureGravity(part)
                end
                RunServiceService.Heartbeat:Wait()
            end
            st.sampling = false
            if best > 5 then
                st.gravity = gravity or st.gravity
                st.measuredSpeed = best
                if not st.reported then
                    st.reported = true
                    notify(string.format(
                        "Rooftop 2 launch speed ~%d. Set Shot power near that.",
                        math.floor(best + 0.5)))
                end
            end
        end)
    end

    -- Height reached at the target distance for a given launch angle.
    local function evaluateHeight(angle, distance, power, gravity)
        local horizontal = power * math.cos(angle)
        if horizontal <= 0.000001 then return -math.huge, nil end
        local flightTime = distance / horizontal
        local vertical = power * math.sin(angle) + cfg.verticalBoost
        return vertical * flightTime
            - 0.5 * gravity * flightTime * flightTime, flightTime
    end

    -- Scans -89 to 89 degrees for sign changes in the height error, bisects
    -- each bracket, and returns the requested root. There is no closed form
    -- because the vertical boost is added independent of angle.
    local function solveArc(distance, heightDifference, power, gravity, rootMode)
        if distance <= 0.0001 or power <= 0 or gravity <= 0 then return nil end

        local minimum, maximum = math.rad(-89), math.rad(89)
        local previousAngle = minimum
        local previousHeight = evaluateHeight(previousAngle, distance, power, gravity)
        local previousError = previousHeight - heightDifference
        local roots = {}

        for index = 1, cfg.solverSegments do
            local angle = minimum + (maximum - minimum) * (index / cfg.solverSegments)
            local height = evaluateHeight(angle, distance, power, gravity)
            local err = height - heightDifference

            if previousError == 0 or err == 0
                or (previousError < 0 and err > 0)
                or (previousError > 0 and err < 0) then
                local low, high = previousAngle, angle
                local lowError = previousError
                for _ = 1, cfg.solverIterations do
                    local middle = (low + high) * 0.5
                    local middleHeight = evaluateHeight(middle, distance, power, gravity)
                    local middleError = middleHeight - heightDifference
                    if lowError == 0
                        or (lowError < 0 and middleError >= 0)
                        or (lowError > 0 and middleError <= 0) then
                        high = middle
                    else
                        low = middle
                        lowError = middleError
                    end
                end
                local root = (low + high) * 0.5
                if #roots == 0 or math.abs(root - roots[#roots]) > 0.00001 then
                    table.insert(roots, root)
                end
            end

            previousAngle = angle
            previousError = err
        end

        -- Low takes the flat root, High takes the lobbed root.
        local angle = (rootMode == "Low") and roots[1] or roots[#roots]
        if not angle then return nil end
        return angle
    end

    local function aimDirection()
        local character = LocalPlayer.Character
        local head = character and character:FindFirstChild("Head")
        if not head then return nil end

        local target = chooseTarget()
        if not target then return nil end
        if (target.Position - head.Position).Magnitude > cfg.maxDistance then
            return nil
        end

        -- Horizontal origin comes from the head, release height comes from the
        -- held ball so the solve matches the real launch point.
        local held = ballPart()
        local releaseY = held and held.Position.Y or head.Position.Y
        local origin = Vector3.new(head.Position.X, releaseY, head.Position.Z)

        local aimPosition, bankShot = UniversalShotVariants.ResolveTarget(target, origin, target.Position)
        if not aimPosition then return nil end
        if not bankShot and cfg.arcMode ~= "Low" then
            aimPosition = aimPosition + Vector3.new(0, cfg.highAimYOffset, 0)
        end

        local delta = aimPosition - origin
        local flat = Vector3.new(delta.X, 0, delta.Z)
        local distance = flat.Magnitude
        if distance <= 0.0001 then return nil end

        local gravity = st.gravity or measureGravity(held) or workspace.Gravity
        local angle = UniversalShotVariants.CustomAngle()
            or solveArc(distance, delta.Y, cfg.power, gravity, cfg.arcMode)
        if not angle then return nil end

        local vertical = math.sin(angle) * (1 + cfg.arcTrim / 100)
        return (flat.Unit * math.cos(angle) + Vector3.new(0, vertical, 0)).Unit
    end

    local function resetJump()
        st.jumpArmed = false
        st.shotFired = false
    end

    st.hookedSend = function(command, ...)
        local args = { ... }
        if command ~= "Ball_Shoot" then
            return st.originalSend(command, ...)
        end

        local released = ballPart()
        if cfg.enabled and holdingBall() then
            local direction = aimDirection()
            if direction then args[1] = direction end
        end
        local result = st.originalSend(command, table.unpack(args))
        calibrate(released)
        return result
    end
    remote.SendServer = st.hookedSend

    connect(RunServiceService.Heartbeat:Connect(function()
        if st.unloaded or not cfg.enabled or cfg.shootMode ~= "Jump apex" then
            resetJump()
            return
        end
        local _, root, humanoid = getCharacter()
        if not root or not humanoid or not holdingBall() then
            resetJump()
            return
        end
        if humanoid.FloorMaterial ~= Enum.Material.Air then
            resetJump()
            return
        end

        local velocityY = root.AssemblyLinearVelocity.Y
        if velocityY > cfg.apexArmVelocity then
            st.jumpArmed = true
        elseif st.jumpArmed and not st.shotFired
            and velocityY <= cfg.apexFireVelocity then
            local direction = aimDirection()
            if direction then
                st.shotFired = true
                local power = tonumber(LocalPlayer:GetAttribute("Power")) or 70
                remote.SendServer("Ball_Shoot", direction, power)
            end
        end
    end))

    local API = {}
    function API:IsReady()
        return not st.unloaded and type(st.originalSend) == "function"
    end
    function API:SetEnabled(value)
        if st.unloaded then return false end
        cfg.enabled = value == true
        if not cfg.enabled then resetJump() end
        notify(cfg.enabled and "Rooftop 2 silent aim ON" or "Rooftop 2 silent aim OFF")
        return true
    end
    function API:SetShootMode(value)
        cfg.shootMode = value == "Jump apex" and "Jump apex" or "Click"
        resetJump()
        notify("Shoot mode: " .. cfg.shootMode)
    end
    function API:SetArcMode(value)
        cfg.arcMode = value == "Low" and "Low" or "High"
        notify("Rooftop 2 arc: " .. (cfg.arcMode == "Low" and "flat" or "lobbed"))
    end
    function API:SetArcTrim(value)
        cfg.arcTrim = math.clamp(tonumber(value) or 0, -40, 40)
    end
    function API:SetPower(value)
        cfg.power = math.clamp(tonumber(value) or 85, 1, 200)
    end
    function API:SetVerticalBoost(value)
        cfg.verticalBoost = math.clamp(tonumber(value) or 55, -100, 200)
    end
    function API:SetMaxDistance(value)
        cfg.maxDistance = math.clamp(tonumber(value) or 220, 1, 1000)
    end
    function API:SetTargetHoop(value)
        local allowed = { Auto = true, Go1 = true, Go2 = true, Own = true, Opponent = true }
        cfg.targetHoop = allowed[value] and value or "Auto"
    end
    function API:RefreshVariants()
        resetJump()
    end
    function API:Destroy()
        if st.unloaded then return end
        st.unloaded = true
        cfg.enabled = false
        resetJump()
        for _, connection in ipairs(st.connections) do
            pcall(function() connection:Disconnect() end)
        end
        if remote.SendServer == st.hookedSend then
            remote.SendServer = st.originalSend
        end
        notify("Rooftop 2 engine unloaded")
    end
    return API
end

local function createDropOffsSilentAim(externalNotify)
    local PlayersService = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local RunServiceService = game:GetService("RunService")
    local SharedTableRegistry = game:GetService("SharedTableRegistry")
    local VirtualUser = game:GetService("VirtualUser")
    local UserInputService = game:GetService("UserInputService")
    local LocalPlayer = PlayersService.LocalPlayer
    local Mouse = LocalPlayer and LocalPlayer:GetMouse()

    local function notify(message)
        if type(externalNotify) == "function" then
            externalNotify(tostring(message))
        end
    end

    local EventsFolder = ReplicatedStorage:FindFirstChild("Events")
    local PlayerData = LocalPlayer and LocalPlayer:FindFirstChild("PlayerData")
    local GameData = PlayerData and PlayerData:FindFirstChild("GameData")
    if not EventsFolder or not GameData or not Mouse then
        notify("Drop Offs shooting objects unavailable in this place")
        return nil
    end

    local Config = {
        Enabled = false,
        ShootMode = "Click",
        TargetHoop = "Auto",
        ApexVelocity = 0.5,
        RisingVelocity = 3,
        FallbackHeight = 8,
    }
    local State = {
        Unloaded = false,
        JumpArmed = false,
        ShotFired = false,
        Connections = {},
        Target = nil,
        ActorState = nil,
        ActorCode = nil,
        ActorInjected = setmetatable({}, { __mode = "k" }),
        LastActorSweep = 0,
    }

    local function connect(connection)
        table.insert(State.Connections, connection)
        return connection
    end

    local function getCharacter()
        local character = LocalPlayer.Character
        if not character then return nil end
        local root = character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("Torso")
        local head = character:FindFirstChild("Head")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        local ball = character:FindFirstChild("Ball")
        if not root or not head or not humanoid then return nil end
        return character, root, head, humanoid, ball
    end

    local function getValue(name)
        local value = GameData:FindFirstChild(name)
        return value and value.Value
    end

    local function getCourt()
        local courtName = getValue("Court")
        if type(courtName) ~= "string" or courtName == "" then return nil end
        return workspace:FindFirstChild(courtName)
    end

    local function offensiveAnchor(court)
        if not court then return nil end
        local team = tostring(getValue("Team") or "Team1")
        local mode = Config.TargetHoop
        local useFirst
        if mode == "Go1" then
            useFirst = true
        elseif mode == "Go2" then
            useFirst = false
        elseif mode == "Own" then
            useFirst = team ~= "Team1"
        else
            -- BallAnimations uses Trig for Team1 alley-oops and Trig1 for
            -- Team2, so this is the game's own offensive-goal mapping.
            useFirst = team == "Team1"
        end
        return court:FindFirstChild(useFirst and "Trig" or "Trig1")
            or court:FindFirstChild(useFirst and "Trig1" or "Trig")
    end

    local function targetPriority(part)
        local name = string.lower(part.Name)
        if string.find(name, "points ring", 1, true) then return 0 end
        if string.find(name, "perfect", 1, true) then return 1 end
        if name == "rim" or string.find(name, "mainrim", 1, true) then return 2 end
        if string.find(name, "ring", 1, true) then return 3 end
        if string.find(name, "basket", 1, true) then return 5 end
        if string.find(name, "goal", 1, true) then return 6 end

        local cursor = part.Parent
        while cursor and cursor ~= workspace do
            local parentName = string.lower(cursor.Name)
            if string.find(parentName, "hoop", 1, true)
                or string.find(parentName, "rim", 1, true)
                or string.find(parentName, "basket", 1, true) then
                return 12
            end
            cursor = cursor.Parent
        end
        return nil
    end

    local function solveTarget()
        local court = getCourt()
        if not court then return nil end
        local anchor = offensiveAnchor(court)
        local _, root, head = getCharacter()
        local anchorPosition = anchor and anchor:IsA("BasePart") and anchor.Position
            or (root and root.Position)
        if not anchorPosition then return nil end

        local bestPart, bestScore
        for _, object in ipairs(court:GetDescendants()) do
            if object:IsA("BasePart") then
                local priority = targetPriority(object)
                if priority then
                    local score = priority * 1000 + (object.Position - anchorPosition).Magnitude
                    if not bestScore or score < bestScore then
                        bestPart, bestScore = object, score
                    end
                end
            end
        end

        local origin = head and head.Position or (root and root.Position)
        if bestPart then
            return UniversalShotVariants.ResolveAimPoint(bestPart, origin, bestPart.Position, 1000)
        end
        if anchor and anchor:IsA("BasePart") then
            local fallback = anchor.Position + Vector3.new(0, Config.FallbackHeight, 0)
            return UniversalShotVariants.ResolveAimPoint(anchor, origin, fallback, 1000)
        end
        return nil
    end

    local stateName = ("DropOffsAim%d%d"):format(
        math.floor(os.clock() * 1000) % 1000000,
        math.random(100000, 999999)
    )
    local stateOk, actorState = pcall(function()
        local sharedState = SharedTableRegistry:GetSharedTable(stateName)
        sharedState.T = nil
        sharedState.A = false
        sharedState.F = 0
        return sharedState
    end)
    if stateOk then State.ActorState = actorState end

    local function publishTarget(target)
        State.Target = typeof(target) == "Vector3" and target or nil
        if State.ActorState then
            pcall(function()
                State.ActorState.T = State.Target
                State.ActorState.A = Config.Enabled and not State.Unloaded
            end)
        end
    end

    local function currentTarget()
        if not Config.Enabled or State.Unloaded then return nil end
        local _, _, _, _, ball = getCharacter()
        if not ball then return nil end
        return State.Target
    end

    -- Keep a main-VM hook for executors that do not isolate LocalScripts.
    if type(hookmetamethod) == "function" then
        local oldIndex
        local indexBody = function(self, key)
            if self == Mouse and key == "Hit" then
                local target = currentTarget()
                if target then return CFrame.new(target) end
            end
            return oldIndex(self, key)
        end
        local wrap = EXECUTOR_CAPABILITIES.newcclosure
        pcall(function()
            oldIndex = hookmetamethod(game, "__index",
                type(wrap) == "function" and wrap(indexBody) or indexBody)
        end)
    end

    -- BallAnimations may execute inside an Actor. Install the same Mouse.Hit
    -- redirect in every Actor and share only the already-resolved Vector3.
    if State.ActorState and type(EXECUTOR_CAPABILITIES.getactors) == "function"
        and type(EXECUTOR_CAPABILITIES.run_on_actor) == "function" then
        State.ActorCode = string.format([=[
local SharedState = game:GetService("SharedTableRegistry"):GetSharedTable(%q)
local Client = game:GetService("Players").LocalPlayer
local ClientMouse = Client:GetMouse()
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local OldIndex
OldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if self == ClientMouse and key == "Hit" then
        local target = SharedState.T
        if SharedState.A == true and typeof(target) == "Vector3" then
            return CFrame.new(target)
        end
    end
    return OldIndex(self, key)
end))

local LastFire = tonumber(SharedState.F) or 0
RunService.Heartbeat:Connect(function()
    local fireId = tonumber(SharedState.F) or 0
    if SharedState.A == true and fireId ~= LastFire then
        LastFire = fireId
        if type(getconnections) == "function" then
            local ok, connections = pcall(getconnections, UserInputService.InputBegan)
            if ok and type(connections) == "table" then
                local fakeInput = {
                    KeyCode = Enum.KeyCode.Unknown,
                    UserInputType = Enum.UserInputType.MouseButton1,
                }
                local invoked = 0
                for _, connection in ipairs(connections) do
                    local functionOk, callback = pcall(function()
                        return connection.Function
                    end)
                    if functionOk and type(callback) == "function" then
                        invoked += 1
                        task.spawn(function()
                            pcall(callback, fakeInput, false)
                        end)
                    else
                        local fireOk, fireMethod = pcall(function()
                            return connection.Fire
                        end)
                        if fireOk and type(fireMethod) == "function" then
                            invoked += 1
                            task.spawn(function()
                                pcall(fireMethod, connection, fakeInput, false)
                            end)
                        end
                    end
                end
                if invoked == 0 and type(firesignal) == "function" then
                    pcall(firesignal, UserInputService.InputBegan, fakeInput, false)
                end
            end
        end
    end
end)
]=], stateName)
    end

    local function injectActors()
        if not State.ActorCode then return 0 end
        local ok, actors = pcall(EXECUTOR_CAPABILITIES.getactors)
        if not ok or type(actors) ~= "table" then return 0 end
        local sent = 0
        for _, actor in ipairs(actors) do
            if not State.ActorInjected[actor] then
                local injected = pcall(
                    EXECUTOR_CAPABILITIES.run_on_actor,
                    actor,
                    State.ActorCode
                )
                if injected then
                    State.ActorInjected[actor] = true
                    sent += 1
                end
            end
        end
        return sent
    end
    injectActors()

    local function resetJump()
        State.JumpArmed = false
        State.ShotFired = false
    end

    local function invokeInputConnections()
        local getter = EXECUTOR_CAPABILITIES.getconnections
        if type(getter) ~= "function" then return false end
        local ok, connections = pcall(getter, UserInputService.InputBegan)
        if not ok or type(connections) ~= "table" then return false end

        local fakeInput = {
            KeyCode = Enum.KeyCode.Unknown,
            UserInputType = Enum.UserInputType.MouseButton1,
        }
        local invoked = 0
        for _, connection in ipairs(connections) do
            local functionOk, callback = pcall(function()
                return connection.Function
            end)
            if functionOk and type(callback) == "function" then
                invoked += 1
                task.spawn(function()
                    pcall(callback, fakeInput, false)
                end)
            else
                local fireOk, fireMethod = pcall(function()
                    return connection.Fire
                end)
                if fireOk and type(fireMethod) == "function" then
                    invoked += 1
                    task.spawn(function()
                        pcall(fireMethod, connection, fakeInput, false)
                    end)
                end
            end
        end
        if invoked == 0 and type(EXECUTOR_CAPABILITIES.firesignal) == "function" then
            return pcall(
                EXECUTOR_CAPABILITIES.firesignal,
                UserInputService.InputBegan,
                fakeInput,
                false
            )
        end
        return invoked > 0
    end

    local function requestActorShot()
        if not State.ActorState then return false end
        return pcall(function()
            State.ActorState.F = (tonumber(State.ActorState.F) or 0) + 1
        end)
    end

    local function sendVirtualClick(x, y)
        local camera = workspace.CurrentCamera
        if not camera then return false end
        local point = Vector2.new(x, y)
        local sentVu = pcall(function()
            VirtualUser:Button1Down(point, camera.CFrame)
            task.wait()
            VirtualUser:Button1Up(point, camera.CFrame)
        end)
        return sentVu
    end

    local function fireNativeClick()
        -- Invoke BallAnimations' actual InputBegan callback first. Its callback
        -- only reads KeyCode/UserInputType from p40, so a small table is enough
        -- to execute the original u13/u14 + Shoot:FireServer path. Send the same
        -- request into Actors because 1v1 isolates BallAnimations on some clients.
        local fired = requestActorShot()
        fired = invokeInputConnections() or fired

        -- Retain physical input only as a fallback. Use a non-UI screen edge so
        -- BallAnimations receives gameProcessedEvent == false.
        local camera = workspace.CurrentCamera
        if not camera then return fired end
        local x = 12
        local y = math.max(48, math.floor(camera.ViewportSize.Y) - 48)
        task.delay(0.03, function()
            if not State.Unloaded and Config.Enabled and State.ShotFired then
                sendVirtualClick(x, y)
                local nativeClick = EXECUTOR_CAPABILITIES.mouse1click
                if type(nativeClick) == "function" then pcall(nativeClick) end
            end
        end)
        return fired
    end

    connect(RunServiceService.Heartbeat:Connect(function()
        if State.Unloaded then return end

        if Config.Enabled then
            local _, root, _, humanoid, ball = getCharacter()
            if ball then publishTarget(solveTarget()) else publishTarget(nil) end

            if os.clock() - State.LastActorSweep >= 1 then
                State.LastActorSweep = os.clock()
                injectActors()
            end

            if Config.ShootMode == "Jump apex" and root and humanoid and ball then
                if humanoid.FloorMaterial ~= Enum.Material.Air then
                    resetJump()
                else
                    local velocityY = root.AssemblyLinearVelocity.Y
                    if velocityY > Config.RisingVelocity then
                        State.JumpArmed = true
                    elseif State.JumpArmed and not State.ShotFired
                        and velocityY <= Config.ApexVelocity then
                        State.ShotFired = true
                        if not fireNativeClick() then
                            notify("Drop Offs native click unavailable")
                        end
                    end
                end
            else
                resetJump()
            end
        else
            publishTarget(nil)
            resetJump()
        end
    end))

    local API = {}
    function API:IsReady()
        return not State.Unloaded and EventsFolder.Parent ~= nil
    end
    function API:SetEnabled(value)
        if State.Unloaded then return false end
        Config.Enabled = value == true
        if Config.Enabled then
            publishTarget(solveTarget())
            injectActors()
        else
            publishTarget(nil)
            resetJump()
        end
        notify(Config.Enabled and "Drop Offs silent aim ON" or "Drop Offs silent aim OFF")
        return true
    end
    function API:SetShootMode(value)
        Config.ShootMode = value == "Jump apex" and "Jump apex" or "Click"
        resetJump()
        notify("Shoot mode: " .. Config.ShootMode)
    end
    function API:SetTargetHoop(value)
        local allowed = { Auto = true, Go1 = true, Go2 = true, Own = true, Opponent = true }
        Config.TargetHoop = allowed[value] and value or "Auto"
        if Config.Enabled then publishTarget(solveTarget()) end
    end
    function API:RefreshVariants()
        if Config.Enabled then publishTarget(solveTarget()) end
    end
    function API:Destroy()
        if State.Unloaded then return end
        State.Unloaded = true
        Config.Enabled = false
        if State.ActorState then
            pcall(function() State.ActorState.A = false end)
        end
        publishTarget(nil)
        resetJump()
        for _, connection in ipairs(State.Connections) do
            pcall(function() connection:Disconnect() end)
        end
        notify("Drop Offs engine unloaded")
    end
    return API
end

