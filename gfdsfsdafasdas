    self.Janitor:Add(button.MouseEnter:Connect(function()
        lib:_tween(button, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceRaised, TextColor3 = lib.Theme.GoldBright })
        lib:_tween(glow, MOTION.Normal, { Size = UDim2.new(1, 0, 0, 1) })
