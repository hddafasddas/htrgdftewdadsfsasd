-- Always-open scrolling list, single or multi select.
function Section:AddListBox(id, options)
    options = options or {}
    local values = options.Values or {}
    local lib = self.Library
    local height = options.Height or 92
    local row = self:_row(19 + height)

    self:_text(row, options.Text or id, UDim2.new(1, 0, 0, 15), "TextMuted")

    local box = create("ScrollingFrame", {
        Position = UDim2.fromOffset(0, 19), Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = lib.Theme.SurfaceAlt, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = lib.Theme.GoldDark,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = row,
    }, { corner(2), stroke(lib.Theme.BorderSoft), padding(3, 3, 3, 3), list(2) })
    lib:_bind(box, "BackgroundColor3", "SurfaceAlt")

    local default = options.Default
    if options.Multi and type(default) ~= "table" then default = {} end
    local control = newControl(lib, id, default or (options.Multi and {} or values[1]), options.Callback)
    local items = {}

    local function refresh()
        for value, item in pairs(items) do
            local active = options.Multi and control.Value[value] or control.Value == value
            lib:_tween(item, MOTION.Fast, {
                TextColor3 = active and lib.Theme.GoldBright or lib.Theme.TextMuted,
                BackgroundTransparency = active and 0.2 or 1,
            })
        end
    end

    function control:SetValue(value, silent)
        if options.Multi then
            self.Value = type(value) == "table" and value or {}
        else
            self.Value = value
        end
        refresh()
        if not silent then self:_emit(self.Value) end
        return self
    end

    for index, value in ipairs(values) do
        local item = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = lib.Theme.GoldDark,
            BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0,
            Font = FONT, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = lib.Theme.TextMuted, Text = "  " .. tostring(value),
            LayoutOrder = index, Parent = box,
        }, { corner(2) })
        items[value] = item
        self.Janitor:Add(item.MouseButton1Click:Connect(function()
            if options.Multi then
                local copy = {}
                for key, state in pairs(control.Value) do copy[key] = state end
                copy[value] = not copy[value]
                control:SetValue(copy)
            else
                control:SetValue(value)
            end
        end))
        self.Janitor:Add(item.MouseEnter:Connect(function()
            lib:_tween(item, MOTION.Fast, { BackgroundTransparency = 0.4 })
        end))
        self.Janitor:Add(item.MouseLeave:Connect(refresh))
    end

    control:SetValue(control.Value, true)
    return control
end

-- Compact numeric stepper for precise values.
function Section:AddStepper(id, options)
    options = merge({ Min = 0, Max = 100, Default = 0, Step = 1, Rounding = 0 }, options)
    local lib = self.Library
    local row = self:_row(20)

    self:_text(row, options.Text or id, UDim2.new(1, -90, 1, 0), "TextMuted")

    local function nub(offset, glyph)
        return create("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, offset, 0.5, 0),
            Size = UDim2.fromOffset(18, 18), BackgroundColor3 = lib.Theme.SurfaceAlt,
            AutoButtonColor = false, BorderSizePixel = 0, Font = FONT, TextSize = 13,
            TextColor3 = lib.Theme.GoldBright, Text = glyph, Parent = row,
        }, { corner(2), stroke(lib.Theme.BorderSoft) })
    end

    local minus = nub(-66, "-")
    local plus = nub(0, "+")

    local readout = create("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.5, 0),
        Size = UDim2.fromOffset(44, 18), BackgroundColor3 = lib.Theme.SurfaceAlt,
        BorderSizePixel = 0, Font = FONT, TextSize = 12,
        TextColor3 = lib.Theme.Text, Text = "", Parent = row,
    }, { corner(2), stroke(lib.Theme.BorderSoft) })
    lib:_bind(readout, "BackgroundColor3", "SurfaceAlt")
    lib:_bind(readout, "TextColor3", "Text")

    local control = newControl(lib, id, options.Default, options.Callback)
    function control:SetValue(value, silent)
        value = round(clamp(tonumber(value) or options.Min, options.Min, options.Max), options.Rounding)
        self.Value = value
        readout.Text = (options.Prefix or "") .. tostring(value) .. (options.Suffix or "")
        if not silent then self:_emit(value) end
        return self
    end

    local function bump(button, delta)
        self.Janitor:Add(button.MouseButton1Click:Connect(function()
            control:SetValue(control.Value + delta)
            lib:_tween(button, MOTION.Fast, { BackgroundColor3 = lib.Theme.GoldDark })
            task.delay(0.1, function()
                lib:_tween(button, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceAlt })
            end)
        end))
    end
    bump(minus, -options.Step)
    bump(plus, options.Step)

    control:SetValue(control.Value, true)
    return control
end

--== search index ===========================================================

-- Each control-adding method is wrapped once here instead of being edited
-- individually. Any control added anywhere in the script is indexed
-- automatically, so the search can never silently fall out of date.
local SEARCH_METHODS = {
    AddButton = "text", AddLabel = "text", AddDivider = "static",
    AddToggle = "option", AddSlider = "option", AddTextbox = "option",
    AddDropdown = "option", AddKeybind = "option", AddColorPicker = "option",
    AddDial = "option", AddSegmented = "option", AddProgressBar = "option",
    AddListBox = "option", AddStepper = "option",
}

for method, kind in pairs(SEARCH_METHODS) do
    local original = Section[method]
    if original then
        Section[method] = function(self, first, second, ...)
            -- Snapshot the body so we can tell which rows this call created,
            -- however many instances the control happens to add.
            local existing = {}
            for _, child in ipairs(self.Body:GetChildren()) do
                existing[child] = true
            end

            local results = table.pack(original(self, first, second, ...))

            -- Tab and section names are part of the haystack, so "autoguard"
            -- surfaces that whole tab and "tuning" surfaces every tuning row.
            local terms = { self.Tab and self.Tab.Name or "", self.Title or "" }
            if kind == "text" then
                table.insert(terms, tostring(first or ""))
            elseif kind == "option" then
                -- Ids read like guard_head_ride; spacing them lets a natural
                -- query such as "head ride" match the id as well as the label.
                table.insert(terms, (tostring(first or ""):gsub("_", " ")))
                if type(second) == "table" then
                    table.insert(terms, tostring(second.Text or ""))
                    if type(second.Values) == "table" then
                        for _, value in ipairs(second.Values) do
                            table.insert(terms, tostring(value))
                        end
                    end
                end
            end

            local rows = {}
            for _, child in ipairs(self.Body:GetChildren()) do
                if not existing[child] and child:IsA("GuiObject") then
                    table.insert(rows, child)
                end
            end

            local window = self.Tab and self.Tab.Window
            if #rows > 0 and window and window.SearchIndex then
                table.insert(window.SearchIndex, {
                    Tab = self.Tab,
                    Section = self,
                    Rows = rows,
                    Static = kind == "static",
                    Text = string.lower(table.concat(terms, " ")),
                })
            end

            return table.unpack(results, 1, results.n)
        end
    end
end

--== config =================================================================

function Aureate:ExportConfig()
    local data = { Version = self.Version, Values = {} }
    for id, control in pairs(self.Options) do
        local value = control.Value
        if typeof(value) == "Color3" then
            data.Values[id] = { __type = "Color3", value = value:ToHex() }
        elseif type(value) ~= "function" then
            data.Values[id] = value
        end
    end
    return HttpService:JSONEncode(data)
end

function Aureate:ImportConfig(json, silent)
    local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
    if not ok or type(data) ~= "table" then return false, "Invalid config" end
    for id, value in pairs(data.Values or {}) do
        local control = self.Options[id]
        if control and control.SetValue then
            if type(value) == "table" and value.__type == "Color3" then
                value = Color3.fromHex(value.value)
            end
            control:SetValue(value, silent)
        end
    end
    return true
end

function Aureate:SaveConfig(name)
    if not writefile then return false, "No filesystem access" end
    if makefolder then pcall(makefolder, self.ConfigFolder) end
    local ok, err = pcall(writefile, self.ConfigFolder .. "/" .. (name or "default") .. ".json", self:ExportConfig())
    return ok, err
end

function Aureate:LoadConfig(name, silent)
    if not readfile or not isfile then return false, "No filesystem access" end
    local path = self.ConfigFolder .. "/" .. (name or "default") .. ".json"
    if not isfile(path) then return false, "Config not found" end
    local ok, contents = pcall(readfile, path)
    if not ok then return false, contents end
    return self:ImportConfig(contents, silent)
end

function Aureate:Destroy()
    for _, window in ipairs(self.Windows) do window:Destroy() end
    self.Janitor:Clean()
    table.clear(self.Options)
    table.clear(self.Bindings)
    table.clear(self.Windows)
end


