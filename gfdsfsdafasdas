    local lib = self.Library
    local row = self:_row(35)

    self:_text(row, options.Text or id, UDim2.new(1, 0, 0, 15), "TextMuted")

    local track = create("Frame", {
        Position = UDim2.fromOffset(0, 19), Size = UDim2.new(1, 0, 0, 16),
        BackgroundColor3 = lib.Theme.SurfaceAlt, BorderSizePixel = 0,
        ClipsDescendants = true, Parent = row,
    }, { corner(2), stroke(lib.Theme.BorderSoft) })
    lib:_bind(track, "BackgroundColor3", "SurfaceAlt")

    local fill = create("Frame", {
        Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = lib.Theme.GoldDark,
        BorderSizePixel = 0, Parent = track,
    })
    lib:_bind(fill, "BackgroundColor3", "GoldDark")
    local sheen = create("Frame", {
        Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = lib.Theme.GoldBright,
        BorderSizePixel = 0, Parent = fill,
    })
    lib:_bind(sheen, "BackgroundColor3", "GoldBright")

    local valueText = create("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = FONT,
        TextSize = 12, TextColor3 = lib.Theme.Text, Text = "", ZIndex = 3, Parent = track,
    })
    lib:_bind(valueText, "TextColor3", "Text")

    local hit = create("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, ZIndex = 4, Parent = track,
    })

    local control = newControl(lib, id, options.Default, options.Callback)
    function control:SetValue(value, silent)
        value = round(clamp(tonumber(value) or options.Min, options.Min, options.Max), options.Rounding)
        self.Value = value
        local alpha = (options.Max - options.Min) ~= 0 and (value - options.Min) / (options.Max - options.Min) or 0
        valueText.Text = (options.Prefix or "") .. tostring(value) .. (options.Suffix or "")
        lib:_tween(fill, MOTION.Fast, { Size = UDim2.new(alpha, 0, 1, 0) })
        if not silent then self:_emit(value) end
        return self
    end

    local dragging = false
    local function update(position)
        local alpha = clamp((position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        control:SetValue(options.Min + (options.Max - options.Min) * alpha)
    end

    self.Janitor:Add(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position)
        end
    end))
    self.Janitor:Add(UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input.Position) end
    end))
    self.Janitor:Add(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end))
    self.Janitor:Add(hit.MouseEnter:Connect(function()
        lib:_tween(track, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceRaised })
    end))
    self.Janitor:Add(hit.MouseLeave:Connect(function()
        lib:_tween(track, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceAlt })
    end))

    control:SetValue(control.Value, true)
    return control
end

