        -- defensive autoguard.
        offenseAuto = false,
        offenseAutoManualOverride = true,
        offenseAutoStopDistance = 1.75,
        offenseAutoResponsiveness = 10,

        -- Learned movement style. The UI only exposes train/show/auto/reset;
        -- these are stable internal model parameters.
        offenseTraining = false,
        offenseLearnInterval = 0.12,
        offenseLearnMinSamples = 16,
        offenseLearnMaxSamples = 600,
        offenseLearnNeighbors = 24,
        offenseLearnWeight = 22,
        offenseLearnChunkSize = 5,
        offenseLearnModeCount = 8,
        offenseLearnHistorySize = 6,
        offenseLearnCorrectionWeight = 3,
        offenseLearnReplanInterval = 0.24,
        offenseLearnSaveEvery = 20,
