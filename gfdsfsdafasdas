State.AutoOffense.LastDefenderDistance = math.huge
State.AutoOffense.StealLaneAligned = false
State.AutoOffense.StealLaneAlignment = -1
State.AutoOffense.StealLaneWidth = math.huge
State.AutoOffense.ShieldTurnUntil = 0
State.AutoOffense.ShieldTurnAngle = 0
