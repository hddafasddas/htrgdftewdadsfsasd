end

function State.PerfectShotStyle.IsNear(Object)
local Part = Object:IsA('BasePart') and Object or Object:FindFirstAncestorWhichIsA('BasePart')
if not Part then return true end
local Origin = State.PerfectShotStyle.Origin
if Origin and (Part.Position - Origin).Magnitude <= 24 then return true end
local Root = LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
return Root and (Part.Position - Root.Position).Magnitude <= 24 or false
end

-- Prevent the color watcher from scheduling itself when this script writes
-- the same property back to the chosen perfect-shot style.
State.PerfectShotStyle.Applying = State.PerfectShotStyle.Applying or setmetatable({}, { __mode = 'k' })

function State.PerfectShotStyle.ApplyObject(Object)
if os.clock() > State.PerfectShotStyle.ActiveUntil then return end
if not (Object and Object.Parent and State.PerfectShotStyle.IsNear(Object)) then return end
local IsSequence = Object:IsA('ParticleEmitter') or Object:IsA('Trail') or Object:IsA('Beam')
local IsLight = Object:IsA('PointLight') or Object:IsA('SpotLight') or Object:IsA('SurfaceLight')
local IsHighlight = Object:IsA('Highlight')
if not (IsSequence or IsLight or IsHighlight) then return end
State.PerfectShotStyle.Objects[Object] = true
-- The game's Perfect Shot loop writes its default Color again before every
-- Emit call. Watch that property and immediately restore the selected color.
if not IsHighlight and not State.PerfectShotStyle.ColorWatches[Object] then
pcall(function()
State.PerfectShotStyle.ColorWatches[Object] = Object:GetPropertyChangedSignal('Color'):Connect(function()
if os.clock() <= State.PerfectShotStyle.ActiveUntil and not State.PerfectShotStyle.Applying[Object] then
State.PerfectShotStyle.Applying[Object] = true
task.defer(function()
pcall(State.PerfectShotStyle.ApplyObject, Object)
-- Keep the guard through the property's signal dispatch, then release it.
task.defer(function() State.PerfectShotStyle.Applying[Object] = nil end)
end)
end
end)
end)
end
local Sequence = State.PerfectShotStyle.Sequence()
local Color = State.PerfectShotStyle.Color()
State.PerfectShotStyle.Applying[Object] = true
pcall(function()
if IsSequence then
if Object.Color ~= Sequence then Object.Color = Sequence end
elseif IsLight then
if Object.Color ~= Color then Object.Color = Color end
elseif IsHighlight then
if Object.FillColor ~= Color then Object.FillColor = Color end
if Object.OutlineColor ~= Color then Object.OutlineColor = Color end
end
end)
task.defer(function() State.PerfectShotStyle.Applying[Object] = nil end)
end

function State.PerfectShotStyle.ApplyEffects()
local Effects = Workspace:FindFirstChild('Effects')
if Effects then
for _, Object in ipairs(Effects:GetDescendants()) do
State.PerfectShotStyle.ApplyObject(Object)
end
end
State.PerfectShotStyle.ApplyText()
end

function State.PerfectShotStyle.Trigger(Position)
table.clear(State.PerfectShotStyle.Objects)
State.PerfectShotStyle.Origin = typeof(Position) == 'Vector3' and Position or nil
State.PerfectShotStyle.ActiveUntil = os.clock() + 2.4
State.PerfectShotStyle.LastScanAt = 0
State.PerfectShotStyle.LastLockAt = 0
for _, Delay in ipairs({ 0, 0.03, 0.12, 0.3, 0.65, 1.1, 1.7 }) do
task.delay(Delay, function()
if os.clock() <= State.PerfectShotStyle.ActiveUntil then
pcall(State.PerfectShotStyle.ApplyEffects)
end
end)
end
end

pcall(function()
GiveSignal(Workspace.DescendantAdded:Connect(function(Object)
if os.clock() <= State.PerfectShotStyle.ActiveUntil then
task.defer(function() pcall(State.PerfectShotStyle.ApplyObject, Object) end)
end
end))
-- Property listeners catch immediate game writes. A 30 Hz lock and occasional
-- hierarchy rescan cover bulk-cloned effect models without doing either per frame.
GiveSignal(RunService.RenderStepped:Connect(function()
local Now = os.clock()
if Now > State.PerfectShotStyle.ActiveUntil then return end
if Now - State.PerfectShotStyle.LastLockAt >= (1 / 30) then
State.PerfectShotStyle.LastLockAt = Now
for Object in pairs(State.PerfectShotStyle.Objects) do
pcall(State.PerfectShotStyle.ApplyObject, Object)
end
end
if Now - State.PerfectShotStyle.LastScanAt >= 0.2 then
State.PerfectShotStyle.LastScanAt = Now
pcall(State.PerfectShotStyle.ApplyEffects)
end
end))
end)

-- Ball Studio: flight trail, custom ball skins/models, shot sounds, cosmetic
-- colorizer and the hard unequip used by every 'None' option. Everything hangs
-- off State so the main chunk gains no new locals (Luau 200-register ceiling).
State.BallStudio = {
Tag = 'SilverSurferBallStudio',
Tracked = nil,
Holding = false,
FlightUntil = 0,
LastTintAt = 0,
LastUpdateAt = 0,
LastProxyVerifyAt = 0,
OriginalColor = setmetatable({}, { __mode = 'k' }),
OriginalFade = setmetatable({}, { __mode = 'k' }),
TakenOver = setmetatable({}, { __mode = 'k' }),
SkinWatch = nil,
LastSkinAt = 0,
TextureCache = {},
CatalogCache = {},
Proxies = setmetatable({}, { __mode = 'k' }),
Hidden = setmetatable({}, { __mode = 'k' }),
}

function State.BallStudio.Shade(RedKey, GreenKey, BlueKey)
return Color3.fromRGB(
math.clamp(math.floor(tonumber(CONFIG[RedKey]) or 255), 0, 255),
math.clamp(math.floor(tonumber(CONFIG[GreenKey]) or 255), 0, 255),
math.clamp(math.floor(tonumber(CONFIG[BlueKey]) or 255), 0, 255))
end

function State.BallStudio.Asset(Value)
local Id = math.floor(tonumber(Value) or 0)
if Id <= 0 then return nil end
return 'rbxassetid://' .. tostring(Id)
end

-- Trail.Texture expects an image content ID. Catalog decal IDs frequently point
-- to a Decal instance instead, so resolve that asset to its underlying Texture
-- first. Direct image IDs still fall back unchanged. Results are cached because
-- GetObjects may yield while Roblox downloads the asset.
function State.BallStudio.ResolveTexture(Value)
local Number = math.max(0, math.floor(tonumber(Value) or 0))
if Number <= 0 then return nil end
local Cached = State.BallStudio.TextureCache[Number]
if Cached ~= nil then return Cached ~= false and Cached or nil end
local Direct = 'rbxassetid://' .. tostring(Number)
local Resolved = Direct
local Ok, Objects = pcall(game.GetObjects, game, Direct)
if Ok and type(Objects) == 'table' then
for _, Root in ipairs(Objects) do
local Candidates = { Root }
for _, Object in ipairs(Root:GetDescendants()) do Candidates[#Candidates + 1] = Object end
for _, Object in ipairs(Candidates) do
local Content
if Object:IsA('Decal') or Object:IsA('Texture') then
Content = Object.Texture
elseif Object:IsA('ImageLabel') or Object:IsA('ImageButton') then
Content = Object.Image
elseif Object:IsA('SpecialMesh') then
Content = Object.TextureId
elseif Object:IsA('MeshPart') then
Content = Object.TextureID
end
if type(Content) == 'string' and Content ~= '' then
Resolved = Content
break
end
end
pcall(function() Root:Destroy() end)
if Resolved ~= Direct then break end
end
end
State.BallStudio.TextureCache[Number] = Resolved or false
return Resolved
end

function State.BallStudio.Purge(Ball, Kind)
if not Ball then return end
local Objects = Ball:GetDescendants()
for Index = #Objects, 1, -1 do
local Object = Objects[Index]
local Mark = Object:GetAttribute(State.BallStudio.Tag)
if Mark ~= nil and (Kind == nil or Mark == Kind) then
pcall(function() Object:Destroy() end)
end
end
end

-- Hard unequip. The game re-serves cosmetics through the replicator, so simply
-- clearing the attribute left the spawned emitters behind. This walks the ball
-- and removes anything owned by that category, never touching our own objects.
function State.BallStudio.HardUnequip(Ball, Category)
if not Ball then return end
pcall(function() Ball:SetAttribute(Category, nil) end)
pcall(State.ClearBallCosmeticObjects, Ball, Category)
local Objects = Ball:GetDescendants()
for Index = #Objects, 1, -1 do
local Object = Objects[Index]
if Object:GetAttribute(State.BallStudio.Tag) == nil then
local Owner = Object
local Matches = false
while Owner and Owner ~= Ball do
if Owner:GetAttribute(Category) ~= nil then
Matches = true
break
end
Owner = Owner.Parent
end
if Matches then pcall(function() Object:Destroy() end) end
end
end
end

-- Body aura 'None' previously only removed our clones, so the server rig kept
-- rendering. Anything flagged Takeover now gets switched off as well.
function State.BallStudio.StripBodyAura(Character)
Character = Character or LP.Character
if not Character then return end
for _, Object in ipairs(Character:GetDescendants()) do
if Object:GetAttribute('Takeover') ~= nil
or Object:GetAttribute('SilverSurferLocalAura') ~= nil then
if Object:IsA('ParticleEmitter') or Object:IsA('Trail')
or Object:IsA('Beam') or Object:IsA('PointLight')
or Object:IsA('SpotLight') or Object:IsA('SurfaceLight') then
pcall(function() Object.Enabled = false end)
end
end
end
end

function State.BallStudio.EnsureTrail(Ball)
if not (Ball and Ball:IsA('BasePart')) then return nil end
local Existing = Ball:FindFirstChild('SilverSurferTrail')
if Existing and Existing:IsA('Trail') then return Existing end
local Made
pcall(function()
local Radius = math.max(Ball.Size.X, Ball.Size.Y, Ball.Size.Z) * 0.5
local Top = Instance.new('Attachment')
Top.Name = 'SilverSurferTrailA0'
Top.Position = Vector3.new(0, Radius * 0.8, 0)
Top:SetAttribute(State.BallStudio.Tag, 'Trail')
Top.Parent = Ball
local Bottom = Instance.new('Attachment')
