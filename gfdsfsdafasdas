function Section:AddDropdown(id, options)
    options = options or {}
    local values = options.Values or {}
    local lib = self.Library
    local section = self
    local row = self:_row(40)

    self:_text(row, options.Text or id, UDim2.new(1, 0, 0, 15), "TextMuted")

    local selector = create("TextButton", {
        Position = UDim2.fromOffset(0, 19), Size = UDim2.new(1, 0, 0, 21),
        BackgroundColor3 = lib.Theme.SurfaceAlt, AutoButtonColor = false,
        BorderSizePixel = 0, Font = FONT, TextSize = TEXT,
        TextColor3 = lib.Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Text = "", ZIndex = 2, Parent = row,
    }, { corner(2), stroke(lib.Theme.BorderSoft), padding(0, 24, 0, 7) })
    lib:_bind(selector, "BackgroundColor3", "SurfaceAlt")
    lib:_bind(selector, "TextColor3", "Text")

    -- Chevron drawn from two rotated bars so it renders on every device.
    local chevron = create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -7, 0.5, 0),
        Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, ZIndex = 3, Parent = selector,
    })
    local barL = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(4, 6),
        Size = UDim2.fromOffset(7, 1), Rotation = 45, BackgroundColor3 = lib.Theme.Gold,
        BorderSizePixel = 0, ZIndex = 3, Parent = chevron,
    })
    local barR = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(8, 6),
        Size = UDim2.fromOffset(7, 1), Rotation = -45, BackgroundColor3 = lib.Theme.Gold,
        BorderSizePixel = 0, ZIndex = 3, Parent = chevron,
    })
    lib:_bind(barL, "BackgroundColor3", "Gold")
    lib:_bind(barR, "BackgroundColor3", "Gold")

    -- Click-catcher sits under the menu and above everything else, so a click
    -- anywhere outside the list closes it without any coordinate maths.
    local blocker = create("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, Visible = false, ZIndex = 500, Parent = lib.Overlay,
    })

    local menu = create("Frame", {
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = lib.Theme.SurfaceRaised,
        BorderSizePixel = 0, ClipsDescendants = true, Visible = false,
        ZIndex = 501, Parent = lib.Overlay,
    }, { corner(2), stroke(lib.Theme.Border) })
    lib:_bind(menu, "BackgroundColor3", "SurfaceRaised")

    local scroller = create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = lib.Theme.GoldDark,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
        ZIndex = 502, Parent = menu,
    }, { padding(3, 3, 3, 3), list(2) })

    local default = options.Default
    if type(default) == "number" then default = values[default] end
    if options.Multi and type(default) ~= "table" then default = {} end

    local control = newControl(lib, id, default or (options.Multi and {} or values[1]), options.Callback)
    local items, open = {}, false

    local function refresh()
        if options.Multi then
            local picked = {}
            for _, value in ipairs(values) do
                if control.Value[value] then table.insert(picked, tostring(value)) end
            end
            selector.Text = #picked > 0 and table.concat(picked, ", ") or (options.Placeholder or "--")
        else
            selector.Text = tostring(control.Value or options.Placeholder or "--")
        end
        for value, item in pairs(items) do
            local active = options.Multi and control.Value[value] or control.Value == value
            lib:_tween(item, MOTION.Fast, {
                TextColor3 = active and lib.Theme.GoldBright or lib.Theme.TextMuted,
                BackgroundTransparency = active and 0.15 or 1,
            })
        end
    end

    function control:SetValue(value, silent)
        if options.Multi then
            self.Value = type(value) == "table" and value or {}
        else
            self.Value = value
        end
        refresh()
        if not silent then self:_emit(self.Value) end
        return self
    end

    local function menuHeight()
        return math.min(#values * 22 + 6, 148)
    end

    -- Re-anchors the floating menu directly beneath its selector, flipping it
    -- above when there is not enough room below.
    local function place()
        local origin = lib.Overlay.AbsolutePosition
        local pos, size = selector.AbsolutePosition, selector.AbsoluteSize
        local height = menuHeight()
        local y = pos.Y + size.Y + 3
        if y + height > origin.Y + lib.Overlay.AbsoluteSize.Y - 6 then
            y = pos.Y - height - 3
        end
        menu.Position = UDim2.fromOffset(pos.X - origin.X, y - origin.Y)
    end

    local function setOpen(state)
        if state and lib.OpenDropdown and lib.OpenDropdown ~= setOpen then
            local other = lib.OpenDropdown
            lib.OpenDropdown = nil
            other(false)
        end
        open = state
        lib.OpenDropdown = state and setOpen or nil
        blocker.Visible = state
        local width = selector.AbsoluteSize.X
        if state then
            menu.Visible = true
            place()
            menu.Size = UDim2.fromOffset(width, 0)
            lib:_tween(menu, MOTION.Normal, { Size = UDim2.fromOffset(width, menuHeight()) })
        else
            lib:_tween(menu, MOTION.Fast, { Size = UDim2.fromOffset(menu.AbsoluteSize.X, 0) })
            task.delay(0.2, function() if not open then menu.Visible = false end end)
        end
        lib:_tween(chevron, MOTION.Normal, { Rotation = state and 180 or 0 })
    end

    self.Janitor:Add(blocker.MouseButton1Click:Connect(function() setOpen(false) end))
    self.Janitor:Add(RunService.RenderStepped:Connect(function()
        if open then place() end
    end))

    for index, value in ipairs(values) do
        local item = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = lib.Theme.GoldDark,
            BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0,
            Font = FONT, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
            TextColor3 = lib.Theme.TextMuted, Text = "  " .. tostring(value),
            LayoutOrder = index, ZIndex = 503, Parent = scroller,
        }, { corner(2) })
        items[value] = item
        self.Janitor:Add(item.MouseButton1Click:Connect(function()
            if options.Multi then
                local copy = {}
                for k, v in pairs(control.Value) do copy[k] = v end
                copy[value] = not copy[value]
                control:SetValue(copy)
            else
                control:SetValue(value)
                setOpen(false)
            end
        end))
        self.Janitor:Add(item.MouseEnter:Connect(function()
            lib:_tween(item, MOTION.Fast, { BackgroundTransparency = 0.35 })
        end))
        self.Janitor:Add(item.MouseLeave:Connect(refresh))
    end

    self.Janitor:Add(selector.MouseButton1Click:Connect(function() setOpen(not open) end))
    self.Janitor:Add(selector.MouseEnter:Connect(function()
        lib:_tween(selector, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceRaised })
    end))
    self.Janitor:Add(selector.MouseLeave:Connect(function()
        lib:_tween(selector, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceAlt })
    end))

    -- Dropdowns used to bake their option buttons once at construction time,
    -- so any list built later (live matches, travel points) stayed frozen at
    -- whatever it held on the first frame. SetValues rebuilds the rows.
    function control:SetValues(newValues)
        if type(newValues) == "table" and newValues ~= values then
            table.clear(values)
            for _, v in ipairs(newValues) do table.insert(values, v) end
        end
        for _, old in pairs(items) do
            pcall(function() old:Destroy() end)
        end
        table.clear(items)
        for index, value in ipairs(values) do
            local item = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = lib.Theme.GoldDark,
                BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0,
                Font = FONT, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
                TextColor3 = lib.Theme.TextMuted, Text = "  " .. tostring(value),
                LayoutOrder = index, ZIndex = 503, Parent = scroller,
            }, { corner(2) })
            items[value] = item
            section.Janitor:Add(item.MouseButton1Click:Connect(function()
                if options.Multi then
                    local copy = {}
                    for k, v in pairs(control.Value) do copy[k] = v end
                    copy[value] = not copy[value]
                    control:SetValue(copy)
                else
                    control:SetValue(value)
                    setOpen(false)
                end
            end))
            section.Janitor:Add(item.MouseEnter:Connect(function()
                lib:_tween(item, MOTION.Fast, { BackgroundTransparency = 0.35 })
            end))
            section.Janitor:Add(item.MouseLeave:Connect(refresh))
        end
        refresh()
        return self
    end

    control:SetValue(control.Value, true)
    return control
end

function Section:AddKeybind(id, options)
    options = options or {}
    local lib = self.Library
    local row = self:_row(20)

    self:_text(row, options.Text or id, UDim2.new(1, -72, 1, 0), "TextMuted")

    local picker = create("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(66, 18), AutoButtonColor = false,
        BackgroundColor3 = lib.Theme.SurfaceAlt, BorderSizePixel = 0, Font = FONT,
        TextSize = 12, TextColor3 = lib.Theme.GoldBright,
        Text = options.Default or "None", Parent = row,
    }, { corner(2), stroke(lib.Theme.BorderSoft) })
    lib:_bind(picker, "BackgroundColor3", "SurfaceAlt")
    lib:_bind(picker, "TextColor3", "GoldBright")

    local control = newControl(lib, id, options.Default or "None", options.Callback)
    control.Mode = options.Mode or "Toggle"
    control.State = control.Mode == "Always"
    control.Binding = false

    function control:SetValue(value, silent)
        if type(value) == "table" then
            self.Value = value[1] or "None"
            self.Mode = value[2] or self.Mode
        else
            self.Value = tostring(value or "None")
        end
        picker.Text = self.Value
        if not silent then self:_emit(self.Value) end
        return self
    end
    function control:GetState() return self.Mode == "Always" or self.State end

    self.Janitor:Add(picker.MouseButton1Click:Connect(function()
        control.Binding = true
        picker.Text = "..."
        lib:_tween(picker, MOTION.Fast, { BackgroundColor3 = lib.Theme.GoldDark })
    end))
    self.Janitor:Add(picker.MouseEnter:Connect(function()
        if not control.Binding then
            lib:_tween(picker, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceRaised })
        end
    end))
    self.Janitor:Add(picker.MouseLeave:Connect(function()
        if not control.Binding then
            lib:_tween(picker, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceAlt })
        end
    end))
    self.Janitor:Add(UserInputService.InputBegan:Connect(function(input, processed)
        if control.Binding then
            local name = inputName(input)
            if name then
                control.Binding = false
                control:SetValue(name)
                lib:_tween(picker, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceAlt })
            end
            return
        end
        -- Roblox's camera controller commonly marks RMB as processed. Mouse
        -- aim binds must still receive it or a default MB2/Hold bind never
        -- enters its active state. Keep the processed guard for keyboard keys
        -- so typing and other focused UI do not trigger binds.
        local isMouseButton = input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2
            or input.UserInputType == Enum.UserInputType.MouseButton3
        if (processed and not isMouseButton) or inputName(input) ~= control.Value then return end
        if control.Mode == "Toggle" then
            control.State = not control.State
            safeCall(options.OnClick, control.State)
        elseif control.Mode == "Hold" then
            control.State = true
            safeCall(options.OnClick, true)
        end
    end))
    self.Janitor:Add(UserInputService.InputEnded:Connect(function(input)
        if control.Mode == "Hold" and inputName(input) == control.Value then
            control.State = false
            safeCall(options.OnClick, false)
        end
    end))
    return control
end

