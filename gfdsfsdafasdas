function State.AutoGetOpen.GetPracticeGetOpenGoal(Court, OriginPosition)
if not Court or typeof(OriginPosition) ~= 'Vector3' then return nil end
local CachedCourt = State.AutoGetOpenPracticeCourt
local CachedGoal = State.AutoGetOpenPracticeGoal
if CachedCourt == Court and CachedGoal and CachedGoal.Parent
and CachedGoal:IsDescendantOf(Court) then
return CachedGoal
end

local Goal = FindNearestGoalFromPosition(OriginPosition, Court)
if not Goal then
local OriginXZ = Vector3.new(OriginPosition.X, 0, OriginPosition.Z)
local BestDistance = math.huge
for _, FolderName in ipairs({ 'Hitboxes', 'HitboxesHome', 'HitboxesAway' }) do
