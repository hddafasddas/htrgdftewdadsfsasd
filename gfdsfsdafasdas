function State.PerfectRelease.SamplePing()
local Samples = State.PerfectRelease.PingSamples
local Value = tonumber(State.Utility.GetPing()) or 0
if Value > 0 then
table.insert(Samples, Value)
while #Samples > 15 do table.remove(Samples, 1) end
end
if #Samples == 0 then return Value end
local Sorted = table.clone(Samples)
table.sort(Sorted)
local Middle = #Sorted // 2 + 1
if #Sorted % 2 == 1 then return Sorted[Middle] end
return (Sorted[Middle - 1] + Sorted[Middle]) * 0.5
end

function State.PerfectRelease.CurrentOffset()
if not CONFIG.PerfectReleaseAutoCalibrate then return 0 end
if State.PerfectRelease.Locked then return 0 end
local Offsets = State.PerfectRelease.Offsets
local Index = State.PerfectRelease.OffsetIndex
if Index < 1 or Index > #Offsets then
State.PerfectRelease.OffsetIndex = 1
return Offsets[1]
end
return Offsets[Index]
end

function State.PerfectRelease.AdvanceProbe()
local Offsets = State.PerfectRelease.Offsets
State.PerfectRelease.OffsetIndex =
(State.PerfectRelease.OffsetIndex % #Offsets) + 1
end

function State.PerfectRelease.SpinUntil(Timestamp)
if not CONFIG.PerfectReleasePrecisionSpin then return end
local Deadline = os.clock() + 0.05
while os.clock() < Timestamp and os.clock() < Deadline do end
end

function State.PerfectRelease.Resolve(WasPerfect)
local Pending = State.PerfectRelease.Pending
if not Pending then return end
State.PerfectRelease.Pending = nil
State.PerfectRelease.Attempts += 1

if WasPerfect then
State.PerfectRelease.Hits += 1
State.PerfectRelease.Misses = 0
State.PerfectRelease.Streak += 1
if State.PerfectRelease.Streak > State.PerfectRelease.BestStreak then
State.PerfectRelease.BestStreak = State.PerfectRelease.Streak
end
State.PerfectRelease.LastResult = 'PERFECT'
local ArcPick = State.LastAutoPowerPick
if ArcPick and os.clock() - (ArcPick.At or 0) < 8 then
State.ArcPowerMemory = State.ArcPowerMemory or {}
State.ArcPowerMemory[CONFIG.SilentMode == 'Low' and 'Low' or 'High'] = { Power = ArcPick.Power, At = os.clock() }
end
if CONFIG.PerfectReleaseAutoCalibrate then
local Adopted = math.clamp(
State.PerfectRelease.GetBase() + (Pending.Offset or 0), 0.15, 0.45)
table.insert(State.PerfectRelease.CalibrationSamples, Adopted)
if #State.PerfectRelease.CalibrationSamples >= 5 then
table.sort(State.PerfectRelease.CalibrationSamples)
State.PerfectRelease.Base = State.PerfectRelease.CalibrationSamples[math.ceil(#State.PerfectRelease.CalibrationSamples / 2)]
State.PerfectRelease.OffsetIndex = 1
State.PerfectRelease.Locked = true
State.PerfectRelease.Save()
end
end
return
end

State.PerfectRelease.Streak = 0
State.PerfectRelease.Misses += 1
State.PerfectRelease.LastResult = 'NOT PERFECT'
if not CONFIG.PerfectReleaseAutoCalibrate then return end
if State.PerfectRelease.Misses >= 2 then
State.PerfectRelease.Locked = false
State.PerfectRelease.AdvanceProbe()
end
end

function State.PerfectRelease.RecordAttempt(Delay, Offset)
if not CONFIG.PerfectRelease then return end
local Token = {}
State.PerfectRelease.Pending = {
Delay = Delay,
Offset = Offset or 0,
At = os.clock(),
Token = Token,
}
State.PerfectRelease.LastDelay = Delay
State.PerfectRelease.LastResult = 'WAITING'
task.delay(1.35, function()
local Pending = State.PerfectRelease.Pending
if Pending and Pending.Token == Token then
State.PerfectRelease.Resolve(false)
end
end)
end

function State.PerfectRelease.Hook()
if State.PerfectRelease.Connection then return end
pcall(function()
local Remotes = ReplicatedStorage:FindFirstChild('Remotes')
local PerfectEvent = Remotes and Remotes:FindFirstChild('perfectEvent')
if not PerfectEvent then return end
State.PerfectRelease.Connection = PerfectEvent.OnClientEvent:Connect(
function(Shooter, ...)
if Shooter ~= LP then return end
State.PerfectRelease.LastPerfectAt = os.clock()
State.PerfectRelease.Resolve(true)
local Position = select(2, ...)
if State.PerfectShotStyle then State.PerfectShotStyle.Trigger(Position) end
end
)
end)
end

function State.PerfectRelease.Accuracy()
if State.PerfectRelease.Attempts <= 0 then return 0 end
return State.PerfectRelease.Hits / State.PerfectRelease.Attempts * 100
end

function State.PerfectRelease.Reset()
State.PerfectRelease.Base = nil
State.PerfectRelease.Locked = false
State.PerfectRelease.OffsetIndex = 1
State.PerfectRelease.Misses = 0
table.clear(State.PerfectRelease.CalibrationSamples)
State.PerfectRelease.Hits = 0
State.PerfectRelease.Attempts = 0
State.PerfectRelease.Streak = 0
State.PerfectRelease.LastResult = 'IDLE'
State.PerfectRelease.Save()
end

State.PerfectRelease.Load()
State.PerfectRelease.Hook()

local function GetPerfectReleaseClientDelay()
local PingMilliseconds = math.clamp(
State.PerfectRelease.SamplePing(), 0, CONFIG.PerfectReleaseMaximumPing)
local OneWayLatency = CONFIG.PerfectReleasePingCompensation
and PingMilliseconds / 2000 or 0
local Offset = State.PerfectRelease.CurrentOffset()
local ClientDelay = State.PerfectRelease.GetBase() + Offset - OneWayLatency
return math.clamp(
ClientDelay,
CONFIG.PerfectReleaseMinimumClientDelay,
CONFIG.PerfectReleaseMaximumClientDelay
), PingMilliseconds, Offset
end

