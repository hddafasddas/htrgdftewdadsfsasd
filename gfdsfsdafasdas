-- The ball handle is an invisible Part (Shape = Ball, Transparency = 1). Every
-- visible piece of a ball skin is cloned onto it by the game replicator and
-- flagged with the 'Ball' attribute, so a decal or a second mesh added next to
-- them never renders. A custom ball has to take that skin layer over instead.
function State.BallStudio.StripGameSkin(Ball)
if not Ball then return end
for _, Child in ipairs(Ball:GetChildren()) do
if Child:GetAttribute('Ball') ~= nil
and Child:GetAttribute(State.BallStudio.Tag) == nil then
pcall(function() Child:Destroy() end)
end
end
end

function State.BallStudio.RestoreGameSkin(Ball)
if not (Ball and State.BallStudio.TakenOver[Ball]) then return end
State.BallStudio.TakenOver[Ball] = nil
if State.Cosmetics.Replicator and State.Cosmetics.Replicator.ReplicateBall then
pcall(function()
State.Cosmetics.Replicator.ReplicateBall(Ball, Ball:GetAttribute('Ball') or 'Ball_Default')
end)
end
end

-- The replicator re-serves the stock skin whenever the ball is re-parented or a
-- cosmetic event fires, so the takeover is re-asserted on every child added.
function State.BallStudio.WatchBall(Ball)
if State.BallStudio.SkinWatch then
pcall(function() State.BallStudio.SkinWatch:Disconnect() end)
State.BallStudio.SkinWatch = nil
end
if not Ball then return end
State.BallStudio.SkinWatch = Ball.ChildAdded:Connect(function(Child)
if not (CONFIG.BallStudioEnabled and CONFIG.CustomBallEnabled) then return end
if Child:GetAttribute(State.BallStudio.Tag) ~= nil then return end
task.defer(function()
if Child.Parent == Ball and Child:GetAttribute('Ball') ~= nil then
pcall(function() Child:Destroy() end)
end
end)
end)
end

-- Every ball part the local player can actually see: the tagged handle (the
-- loose / in-flight ball) and every part of the held Basketball tool. The old
-- code only ever skinned the tagged handle, which is why a trail showed up on
-- a shot but the mesh and decals never appeared while dribbling.
function State.BallStudio.Targets()
local Found, Seen = {}, {}
local function Add(Part)
if Part and Part:IsA('BasePart') and not Seen[Part] then
Seen[Part] = true
Found[#Found + 1] = Part
end
end
Add(GetLocalBallHandle())
local Character = LP.Character
local Basketball = Character and Character:FindFirstChild('Basketball')
if Basketball then
Add(Basketball:FindFirstChild('Ball'))
for _, Object in ipairs(Basketball:GetDescendants()) do
if Object:IsA('BasePart') and Object:GetAttribute(State.BallStudio.Tag) == nil then
Add(Object)
end
end
end
return Found
end

-- The custom skin lives on our own part instead of on the game's ball. A decal
-- or SpecialMesh parented straight onto the ball fought the replicator, the
-- cosmetics spoofer and the tool's per-frame transparency reset, and lost. The
-- proxy is anchored and re-positioned every frame, so it never touches the
-- physics of the real ball and nothing in the game knows it exists.
function State.BallStudio.EnsureProxy(Ball)
local Proxy = State.BallStudio.Proxies[Ball]
if Proxy and Proxy.Parent then return Proxy end
Proxy = nil
pcall(function()
Proxy = Instance.new('Part')
Proxy.Name = 'SilverSurferBallSkin'
Proxy.Shape = Enum.PartType.Ball
Proxy.Anchored = true
Proxy.CanCollide = false
Proxy.CanQuery = false
Proxy.CanTouch = false
Proxy.Massless = true
Proxy.CastShadow = false
Proxy.Material = Enum.Material.SmoothPlastic
Proxy.Size = Ball.Size
Proxy.CFrame = Ball.CFrame
Proxy:SetAttribute(State.BallStudio.Tag, 'Skin')
Proxy.Parent = Ball
end)
State.BallStudio.Proxies[Ball] = Proxy
return Proxy
end

function State.BallStudio.DropProxy(Ball)
local Proxy = State.BallStudio.Proxies[Ball]
State.BallStudio.Proxies[Ball] = nil
if Proxy then pcall(function() Proxy:Destroy() end) end
if State.BallStudio.Hidden[Ball] then
State.BallStudio.Hidden[Ball] = nil
local Fade = State.BallStudio.OriginalFade[Ball]
pcall(function() Ball.LocalTransparencyModifier = 0 end)
pcall(function() Ball.Transparency = Fade or 0 end)
end
end

-- The Basketball tool forces LocalTransparencyModifier back to 0 every frame,
-- so the stock ball has to be hidden through Transparency, not through LTM.
function State.BallStudio.HideStock(Ball, Hide)
if Hide then
if State.BallStudio.OriginalFade[Ball] == nil then
State.BallStudio.OriginalFade[Ball] = Ball.Transparency
end
State.BallStudio.Hidden[Ball] = true
if Ball.Transparency < 1 then pcall(function() Ball.Transparency = 1 end) end
elseif State.BallStudio.Hidden[Ball] then
State.BallStudio.Hidden[Ball] = nil
local Fade = State.BallStudio.OriginalFade[Ball]
pcall(function() Ball.Transparency = Fade or 0 end)
end
end

-- Loads a Roblox catalog asset (accessory, model, tool, MeshPart, or Part)
-- and keeps a clean template. Scripts and old joints are never allowed onto the
-- live ball. A false cache entry prevents repeatedly requesting an invalid ID.
function State.BallStudio.LoadCatalogItem(Value)
local Id = math.max(0, math.floor(tonumber(Value) or 0))
if Id <= 0 then return nil end
local Cached = State.BallStudio.CatalogCache[Id]
if Cached == false then return nil end
if typeof(Cached) == 'Instance' then
local Ok, Copy = pcall(function() return Cached:Clone() end)
return Ok and Copy or nil
end
local Direct = 'rbxassetid://' .. tostring(Id)
local Ok, Objects = pcall(game.GetObjects, game, Direct)
if not (Ok and type(Objects) == 'table' and Objects[1]) then
State.BallStudio.CatalogCache[Id] = false
return nil
end
local Template = Objects[1]
for Index = 2, #Objects do pcall(function() Objects[Index]:Destroy() end) end
for _, Object in ipairs(Template:GetDescendants()) do
if Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
or Object:IsA('JointInstance') or Object:IsA('WeldConstraint') then
pcall(function() Object:Destroy() end)
end
end
State.BallStudio.CatalogCache[Id] = Template
local CloneOk, Copy = pcall(function() return Template:Clone() end)
return CloneOk and Copy or nil
end

function State.BallStudio.MountCatalogItem(Ball, Proxy, Value, Scale, Tint)
local Item = State.BallStudio.LoadCatalogItem(Value)
if not Item then return false end
local Container = Instance.new('Model')
Container.Name = 'SilverSurferCatalogBall'
Container:SetAttribute(State.BallStudio.Tag, 'Skin')
Item.Parent = Container
Container.Parent = Proxy
local Parts = {}
for _, Object in ipairs(Container:GetDescendants()) do
if Object:IsA('Script') or Object:IsA('LocalScript') or Object:IsA('ModuleScript')
or Object:IsA('JointInstance') or Object:IsA('WeldConstraint') then
pcall(function() Object:Destroy() end)
elseif Object:IsA('BasePart') then
Parts[#Parts + 1] = Object
Object.Anchored = true
Object.CanCollide = false
Object.CanQuery = false
Object.CanTouch = false
Object.Massless = true
Object.CastShadow = false
if Tint then
Object.Color = Tint
if Object:IsA('MeshPart') then pcall(function() Object.UsePartColor = true end) end
end
elseif Tint and (Object:IsA('Decal') or Object:IsA('Texture')) then
Object.Color3 = Tint
elseif Tint and Object:IsA('SpecialMesh') then
Object.VertexColor = Vector3.new(Tint.R, Tint.G, Tint.B)
end
end
if #Parts == 0 then Container:Destroy(); return false end
local _, InitialSize = Container:GetBoundingBox()
local Largest = math.max(InitialSize.X, InitialSize.Y, InitialSize.Z)
if Largest <= 0.0001 then Container:Destroy(); return false end
local Diameter = math.max(Ball.Size.X, Ball.Size.Y, Ball.Size.Z)
local Factor = (Diameter * Scale) / Largest
local ScaleOk = pcall(function() Container:ScaleTo(Factor) end)
if not ScaleOk then Container:Destroy(); return false end
local BoxCFrame = Container:GetBoundingBox()
local Shift = Proxy.CFrame * BoxCFrame:Inverse()
Container:PivotTo(Shift * Container:GetPivot())
for _, Part in ipairs(Parts) do
Part.Anchored = false
local Weld = Instance.new('WeldConstraint')
Weld.Name = 'SilverSurferCatalogWeld'
Weld.Part0 = Proxy
Weld.Part1 = Part
Weld:SetAttribute(State.BallStudio.Tag, 'Skin')
Weld.Parent = Part
end
return true
end

function State.BallStudio.ApplyBall(Ball)
if not (Ball and Ball:IsA('BasePart') and Ball.Parent) then return end
if State.BallStudio.OriginalColor[Ball] == nil then
State.BallStudio.OriginalColor[Ball] = Ball.Color
State.BallStudio.OriginalFade[Ball] = Ball.Transparency
end
if not (CONFIG.BallStudioEnabled and CONFIG.CustomBallEnabled) then
State.BallStudio.Purge(Ball, 'Skin')
State.BallStudio.DropProxy(Ball)
local Color = State.BallStudio.OriginalColor[Ball]
pcall(function() if Color then Ball.Color = Color end end)
State.BallStudio.RestoreGameSkin(Ball)
return
end
local Catalog = math.max(0, math.floor(tonumber(CONFIG.CustomBallCatalogId) or 0))
local Skin = State.BallStudio.Asset(CONFIG.CustomBallDecalId)
local Model = State.BallStudio.Asset(CONFIG.CustomBallMeshId)
local Texture = State.BallStudio.Asset(CONFIG.CustomBallMeshTextureId)
if Catalog <= 0 and not (Skin or Model) then
-- Nothing to show yet: leave the stock ball alone instead of hiding it and
-- rendering an empty proxy, which just looked like the ball had vanished.
State.BallStudio.Purge(Ball, 'Skin')
State.BallStudio.DropProxy(Ball)
return
end
local Tint = nil
if CONFIG.CustomBallTint then
Tint = State.BallStudio.Shade('CustomBallR', 'CustomBallG', 'CustomBallB')
end
local Scale = math.clamp(tonumber(CONFIG.CustomBallScale) or 1, 0.001, 5)
State.BallStudio.StripGameSkin(Ball)
State.BallStudio.TakenOver[Ball] = true
State.BallStudio.HideStock(Ball, true)
local Proxy = State.BallStudio.EnsureProxy(Ball)
if not Proxy then
-- Never leave the real ball hidden if a replacement visual could not be made.
State.BallStudio.HideStock(Ball, false)
State.BallStudio.RestoreGameSkin(Ball)
return
end
local Stamp = tostring(Catalog) .. '|' .. tostring(Model or '') .. '|' .. tostring(Skin or '') .. '|'
.. tostring(Texture or '') .. '|' .. tostring(Scale) .. '|'
.. tostring(Tint and Tint:ToHex() or 'none')
if Proxy:GetAttribute('SilverSurferStamp') == Stamp then return end
Proxy:SetAttribute('SilverSurferStamp', Stamp)
for _, Child in ipairs(Proxy:GetChildren()) do
pcall(function() Child:Destroy() end)
end
if Catalog > 0 then
Proxy.Transparency = 1
Proxy.Size = Ball.Size
if State.BallStudio.MountCatalogItem(Ball, Proxy, Catalog, Scale, Tint) then return end
end
if Model then
-- MeshPart.Size is the rendered bounding-box size, unlike SpecialMesh.Scale,
-- which depends on the asset's arbitrary authored dimensions. This makes 1.00
-- automatically fit every model to the original ball's exact size. The UI
-- value is only a multiplier around that fitted size (0.5 half, 2.0 double).
pcall(function()
Proxy.Transparency = 1
Proxy.Size = Ball.Size
local Visual = Instance.new('MeshPart')
Visual.Name = 'SilverSurferBallMesh'
Visual.MeshId = Model
Visual.TextureID = Texture or Skin or ''
local AppliedTint = Tint or Color3.fromRGB(255, 255, 255)
Visual:SetAttribute('SilverSurferFitScale', Scale)
Visual:SetAttribute('SilverSurferTextureId', Texture or Skin or '')
Visual:SetAttribute('SilverSurferTintR', AppliedTint.R)
Visual:SetAttribute('SilverSurferTintG', AppliedTint.G)
Visual:SetAttribute('SilverSurferTintB', AppliedTint.B)
Visual.Size = Ball.Size * Scale
Visual.CFrame = Proxy.CFrame
Visual.Color = AppliedTint
-- MeshPart textures only reliably multiply by Color when UsePartColor is on.
-- This covers both a bare mesh ID and a mesh carrying TextureID.
pcall(function() Visual.UsePartColor = true end)
Visual.Transparency = 0
Visual.Material = Enum.Material.SmoothPlastic
Visual.Anchored = false
Visual.CanCollide = false
Visual.CanQuery = false
Visual.CanTouch = false
Visual.Massless = true
Visual.CastShadow = false
Visual:SetAttribute(State.BallStudio.Tag, 'Skin')
Visual.Parent = Proxy
local Weld = Instance.new('WeldConstraint')
Weld.Name = 'SilverSurferBallMeshWeld'
Weld.Part0 = Proxy
Weld.Part1 = Visual
Weld:SetAttribute(State.BallStudio.Tag, 'Skin')
Weld.Parent = Proxy
end)
return
end
-- Decal-only mode still needs a mesh: Roblox Decal instances are flat face
-- projections and cannot wrap a sphere. A built-in Sphere SpecialMesh gives the
-- image spherical UVs, so one texture covers the whole ball without seams.
-- Mesh textures multiply by the parent's Color, therefore the base must be
-- pure white when tint is disabled or the original ball color will recolor it.
pcall(function()
Proxy.Shape = Enum.PartType.Ball
Proxy.Size = Ball.Size * Scale
Proxy.Transparency = 0
Proxy.Color = Tint or Color3.fromRGB(255, 255, 255)
local Wrap = Instance.new('SpecialMesh')
Wrap.Name = 'SilverSurferBallDecal'
Wrap.MeshType = Enum.MeshType.Sphere
Wrap.TextureId = Skin
Wrap.Scale = Vector3.new(1, 1, 1)
if Tint then
Wrap.VertexColor = Vector3.new(Tint.R, Tint.G, Tint.B)
else
Wrap.VertexColor = Vector3.new(1, 1, 1)
end
Wrap:SetAttribute(State.BallStudio.Tag, 'Skin')
Wrap.Parent = Proxy
end)
end

-- Keeps every proxy glued to its ball. RenderStepped runs after physics, so
-- this is frame accurate and costs nothing on the network.
function State.BallStudio.SyncProxies(VerifyAppearance)
for Ball, Proxy in pairs(State.BallStudio.Proxies) do
if not (Ball and Ball.Parent and Proxy and Proxy.Parent) then
State.BallStudio.Proxies[Ball] = nil
if Proxy then pcall(function() Proxy:Destroy() end) end
else
pcall(function()
Proxy.CFrame = Ball.CFrame
if VerifyAppearance == false then return end
local Visual = Proxy:FindFirstChild('SilverSurferBallMesh')
if Visual and Visual:IsA('MeshPart') then
-- MeshId loads asynchronously. Roblox can replace Size with the asset's
-- authored dimensions after assignment, so enforce the fitted bounding box
-- after loading and on every frame thereafter.
local FitScale = math.clamp(tonumber(Visual:GetAttribute('SilverSurferFitScale')) or 1, 0.001, 5)
local WantedSize = Ball.Size * FitScale
if (Visual.Size - WantedSize).Magnitude > 0.001 then
Visual.Size = WantedSize
end
-- Mesh and texture content can finish loading after creation and restore their
-- authored appearance. Reassert both the TextureID and multiplicative tint.
local WantedTexture = Visual:GetAttribute('SilverSurferTextureId') or ''
if Visual.TextureID ~= WantedTexture then Visual.TextureID = WantedTexture end
local TintR = math.clamp(tonumber(Visual:GetAttribute('SilverSurferTintR')) or 1, 0, 1)
local TintG = math.clamp(tonumber(Visual:GetAttribute('SilverSurferTintG')) or 1, 0, 1)
local TintB = math.clamp(tonumber(Visual:GetAttribute('SilverSurferTintB')) or 1, 0, 1)
local WantedTint = Color3.new(TintR, TintG, TintB)
if Visual.Color ~= WantedTint then Visual.Color = WantedTint end
pcall(function() Visual.UsePartColor = true end)
end
end)
end
end
end

-- Shot sound. Parenting a Sound to the ball makes it positional, so anything
-- past the roll-off distance was silent by the time the shot released. It now
-- plays flat through SoundService, and waits for the asset to stream in before
-- playing so a freshly typed ID is not skipped.
function State.BallStudio.PlayShotSound(Ball, Force)
if not Force and not (CONFIG.BallStudioEnabled and CONFIG.ShotSoundEnabled) then
return
end
local Id = State.BallStudio.Asset(CONFIG.ShotSoundId)
if not Id then return end
pcall(function()
local Sound = Instance.new('Sound')
Sound.Name = 'SilverSurferShotSound'
Sound.SoundId = Id
Sound.Volume = math.clamp(tonumber(CONFIG.ShotSoundVolume) or 1.2, 0, 10)
Sound.PlaybackSpeed = math.clamp(tonumber(CONFIG.ShotSoundPitch) or 1, 0.25, 4)
Sound.RollOffMode = Enum.RollOffMode.Inverse
Sound.RollOffMinDistance = 30
Sound.RollOffMaxDistance = 1200
Sound.Looped = false
Sound:SetAttribute(State.BallStudio.Tag, 'Sound')
Sound.Parent = game:GetService('SoundService')
local Duration = math.clamp(tonumber(CONFIG.ShotSoundDuration) or 0, 0, 120)
Sound.Ended:Connect(function() pcall(function() Sound:Destroy() end) end)
pcall(function()
Sound.Played:Once(function()
if Duration <= 0 then return end
task.delay(Duration, function()
if Sound.Parent then
pcall(function() Sound:Stop() end)
pcall(function() Sound:Destroy() end)
end
end)
end)
end)
if Sound.IsLoaded then
Sound:Play()
else
pcall(function()
Sound.Loaded:Once(function()
if Sound.Parent and not Sound.IsPlaying then Sound:Play() end
end)
end)
Sound:Play()
end
-- Ended normally removes it. This is only a safety cleanup for invalid assets.
task.delay(300, function() pcall(function() Sound:Destroy() end) end)
end)
end

function State.BallStudio.IsCosmetic(Object)
local Owner = Object
while Owner and Owner ~= game do
if Owner:GetAttribute('Aura') ~= nil or Owner:GetAttribute('Trail') ~= nil
or Owner:GetAttribute('Ball') ~= nil or Owner:GetAttribute('Takeover') ~= nil
or Owner:GetAttribute('SilverSurferLocalAura') ~= nil then
return true
end
Owner = Owner.Parent
end
return false
end

function State.BallStudio.TintObject(Object, Tint)
if Object:IsA('ParticleEmitter') or Object:IsA('Trail') or Object:IsA('Beam') then
Object.Color = ColorSequence.new(Tint)
elseif Object:IsA('PointLight') or Object:IsA('SpotLight')
or Object:IsA('SurfaceLight') then
Object.Color = Tint
elseif Object:IsA('Decal') or Object:IsA('Texture') then
Object.Color3 = Tint
elseif Object:IsA('BasePart') then
Object.Color = Tint
end
end

function State.BallStudio.TintCosmetics()
if not (CONFIG.BallStudioEnabled and CONFIG.CosmeticTintEnabled) then return end
local Tint = State.BallStudio.Shade('CosmeticTintR', 'CosmeticTintG', 'CosmeticTintB')
local Ball = GetLocalBallHandle()
local Character = LP.Character
for _, Root in ipairs({ Character, Ball }) do
