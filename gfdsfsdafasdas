        -- wrong end of the floor.
        offenseInvertCourt = false,
    }

    -- Relative pull of each hand-switch signal. Movement intent leads, then
    -- defender pressure, then the court read, then the camera hint.
    local HAND_WEIGHT_INTENT = 1.6
    local HAND_WEIGHT_PRESSURE = 1.1
    local HAND_WEIGHT_COURT = 0.55
    local HAND_WEIGHT_SIDELINE = 0.8
    local HAND_WEIGHT_CAMERA = 0.6
    local HAND_STICKINESS = 0.12
    local HAND_DEFENDER_RANGE = 22
    local HAND_SIDELINE_START = 0.55

    -- Each game names the ball differently, so try the known names first.
    local BALL_NAMES = {
        ["Hoopz"] = { "Basketball", "Ball" },
        ["Swish"] = { "Basketball", "Ball", "BasketBall", "GameBall", "bball" },
        ["Drop Offs"] = { "Basketball", "Ball", "BasketBall", "GameBall", "TheBall" },
        ["Rooftop 2"] = { "Ball", "Basketball", "BasketBall", "GameBall" },
    }

    -- Name fragments used when the exact name lookup fails. Only Hoopz reliably
    -- names the ball "Basketball", so every other game needs fuzzy matching.
    local BALL_KEYWORDS = { "basketball", "bball", "ball" }

    -- Court props also contain "ball", so filter the obvious static geometry out.
    local BALL_NAME_BLOCKLIST = {
        "hoop", "rim", "net", "backboard", "board", "spawn", "court", "wall",
        "floor", "stand", "rack", "cart", "button", "gui", "billboard",
        "volleyball", "football", "baseball", "handball", "pinball",
    }

    local SEARCH_FOLDERS = {
        "Balls", "Ball", "Basketballs", "Ingame", "InGame",
        "GameObjects", "Debris", "Courts",
    }

    local st = {
        ball = nil,
        nextDeepScan = 0,
        nextBallRefresh = 0,
        ballCandidates = {},
        worldBalls = {},
        nextWorldScan = 0,
        moving = false,
        autoRotateHumanoid = nil,
        savedAutoRotate = nil,
        jitterPhase = 0,
        lastHandSwitch = 0,
        pendingHand = nil,
        lastDetectedHand = nil,
        handStableSince = 0,
        lastDesiredHand = nil,
        desiredHandSince = 0,
        court = nil,
        nextCourtScan = 0,
        practiceNoticeShown = false,
        adaptiveTarget = nil,
        adaptiveMode = "Off-ball",
        adaptiveState = "WAITING",
        nextAdaptiveScan = 0,
        headRideEngaged = false,
        headRideEngagedTarget = nil,
        headRideMounted = false,
        headRideStatus = "OFF",
        headRideLastJump = 0,
        -- Where the defensive solve last wanted the player to stand. Captured
        -- even when movement is suppressed, which is what advisory mode needs.
        suggestedPosition = nil,
        suggestedAt = 0,
        suggestOnly = false,
        suggestKind = "defense",
        offenseSpot = nil,
        offenseKind = nil,
        nextOffenseScan = 0,
        offenseRead = nil,
        offenseAutoMoving = false,
        offenseAutoDirection = nil,
        offenseLearnSamples = {},
        offenseLearnPending = {},
        offenseLearnHistory = {},
        offenseLearnPlan = nil,
        offenseLearnCount = 0,
        offenseLearnSinceSave = 0,
        nextOffenseLearn = 0,
        offenseLearnedReady = false,
    }

    local function asPart(instance)
        if not instance then return nil end
        if instance:IsA("BasePart") then return instance end

        -- Hoopz stores the physical ball inside a Basketball tool/model. Prefer
        -- the real Ball child; non-recursive scans miss some practice variants.
        local namedBall = instance:FindFirstChild("Ball", true)
        if namedBall and namedBall:IsA("BasePart") then return namedBall end
        local handle = instance:FindFirstChild("Handle", true)
        if handle and handle:IsA("BasePart") then return handle end
        if instance:IsA("Model") and instance.PrimaryPart then return instance.PrimaryPart end
        return instance:FindFirstChildWhichIsA("BasePart", true)
    end

    local function looksLikeBall(instance)
        return string.find(string.lower(instance.Name), "ball", 1, true) ~= nil
    end

    local function validBall(part)
        return part ~= nil and part.Parent ~= nil and part:IsDescendantOf(workspace)
    end

    local function nameBlocked(lowerName)
        for _, term in ipairs(BALL_NAME_BLOCKLIST) do
            if string.find(lowerName, term, 1, true) then return true end
        end
        return false
    end

    local function nameLooksLikeBall(name)
        local lower = string.lower(name or "")
        if lower == "" or nameBlocked(lower) then return false end
        for _, keyword in ipairs(BALL_KEYWORDS) do
            if string.find(lower, keyword, 1, true) then return true end
        end
        return false
    end

    local function plausibleBallPart(part)
        if not part or not part:IsA("BasePart") then return false end
        local ok, size = pcall(function() return part.Size end)
        if ok and typeof(size) == "Vector3" and size.Magnitude > 14 then
            return false
        end
        return true
    end

    -- Deep, name-agnostic search. Hoopz parents a "Basketball" tool directly to
    -- the character, but Swish, Drop Offs and Rooftop 2 rename or nest it.
    local function deepFindBall(container, depth)
        if not container then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if nameLooksLikeBall(child.Name) then
                local part = asPart(child)
                if part and plausibleBallPart(part) then return part end
            end
        end
        if (depth or 0) <= 0 then return nil end
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("Tool") or child:IsA("Model") or child:IsA("Folder")
                or child:IsA("Accessory") then
                local nested = deepFindBall(child, (depth or 0) - 1)
                if nested then return nested end
            end
        end
        return nil
    end

    -- Cached, name-agnostic sweep of every ball currently in the world.
    local function refreshWorldBalls(force)
        local now = os.clock()
        if not force and now < st.nextWorldScan then return st.worldBalls end
        st.nextWorldScan = now + 0.5

        local found, seen = {}, {}
        for _, instance in ipairs(workspace:GetDescendants()) do
            if nameLooksLikeBall(instance.Name) then
                local part = asPart(instance)
                if validBall(part) and plausibleBallPart(part) and not seen[part] then
                    seen[part] = true
                    table.insert(found, part)
                end
            end
        end
        st.worldBalls = found
        return found
    end

    -- Only Hoopz reparents the ball to the carrier. The other games weld it or
    -- leave it in workspace, so possession has to be detected by joints too.
    local function attachedToCharacter(part, character)
        if not part or not character then return false end
        if part:IsDescendantOf(character) then return true end
        local ok, joints = pcall(function() return part:GetJoints() end)
        if ok and type(joints) == "table" then
            for _, joint in ipairs(joints) do
                local okParts, part0, part1 = pcall(function()
                    return joint.Part0, joint.Part1
                end)
                if okParts then
                    if (part0 and part0:IsDescendantOf(character))
                        or (part1 and part1:IsDescendantOf(character)) then
                        return true
                    end
                end
            end
        end
        return false
    end

    local HOLD_POINT_NAMES = {
        "RightHand", "LeftHand", "Right Arm", "Left Arm",
        "RightLowerArm", "LeftLowerArm", "HumanoidRootPart",
    }

    local function holdPoints(character)
        local points = {}
        for _, name in ipairs(HOLD_POINT_NAMES) do
            local part = character:FindFirstChild(name)
            if part and part:IsA("BasePart") then table.insert(points, part) end
        end
        return points
    end

    local function searchContainer(container)
        if not container then return nil end

        local names = BALL_NAMES[getGame() or ""] or { "Ball", "Basketball" }
        for _, name in ipairs(names) do
            local part = asPart(container:FindFirstChild(name))
            if part and plausibleBallPart(part) then return part end
        end

        local nested = deepFindBall(container, 3)
        if nested then return nested end

        -- Possession fallback for games that never parent the ball to the
        -- carrier: accept a welded ball, or one held right at the hands.
        if not container:FindFirstChildOfClass("Humanoid") then return nil end

        local points = holdPoints(container)
        if #points == 0 then return nil end

        local bestPart, bestDistance = nil, math.huge
        for _, part in ipairs(refreshWorldBalls()) do
            if validBall(part) then
                if attachedToCharacter(part, container) then return part end
                for _, point in ipairs(points) do
                    local distance = (part.Position - point.Position).Magnitude
                    local limit = point.Name == "HumanoidRootPart" and 4.5 or 5.5
                    if distance <= limit and distance < bestDistance then
                        bestPart, bestDistance = part, distance
                    end
                end
            end
        end
        return bestPart
    end

    local function teamMarker(player)
        local attributeNames = { "Team", "TeamName", "TeamId", "Squad", "Side" }
        for _, name in ipairs(attributeNames) do
            local value = player:GetAttribute(name)
            if value ~= nil then return tostring(value) end
            local character = player.Character
            if character then
                value = character:GetAttribute(name)
                if value ~= nil then return tostring(value) end
                local object = character:FindFirstChild(name)
                if object and object:IsA("ValueBase") then
                    return tostring(object.Value)
                end
            end
        end
        return nil
    end

    local MEANINGLESS_TEAM_MARKERS = {
        [""] = true, ["none"] = true, ["nil"] = true, ["0"] = true,
        ["-1"] = true, ["false"] = true, ["neutral"] = true,
        ["default"] = true, ["spectator"] = true, ["lobby"] = true,
    }

    -- Raw team identity is also used by offence. It must not depend on the
    -- defensive "ignore teammates" preference.
    local function sameTeamIdentity(player)
        if player == LocalPlayer then return true end
        if LocalPlayer.Team and player.Team then
            return LocalPlayer.Team == player.Team
        end
        if not LocalPlayer.Neutral and not player.Neutral
            and LocalPlayer.TeamColor == player.TeamColor then
            return true
        end

        local localMarker = teamMarker(LocalPlayer)
        local otherMarker = teamMarker(player)
        if localMarker and otherMarker and localMarker == otherMarker
            and not MEANINGLESS_TEAM_MARKERS[string.lower(localMarker)] then
            return true
        end

        -- Hoopz creates TeamSpot on many characters; only an enabled marker
        -- identifies someone the local client currently considers a teammate.
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local teamSpot = root and root:FindFirstChild("TeamSpot")
        if teamSpot then
            local ok, enabled = pcall(function() return teamSpot.Enabled end)
            if ok and enabled == true then return true end
        end
        return false
    end

    local function isTeammate(player)
        if player == LocalPlayer then return true end
        return cfg.ignoreTeammates and sameTeamIdentity(player) or false
    end

    local carrierOf

    ----------------------------------------------------------------------
    -- Court awareness
    --
    -- Hoopz keeps every live match under workspace.Courts. Each court model
    -- exposes _CourtPlayers (ObjectValues named Home1/Away2/... that point at
    -- Players), _CourtSettings (Gamemode, CurrentBall, Started) and the hitbox
    -- folders holding the scoring parts. Gamemode 2 is a full court with two
    -- hoops; every other gamemode is a half court sharing a single hoop.
    --
    -- Knowing the court gives Cutoff three things name-scanning cannot: which
    -- basket the carrier is actually attacking, where the sidelines are, and
    -- an authoritative reference to the live ball.
    ----------------------------------------------------------------------

    local COURT_RESCAN_INTERVAL = 1.0
    -- Court footprints taken from the game's own court-skin overlay parts.
    local FULL_COURT_SIZE = Vector3.new(238.5, 1.5, 160.5)
    local HALF_COURT_SIZE = Vector3.new(160.5, 1.5, 140.5)

    -- FieldGoal is the part Hoopz itself compares against when deciding whose
    -- basket is whose. Net and Backboard cover older or reskinned courts.
    local GOAL_PART_NAMES = { "FieldGoal", "Goal", "Net", "Backboard", "hoop" }

    local function goalPartOf(hitboxes)
        if not hitboxes then return nil end
        for _, name in ipairs(GOAL_PART_NAMES) do
            local found = hitboxes:FindFirstChild(name, true)
            local part = found and asPart(found)
            if part then return part end
        end
        return nil
    end

    -- Swish, Drop Offs and Rooftop do not expose Hoopz _CourtSettings. Use the
    -- same tags/names already proven by Silver Surfer's shooting engines, then
    -- follow GEAGLEH's fallback of selecting the nearest scoring goal.
    local GENERIC_GOAL_NAMES = {
        rim = true, mainrim = true, c__rim = true,
        realgo = true, realgo1 = true, go1 = true, go2 = true,
        hoop = true, basketballhoop = true, fieldgoal = true,
        perfect = true, perf = true,
    }
    local genericGoals, nextGenericGoalScan = {}, 0

    local function refreshGenericGoals(force)
        local now = os.clock()
        -- Throttle empty results too; courts often stream in a moment after
        -- the character, and rescanning Workspace every offense tick is costly.
        if not force and now < nextGenericGoalScan then
            return genericGoals
        end
        nextGenericGoalScan = now + 1.5
        table.clear(genericGoals)
        local seen = {}
        local function add(object)
            local part = asPart(object)
            if not part and object then
                part = object:FindFirstChildWhichIsA("BasePart", true)
            end
            if part and part:IsA("BasePart") and part.Parent and not seen[part] then
                seen[part] = true
                table.insert(genericGoals, part)
            end
        end
        pcall(function()
            for _, object in ipairs(
                CollectionServiceLocal:GetTagged("FieldGoals")
            ) do
                add(object)
            end
        end)
        for _, object in ipairs(workspace:GetDescendants()) do
            if GENERIC_GOAL_NAMES[string.lower(object.Name)] then add(object) end
        end
        return genericGoals
    end

    local function nearestGenericGoal(playerRoot)
        if not playerRoot then return nil end
        local best, bestDistance = nil, math.huge
        for _, goal in ipairs(refreshGenericGoals(false)) do
            if goal and goal.Parent then
                local distance = (goal.Position - playerRoot.Position).Magnitude
                if distance < bestDistance then
                    best, bestDistance = goal, distance
                end
            end
        end
        return best
    end

    local function namedRim(container)
        if not container then return nil end
        local cRim = container:FindFirstChild("C__Rim", true)
        local exact = cRim and cRim:FindFirstChild("Hoop")
        if exact and exact:IsA("BasePart") then return exact end
        for _, object in ipairs(container:GetDescendants()) do
            if object:IsA("BasePart") then
                local name = string.lower(object.Name)
                if GENERIC_GOAL_NAMES[name]
                    or string.find(name, "points ring", 1, true) then
                    return object
                end
            end
        end
        return asPart(container)
    end

    -- Authoritative adapters copied from each game's own shooting resolver.
    -- This avoids selecting a lobby/practice hoop merely because it happens to
    -- be closer than the active court.
    local function gameSpecificGoal(playerRoot)
        if not playerRoot then return nil end
        local gameName = getGame()

        if gameName == "Swish" then
            local best, bestDistance = nil, math.huge
            local ok, tagged = pcall(function()
                return CollectionServiceLocal:GetTagged("FieldGoals")
            end)
            if ok then
                for _, object in ipairs(tagged) do
                    local part = asPart(object)
                    if part then
                        local distance = (part.Position - playerRoot.Position).Magnitude
                        if distance < bestDistance then
                            best, bestDistance = part, distance
                        end
                    end
                end
            end
            if best then return best end
        elseif gameName == "Drop Offs" then
            local playerData = LocalPlayer:FindFirstChild("PlayerData")
            local gameData = playerData and playerData:FindFirstChild("GameData")
            local courtValue = gameData and gameData:FindFirstChild("Court")
            local teamValue = gameData and gameData:FindFirstChild("Team")
            local courtName = courtValue and tostring(courtValue.Value) or ""
            local court = courtName ~= "" and workspace:FindFirstChild(courtName)
            if court then
                local team = teamValue and tostring(teamValue.Value) or "Team1"
                -- Drop Offs' own BallAnimations mapping: Team1 attacks Trig,
                -- Team2 attacks Trig1.
                local anchor = court:FindFirstChild(
                    team == "Team1" and "Trig" or "Trig1"
                ) or court:FindFirstChild(
                    team == "Team1" and "Trig1" or "Trig"
                )
                local rim = namedRim(anchor)
                if rim then return rim end
                local anchorPart = asPart(anchor)
                if anchorPart then return anchorPart end
            end
        elseif gameName == "Rooftop 2" then
            local courts = workspace:FindFirstChild("Courts")
            local matchId = tostring(LocalPlayer:GetAttribute("Match") or "")
            local best, bestScore = nil, math.huge
            if courts then
                for _, court in ipairs(courts:GetChildren()) do
                    local exactMatch = matchId ~= "" and (
                        court.Name == matchId
                        or tostring(court:GetAttribute("ID") or "") == matchId
                        or tostring(court:GetAttribute("Match") or "") == matchId
                    )
                    local hoops = court:FindFirstChild("Hoops")
                    if hoops then
                        for _, container in ipairs(hoops:GetChildren()) do
                            local rim = namedRim(container)
                            if rim then
                                local distance =
                                    (rim.Position - playerRoot.Position).Magnitude
                                local score = exactMatch and distance - 100000 or distance
                                if score < bestScore then
                                    best, bestScore = rim, score
                                end
                            end
                        end
                    end
                end
            end
            if best then return best end
        end

        return nil
    end

    -- Roster lookup. The court's own list is authoritative; the tagged roster
    -- is a fallback that survives players being moved between courts.
    local function courtTeamOf(courtModel, player)
        if not player then return nil end

        local roster = courtModel and courtModel:FindFirstChild("_CourtPlayers")
        if roster then
            for _, entry in ipairs(roster:GetChildren()) do
                local ok, value = pcall(function() return entry.Value end)
                if ok and value == player then
                    return string.sub(entry.Name, 1, 4) == "Home" and "Home" or "Away"
                end
            end
        end

        local ok, tagged = pcall(function()
            return CollectionServiceLocal:GetTagged("PlayingPlayers")
        end)
        if ok and type(tagged) == "table" then
            for _, entry in ipairs(tagged) do
                local okValue, value = pcall(function() return entry.Value end)
                if okValue and value == player then
                    return string.sub(entry.Name, 1, 4) == "Home" and "Home" or "Away"
                end
            end
        end
        return nil
    end

    local function resolveCourt()
        local now = os.clock()
        -- Throttle misses as well as hits. The other three games have no Courts
        -- folder at all, so a nil result must not rescan on every frame.
        if now < st.nextCourtScan then
            local cached = st.court
            if not cached or (cached.Model and cached.Model.Parent) then
                return cached
            end
        end
        st.nextCourtScan = now + COURT_RESCAN_INTERVAL

        local courts = workspace:FindFirstChild("Courts")
        if not courts then
            st.court = nil
            return nil
        end

        local localCharacter = LocalPlayer.Character
        local localRoot = localCharacter
            and localCharacter:FindFirstChild("HumanoidRootPart")

        local best, bestScore = nil, math.huge
        for _, model in ipairs(courts:GetChildren()) do
            local courtSettings = model:FindFirstChild("_CourtSettings")
            if courtSettings then
                local centerHolder = model:FindFirstChild("Center")
                if not centerHolder then
                    local positions = model:FindFirstChild("_CourtPositions")
                    centerHolder = positions and positions:FindFirstChild("Center")
                end
                local center = asPart(centerHolder)

                -- Being on the roster wins outright. Otherwise fall back to the
                -- nearest court so spectating and warmups still resolve.
                local team = courtTeamOf(model, LocalPlayer)
                local score = math.huge
                if team then
                    score = -1
                elseif center and localRoot then
                    score = (center.Position - localRoot.Position).Magnitude
                end

                if score < bestScore then
                    local gamemode = courtSettings:FindFirstChild("Gamemode")
                    local okMode, modeValue = pcall(function() return gamemode.Value end)
                    local isFull = okMode and modeValue == 2

                    local homeGoal, awayGoal
                    if isFull then
                        homeGoal = goalPartOf(model:FindFirstChild("HitboxesHome"))
                        awayGoal = goalPartOf(model:FindFirstChild("HitboxesAway"))
                    else
                        -- One hoop, so both sides attack it.
                        local shared = goalPartOf(model:FindFirstChild("Hitboxes"))
                        homeGoal, awayGoal = shared, shared
                    end

                    bestScore = score
                    best = {
                        Model = model,
                        Settings = courtSettings,
                        Center = center,
                        IsFull = isFull,
                        Size = isFull and FULL_COURT_SIZE or HALF_COURT_SIZE,
                        HomeGoal = homeGoal,
                        AwayGoal = awayGoal,
                        LocalTeam = team,
                    }
                end
            end
        end

        st.court = best
        return best
    end

    -- Offence team filtering is always active, independent of autoguard UI.
    -- Hoopz roster data wins when present; the generic identity markers cover
    -- Swish, Drop Offs and Rooftop.
    local function offenseTeammate(player)
        if player == LocalPlayer or sameTeamIdentity(player) then return true end
        local court = resolveCourt()
        if court and court.Model then
            local mine = courtTeamOf(court.Model, LocalPlayer)
            local theirs = courtTeamOf(court.Model, player)
            if mine and theirs then return mine == theirs end
        end
        return false
    end

    -- The court that a player is attacking. Home shoots on the Away basket and
    -- vice versa, matching the game's own self-dunk guard. Other games fall
    -- back to their nearest live rim, matching GEAGLEH's cross-game resolver.
    local function attackingGoal(player, playerRoot, playerVelocity)
        if not playerRoot then return nil end
        local court = resolveCourt()
        if not court then
            return gameSpecificGoal(playerRoot)
                or nearestGenericGoal(playerRoot)
        end
        if not court.IsFull then
            return court.HomeGoal or court.AwayGoal
                or nearestGenericGoal(playerRoot)
        end
        if not (court.HomeGoal and court.AwayGoal) then
            return court.HomeGoal or court.AwayGoal
                or nearestGenericGoal(playerRoot)
        end

        local team = courtTeamOf(court.Model, player)
        if team == "Home" then return court.AwayGoal end
        if team == "Away" then return court.HomeGoal end
        if not playerRoot then return nil end

        -- Roster unknown (pickup games, mid-substitution). Infer the basket
        -- from momentum first, then from facing, then from proximity.
        local origin = playerRoot.Position
        local function towards(goal)
            local delta = goal.Position - origin
            local flat = Vector3.new(delta.X, 0, delta.Z)
            return flat.Magnitude > 0.01 and flat.Unit or nil
        end
        local toHome, toAway = towards(court.HomeGoal), towards(court.AwayGoal)
        if not toHome or not toAway then return court.HomeGoal or court.AwayGoal end

        local heading
        if playerVelocity and playerVelocity.Magnitude > 2 then
            heading = playerVelocity.Unit
        else
            local look = playerRoot.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            heading = flatLook.Magnitude > 0.01 and flatLook.Unit or nil
        end

        if heading then
            local homeDot, awayDot = heading:Dot(toHome), heading:Dot(toAway)
            if math.abs(homeDot - awayDot) > 0.15 then
                return homeDot > awayDot and court.HomeGoal or court.AwayGoal
            end
        end

        local homeDistance = (court.HomeGoal.Position - origin).Magnitude
        local awayDistance = (court.AwayGoal.Position - origin).Magnitude
        return homeDistance <= awayDistance and court.HomeGoal or court.AwayGoal
    end

    -- Hoopz's solo Practice area is not a court: it is a single axis-aligned
    -- ReplicatedStorage.PracticeRegion box with no opponent inside it. Read it
    -- directly rather than guessing at a court model, since Practice does not
    -- reliably expose _CourtSettings/_CourtPlayers the way a match court does.
    local function practiceRegionBounds()
        local ok, region = pcall(function()
            return game:GetService("ReplicatedStorage"):FindFirstChild("PracticeRegion")
        end)
        if not ok or not region then return nil end
        local part = asPart(region)
        if not part then return nil end
        return part
    end

    local function inPracticeRegion(root)
        if not root then return false end
        local region = practiceRegionBounds()
        if not region then return false end
        local half = region.Size * 0.5
        local localPoint = region.CFrame:PointToObjectSpace(root.Position)
        return math.abs(localPoint.X) < half.X and math.abs(localPoint.Z) < half.Z
    end

    -- Courts are rotated relative to the world (notably the 1v1 half courts),
    -- so bounds are clamped in the court's own object space. Practice uses its
    -- own region box instead, since it is not part of workspace.Courts.
    local function clampToCourt(position)
        local region = practiceRegionBounds()
        if region then
            local half = region.Size * 0.5
            local inset = cfg.cutoffCourtInset
            local limitX = math.max(half.X - inset, 1)
            local limitZ = math.max(half.Z - inset, 1)
            local localPoint = region.CFrame:PointToObjectSpace(position)
            if math.abs(localPoint.X) < half.X and math.abs(localPoint.Z) < half.Z then
                return region.CFrame:PointToWorldSpace(Vector3.new(
                    math.clamp(localPoint.X, -limitX, limitX),
                    localPoint.Y,
                    math.clamp(localPoint.Z, -limitZ, limitZ)
                ))
            end
        end

        local court = resolveCourt()
        if not court or not court.Center then return position end

        local half = court.Size * 0.5
        local inset = cfg.cutoffCourtInset
        local limitX = math.max(half.X - inset, 1)
        local limitZ = math.max(half.Z - inset, 1)

        local centerFrame = court.Center.CFrame
        local localPoint = centerFrame:PointToObjectSpace(position)
        return centerFrame:PointToWorldSpace(Vector3.new(
            math.clamp(localPoint.X, -limitX, limitX),
            localPoint.Y,
            math.clamp(localPoint.Z, -limitZ, limitZ)
        ))
    end

    -- The court publishes the ball it is currently playing with, which beats
    -- name matching whenever it is available.
    local function courtBallPart()
        local court = resolveCourt()
        local currentBall = court and court.Settings
            and court.Settings:FindFirstChild("CurrentBall")
        if not currentBall then return nil end
        local ok, value = pcall(function() return currentBall.Value end)
        if not ok or not value then return nil end
        local part = asPart(value)
        if part and validBall(part) then return part end
        return nil
    end

    local function findBall()
        local localCharacter = LocalPlayer.Character
        local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

        -- Offball selects the closest eligible opponent who does NOT currently
        -- hold a ball. Returning their root lets the shared movement pipeline
        -- treat that player as the active defensive target.
        if cfg.mode == "Offball" then
            if not localRoot then return nil end
            local function closestOffballTarget(skipTeammates)
                local bestRoot, bestDistance = nil, math.huge
                for _, player in ipairs(PlayersService:GetPlayers()) do
                    if player ~= LocalPlayer
                        and not (skipTeammates and isTeammate(player)) then
                        local character = player.Character
                        local targetRoot = character
                            and character:FindFirstChild("HumanoidRootPart")
                        local humanoid = character
                            and character:FindFirstChildOfClass("Humanoid")
                        local hasBall = character and searchContainer(character) ~= nil
                        if targetRoot and humanoid and humanoid.Health > 0
                            and not hasBall then
                            local distance = (targetRoot.Position - localRoot.Position).Magnitude
                            if distance < bestDistance then
                                bestRoot = targetRoot
                                bestDistance = distance
                            end
                        end
                    end
                end
                return bestRoot
            end

            local closestRoot = closestOffballTarget(true)
                or closestOffballTarget(false)
            st.ball = closestRoot
            return closestRoot
        end

        -- Carrier modes reevaluate every frame and defend the closest eligible
        -- opponent who currently has a Basketball.
        if cfg.mode == "Carrier" or cfg.mode == "Mirror"
            or cfg.mode == "Backward" or cfg.mode == "360"
            or cfg.mode == "Jitter" or cfg.mode == "Cutoff" then
            if not localRoot then return nil end

            -- Prefer the ball the court says is in play. Falls straight through
            -- to the scan below when it is missing or held by a teammate.
            local courtBall = courtBallPart()
            if courtBall then
                local owner = carrierOf(courtBall)
                if owner and owner ~= LocalPlayer and not isTeammate(owner) then
                    st.ball = courtBall
                    return courtBall
                end
            end

            local function closestCarrierBall(skipTeammates)
                local bestBall, bestDistance = nil, math.huge
                for _, player in ipairs(PlayersService:GetPlayers()) do
                    if player ~= LocalPlayer
                        and not (skipTeammates and isTeammate(player)) then
                        local character = player.Character
                        local carrierRoot = character and character:FindFirstChild("HumanoidRootPart")
                        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                        local ball = character and searchContainer(character)
                        if carrierRoot and ball and humanoid and humanoid.Health > 0 then
                            local distance = (carrierRoot.Position - localRoot.Position).Magnitude
                            if distance < bestDistance then
                                bestBall = ball
                                bestDistance = distance
                            end
                        end
                    end
                end
                return bestBall
            end

            -- Never let an unreliable teammate guess leave autoguard with no
            -- target: retry without the filter before giving up.
            local closestBall = closestCarrierBall(true)
                or closestCarrierBall(false)
            st.ball = closestBall
            return closestBall
        end

        -- Ball mode must select by distance, not player-list order or an old
        -- cached target. Refresh the world candidate set periodically, then
        -- recalculate every candidate's live distance on every frame.
        if not localRoot then return nil end
        local now = os.clock()
        if now >= st.nextBallRefresh then
            st.nextBallRefresh = now + 0.5
            local refreshed, seen = {}, {}

            local function addCandidate(instance)
                local part = asPart(instance)
                local owner = part and carrierOf and carrierOf(part)
                if validBall(part) and not (owner and isTeammate(owner))
                    and not seen[part] then
                    seen[part] = true
                    table.insert(refreshed, part)
                end
            end

            -- Player-held balls are the most reliable candidates.
            for _, player in ipairs(PlayersService:GetPlayers()) do
                local character = player.Character
                if character and not isTeammate(player) then
                    addCandidate(searchContainer(character))
                end
            end

            -- Include loose balls and balls nested inside Basketball tools or
            -- models. The sweep is name-agnostic, so Swish, Drop Offs and
            -- Rooftop 2 balls are found even though they are not called
            -- "Basketball" like they are in Hoopz.
            for _, part in ipairs(refreshWorldBalls(true)) do
                addCandidate(part)
            end
            st.ballCandidates = refreshed
        end

        local function scanBalls(skipTeammates)
            local bestBall, bestDistance = nil, math.huge
            local considered = {}
            local function consider(part)
                local owner = part and carrierOf and carrierOf(part)
                if validBall(part)
                    and not (skipTeammates and owner and isTeammate(owner))
                    and not considered[part] then
                    considered[part] = true
                    local distance = (part.Position - localRoot.Position).Magnitude
                    if distance < bestDistance then
                        bestBall = part
                        bestDistance = distance
                    end
                end
            end

            -- Check held balls fresh each frame so possession changes do not wait
            -- for the periodic world refresh.
            for _, player in ipairs(PlayersService:GetPlayers()) do
                local character = player.Character
                if character and not (skipTeammates and isTeammate(player)) then
                    consider(searchContainer(character))
                end
            end
            for _, part in ipairs(st.ballCandidates) do
                consider(part)
            end
            -- The cached candidate list is teammate-filtered, so the unfiltered
            -- pass reads the raw world sweep as well.
            for _, part in ipairs(refreshWorldBalls()) do
                consider(part)
            end
            return bestBall
        end

        local closestBall = scanBalls(true) or scanBalls(false)
        st.ball = closestBall
        return closestBall
    end

    carrierOf = function(part)
        if not part then return nil end
        local model = part:FindFirstAncestorOfClass("Model")
        while model do
            local player = PlayersService:GetPlayerFromCharacter(model)
            if player then return player end
            model = model:FindFirstAncestorOfClass("Model")
        end

        -- Outside Hoopz the ball usually stays in workspace while it is carried,
        -- so ancestry alone never reveals the owner. Fall back to the weld
        -- target, then to whoever is holding it at hand range.
        local bestPlayer, bestDistance = nil, math.huge
        for _, player in ipairs(PlayersService:GetPlayers()) do
            local character = player.Character
            if character then
                if attachedToCharacter(part, character) then return player end
                for _, point in ipairs(holdPoints(character)) do
                    local distance = (part.Position - point.Position).Magnitude
                    local limit = point.Name == "HumanoidRootPart" and 4.5 or 5.5
                    if distance <= limit and distance < bestDistance then
                        bestPlayer, bestDistance = player, distance
                    end
                end
            end
        end
        return bestPlayer
    end

    local function stopMoving(humanoid)
        if humanoid and st.moving then
            humanoid:Move(Vector3.new(0, 0, 0), false)
        end
        st.moving = false
    end

    local function restoreAutoRotate()
        if st.autoRotateHumanoid and st.autoRotateHumanoid.Parent then
            st.autoRotateHumanoid.AutoRotate = st.savedAutoRotate ~= false
        end
        st.autoRotateHumanoid = nil
        st.savedAutoRotate = nil
    end

    local function manualMovementActive()
        local movementKeys = {
            Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
            Enum.KeyCode.Up, Enum.KeyCode.Left, Enum.KeyCode.Down, Enum.KeyCode.Right,
        }
        for _, keyCode in ipairs(movementKeys) do
            if UserInputService:IsKeyDown(keyCode) then return true end
        end

        local ok, gamepadInputs = pcall(function()
            return UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
        end)
        if ok then
            for _, input in ipairs(gamepadInputs) do
                if input.KeyCode == Enum.KeyCode.Thumbstick1
                    and input.Position.Magnitude > 0.15 then
                    return true
                end
            end
        end
        return false
    end

    local function detectBallHand(character, humanoid, root, ball)
        local animator = humanoid:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                local name = string.lower(track.Name or "")
                local animation = track.Animation
                if animation and animation.Name ~= "" then
                    name = string.lower(animation.Name)
                end
                if name == "rtrack" or name == "rfreeze" or name == "ranim" then
                    return "Right"
                elseif name == "ltrack" or name == "lfreeze" or name == "lanim" then
                    return "Left"
                end
            end
        end

        local leftHand = character:FindFirstChild("LeftHand")
            or character:FindFirstChild("Left Arm")
            or character:FindFirstChild("LeftLowerArm")
        local rightHand = character:FindFirstChild("RightHand")
            or character:FindFirstChild("Right Arm")
            or character:FindFirstChild("RightLowerArm")
        if leftHand and rightHand then
            local leftDistance = (ball.Position - leftHand.Position).Magnitude
            local rightDistance = (ball.Position - rightHand.Position).Magnitude
            if math.abs(leftDistance - rightDistance) > 0.08 then
                return leftDistance < rightDistance and "Left" or "Right"
            end
        end

        local localBall = root.CFrame:PointToObjectSpace(ball.Position)
        if math.abs(localBall.X) > 0.08 then
            return localBall.X < 0 and "Left" or "Right"
        end
        return nil
    end

    local UP_VECTOR = Vector3.new(0, 1, 0)

    local function flatten(vector)
        if not vector then return nil end
        local flat = Vector3.new(vector.X, 0, vector.Z)
        if flat.Magnitude < 0.01 then return nil end
        return flat.Unit
    end

    local function rightOf(direction)
        if not direction then return nil end
        return flatten(direction:Cross(UP_VECTOR))
    end

    local function thumbstickPosition()
        local ok, gamepadInputs = pcall(function()
            return UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
        end)
        if not ok or type(gamepadInputs) ~= "table" then return nil end
        for _, input in ipairs(gamepadInputs) do
            if input.KeyCode == Enum.KeyCode.Thumbstick1 then
                if input.Position.Magnitude > 0.15 then return input.Position end
                return nil
            end
        end
        return nil
    end

    -- Full WASD state as a forward/strafe pair. The old code only compared A
    -- against D, so W, S and every diagonal read as "no input" and the hand
    -- never moved on a straight drive or a pull-back.
    local function movementAxes()
        local function held(...)
            for _, keyCode in ipairs({ ... }) do
                if UserInputService:IsKeyDown(keyCode) then return 1 end
            end
            return 0
        end
        local forward = held(Enum.KeyCode.W, Enum.KeyCode.Up)
            - held(Enum.KeyCode.S, Enum.KeyCode.Down)
        local strafe = held(Enum.KeyCode.D, Enum.KeyCode.Right)
            - held(Enum.KeyCode.A, Enum.KeyCode.Left)

        local thumbstick = thumbstickPosition()
        if thumbstick then
            if forward == 0 then forward = thumbstick.Y end
            if strafe == 0 then strafe = thumbstick.X end
        end
        return forward, strafe
    end

    local function cameraBasis()
        local camera = workspace.CurrentCamera
        if not camera then return nil, nil end
        local look = flatten(camera.CFrame.LookVector)
        return look, rightOf(look) or flatten(camera.CFrame.RightVector)
    end

    -- Where the player is asking to go, in world space. Roblox keyboard input
    -- is camera relative, so the camera basis is what turns a raw W/A/S/D pair
    -- into a heading. MoveDirection covers touch and custom control schemes.
    local function movementIntent(humanoid)
        local forward, strafe = movementAxes()
        local look, right = cameraBasis()
        if look and right
            and (math.abs(forward) > 0.05 or math.abs(strafe) > 0.05) then
            local intent = flatten(look * forward + right * strafe)
            if intent then return intent end
        end
        return flatten(humanoid and humanoid.MoveDirection)
    end

    local function nearestDefender(root)
        local direction, closest = nil, math.huge
        for _, player in ipairs(PlayersService:GetPlayers()) do
            if player ~= LocalPlayer and not isTeammate(player) then
                local character = player.Character
                local defenderRoot = character
                    and character:FindFirstChild("HumanoidRootPart")
                local defenderHumanoid = character
                    and character:FindFirstChildOfClass("Humanoid")
                if defenderRoot and defenderHumanoid
                    and defenderHumanoid.Health > 0 then
                    local offset = defenderRoot.Position - root.Position
                    local flat = Vector3.new(offset.X, 0, offset.Z)
                    local distance = flat.Magnitude
                    if distance > 0.05 and distance < closest
                        and distance <= HAND_DEFENDER_RANGE then
                        direction, closest = flat.Unit, distance
                    end
                end
            end
        end
        return direction, closest
    end

    -- Signed push away from whichever sideline the player is hugging, measured
    -- in the court's own object space so rotated courts still read correctly.
    local function sidelinePush(root, frameRight)
        if not frameRight then return 0 end
        local cframe, size
        local region = practiceRegionBounds()
        if region then
            cframe, size = region.CFrame, region.Size
        else
            local court = resolveCourt()
            local model = court and court.Model
            if model then
                local ok, modelCFrame, modelSize =
                    pcall(model.GetBoundingBox, model)
                if ok then cframe, size = modelCFrame, modelSize end
            end
        end
        if not cframe or not size then return 0 end

        local half = size * 0.5
        if half.X < 2 or half.Z < 2 then return 0 end

        -- Sidelines run along the short axis of the court footprint.
        local useX = half.X <= half.Z
        local limit = useX and half.X or half.Z
        local axis = flatten(useX and cframe.RightVector or cframe.LookVector)
        if not axis or limit < 2 then return 0 end

        local localPoint = cframe:PointToObjectSpace(root.Position)
        local offset = useX and localPoint.X or localPoint.Z
        local ratio = math.clamp(offset / limit, -1, 1)
        if math.abs(ratio) < HAND_SIDELINE_START then return 0 end

        local openCourt = axis * (ratio > 0 and -1 or 1)
        local strength = (math.abs(ratio) - HAND_SIDELINE_START)
            / (1 - HAND_SIDELINE_START)
        return openCourt:Dot(frameRight) * math.clamp(strength, 0, 1)
    end

    -- Blends four signals into one signed score: positive wants the right
    -- hand, negative wants the left hand, near zero means "no opinion" so the
    -- existing hysteresis leaves the current hand alone.
    --   1. Movement intent  - full WASD/thumbstick heading, not just A vs D.
    --   2. Camera           - swinging the view ahead of the body pre-switches.
    --   3. Court            - keeps the ball on the attacking side of the rim
    --                         and off the sideline.
    --   4. Pressure         - keeps the ball away from the nearest defender.
    local function desiredMovementHand(character, humanoid, root)
        local cameraLook, cameraRight = cameraBasis()
        local facing = flatten(root and root.CFrame.LookVector)
        local frameLook = cameraLook or facing
        local frameRight = cameraRight or rightOf(frameLook)
        if not frameLook or not frameRight then return nil end

        local intent = movementIntent(humanoid)
        local score = 0

        if intent then
            local lateral = intent:Dot(frameRight)
            local depth = intent:Dot(frameLook)
            score = score + lateral * HAND_WEIGHT_INTENT
            -- A straight drive or a straight pull-back has no lateral term of
            -- its own, so let the court and pressure signals below decide it.
            if depth < -0.5 and math.abs(lateral) < 0.25 then
                score = score * 0.5
            end
        end

        if cfg.handSwitchCamera and cameraRight and facing then
            -- Negative dot means the body trails to the left of the view, so
            -- the player has swung the camera right and is turning that way.
            score = score - facing:Dot(cameraRight) * HAND_WEIGHT_CAMERA
        end

        if cfg.handSwitchCourt and root then
            local velocity = root.AssemblyLinearVelocity or root.Velocity
            local goal = attackingGoal(LocalPlayer, root, velocity)
            if goal then
                local toGoal = flatten(goal.Position - root.Position)
                if toGoal then
                    local closing = intent and intent:Dot(toGoal) or 0
                    local lateralToGoal = toGoal:Dot(frameRight)
                    -- Attacking the rim keeps the ball on the driving side;
                    -- backing away from it swings the ball to the far side so
                    -- the recovering defender is on the wrong hand.
                    score = score + lateralToGoal * HAND_WEIGHT_COURT
                        * (closing >= -0.15 and 1 or -1)
                end
            end
            score = score + sidelinePush(root, frameRight) * HAND_WEIGHT_SIDELINE
        end

        local defender, defenderDistance = nearestDefender(root)
        if defender then
            local pressure = math.clamp(
                1 - (defenderDistance - 4) / (HAND_DEFENDER_RANGE - 4),
                0,
                1
            )
            score = score - defender:Dot(frameRight)
                * HAND_WEIGHT_PRESSURE * pressure
        end

        -- Slight bias toward the hand already being asked for, so a score that
        -- hovers around zero does not oscillate between the two hands.
        if st.lastDesiredHand == "Right" then
            score = score + HAND_STICKINESS
        elseif st.lastDesiredHand == "Left" then
            score = score - HAND_STICKINESS
        end

        if math.abs(score) < cfg.handSwitchSensitivity then return nil end
        return score > 0 and "Right" or "Left"
    end

    -- Different executors expose input simulation differently: some put
    -- keypress/keyrelease under getgenv(), others only under _G, and some
    -- expose neither but do allow VirtualInputManager. Try each in turn so
    -- the feature has a chance of actually doing something everywhere,
    -- instead of silently never firing on executors that lack getgenv keys.
    local function resolveKeyPressFunctions()
        local environments = {}
        if type(getgenv) == "function" then
            local ok, result = pcall(getgenv)
            if ok and type(result) == "table" then
                table.insert(environments, result)
            end
        end
        table.insert(environments, _G)

        for _, environment in ipairs(environments) do
            if type(environment.keypress) == "function" then
                return environment.keypress, environment.keyrelease
            end
        end
        return nil, nil
    end

    local function tapHandSwitchKey()
        local press, release = resolveKeyPressFunctions()
        if type(press) == "function" then
            local ok = pcall(press, 0x48)
            if ok then
                if type(release) == "function" then
                    task.delay(0.04, function() pcall(release, 0x48) end)
                end
                return true
            end
        end

        -- Fallback for executors without keypress/keyrelease: fire the real
        -- input event through Roblox's own VirtualInputManager. Wrapped in
        -- pcall since some executors sandbox this; failure just means we
        -- fall through to "could not tap", same as before this fallback.
        local ok = pcall(function()
            local vim = game:GetService("VirtualInputManager")
            vim:SendKeyEvent(true, Enum.KeyCode.H, false, game)
            task.delay(0.04, function()
                pcall(function()
                    vim:SendKeyEvent(false, Enum.KeyCode.H, false, game)
                end)
            end)
        end)
        return ok
    end

    -- Clears every hysteresis timer the hand-switch state machine tracks, not
    -- just the two the old code touched. Leaving handStableSince/
    -- desiredHandSince stale across a ball drop-and-pickup let the very next
    -- frame skip the settle window entirely and fire an immediate, unverified
    -- switch attempt.
    local function resetHandSwitchState()
        st.pendingHand = nil
        st.lastDesiredHand = nil
        st.lastDetectedHand = nil
        st.handStableSince = 0
        st.desiredHandSince = 0
    end

    local function updateDirectionalHandSwitch(character, humanoid, root, ball)
        local now = os.clock()
        local desired = desiredMovementHand(character, humanoid, root)
        if not desired then
            st.lastDesiredHand = nil
            st.pendingHand = nil
            return
        end
        if desired ~= st.lastDesiredHand then
            st.lastDesiredHand = desired
            st.desiredHandSince = now
            st.pendingHand = nil
            return
        end
        if now - st.desiredHandSince < 0.10 then return end

        local current = detectBallHand(character, humanoid, root, ball)
        if not current then return end
        if current ~= st.lastDetectedHand then
            st.lastDetectedHand = current
            st.handStableSince = now
            return
        end
        if now - st.handStableSince < 0.06 then return end
        if current == desired then
            st.pendingHand = nil
            return
        end
        if st.pendingHand == desired and now - st.lastHandSwitch < 0.90 then
            return
        end
        if now - st.lastHandSwitch < cfg.handSwitchCooldown then return end

        if tapHandSwitchKey() then
            st.lastHandSwitch = now
            st.pendingHand = desired
        end
    end

    local function claimRotationControl(humanoid)
        if st.autoRotateHumanoid ~= humanoid then
            restoreAutoRotate()
            st.autoRotateHumanoid = humanoid
            st.savedAutoRotate = humanoid.AutoRotate
        end
        humanoid.AutoRotate = false
    end

    local function applyAutoBody(root, humanoid, dt)
        local threats = {}
        for _, player in ipairs(PlayersService:GetPlayers()) do
            if player ~= LocalPlayer and not isTeammate(player) then
                local character = player.Character
                local defenderRoot = character
                    and character:FindFirstChild("HumanoidRootPart")
                local defenderHumanoid = character
                    and character:FindFirstChildOfClass("Humanoid")
                if defenderRoot and defenderHumanoid and defenderHumanoid.Health > 0 then
                    local offset = defenderRoot.Position - root.Position
                    local flat = Vector3.new(offset.X, 0, offset.Z)
                    local distance = flat.Magnitude
                    if distance > 0.05 and distance <= cfg.autoBodyRange then
                        table.insert(threats, {
                            Direction = flat.Unit,
                            Distance = distance,
                        })
                    end
                end
            end
        end

        if #threats == 0 then return false end
        table.sort(threats, function(a, b)
            return a.Distance < b.Distance
        end)

        -- The closest defender leads, while up to three additional defenders
        -- influence the protected angle. Inverse-square weighting keeps nearby
        -- pressure dominant and prevents distant players from whipping rotation.
        local combined = Vector3.new(0, 0, 0)
        local count = math.min(#threats, cfg.autoBodyMaxDefenders)
        for index = 1, count do
            local threat = threats[index]
            local weight = 1 / math.max(threat.Distance * threat.Distance, 1)
            if index == 1 then weight = weight * 1.75 end
            combined = combined + threat.Direction * weight
        end
        if combined.Magnitude <= 0.001 then
            combined = threats[1].Direction
        end

        claimRotationControl(humanoid)
        local faceAway = -combined.Unit
        local target = CFrame.lookAt(root.Position, root.Position + faceAway)
        local alpha = 1 - math.exp(
            -cfg.autoBodySmoothness * math.max(tonumber(dt) or 1 / 60, 0)
        )
        root.CFrame = root.CFrame:Lerp(target, math.clamp(alpha, 0, 1))
        return true
    end

    -- ==== Adaptive defense =================================================
    -- Every helper below resolves possession through searchContainer/carrierOf
    -- rather than a hard-coded "Basketball" lookup, so the same code works in
    -- Hoopz, Swish, Drop Offs and Rooftop 2. Those two helpers already consult
    -- the per-game BALL_NAMES/BALL_KEYWORDS tables.

    local POSSESSION_FLAGS = {
        "Ball", "HasBall", "HoldingBall", "Possession", "HasBasketball",
        "BallHandler", "IsBallHandler",
    }

    local function truthyPossession(value)
        if value == nil or value == false or value == "" then return false end
        if type(value) == "number" then return value ~= 0 end
        local text = string.lower(tostring(value))
        return text ~= "false" and text ~= "none" and text ~= "nil"
            and text ~= "0"
    end

    local function crossGameHoldingBall(player, character)
        if not player or not character then return false end
        if searchContainer(character) then return true end

        -- Rooftop 2 commonly keeps the physical ball in Workspace and exposes
        -- possession only through Player.Ball. The broader list covers private
        -- servers and renamed variants of the other games.
        for _, name in ipairs(POSSESSION_FLAGS) do
            local okPlayer, playerValue = pcall(function()
                return player:GetAttribute(name)
            end)
            if okPlayer and truthyPossession(playerValue) then return true end
            local okCharacter, characterValue = pcall(function()
                return character:GetAttribute(name)
            end)
            if okCharacter and truthyPossession(characterValue) then return true end

            local valueObject = character:FindFirstChild(name)
                or player:FindFirstChild(name)
            if valueObject and valueObject:IsA("ValueBase")
                and truthyPossession(valueObject.Value) then
                return true
            end
        end
        return false
    end

    local function ballHandlerPlayer()
        for _, player in ipairs(PlayersService:GetPlayers()) do
            local character = player.Character
            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")
            if character and humanoid and humanoid.Health > 0
                and crossGameHoldingBall(player, character) then
                return player
            end
        end

        -- Games that leave the ball parented to workspace while it is being
        -- dribbled never match the container scan, so fall back to the loose
        -- ball plus proximity-based ownership.
        local ball = st.ball or courtBallPart()
        if ball then return carrierOf(ball) end
        return nil
    end

    local function closestOffBallOpponent(root, handler)
        local best, bestDistance = nil, math.huge
        for _, player in ipairs(PlayersService:GetPlayers()) do
            if player ~= LocalPlayer and player ~= handler
                and not isTeammate(player) then
                local character = player.Character
                local humanoid = character
                    and character:FindFirstChildOfClass("Humanoid")
                local opponentRoot = character
                    and character:FindFirstChild("HumanoidRootPart")
                if humanoid and opponentRoot and humanoid.Health > 0
                    and not searchContainer(character) then
                    local distance =
                        (opponentRoot.Position - root.Position).Magnitude
                    if distance < bestDistance and distance <= cfg.maxRange then
                        best, bestDistance = player, distance
                    end
                end
            end
        end
        return best, bestDistance
    end

    -- Picks who to guard. The handler wins while they are inside the on-ball
    -- radius, unless the nearest off-ball opponent is clearly closer by more
    -- than the slack, which is what stops the assignment flickering when two
    -- opponents are about the same distance away.
    local function chooseDefensiveAssignment(root, handler)
        local handlerCharacter = handler and handler.Character
        local handlerRoot = handlerCharacter
            and handlerCharacter:FindFirstChild("HumanoidRootPart")
        local offBall, offBallDistance = closestOffBallOpponent(root, handler)

        if not handlerRoot then
            if not offBall then return nil, "Off-ball", "WAITING" end
            return offBall, "Off-ball", "OFF-BALL INTENT"
        end
        if not offBall then return handler, "On-ball", "ON-BALL INTENT" end

        local handlerDistance = (handlerRoot.Position - root.Position).Magnitude
        local closeEnough = handlerDistance <= cfg.adaptiveOnBallDistance
        local leaningOffBall =
            offBallDistance + cfg.adaptiveIntentSlack < handlerDistance
        if closeEnough and not leaningOffBall then
            return handler, "On-ball", "ON-BALL INTENT"
        end
        return offBall, "Off-ball", "OFF-BALL INTENT"
    end

    -- Reassignment is throttled instead of running every frame: the decision
    -- only needs to keep up with possession changes, and rescanning the roster
    -- at render rate is wasted work.
    local function updateAdaptiveAssignment(root, holdingBall)
        local now = os.clock()
        if now < st.nextAdaptiveScan then
            return st.adaptiveTarget, st.adaptiveMode
        end
        st.nextAdaptiveScan = now + 0.10

        if holdingBall then
            st.adaptiveTarget, st.adaptiveMode = nil, "Off-ball"
            st.adaptiveState = "PAUSED | LOCAL POSSESSION"
            return nil, "Off-ball"
        end

        local handler = ballHandlerPlayer()
        if handler == LocalPlayer or (handler and isTeammate(handler)) then
            st.adaptiveTarget, st.adaptiveMode = nil, "Off-ball"
            st.adaptiveState = "OFFENSE"
            return nil, "Off-ball"
        end

        local target, mode, state = chooseDefensiveAssignment(root, handler)
        st.adaptiveTarget, st.adaptiveMode, st.adaptiveState = target, mode, state
        return target, mode
    end

    -- ==== Head Ride ========================================================

    local function headRideReset(status)
        st.headRideEngaged = false
        st.headRideEngagedTarget = nil
        st.headRideMounted = false
        st.headRideStatus = status
            or (cfg.headRide and "WAITING FOR OFF-BALL" or "OFF")
    end

    local function headRideMountState(root, humanoid, head)
        local feetOffset =
            humanoid.RigType == Enum.HumanoidRigType.R6 and 3.5 or 3
        local feet = root.Position - Vector3.new(0, feetOffset, 0)
        local difference = feet - head.Position
        local horizontal =
            Vector3.new(difference.X, 0, difference.Z).Magnitude
        local mounted = math.abs(difference.Y) < cfg.headRideMountVertical
            and horizontal < cfg.headRideMountHorizontal
        return mounted, feetOffset
    end

    -- Closes on the assigned off-ball opponent and, once inside the engage
    -- radius, climbs onto and rides their head. Returns true when it has taken
    -- over movement for this frame.
    local function headRideStep(target, humanoid, root, dt)
        if not (cfg.headRide and target and humanoid and root) then
            return false
        end
        if st.headRideEngagedTarget and st.headRideEngagedTarget ~= target then
            headRideReset("NEW OFF-BALL ASSIGNMENT")
        end

        local character = target.Character
        local targetRoot = character
            and character:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = character
            and character:FindFirstChildOfClass("Humanoid")
        local head = character and character:FindFirstChild("Head")
        if not (character and targetRoot and targetHumanoid and head)
            or targetHumanoid.Health <= 0
            or searchContainer(character) then
            headRideReset("WAITING FOR OFF-BALL")
            return false
        end

        if cfg.headRideManualOverride and manualMovementActive() then
            st.headRideStatus = "MANUAL OVERRIDE"
            st.moving = false
            return true
        end

        local now = os.clock()
        local offset = targetRoot.Position - root.Position
        local flatOffset = Vector3.new(offset.X, 0, offset.Z)
        local distance = flatOffset.Magnitude

        local engageRange = math.max(cfg.headRideEngageRange, 1.5)
        if not st.headRideEngaged then
            if distance > engageRange then
                st.headRideStatus =
                    string.format("OFF-BALL GUARD | %.1f", distance)
                return false
            end
            st.headRideEngaged = true
            st.headRideEngagedTarget = target
        end

        local mounted, feetOffset = headRideMountState(root, humanoid, head)
        st.headRideMounted = mounted
        if mounted then
            -- Hold the seat. Rotation is left as-is so the ride does not fight
            -- the player's camera or Auto Body.
            local desiredPosition =
                head.Position + Vector3.new(0, feetOffset + 0.2, 0)
            local desiredCFrame =
                CFrame.new(desiredPosition) * root.CFrame.Rotation
            local smoothness = math.max(cfg.headRideMountSmoothness, 1)
            local alpha = 1 - math.exp(
                -smoothness * math.clamp(tonumber(dt) or 1 / 60, 0, 0.1)
            )
            root.CFrame = root.CFrame:Lerp(desiredCFrame, alpha)
            humanoid:Move(Vector3.new(0, 0, 0), false)
            st.moving = false
            st.headRideStatus = "RIDING | " .. target.Name
            return true
        end

        if distance < 0.01 then
            humanoid:Move(Vector3.new(0, 0, 0), false)
            st.moving = false
            st.headRideStatus = "MOUNTING | " .. target.Name
            return true
        end

        -- Blend the chase vector with the target's own movement so the mount
        -- lands where they are going instead of where they were.
        local targetMove = Vector3.new(
            targetHumanoid.MoveDirection.X,
            0,
            targetHumanoid.MoveDirection.Z
        )
        local followDistance = math.max(cfg.headRideFollowDistance, 0.5)
        local autoJump = cfg.headRideAutoJump == true
        local approachDistance = autoJump
            and math.min(followDistance, 1.4)
            or followDistance

        local moveDirection
        if distance > approachDistance then
            moveDirection = flatOffset.Unit
            if targetMove.Magnitude > 0.05 then
                local blend = targetMove.Unit + flatOffset.Unit
                if blend.Magnitude > 0.05 then moveDirection = blend.Unit end
            end
        elseif targetMove.Magnitude > 0.05 then
            moveDirection = targetMove.Unit
        else
            moveDirection = Vector3.new(0, 0, 0)
        end
        humanoid:Move(moveDirection, false)
        st.moving = moveDirection.Magnitude > 0

        local jumpDistance = math.max(cfg.headRideJumpDistance, 1)
        if autoJump and distance <= jumpDistance
            and humanoid.FloorMaterial ~= Enum.Material.Air
            and now - (st.headRideLastJump or 0) >= cfg.headRideJumpCooldown then
            st.headRideLastJump = now
            humanoid.Jump = true
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
            st.headRideStatus = "JUMPING TO | " .. target.Name
        else
            st.headRideStatus = "FOLLOWING | " .. target.Name
        end
        return true
    end

    -- Plain off-ball denial used when Head Ride is disabled or still out of
    -- range: hold station in front of (or behind) the assigned opponent.
    local function adaptiveOffBallStep(target, humanoid, root)
        local character = target and target.Character
        local targetRoot = character
            and character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then return false end

        restoreAutoRotate()

        local look = targetRoot.CFrame.LookVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        local desired
        if flatLook.Magnitude > 0.01 then
            local direction = cfg.offballPosition == "Behind" and -1 or 1
            desired = targetRoot.Position
                + flatLook.Unit * cfg.offballDistance * direction
        else
            desired = targetRoot.Position
        end

        st.suggestedPosition = desired
        st.suggestedAt = os.clock()

        local delta = desired - root.Position
        local flat = Vector3.new(delta.X, 0, delta.Z)
        if flat.Magnitude > 1 then
            humanoid:Move(flat.Unit, false)
            st.moving = true
        else
            humanoid:Move(Vector3.new(0, 0, 0), false)
            st.moving = false
        end

        local faceDelta = targetRoot.Position - root.Position
        local flatFace = Vector3.new(faceDelta.X, 0, faceDelta.Z)
        if flatFace.Magnitude > 0.05 then
            root.CFrame = CFrame.lookAt(
                root.Position,
                root.Position + flatFace.Unit
            )
        end
        return true
    end

    local function step(dt)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root or humanoid.Health <= 0 then
            restoreAutoRotate()
            stopMoving(humanoid)
            return
        end
        if humanoid.Sit or humanoid.PlatformStand then
            restoreAutoRotate()
            stopMoving(humanoid)
            return
        end

        local heldBall = searchContainer(character)
        local holdingBall = heldBall ~= nil
        -- Hand switching only cares about the ball and movement input, not
        -- about whether Auto Body's defender-facing behaviour is on. Those
        -- are unrelated features that happened to share a UI section.
        if cfg.autoHandSwitch and heldBall then
            updateDirectionalHandSwitch(character, humanoid, root, heldBall)
        else
            resetHandSwitchState()
        end

        -- Auto Body is independent from Autoguard. It can run constantly or only
        -- while holding the ball, and always leaves movement under player control.
        local autoBodyAllowed = cfg.autoBody
            and (not cfg.autoBodyOnlyHolding or holdingBall)
        if autoBodyAllowed and applyAutoBody(root, humanoid, dt) then
            st.ball = nil
            st.moving = false
            return
        end

        -- Advisory mode keeps solving while the guard itself is switched off.
        -- The render bind neutralises anything this pass tries to apply.
        if not cfg.enabled and not st.suggestOnly then
            restoreAutoRotate()
            stopMoving(humanoid)
            return
        end

        -- This check runs after Roblox's ControlModule. Do not issue a zero Move
        -- here: simply returning preserves the WASD/thumbstick direction that the
        -- control script wrote earlier in the same frame.
        if cfg.manualMovementOverride and manualMovementActive()
            and not st.suggestOnly then
            restoreAutoRotate()
            st.moving = false
            return
        end

        if cfg.pauseWhenHolding and holdingBall then
            st.ball = nil
            restoreAutoRotate()
            stopMoving(humanoid)
            return
        end

        -- Adaptive defense runs before the fixed-mode logic so the assignment
        -- can swap between the ball handler and an off-ball man mid-possession.
        -- On-ball assignments fall through to the existing carrier logic below;
        -- off-ball assignments are handled entirely here.
        if cfg.adaptiveDefense then
            local target, adaptiveMode = updateAdaptiveAssignment(root, holdingBall)
            cfg.mode = adaptiveMode == "Off-ball" and "Offball" or cfg.onballMode

            if adaptiveMode == "Off-ball" then
                if target then
                    if headRideStep(target, humanoid, root, dt) then
                        st.ball = nil
                        return
                    end
                    if adaptiveOffBallStep(target, humanoid, root) then
                        st.ball = nil
                        return
                    end
                else
                    headRideReset()
                    restoreAutoRotate()
                    stopMoving(humanoid)
                    return
                end
            else
                headRideReset(cfg.headRide and "ON-BALL | NORMAL GUARD" or "OFF")
            end
        elseif st.headRideStatus ~= "OFF" then
            headRideReset("OFF")
        end

        local ball = findBall()
        if not ball then
            restoreAutoRotate()
            stopMoving(humanoid)
            -- Autoguard's on-ball/off-ball modes all guard an opponent, and
            -- Hoopz's solo Practice area has none. Say so once instead of
            -- leaving the toggle looking like it silently failed.
            if notify and not st.practiceNoticeShown and inPracticeRegion(root) then
                st.practiceNoticeShown = true
                notify("Autoguard: no opponent to guard (Practice has none)")
            end
            return
        end
        st.practiceNoticeShown = false

        local carrier = carrierOf(ball)

        local targetPosition = ball.Position
        local effectiveStopDistance = cfg.stopDistance
        if (cfg.mode == "Carrier" or cfg.mode == "Offball"
            or cfg.mode == "Mirror" or cfg.mode == "Backward"
            or cfg.mode == "360" or cfg.mode == "Jitter"
            or cfg.mode == "Cutoff")
            and carrier and carrier ~= LocalPlayer then
            local carrierCharacter = carrier.Character
            local carrierRoot = carrierCharacter
                and carrierCharacter:FindFirstChild("HumanoidRootPart")
            local carrierHumanoid = carrierCharacter
                and carrierCharacter:FindFirstChildOfClass("Humanoid")
            if carrierRoot then
                if cfg.mode == "Offball" then
                    local look = carrierRoot.CFrame.LookVector
                    local flatLook = Vector3.new(look.X, 0, look.Z)
                    if flatLook.Magnitude > 0.01 then
                        local direction = cfg.offballPosition == "Behind" and -1 or 1
                        targetPosition = carrierRoot.Position
                            + flatLook.Unit * cfg.offballDistance * direction
                    else
                        targetPosition = carrierRoot.Position
                    end
                    effectiveStopDistance = 1
                elseif cfg.mode == "Mirror" then
                    -- Hold a point directly in front of the carrier. As their yaw
                    -- changes, this anchor rotates around them to mirror cuts.
                    local carrierLook = carrierRoot.CFrame.LookVector
                    local flatLook = Vector3.new(carrierLook.X, 0, carrierLook.Z)
                    if flatLook.Magnitude > 0.01 then
                        flatLook = flatLook.Unit
                        targetPosition = carrierRoot.Position
                            + flatLook * cfg.mirrorDistance
                    else
                        targetPosition = carrierRoot.Position
                    end
                    effectiveStopDistance = 1.25
                elseif cfg.mode == "Cutoff" then
                    -- Beat the carrier to their own drive line rather than
                    -- trailing them. The anchor sits between the carrier and
                    -- the basket they are attacking, then slides along whatever
                    -- direction they are genuinely moving.
                    local carrierVelocity = Vector3.new(0, 0, 0)
                    local okVelocity, velocity = pcall(function()
                        return carrierRoot.AssemblyLinearVelocity
                    end)
                    if okVelocity and typeof(velocity) == "Vector3" then
                        carrierVelocity = Vector3.new(velocity.X, 0, velocity.Z)
                    end

                    local goal = attackingGoal(carrier, carrierRoot, carrierVelocity)
                    local driveDirection
                    if goal then
                        local toGoal = goal.Position - carrierRoot.Position
                        local flatGoal = Vector3.new(toGoal.X, 0, toGoal.Z)
                        if flatGoal.Magnitude > 0.01 then
                            driveDirection = flatGoal.Unit
                        end
                    end
                    if not driveDirection then
                        -- No court resolved: fall back to where they face.
                        local look = carrierRoot.CFrame.LookVector
                        local flatLook = Vector3.new(look.X, 0, look.Z)
                        if flatLook.Magnitude > 0.01 then
                            driveDirection = flatLook.Unit
                        end
                    end

                    -- Blend the hoop line toward live momentum so a hard cut
                    -- away from the basket still drags the anchor with it.
                    if carrierVelocity.Magnitude > 1.5 then
                        local bias = math.clamp(cfg.cutoffBias / 100, 0, 1)
                        local blended = carrierVelocity.Unit
                        if driveDirection then
                            blended = driveDirection * (1 - bias)
                                + carrierVelocity.Unit * bias
                        end
                        if blended.Magnitude > 0.01 then
                            driveDirection = blended.Unit
                        end
                    end

                    if driveDirection then
                        targetPosition = carrierRoot.Position
                            + driveDirection * cfg.cutoffDepth
                            + carrierVelocity * (cfg.cutoffLead / 100)
                    else
                        targetPosition = carrierRoot.Position
                    end
                    if cfg.cutoffClampCourt then
                        targetPosition = clampToCourt(targetPosition)
                    end
                    effectiveStopDistance = 1.25

                    -- Hold the chest on the carrier while sliding sideways.
                    claimRotationControl(humanoid)
                elseif cfg.mode == "Backward" then
                    -- Chase the carrier normally, but point the character away
                    -- from them. Movement remains world-space, so this makes the
                    -- defender literally move toward the carrier while turned
                    -- backwards.
                    targetPosition = carrierRoot.Position
                    effectiveStopDistance = cfg.stopDistance
                elseif cfg.mode == "360" then
                    targetPosition = carrierRoot.Position
                    effectiveStopDistance = cfg.stopDistance
                    if st.autoRotateHumanoid ~= humanoid then
                        restoreAutoRotate()
                        st.autoRotateHumanoid = humanoid
                        st.savedAutoRotate = humanoid.AutoRotate
                    end
                    humanoid.AutoRotate = false
                    root.CFrame = root.CFrame * CFrame.Angles(
                        0,
                        math.rad(cfg.spinSpeed) * (tonumber(dt) or 1 / 60),
                        0
                    )
                elseif cfg.mode == "Jitter" then
                    targetPosition = carrierRoot.Position
                    effectiveStopDistance = cfg.stopDistance
                    if st.autoRotateHumanoid ~= humanoid then
                        restoreAutoRotate()
                        st.autoRotateHumanoid = humanoid
                        st.savedAutoRotate = humanoid.AutoRotate
                    end
                    humanoid.AutoRotate = false
                    st.jitterPhase = st.jitterPhase
                        + (tonumber(dt) or 1 / 60) * cfg.jitterSpeed * math.pi * 2
                    local faceDelta = carrierRoot.Position - root.Position
                    local flatFace = Vector3.new(faceDelta.X, 0, faceDelta.Z)
                    if flatFace.Magnitude > 0.05 then
                        local baseFacing = CFrame.lookAt(
                            root.Position,
                            root.Position + flatFace.Unit
                        )
                        root.CFrame = baseFacing * CFrame.Angles(
                            0,
                            math.rad(cfg.jitterAngle) * math.sin(st.jitterPhase),
                            0
                        )
                    end
                else
                    targetPosition = carrierRoot.Position
                end

                if cfg.mode ~= "360" and cfg.mode ~= "Jitter"
                    and cfg.mode ~= "Cutoff" then
                    restoreAutoRotate()
                end

                if cfg.mode == "Mirror" or cfg.mode == "Offball"
                    or cfg.mode == "Cutoff" then
                    local faceDelta = carrierRoot.Position - root.Position
                    local flatFace = Vector3.new(faceDelta.X, 0, faceDelta.Z)
                    if flatFace.Magnitude > 0.05 then
                        root.CFrame = CFrame.lookAt(
                            root.Position,
                            root.Position + flatFace.Unit
                        )
                    end
                elseif cfg.mode == "Backward" then
                    local awayDelta = root.Position - carrierRoot.Position
                    local flatAway = Vector3.new(awayDelta.X, 0, awayDelta.Z)
                    if flatAway.Magnitude > 0.05 then
                        root.CFrame = CFrame.lookAt(
                            root.Position,
                            root.Position + flatAway.Unit
                        )
                    end
                end
            end

            -- Mirror the guarded ball carrier's jump while we are grounded.
            -- Jumping is intentionally used instead of Freefall so dropping from
            -- a ledge does not make autoguard jump for no reason.
            if cfg.jumpBlock and carrierHumanoid
                and (carrierHumanoid.Jump
                    or carrierHumanoid:GetState() == Enum.HumanoidStateType.Jumping)
                and humanoid.FloorMaterial ~= Enum.Material.Air then
                humanoid.Jump = true
            end
        elseif cfg.lead > 0 then
            -- Lead a loose or passed ball instead of trailing behind it.
            local ok, velocity = pcall(function()
                return ball.AssemblyLinearVelocity
            end)
            if ok and typeof(velocity) == "Vector3" then
                targetPosition = targetPosition + velocity * (cfg.lead / 100) * 0.25
            end
        end

        -- In Ball mode, intercept a descending ball before it reaches the
        -- floor. Hoopz can leave a thrown Basketball parented near its previous
        -- owner briefly, so distance from that owner is also used to decide
        -- whether the ball is genuinely loose.
        local ballIsLoose = carrier == nil
        if carrier then
            local carrierCharacter = carrier.Character
            local carrierRoot = carrierCharacter
                and carrierCharacter:FindFirstChild("HumanoidRootPart")
            if not carrierRoot or (ball.Position - carrierRoot.Position).Magnitude > 8 then
                ballIsLoose = true
            end
        end

        if cfg.mode == "Ball" and cfg.airCatch and ballIsLoose then
            local ok, velocity = pcall(function()
                return ball.AssemblyLinearVelocity
            end)
            if not ok or typeof(velocity) ~= "Vector3" then
                ok, velocity = pcall(function() return ball.Velocity end)
            end

            if ok and typeof(velocity) == "Vector3" then
                local gravity = math.max(workspace.Gravity, 1)
                local function descendingTimeToHeight(height)
                    local verticalOffset = ball.Position.Y - height
                    local discriminant = velocity.Y * velocity.Y
                        + 2 * gravity * verticalOffset
                    if discriminant < 0 then return nil end
                    local value = (velocity.Y + math.sqrt(discriminant)) / gravity
                    if value > 0 then return value end
                    return nil
                end

                local jumpCatchHeight = root.Position.Y + 5.5
                local groundCatchHeight = root.Position.Y + 2.5
                local jumpCatchTime = descendingTimeToHeight(jumpCatchHeight)
                local groundCatchTime = descendingTimeToHeight(groundCatchHeight)

                -- Direct overhead interception: compare the rising character and
                -- descending ball as relative motion. Gravity affects both, so it
                -- cancels from their separation. This catches the case where the
                -- ball is already below the earlier fixed jump-height crossing.
                local jumpVelocity
                if humanoid.UseJumpPower then
                    jumpVelocity = humanoid.JumpPower
                else
                    jumpVelocity = math.sqrt(
                        2 * gravity * math.max(humanoid.JumpHeight, 1)
                    )
                end
                local verticalGap = ball.Position.Y - root.Position.Y
                local relativeClosingSpeed = jumpVelocity - velocity.Y
                local directInterceptTime = nil
                if verticalGap > 2.5 and relativeClosingSpeed > 0.01 then
                    directInterceptTime = (verticalGap - 2.5)
                        / relativeClosingSpeed
                end

                local directJumpChosen = false
                if directInterceptTime and directInterceptTime > 0
                    and directInterceptTime <= 0.9 and groundCatchTime
                    and directInterceptTime + 0.03 < groundCatchTime then
                    local directPoint = ball.Position + Vector3.new(
                        velocity.X * directInterceptTime,
                        0,
                        velocity.Z * directInterceptTime
                    )
                    local directDelta = directPoint - root.Position
                    local directDistance = Vector3.new(
                        directDelta.X,
                        0,
                        directDelta.Z
                    ).Magnitude
                    local directReach = math.max(humanoid.WalkSpeed, 1)
                        * directInterceptTime + 5

                    if directDistance <= directReach then
                        directJumpChosen = true
                        targetPosition = Vector3.new(
                            directPoint.X,
                            root.Position.Y,
                            directPoint.Z
                        )
                        effectiveStopDistance = math.min(effectiveStopDistance, 1.25)
                        if humanoid.FloorMaterial ~= Enum.Material.Air then
                            humanoid.Jump = true
                            pcall(function()
                                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                            end)
                        end
                    end
                end

                if not directJumpChosen and jumpCatchTime and groundCatchTime
                    and jumpCatchTime <= 5 then
                    local jumpPoint = ball.Position + Vector3.new(
                        velocity.X * jumpCatchTime,
                        0,
                        velocity.Z * jumpCatchTime
                    )
                    local groundPoint = ball.Position + Vector3.new(
                        velocity.X * groundCatchTime,
                        0,
                        velocity.Z * groundCatchTime
                    )
                    local jumpDelta = jumpPoint - root.Position
                    local groundDelta = groundPoint - root.Position
                    local jumpDistance = Vector3.new(
                        jumpDelta.X,
                        0,
                        jumpDelta.Z
                    ).Magnitude
                    local groundDistance = Vector3.new(
                        groundDelta.X,
                        0,
                        groundDelta.Z
                    ).Magnitude
                    local walkSpeed = math.max(humanoid.WalkSpeed, 1)
                    local jumpRunTime = jumpDistance / walkSpeed
                    local groundRunTime = groundDistance / walkSpeed

                    -- Compare the complete intercept ETAs. A mid-air attempt is
                    -- selected only when we can reach its X/Z point in time and
                    -- it beats waiting for the standing-height interception.
                    local jumpFeasible = jumpRunTime <= jumpCatchTime + 0.12
                    local groundFeasible = groundRunTime <= groundCatchTime + 0.12
                    local midairETA = math.max(jumpCatchTime, jumpRunTime)
                    local groundETA = math.max(groundCatchTime, groundRunTime)
                    local midairIsFaster = jumpFeasible
                        and (not groundFeasible or midairETA + 0.05 < groundETA)

                    if midairIsFaster then
                        targetPosition = Vector3.new(
                            jumpPoint.X,
                            root.Position.Y,
                            jumpPoint.Z
                        )
                        effectiveStopDistance = math.min(effectiveStopDistance, 1.25)

                        -- Time the launch so the character rises into the ball
                        -- instead of jumping immediately while it is still high.
                        local jumpRiseTime
                        if humanoid.UseJumpPower then
                            jumpRiseTime = humanoid.JumpPower / gravity
                        else
                            jumpRiseTime = math.sqrt(
                                2 * math.max(humanoid.JumpHeight, 1) / gravity
                            )
                        end
                        jumpRiseTime = math.clamp(jumpRiseTime, 0.2, 0.75)
                        local atLaunchWindow = jumpCatchTime <= jumpRiseTime + 0.18
                        local closeEnough = jumpDistance <= walkSpeed
                            * math.max(jumpCatchTime, 0.1) + 5

                        if atLaunchWindow and closeEnough
                            and humanoid.FloorMaterial ~= Enum.Material.Air then
                            humanoid.Jump = true
                            pcall(function()
                                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                            end)
                        end
                    else
                        -- Waiting is faster, so run toward the lower interception
                        -- without jumping.
                        targetPosition = Vector3.new(
                            groundPoint.X,
                            root.Position.Y,
                            groundPoint.Z
                        )
                    end
                end
            end
        end

        -- Publish the solve before acting on it. The ghost renders this exact
        -- vector, so the suggestion can never drift from what the guard thinks.
        st.suggestedPosition = targetPosition
        st.suggestedAt = os.clock()

        local delta = targetPosition - root.Position
        local flat = Vector3.new(delta.X, 0, delta.Z)
        local distance = flat.Magnitude
        if distance > cfg.maxRange or distance <= effectiveStopDistance or distance < 0.05 then
            stopMoving(humanoid)
            return
        end

        humanoid:Move(flat.Unit, false)
        st.moving = true
    end

    --== offence ghost prediction ============================================
    -- Reads the defender assigned to you and proposes where to go: a driving
    -- lane when you have the ball, open space when you do not. Candidate spots
    -- are sampled and scored, rather than derived from a single formula, so
    -- the same solver handles both cases by reweighting.

    -- Candidate spots are laid out in the court's own frame: so many studs
    -- downcourt toward the rim, so many studs across. Sampling a ring in world
    -- space was the mistake that produced upcourt suggestions, because the
    -- spot furthest from your defender is usually the one behind you.
    local OFFENSE_DRIVE_FORWARD = { 2, 4, 6, 8, 11, 14 }
    local OFFENSE_DRIVE_LATERAL = { -9, -6, -3, 0, 3, 6, 9 }
    local OFFENSE_SPOT_FORWARD = { -6, -3, 0, 3, 6, 9, 12 }
    local OFFENSE_SPOT_LATERAL = { -12, -8, -4, 0, 4, 8, 12 }
    -- Downcourt progress outranks every other term.
    local OFFENSE_FORWARD_GAIN = 1.35
    local OFFENSE_STEAL_LANE = 0.9

    local function flatDistance(a, b)
        return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
    end

    -- Perpendicular distance from a point to a segment, flattened to the court
    -- plane. Used for "is anyone standing in this lane".
    local function segmentDistance(point, a, b)
        local abx, abz = b.X - a.X, b.Z - a.Z
        local lengthSquared = abx * abx + abz * abz
        if lengthSquared < 0.001 then return flatDistance(point, a) end
        local t = ((point.X - a.X) * abx + (point.Z - a.Z) * abz) / lengthSquared
        t = math.clamp(t, 0, 1)
        local closest = Vector3.new(a.X + abx * t, point.Y, a.Z + abz * t)
        return flatDistance(point, closest)
    end

    local function livingRoots(wantTeammates)
        local roots = {}
        for _, player in ipairs(PlayersService:GetPlayers()) do
            if player ~= LocalPlayer then
                local mate = offenseTeammate(player)
                if mate == (wantTeammates == true) then
                    local character = player.Character
                    local humanoid = character
                        and character:FindFirstChildOfClass("Humanoid")
                    local playerRoot = character
                        and character:FindFirstChild("HumanoidRootPart")
                    if humanoid and playerRoot and humanoid.Health > 0 then
                        table.insert(roots, playerRoot)
                    end
                end
            end
        end
        return roots
    end

    -- Dedicated defender acquisition: read the closest living opponent to the
    -- local character every solve. This never uses ball distance, player-list
    -- order, the current guard target, or a stale cached assignment.
    local function allLivingOtherRoots()
        local roots = {}
        for _, player in ipairs(PlayersService:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local humanoid = character
                    and character:FindFirstChildOfClass("Humanoid")
                local playerRoot = character
                    and character:FindFirstChild("HumanoidRootPart")
                if humanoid and playerRoot and humanoid.Health > 0 then
                    table.insert(roots, playerRoot)
                end
            end
        end
        return roots
    end

    local function closestOffenseDefender(origin, opponents)
        local closest, closestGap = nil, math.huge
        for _, opponentRoot in ipairs(opponents) do
            if opponentRoot and opponentRoot.Parent then
                local gap = flatDistance(origin, opponentRoot.Position)
                if gap < closestGap then
                    closest, closestGap = opponentRoot, gap
                end
            end
        end
        return closest, closestGap
    end

    -- Classifies how the defender is playing you right now: how tight, which
    -- shoulder they are shading, whether they are between you and the rim, and
    -- where they will be a moment from now given how they are moving. Every
    -- offensive suggestion is scored against this read rather than against a
    -- static snapshot of where they happen to be standing.
    local function readDefender(origin, defenderRoot, hoop)
        local defenderPos = defenderRoot.Position

        local ok, velocity = pcall(function()
            return defenderRoot.AssemblyLinearVelocity
        end)
        if not ok or typeof(velocity) ~= "Vector3" then
            velocity = defenderRoot.Velocity
        end

        local lead = math.clamp(cfg.offensePredict, 0, 1.5)
        local future = Vector3.new(
            defenderPos.X + velocity.X * lead,
            origin.Y,
            defenderPos.Z + velocity.Z * lead
        )

        local toHoopRaw = Vector3.new(hoop.X - origin.X, 0, hoop.Z - origin.Z)
        local toHoop = toHoopRaw.Magnitude > 0.01
            and toHoopRaw.Unit
            or Vector3.new(0, 0, 1)
        local right = toHoop:Cross(Vector3.new(0, 1, 0))

        local offset = Vector3.new(
            defenderPos.X - origin.X, 0, defenderPos.Z - origin.Z
        )
        local gap = offset.Magnitude
        -- Positive shade means they are cheating to your right; positive depth
        -- means they are sitting between you and the basket.
        local shade = offset:Dot(right)
        local depth = offset:Dot(toHoop)

        -- Are they actively closing you down, or just drifting?
        local closing = false
        if gap > 0.01 then
            local flatVelocity = Vector3.new(velocity.X, 0, velocity.Z)
            if flatVelocity.Magnitude > 4 then
                closing = flatVelocity.Unit:Dot((offset * -1).Unit) > 0.5
            end
        end

        local pressing = gap <= cfg.offensePressDistance
        local sagging = gap >= cfg.offenseSagDistance
        local posture = pressing and "PRESSURE"
            or (sagging and "SAGGING" or "EVEN")
        if depth < -1.5 then posture = "TRAILING" end

        local side = "SQUARE"
        if shade > 1.5 then
            side = "SHADING RIGHT"
        elseif shade < -1.5 then
            side = "SHADING LEFT"
        end

        return {
            Position = defenderPos,
            Future = future,
            ToHoop = toHoop,
            Right = right,
            Gap = gap,
            Shade = shade,
            Depth = depth,
            Pressing = pressing,
            Sagging = sagging,
            Closing = closing,
            Text = posture .. " " .. side,
        }
    end

    -- Personal BeT-lite: a Roblox-friendly imitation model inspired by
    -- Behavior Transformer, Action Chunking and DAgger. It keeps the model
    -- entirely local: mode voting prevents left/right averaging, residuals
    -- preserve the player's exact angle, chunks preserve short combinations,
    -- and manual overrides while Auto Follow is active receive extra weight.
    local LEARN_MODEL_FOLDER = "SilverSurferUI"
    local LEARN_MODEL_PATH = LEARN_MODEL_FOLDER
        .. "/offense_style_" .. tostring(LocalPlayer.UserId) .. ".json"
    local LEARN_MODEL_VERSION = 2

    local function saveMovementStyle(force)
        if not writefile then return false end
        if not force
            and st.offenseLearnSinceSave < cfg.offenseLearnSaveEvery then
            return false
        end
        if makefolder then pcall(makefolder, LEARN_MODEL_FOLDER) end
        local payload = {
            Version = LEARN_MODEL_VERSION,
            Samples = st.offenseLearnSamples,
        }
        local ok = pcall(function()
            writefile(LEARN_MODEL_PATH, HttpService:JSONEncode(payload))
        end)
        if ok then st.offenseLearnSinceSave = 0 end
        return ok
    end

    local function loadMovementStyle()
        if not readfile or not isfile then return false end
        local exists = false
        pcall(function() exists = isfile(LEARN_MODEL_PATH) end)
        if not exists then return false end
        local ok, payload = pcall(function()
            return HttpService:JSONDecode(readfile(LEARN_MODEL_PATH))
        end)
        if not ok or type(payload) ~= "table"
            or payload.Version ~= LEARN_MODEL_VERSION
            or type(payload.Samples) ~= "table" then
            return false
        end
        local loaded = {}
        for _, sample in ipairs(payload.Samples) do
            if type(sample) == "table"
                and type(sample.Features) == "table"
                and type(sample.Chunk) == "table"
                and #sample.Chunk > 0 then
                table.insert(loaded, sample)
                if #loaded >= cfg.offenseLearnMaxSamples then break end
            end
        end
        st.offenseLearnSamples = loaded
        st.offenseLearnCount = #loaded
        st.offenseLearnedReady =
            #loaded >= cfg.offenseLearnMinSamples
        return #loaded > 0
    end

    local function deleteMovementStyle()
        if delfile then
            pcall(delfile, LEARN_MODEL_PATH)
        elseif writefile then
            if makefolder then pcall(makefolder, LEARN_MODEL_FOLDER) end
            pcall(function()
                writefile(LEARN_MODEL_PATH, HttpService:JSONEncode({
                    Version = LEARN_MODEL_VERSION,
                    Samples = {},
                }))
            end)
        end
    end

    local function movementHistorySignature()
        local history = st.offenseLearnHistory
        local forward, lateral, weightTotal = 0, 0, 0
        local weight = 1
        local used = 0
        for index = #history, 1, -1 do
            local action = history[index]
            forward = forward + (action.Forward or 0) * weight
            lateral = lateral + (action.Lateral or 0) * weight
            weightTotal = weightTotal + weight
            weight = weight * 0.68
            used = used + 1
            if used >= cfg.offenseLearnHistorySize then break end
        end
        if weightTotal <= 0 then return 0, 0, 0, 0 end
        local previous = history[#history]
        local beforePrevious = history[#history - 1]
        local turnForward = previous and beforePrevious
            and ((previous.Forward or 0) - (beforePrevious.Forward or 0)) or 0
        local turnLateral = previous and beforePrevious
            and ((previous.Lateral or 0) - (beforePrevious.Lateral or 0)) or 0
        return forward / weightTotal, lateral / weightTotal,
            turnForward, turnLateral
    end

    -- Encode each state in the basket-relative court frame. No world X/Z is
    -- retained, so one learned style transfers across rotated courts and games.
    local function movementFeatures(origin, read, hoop, holdingBall)
        local previousForward, previousLateral,
            turnForward, turnLateral = movementHistorySignature()
        return {
            Gap = math.clamp(read.Gap / 18, 0, 3),
            Shade = math.clamp(read.Shade / 12, -2, 2),
            Depth = math.clamp(read.Depth / 16, -2, 2),
            Pressing = read.Pressing and 1 or 0,
            Sagging = read.Sagging and 1 or 0,
            Closing = read.Closing and 1 or 0,
            Holding = holdingBall and 1 or 0,
            Rim = math.clamp(flatDistance(origin, hoop) / 100, 0, 3),
            PreviousForward = previousForward,
            PreviousLateral = previousLateral,
            TurnForward = turnForward,
            TurnLateral = turnLateral,
        }
    end

    local function movementFeatureDistance(a, b)
        local function delta(name)
            return (tonumber(a[name]) or 0) - (tonumber(b[name]) or 0)
        end
        local gap, shade, depth = delta("Gap"), delta("Shade"), delta("Depth")
        local pressing, sagging = delta("Pressing"), delta("Sagging")
        local closing, holding = delta("Closing"), delta("Holding")
        local rim = delta("Rim")
        local previousForward = delta("PreviousForward")
        local previousLateral = delta("PreviousLateral")
        local turnForward, turnLateral =
            delta("TurnForward"), delta("TurnLateral")
        return gap * gap + shade * shade * 1.5 + depth * depth
            + pressing * pressing * 0.8 + sagging * sagging * 0.5
            + closing * closing * 0.65 + holding * holding * 4
            + rim * rim * 0.35
            + previousForward * previousForward * 1.2
            + previousLateral * previousLateral * 1.2
            + turnForward * turnForward * 0.45
            + turnLateral * turnLateral * 0.45
    end

    local function movementMode(forward, lateral)
        local count = math.max(cfg.offenseLearnModeCount, 4)
        local step = math.pi * 2 / count
        local angle = math.atan(lateral, forward)
        local index = math.floor((angle + step * 0.5) / step) % count
        return index + 1
    end

    local function movementModeCenter(mode)
        local count = math.max(cfg.offenseLearnModeCount, 4)
        local angle = ((tonumber(mode) or 1) - 1) * math.pi * 2 / count
        return math.cos(angle), math.sin(angle)
    end

    local function encodeMovementAction(forward, lateral)
        local magnitude = math.sqrt(forward * forward + lateral * lateral)
        if magnitude > 1 then
            forward, lateral = forward / magnitude, lateral / magnitude
        end
        local mode = movementMode(forward, lateral)
        local centerForward, centerLateral = movementModeCenter(mode)
        return {
            Mode = mode,
            ResidualForward = forward - centerForward,
            ResidualLateral = lateral - centerLateral,
            Forward = forward,
            Lateral = lateral,
        }
    end

    local function decodeMovementAction(action)
        if type(action) ~= "table" then return 0, 0 end
        if action.ResidualForward ~= nil then
            local centerForward, centerLateral =
                movementModeCenter(action.Mode)
            return centerForward + (tonumber(action.ResidualForward) or 0),
                centerLateral + (tonumber(action.ResidualLateral) or 0)
        end
        return tonumber(action.Forward) or 0,
            tonumber(action.Lateral) or 0
    end

    local function completeMovementChunk(pending)
        local samples = st.offenseLearnSamples
        table.insert(samples, {
            Features = pending.Features,
            Chunk = pending.Chunk,
            Weight = pending.Weight or 1,
        })
        while #samples > cfg.offenseLearnMaxSamples do
            table.remove(samples, 1)
        end
        st.offenseLearnCount = #samples
        st.offenseLearnedReady =
            #samples >= cfg.offenseLearnMinSamples
        st.offenseLearnSinceSave = st.offenseLearnSinceSave + 1
        saveMovementStyle(false)
    end

    local function learnCurrentMovement(root, read, hoop, holdingBall)
        local manual = manualMovementActive()
        if not manual then return end
        -- DAgger-style correction: an override during Auto Follow remains a
        -- training label even when the dedicated training toggle is off.
        if not cfg.offenseTraining and not cfg.offenseAuto then return end
        local now = os.clock()
        if now < (st.nextOffenseLearn or 0) then return end
        st.nextOffenseLearn = now + cfg.offenseLearnInterval

        local character = LocalPlayer.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")
        local movement = humanoid and humanoid.MoveDirection
        if not movement then return end
        movement = Vector3.new(movement.X, 0, movement.Z)
        if movement.Magnitude <= 0.12 then return end
        movement = movement.Unit

        local features = movementFeatures(
            root.Position, read, hoop, holdingBall
        )
        local action = encodeMovementAction(
            movement:Dot(read.ToHoop), movement:Dot(read.Right)
        )

        -- Finish every overlapping short trajectory that was started on an
        -- earlier frame. This learns combinations instead of disconnected taps.
        local pending = st.offenseLearnPending
        for index = #pending, 1, -1 do
            local trajectory = pending[index]
            table.insert(trajectory.Chunk, action)
            if #trajectory.Chunk >= cfg.offenseLearnChunkSize then
                completeMovementChunk(trajectory)
                table.remove(pending, index)
            end
        end

        local correction = cfg.offenseAuto and manual
        table.insert(pending, {
            Features = features,
            Chunk = { action },
            Weight = correction and cfg.offenseLearnCorrectionWeight or 1,
        })
        while #pending > cfg.offenseLearnChunkSize do
            table.remove(pending, 1)
        end

        local history = st.offenseLearnHistory
        table.insert(history, action)
        while #history > cfg.offenseLearnHistorySize do
            table.remove(history, 1)
        end
        st.offenseLearnPlan = nil
    end

    local function buildLearnedPlan(origin, read, hoop, holdingBall)
        local samples = st.offenseLearnSamples
        if #samples < cfg.offenseLearnMinSamples then return nil end
        local features = movementFeatures(origin, read, hoop, holdingBall)
        local ranked = {}
        for _, sample in ipairs(samples) do
            table.insert(ranked, {
                Distance = movementFeatureDistance(features, sample.Features),
                Sample = sample,
            })
        end
        table.sort(ranked, function(a, b)
            return a.Distance < b.Distance
        end)

        local count = math.min(#ranked, cfg.offenseLearnNeighbors)
        local modeVotes = {}
        local totalVote = 0
        for index = 1, count do
            local entry = ranked[index]
            local firstAction = entry.Sample.Chunk[1]
            local mode = firstAction and firstAction.Mode
                or movementMode(decodeMovementAction(firstAction))
            local weight = (tonumber(entry.Sample.Weight) or 1)
                / (0.06 + entry.Distance)
            modeVotes[mode] = (modeVotes[mode] or 0) + weight
            totalVote = totalVote + weight
        end

        local bestMode, bestVote = nil, -math.huge
        for mode, vote in pairs(modeVotes) do
            if vote > bestVote then
                bestMode, bestVote = mode, vote
            end
        end
        if not bestMode then return nil end

        local chunk = {}
        for stepIndex = 1, cfg.offenseLearnChunkSize do
            local forward, lateral, totalWeight = 0, 0, 0
            for index = 1, count do
                local entry = ranked[index]
                local firstAction = entry.Sample.Chunk[1]
                local sampleMode = firstAction and firstAction.Mode
                if sampleMode == bestMode then
                    local action = entry.Sample.Chunk[stepIndex]
                        or entry.Sample.Chunk[#entry.Sample.Chunk]
                    local actionForward, actionLateral =
                        decodeMovementAction(action)
                    local weight = (tonumber(entry.Sample.Weight) or 1)
                        / (0.06 + entry.Distance)
                    forward = forward + actionForward * weight
                    lateral = lateral + actionLateral * weight
                    totalWeight = totalWeight + weight
                end
            end
            if totalWeight > 0 then
                table.insert(chunk, {
                    Forward = forward / totalWeight,
                    Lateral = lateral / totalWeight,
                })
            end
        end
        if #chunk == 0 then return nil end

        local now = os.clock()
        return {
            Actions = chunk,
            Started = now,
            NextReplan = now + cfg.offenseLearnReplanInterval,
            Mode = bestMode,
            Confidence = math.clamp(
                (bestVote / math.max(totalVote, 0.001))
                    * ((#samples - cfg.offenseLearnMinSamples + 1) / 60 + 0.35),
                0.25, 1
            ),
            Samples = #samples,
        }
    end

    local function predictLearnedMovement(origin, read, hoop, holdingBall)
        local now = os.clock()
        local plan = st.offenseLearnPlan
        if not plan or now >= (plan.NextReplan or 0) then
            plan = buildLearnedPlan(origin, read, hoop, holdingBall)
            st.offenseLearnPlan = plan
        end
        if not plan or not plan.Actions or #plan.Actions == 0 then return nil end
        local elapsed = math.max(now - (plan.Started or now), 0)
        local index = math.clamp(
            math.floor(elapsed / cfg.offenseLearnInterval) + 1,
            1,
            #plan.Actions
        )
        local action = plan.Actions[index]
        local direction = read.ToHoop * action.Forward
            + read.Right * action.Lateral
        if direction.Magnitude <= 0.05 then return nil end
        return {
            Direction = direction.Unit,
            Confidence = plan.Confidence,
            Samples = plan.Samples,
            Mode = plan.Mode,
            ChunkStep = index,
        }
    end

    loadMovementStyle()

    local function offenseScore(
        candidate, origin, read, opponents, teammates, hoop,
        holdingBall, handlerRoot
    )
        local toCandidate = Vector3.new(
            candidate.X - origin.X, 0, candidate.Z - origin.Z
        )
        local travel = toCandidate.Magnitude
        -- Decompose the move the way the offence actually thinks about it:
        -- how much ground it gains toward the rim, and how far it strafes.
        local forwardGain = toCandidate:Dot(read.ToHoop)
        local lateralGain = toCandidate:Dot(read.Right)

        -- Getting downcourt is the spine of the read.
        local score = forwardGain * OFFENSE_FORWARD_GAIN

        -- Separation is measured against where the defender is going to be,
        -- not where they are, but it is capped and discounted so that it can
        -- break a tie between two forward options and never outvote going the
        -- right way down the floor.
        score = score + math.min(flatDistance(candidate, read.Future), 10)
            * cfg.offenseSeparation * 0.45

        -- Never suggest a spot somebody is already standing on.
        for _, opponentRoot in ipairs(opponents) do
            local gap = flatDistance(candidate, opponentRoot.Position)
            if gap < 5 then score = score - (5 - gap) * 4 end
        end

        -- Prefer nearby answers over long sprints across the floor.
        score = score - travel * 0.25

        if holdingBall then
            -- Ball security now works the way GEAGLEH's does: it slides you
            -- along the strafe axis, off the defender's ball-line. It can no
            -- longer push you backwards, because no backward spot exists to
            -- push you to.
            if cfg.offenseProtect then
                local reach = math.max(cfg.offenseStealRadius, 0.01)
                local exposure = flatDistance(candidate, read.Future)
                if exposure < reach then
                    local risk = (reach - exposure) / reach
                    score = score - risk * 18 * cfg.offenseProtectWeight
                        * (read.Closing and 1.6 or 1)
                end

                -- Carry the ball to the shoulder away from them rather than
                -- dragging it across their body.
                if math.abs(read.Shade) > cfg.offenseSideDeadzone then
                    local awaySide = read.Shade > 0 and -1 or 1
                    score = score + lateralGain * awaySide
                        * OFFENSE_STEAL_LANE * cfg.offenseProtectWeight
                end
            end

            -- Attack the shoulder they are not covering.
            if math.abs(read.Shade) > 1.5 then
                local openSide = read.Shade > 0 and -1 or 1
                score = score + lateralGain * openSide
                    * 0.6 * cfg.offenseReadWeight
            end

            if read.Sagging then
                -- They are giving you room, so take the space in front of you
                -- instead of sprinting into a set defender.
                score = score - travel * 0.5
            elseif read.Pressing then
                -- Under real pressure, strafing off the ball-line is worth
                -- more than a couple of extra studs toward the rim.
                score = score + math.abs(lateralGain) * 0.5
                    * cfg.offenseReadWeight
            end

            for _, opponentRoot in ipairs(opponents) do
                local lane = segmentDistance(opponentRoot.Position, candidate, hoop)
                if lane < 4 then
                    score = score - (4 - lane) * 3 * cfg.offenseLane
                end
            end
        else
            -- Off ball: hold useful spacing from the rim, keep the passing
            -- lane alive, and do not crowd your own teammates.
            score = score - math.abs(
                flatDistance(candidate, hoop) - cfg.offensePreferredRange
            ) * 0.6
            if handlerRoot then
                for _, opponentRoot in ipairs(opponents) do
                    local lane = segmentDistance(
                        opponentRoot.Position, handlerRoot.Position, candidate
                    )
                    if lane < 4 then
                        score = score - (4 - lane) * 3 * cfg.offenseLane
                    end
                end

                -- Being denied: if your defender is sitting in the passing
                -- lane, reward cutting behind them instead of fighting it.
                local denial = segmentDistance(
                    read.Position, handlerRoot.Position, origin
                )
                if denial < 4 then
                    local backdoor = segmentDistance(
                        read.Position, handlerRoot.Position, candidate
                    )
                    score = score + math.min(backdoor, 8) * 1.2
                        * cfg.offenseReadWeight
                end
            end
            for _, mateRoot in ipairs(teammates) do
                local gap = flatDistance(candidate, mateRoot.Position)
                if gap < 10 then score = score - (10 - gap) * 0.8 end
            end
        end

        return score
    end

    local function offenseSolve(root, holdingBall, handlerRoot)
        local origin = root.Position
        local opponents = livingRoots(false)
        if #opponents == 0 and getGame() ~= "Hoopz" then
            -- Some variants put everybody on one placeholder Team. When that
            -- happens, the only honest fallback is the closest other player.
            opponents = allLivingOtherRoots()
        end
        if #opponents == 0 then return nil, nil, nil end

        local defender, defenderGap =
            closestOffenseDefender(origin, opponents)
        -- Nobody is actually pressuring you, so there is nothing to beat.
        if not defender or defenderGap > cfg.offenseDefenderRange then
            return nil, nil, nil
        end

        local rootVelocity = nil
        pcall(function() rootVelocity = root.AssemblyLinearVelocity end)
        local goal = attackingGoal(LocalPlayer, root, rootVelocity)
        local hoop = goal and goal.Position
        if not hoop then return nil, nil, nil end
        if cfg.offenseInvertCourt then
            -- Mirror the basket through the player, flipping which way counts
            -- as downcourt without disturbing any of the lane maths.
            hoop = Vector3.new(
                origin.X * 2 - hoop.X, hoop.Y, origin.Z * 2 - hoop.Z
            )
        end

        local read = readDefender(origin, defender, hoop)
        learnCurrentMovement(root, read, hoop, holdingBall)
        local learned = predictLearnedMovement(
            origin, read, hoop, holdingBall
        )
        local teammates = livingRoots(true)
        -- The ghost is a local next-step cue, not a far-away destination. The
        -- full candidate grid is compressed into this radius around the current
        -- root and hard-capped again after court clamping.
        local localRadius = math.max(cfg.offenseLocalRadius, 2.5)
        local maxRadius = math.min(
            math.max(cfg.offenseSampleRadius, 4), localRadius
        )
        local best, bestScore = nil, -math.huge

        -- Driving keeps every candidate ahead of the ball. Spotting up allows
        -- a little drift back for spacing, but never a genuine retreat.
        local forwardSteps = holdingBall
            and OFFENSE_DRIVE_FORWARD
            or OFFENSE_SPOT_FORWARD
        local lateralSteps = holdingBall
            and OFFENSE_DRIVE_LATERAL
            or OFFENSE_SPOT_LATERAL
        local scale = maxRadius / 14

        for _, ahead in ipairs(forwardSteps) do
            for _, across in ipairs(lateralSteps) do
                local raw = origin
                    + read.ToHoop * (ahead * scale)
                    + read.Right * (across * scale)
                local clamped = clampToCourt(raw) or raw
                local candidate = Vector3.new(clamped.X, origin.Y, clamped.Z)

                local localDelta = Vector3.new(
                    candidate.X - origin.X, 0, candidate.Z - origin.Z
                )
                if localDelta.Magnitude > localRadius then
                    local capped = origin + localDelta.Unit * localRadius
                    local safe = clampToCourt(capped) or capped
                    candidate = Vector3.new(safe.X, origin.Y, safe.Z)
                    local finalDelta = Vector3.new(
                        candidate.X - origin.X, 0, candidate.Z - origin.Z
                    )
                    if finalDelta.Magnitude > localRadius then
                        candidate = origin
                            + finalDelta.Unit * localRadius
                    end
                end

                -- Hard guard, applied after the court clamp: whatever the
                -- other terms say, never advise heading back upcourt.
                local gain = Vector3.new(
                    candidate.X - origin.X, 0, candidate.Z - origin.Z
                ):Dot(read.ToHoop)
                if gain >= -math.abs(cfg.offenseMaxRetreat) then
                    local score = offenseScore(
                        candidate, origin, read, opponents, teammates, hoop,
                        holdingBall, handlerRoot
                    )
                    if learned then
                        local candidateDelta = Vector3.new(
                            candidate.X - origin.X, 0,
                            candidate.Z - origin.Z
                        )
                        if candidateDelta.Magnitude > 0.01 then
                            -- Learned preference is dominant, while the base
                            -- solver remains a safety envelope around it.
                            local alignment = candidateDelta.Unit:Dot(
                                learned.Direction
                            )
                            score = score + alignment
                                * cfg.offenseLearnWeight
                                * learned.Confidence
                        end
                    end
                    if score > bestScore then
                        best, bestScore = candidate, score
                    end
                end
            end
        end

        if not best then return nil, nil, nil end

        -- Holding the ball inside a defender's reach is the one situation
        -- worth naming outright, because the answer is "move, now".
        local kind = holdingBall and "DRIVE" or "GET OPEN"
        if cfg.offenseTraining
            and st.offenseLearnCount < cfg.offenseLearnMinSamples then
            kind = string.format(
                "LEARNING %d/%d",
                st.offenseLearnCount, cfg.offenseLearnMinSamples
            )
        elseif learned then
            kind = "YOUR NEXT MOVE"
        end
        if holdingBall and cfg.offenseProtect
            and defenderGap <= math.max(cfg.offenseStealRadius, 0) then
            kind = "PROTECT"
        end
        return best, kind, read.Text
    end

    -- Runs independently of the autoguard solver: offence prediction never
    -- needs the guard switched on, and never touches movement.
    local function offenseUpdate()
        if not cfg.offenseGhost and not cfg.offenseAuto
            and not cfg.offenseTraining then
            st.offenseSpot, st.offenseKind, st.offenseRead = nil, nil, nil
            return false
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not humanoid or not root or humanoid.Health <= 0 then
            st.offenseSpot, st.offenseKind, st.offenseRead = nil, nil, nil
            return false
        end

        local holdingBall = crossGameHoldingBall(LocalPlayer, character)
        local handler = ballHandlerPlayer()
        -- Only advise while your side actually has the ball when the game tells
        -- us who owns it. Non-Hoopz games sometimes hide that state completely;
        -- fail open as an off-ball read instead of disabling the feature.
        local onOffense = holdingBall
            or (handler ~= nil
                and (handler == LocalPlayer or offenseTeammate(handler)))
        if getGame() ~= "Hoopz" and not onOffense then
            -- These games can hide or briefly misreport possession. The user
            -- explicitly enabled an offence-only visual, so fail open and use
            -- the nearest-defender off-ball read rather than showing nothing.
            onOffense = true
            handler = nil
        end
        if not onOffense then
            st.offenseSpot, st.offenseKind, st.offenseRead = nil, nil, nil
            return false
        end

        local handlerCharacter = handler and handler.Character
        local handlerRoot = handlerCharacter
            and handlerCharacter:FindFirstChild("HumanoidRootPart")

        local now = os.clock()
        if now >= (st.nextOffenseScan or 0) then
            st.nextOffenseScan = now + math.max(cfg.offenseRefresh, 0.03)
            local spot, kind, readText =
                offenseSolve(root, holdingBall, handlerRoot)
            st.offenseSpot, st.offenseKind = spot, kind
            st.offenseRead = readText
        end

        if not st.offenseSpot then return false end

        st.suggestedPosition = st.offenseSpot
        st.suggestedAt = now
        st.suggestKind = "offense"
        return true
    end

    local function offenseAutoStop(humanoid)
        local wasMoving = st.offenseAutoMoving
        if wasMoving and humanoid and humanoid.Parent then
            humanoid:Move(Vector3.new(0, 0, 0), false)
        end
        st.offenseAutoMoving = false
        st.offenseAutoDirection = nil
        if wasMoving then st.moving = false end
    end

    -- Follow the exact spot published to the ghost. This runs after Roblox's
    -- ControlModule and after the defensive solver, so the final Move call wins
    -- only while Auto Ghost has a valid offense target.
    local function offenseAutoStep(dt)
        local character = LocalPlayer.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not cfg.offenseAuto or not humanoid or not root
            or humanoid.Health <= 0 or not st.offenseSpot then
            offenseAutoStop(humanoid)
            return false
        end

        -- Yield instantly to keyboard or thumbstick input without writing zero
        -- movement over the direction ControlModule issued earlier this frame.
        if cfg.offenseAutoManualOverride and manualMovementActive() then
            st.offenseAutoMoving = false
            st.offenseAutoDirection = nil
            st.moving = false
            return false
        end

        local delta = Vector3.new(
            st.offenseSpot.X - root.Position.X, 0,
            st.offenseSpot.Z - root.Position.Z
        )
        local distance = delta.Magnitude
        if distance <= math.max(cfg.offenseAutoStopDistance, 0.1)
            or distance <= 0.01 then
            offenseAutoStop(humanoid)
            return true
        end

        local desired = delta.Unit
        local previous = st.offenseAutoDirection or desired
        local alpha = 1 - math.exp(
            -math.max(cfg.offenseAutoResponsiveness, 1)
                * math.clamp(tonumber(dt) or 1 / 60, 0, 0.1)
        )
        local direction = previous:Lerp(desired, math.clamp(alpha, 0, 1))
        if direction.Magnitude <= 0.01 then direction = desired end
        direction = direction.Unit

        humanoid:Move(direction, false)
        st.offenseAutoDirection = direction
        st.offenseAutoMoving = true
        st.moving = true
        return true
    end

    --== guard ghost =========================================================
    -- Renders a translucent copy of the player's own rig at the position the
    -- defensive solve wants them to occupy, posed bone-for-bone from the live
    -- character. It reads as "you, standing where you should be" rather than
    -- as an abstract marker, and it never touches the controls.

    local ghost = {
        Model = nil, Parts = {}, Decals = {}, Source = nil, SourceCount = 0,
        Line = nil, Label = nil, LabelText = nil, Highlight = nil,
        Humanoid = nil, Alpha = 0, CFrame = nil,
    }

    local function ghostDestroy()
        if ghost.Model then pcall(function() ghost.Model:Destroy() end) end
        if ghost.Line then pcall(function() ghost.Line:Destroy() end) end
        ghost.Model, ghost.Source, ghost.CFrame, ghost.Line = nil, nil, nil, nil
        ghost.Label, ghost.LabelText, ghost.Highlight = nil, nil, nil
        ghost.Humanoid = nil
        ghost.Parts, ghost.Decals = {}, {}
        ghost.SourceCount, ghost.Alpha = 0, 0
    end

    -- Roblox's supported avatar-copy path. A HumanoidDescription carries body
    -- scaling, classic/layered clothes, rigid accessories, face and body colors
    -- without carrying game-owned descendants such as basketballs, hitboxes,
    -- effects or welded helper geometry.
    local avatarTemplate = {
        Character = nil, Model = nil, Pending = false,
    }

    local function requestAvatarTemplate(character)
        if avatarTemplate.Character ~= character then
            if avatarTemplate.Model then
                pcall(function() avatarTemplate.Model:Destroy() end)
            end
            avatarTemplate.Character = character
            avatarTemplate.Model = nil
            avatarTemplate.Pending = false
        end
        if avatarTemplate.Model then return avatarTemplate.Model end
        if avatarTemplate.Pending then return nil end

        avatarTemplate.Pending = true
        task.spawn(function()
            local humanoid = character
                and character:FindFirstChildOfClass("Humanoid")
            local description = nil
            if humanoid then
                local ok, value = pcall(function()
                    return humanoid:GetAppliedDescription()
                end)
                if ok and value then description = value end
            end
            -- Fallback still uses Roblox avatar data, never the contaminated
            -- in-game character hierarchy.
            if not description then
                local ok, value = pcall(function()
                    return PlayersService:GetHumanoidDescriptionFromUserIdAsync(
                        LocalPlayer.UserId
                    )
                end)
                if ok and value then description = value end
            end

            local model = nil
            if description and humanoid then
                local ok, value = pcall(function()
                    return PlayersService:CreateHumanoidModelFromDescriptionAsync(
                        description, humanoid.RigType,
                        Enum.AssetTypeVerification.Default
                    )
                end)
                -- Older clients expose the same API before the optional asset
                -- verification argument was added.
                if not ok then
                    ok, value = pcall(function()
                        return PlayersService:
                            CreateHumanoidModelFromDescriptionAsync(
                                description, humanoid.RigType
                            )
                    end)
                end
                if ok and value then model = value end
            end
            if description then pcall(function() description:Destroy() end) end

            if avatarTemplate.Character ~= character then
                if model then pcall(function() model:Destroy() end) end
                return
            end
            avatarTemplate.Pending = false
            if model then
                model.Archivable = true
                model.Parent = nil
                avatarTemplate.Model = model
            end
        end)
        return nil
    end

    local function avatarPartKey(part)
        local accessory = part:FindFirstAncestorOfClass("Accessory")
        if accessory then
            return "Accessory/" .. accessory.Name .. "/" .. part.Name
        end
        return "Body/" .. part.Name
    end

    local function liveAvatarParts(character)
        local keyed, counts = {}, {}
        for _, descendant in ipairs(character:GetDescendants()) do
            if descendant:IsA("BasePart") then
                local accessory = descendant:FindFirstAncestorOfClass("Accessory")
                -- Standard body parts are direct Model children; appearance
                -- parts under an Accessory are also valid. Everything else is
                -- game-owned attachment geometry and is intentionally ignored.
                if accessory or descendant.Parent == character then
                    local key = avatarPartKey(descendant)
                    counts[key] = (counts[key] or 0) + 1
                    keyed[key .. "#" .. counts[key]] = descendant
                end
            end
        end
        return keyed
    end

    local function ghostNeutralizePart(part)
        if not part or not part:IsA("BasePart") then return end
        -- Disable every physics/contact surface on the visual puppet. Keep this
        -- separate from avatar pairing so unmatched layered-clothing and
        -- accessory parts can never collide with the player or the court.
        pcall(function()
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Massless = true
            part.CastShadow = false
        end)
    end

    local function ghostBuild(character)
        ghostDestroy()

        local template = requestAvatarTemplate(character)
        if not template then return false end
        local ok, clone = pcall(function() return template:Clone() end)
        if not ok or not clone then return false end

        -- Keep the complete visual avatar. In particular, Roblox needs the
        -- Humanoid to resolve Shirt/Pants/BodyColors and layered clothing
        -- cages. Only remove objects that can execute, interact, make sound,
        -- or add unrelated UI. Accessories, meshes, textures, faces, clothing,
        -- SurfaceAppearance, WrapLayer/WrapTarget and joints all stay intact.
        for _, descendant in ipairs(clone:GetDescendants()) do
            if descendant:IsA("BasePart") then
                ghostNeutralizePart(descendant)
            end
            if descendant:IsA("BaseScript") or descendant:IsA("Sound")
                or descendant:IsA("Tool") or descendant:IsA("ProximityPrompt")
                or descendant:IsA("ClickDetector")
                or descendant:IsA("BillboardGui")
                or descendant:IsA("Highlight") or descendant:IsA("ForceField")
                or descendant:IsA("Explosion") then
                pcall(function() descendant:Destroy() end)
            end
        end

        -- Neuter the retained Humanoid instead of deleting it. This preserves
        -- avatar assembly while making the clone a completely inert puppet.
        local ghostHumanoid = clone:FindFirstChildOfClass("Humanoid")
        if ghostHumanoid then
            pcall(function()
                ghostHumanoid.DisplayDistanceType =
                    Enum.HumanoidDisplayDistanceType.None
                ghostHumanoid.HealthDisplayType =
                    Enum.HumanoidHealthDisplayType.AlwaysOff
                ghostHumanoid.NameDisplayDistance = 0
                ghostHumanoid.HealthDisplayDistance = 0
                ghostHumanoid.BreakJointsOnDeath = false
                ghostHumanoid.RequiresNeck = false
                ghostHumanoid.PlatformStand = true
                ghostHumanoid.AutoRotate = false
                ghostHumanoid.WalkSpeed = 0
                ghostHumanoid.JumpPower = 0
            end)
            pcall(function() ghostHumanoid.EvaluateStateMachine = false end)
            for _, stateType in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
                pcall(function()
                    ghostHumanoid:SetStateEnabled(stateType, false)
                end)
            end
            pcall(function()
                ghostHumanoid:ChangeState(Enum.HumanoidStateType.Physics)
            end)
            local animator = ghostHumanoid:FindFirstChildOfClass("Animator")
            if animator then pcall(function() animator:Destroy() end) end
        end

        -- Pair by body/accessory identity rather than descendant index. The
        -- live game may insert a Ball, hitbox or helper part anywhere in its
        -- hierarchy; none of those can offset the avatar pose mapping now.
        local realParts = liveAvatarParts(character)
        local cloneCounts, paired = {}, {}
        for _, descendant in ipairs(clone:GetDescendants()) do
            if descendant:IsA("BasePart") then
                local key = avatarPartKey(descendant)
                cloneCounts[key] = (cloneCounts[key] or 0) + 1
                local realPart = realParts[
                    key .. "#" .. cloneCounts[key]
                ]
                if realPart then
                    ghostNeutralizePart(descendant)
                    descendant.LocalTransparencyModifier = 0
                    table.insert(paired, {
                        Ghost = descendant,
                        Real = realPart,
                        BaseColor = descendant.Color,
                        BaseTransparency = descendant.Transparency,
                    })
                end
            end
        end
        if #paired == 0 then
            pcall(function() clone:Destroy() end)
            return false
        end

        -- Preserve original decal and texture alpha independently from body
        -- transparency. This includes the face and clothing-surface graphics.
        local decals = {}
        for _, descendant in ipairs(clone:GetDescendants()) do
            if descendant:IsA("Decal") or descendant:IsA("Texture") then
                table.insert(decals, {
                    Object = descendant,
                    BaseTransparency = descendant.Transparency,
                })
            end
        end

        clone.Name = "AureateGuardGhost"
        -- Layered clothing may materialize additional wrap parts after the
        -- model is parented. Neutralize those immediately as well.
        clone.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("BasePart") then
                ghostNeutralizePart(descendant)
            end
        end)
        clone.Parent = workspace

        local highlight = Instance.new("Highlight")
        highlight.Name = "GhostGlow"
        highlight.Adornee = clone
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.55
        highlight.OutlineTransparency = 0
        highlight.Parent = clone

        local line = Instance.new("Part")
        line.Name = "AureateGuardGhostPath"
        line.Anchored, line.CanCollide, line.CanQuery = true, false, false
        line.CanTouch, line.CastShadow = false, false
        line.Material = Enum.Material.Neon
        line.Size = Vector3.new(0.1, 0.1, 1)
        line.Parent = workspace

        -- Accessory handles can appear first in traversal order; anchor the
        -- label to the actual rig instead so it always sits above the avatar.
        local anchor = clone:FindFirstChild("HumanoidRootPart")
            or clone:FindFirstChild("Head") or paired[1].Ghost
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "GhostLabel"
        billboard.Size = UDim2.fromOffset(210, 34)
        billboard.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
        billboard.AlwaysOnTop = true
        billboard.Adornee = anchor
        billboard.Parent = anchor

        local text = Instance.new("TextLabel")
        text.BackgroundTransparency = 1
        text.Size = UDim2.fromScale(1, 1)
        text.Font = Enum.Font.Gotham
        text.TextSize = 13
        text.TextStrokeTransparency = 0.5
        text.Text = ""
        text.Parent = billboard

        ghost.Model, ghost.Parts, ghost.Decals = clone, paired, decals
        ghost.Source, ghost.SourceCount = character, #paired
        ghost.Humanoid = ghostHumanoid
        ghost.Highlight, ghost.Line = highlight, line
        ghost.Label, ghost.LabelText = billboard, text
        ghost.Alpha, ghost.CFrame = 0, nil
        return true
    end

    local function ghostApplyAlpha(color)
        local base = math.clamp(cfg.ghostTransparency, 0, 0.98)
        for _, pair in ipairs(ghost.Parts) do
            if pair.Ghost.Parent then
                -- Never repaint the avatar. Blend from each object's own alpha
                -- toward invisible, preserving transparent hair, glasses,
                -- layered clothing and every original texture/color.
                pair.Ghost.Color = pair.BaseColor
                local settled = pair.BaseTransparency
                    + (1 - pair.BaseTransparency) * base
                pair.Ghost.Transparency = 1 - (1 - settled) * ghost.Alpha
            end
        end
        for _, entry in ipairs(ghost.Decals) do
            if entry.Object.Parent then
                local settled = entry.BaseTransparency
                    + (1 - entry.BaseTransparency) * base
                entry.Object.Transparency =
                    1 - (1 - settled) * ghost.Alpha
            end
        end
        if ghost.Highlight then
            ghost.Highlight.Enabled = ghost.Alpha > 0.02
            ghost.Highlight.FillTransparency = 1 - 0.45 * ghost.Alpha
            ghost.Highlight.OutlineTransparency = 1 - ghost.Alpha
            if color then
                ghost.Highlight.FillColor = color
                ghost.Highlight.OutlineColor = color
            end
        end
    end

    local function ghostFade(dt)
        if not ghost.Model then return end
        ghost.Alpha = ghost.Alpha - (tonumber(dt) or 0) * 5
        if ghost.Alpha <= 0 then
            ghostDestroy()
            return
        end
        ghostApplyAlpha(nil)
        if ghost.Line then ghost.Line.Transparency = 1 end
        if ghost.LabelText then ghost.LabelText.TextTransparency = 1 end
    end

    local function ghostUpdate(dt)
        if not cfg.ghost and not cfg.offenseGhost and not cfg.offenseAuto then
            if ghost.Model then ghostDestroy() end
            return
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local suggestion = st.suggestedPosition
        -- A stale solve is worse than none: it would park the ghost at a spot
        -- the guard has already abandoned.
        local fresh = suggestion ~= nil
            and (os.clock() - (st.suggestedAt or 0)) < 0.30

        if not fresh or not root or not humanoid or humanoid.Health <= 0 then
            ghostFade(dt)
            return
        end

        local flat = Vector3.new(
            suggestion.X - root.Position.X, 0, suggestion.Z - root.Position.Z
        )
        local distance = flat.Magnitude
        -- Already standing in the right place, so there is nothing to suggest.
        if distance < math.max(cfg.ghostDeadzone, 0) then
            ghostFade(dt)
            return
        end

        if ghost.Source ~= character or not ghost.Model or not ghost.Model.Parent then
            -- The clean-avatar API yields, so its template is prepared on a
            -- spawned task. Until it is ready, simply skip this frame rather
            -- than stalling RenderStep or showing a contaminated fallback.
            if not ghostBuild(character) then return end
        end

        local goal = CFrame.new(
            Vector3.new(suggestion.X, root.Position.Y, suggestion.Z)
        ) * root.CFrame.Rotation
        if not ghost.CFrame then ghost.CFrame = goal end
        local smoothing = 1 - math.exp(
            -math.max(cfg.ghostSmoothness, 1) * math.clamp(tonumber(dt) or 1 / 60, 0, 0.1)
        )
        ghost.CFrame = ghost.CFrame:Lerp(goal, smoothing)

        -- Mirror the live pose exactly by re-applying each part's transform
        -- relative to the real root, around the suggested root instead.
        local inverse = root.CFrame:Inverse()
        for _, pair in ipairs(ghost.Parts) do
            if pair.Ghost.Parent and pair.Real.Parent then
                pair.Ghost.CFrame = ghost.CFrame * (inverse * pair.Real.CFrame)
            end
        end

        ghost.Alpha = math.min(ghost.Alpha + (tonumber(dt) or 0) * 5, 1)

        -- Offence reads cool, defence reads gold. Distance shading only makes
        -- sense on defence, where being far away means being out of position;
        -- on offence a distant spot is the whole point of the suggestion.
        local offense = st.suggestKind == "offense"
        local color = offense
            and Color3.fromRGB(120, 196, 224)
            or Color3.fromRGB(214, 178, 92)
        if offense and st.offenseKind == "PROTECT" then
            -- The ball is inside the defender's reach right now.
            color = Color3.fromRGB(211, 102, 102)
        end
        if cfg.ghostFeedback and not offense then
            if distance > 14 then
                color = Color3.fromRGB(211, 102, 102)
            elseif distance < math.max(cfg.ghostDeadzone, 0) * 2 then
                color = Color3.fromRGB(126, 196, 143)
            end
        end
        ghostApplyAlpha(color)

        if ghost.Line then
            if cfg.ghostPath then
                local from = root.Position
                local to = ghost.CFrame.Position
                local span = (to - from).Magnitude
                if span > 0.2 then
                    ghost.Line.Size = Vector3.new(0.1, 0.1, span)
                    ghost.Line.CFrame = CFrame.lookAt(from:Lerp(to, 0.5), to)
                    ghost.Line.Color = color
                    ghost.Line.Transparency = 1 - 0.55 * ghost.Alpha
                else
                    ghost.Line.Transparency = 1
                end
            else
                ghost.Line.Transparency = 1
            end
        end

        if ghost.LabelText then
            if cfg.ghostLabel then
                if offense then
                    -- Two lines: what to do, then how far and why.
                    ghost.LabelText.Text = string.format(
                        "%s\n%.1f studs  %s",
                        st.offenseKind or "MOVE",
                        distance,
                        st.offenseRead or "READING"
                    )
                else
                    ghost.LabelText.Text =
                        string.format("%.1f studs", distance)
                end
                ghost.LabelText.TextColor3 = color
                ghost.LabelText.TextTransparency = 1 - ghost.Alpha
            else
                ghost.LabelText.TextTransparency = 1
            end
        end
    end

    -- ControlModule writes Humanoid:Move during its render step. Heartbeat ran
    -- at the wrong point in the frame, allowing normal controls to replace the
    -- guard direction before physics used it. Run just after input instead.
    local bindName = "AureateAutoguard_" .. tostring(LocalPlayer.UserId)
    pcall(function() RunServiceLocal:UnbindFromRenderStep(bindName) end)
    RunServiceLocal:BindToRenderStep(
        bindName,
        Enum.RenderPriority.Input.Value + 1,
        function(dt)
            -- Advisory mode: solve, but apply nothing. Rather than threading a
            -- suppression flag through every movement site in the solver, the
            -- character's movement state is snapshotted and restored around the
            -- call. Nothing physical happens between the two, so the pass is
            -- observationally a no-op no matter which branch it took.
            st.suggestOnly = (not cfg.enabled) and cfg.ghost and cfg.ghostAdvisory

            if st.suggestOnly then
                local character = LocalPlayer.Character
                local humanoid = character
                    and character:FindFirstChildOfClass("Humanoid")
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local savedMove = humanoid and humanoid.MoveDirection
                local savedRotate = humanoid and humanoid.AutoRotate
                local savedCFrame = root and root.CFrame

                pcall(step, dt)

                if humanoid and humanoid.Parent then
                    humanoid.AutoRotate = savedRotate
                    -- Re-assert the direction the control script wrote earlier
                    -- this frame, undoing any Move the solver issued.
                    humanoid:Move(savedMove or Vector3.new(0, 0, 0), false)
                end
                if root and root.Parent and savedCFrame then
                    root.CFrame = savedCFrame
                end
                st.suggestOnly = false
            else
                pcall(step, dt)
            end

            -- Offence prediction wins the ghost when your side has the ball;
            -- otherwise whatever the defensive solve published stands.
            local claimed = false
            local okOffense, result = pcall(offenseUpdate)
            if okOffense then claimed = result == true end
            if not claimed then st.suggestKind = "defense" end

            -- A miss also runs the release path so movement from the previous
            -- target can never remain latched.
            pcall(offenseAutoStep, dt)
            pcall(ghostUpdate, dt)
        end
    )

    local connection = {}
    function connection:Destroy()
        pcall(function() RunServiceLocal:UnbindFromRenderStep(bindName) end)
        local character = LocalPlayer.Character
        pcall(offenseAutoStop,
            character and character:FindFirstChildOfClass("Humanoid"))
        pcall(ghostDestroy)
    end

