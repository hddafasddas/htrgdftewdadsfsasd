local IsGuardOpponent
IsGuardOpponent = WYNF_JIT_MAX(function(Player)
if not Player or Player == LP then return false end

local Now = os.clock()
local Cached = PerfCache.GuardOpponent[Player]
if Cached and Now - Cached.At < 0.2 then return Cached.Value end

local Result
local MyCourt, MySlotName, MySlot = ResolvePlayerCourt(LP)
local TheirCourt, TheirSlotName, TheirSlot = ResolvePlayerCourt(Player)
if MyCourt then
if not TheirCourt or MyCourt ~= TheirCourt then
Result = false
end
local MySide = ResolvePlayerCourtTeam(LP, MyCourt, MySlotName, MySlot)
local TheirSide = ResolvePlayerCourtTeam(Player, TheirCourt, TheirSlotName, TheirSlot)
if Result == nil and MySide and TheirSide then Result = MySide ~= TheirSide end
end

if Result == nil then
if not LP.Neutral and not Player.Neutral and LP.Team and Player.Team then
Result = LP.Team ~= Player.Team
else
Result = true
end
end
PerfCache.GuardOpponent[Player] = { At = Now, Value = Result }
return Result
end)

