function State.AutoGetOpen.DistanceToSegmentXZ(Point, A, B)
local P = Vector2.new(Point.X, Point.Z)
local P0 = Vector2.new(A.X, A.Z)
local P1 = Vector2.new(B.X, B.Z)
local Segment = P1 - P0
local LengthSquared = Segment:Dot(Segment)
if LengthSquared <= 0.0001 then return (P - P0).Magnitude end
local Alpha = math.clamp((P - P0):Dot(Segment) / LengthSquared, 0, 1)
return (P - (P0 + Segment * Alpha)).Magnitude
end

function State.AutoGetOpen.GetPredictedPlayerPosition(Player, TargetPosition)
local Root, PlayerHumanoid = GetPlayerRoot(Player)
if not Root or not PlayerHumanoid then return nil end
local Velocity = Vector3.new(
Root.AssemblyLinearVelocity.X, 0, Root.AssemblyLinearVelocity.Z)
local MoveDirection = Vector3.new(
PlayerHumanoid.MoveDirection.X, 0, PlayerHumanoid.MoveDirection.Z)
local WalkSpeed = math.max(0, PlayerHumanoid.WalkSpeed)
local Distance = TargetPosition and (TargetPosition - Root.Position).Magnitude
or (Root.Position - LP.Character.HumanoidRootPart.Position).Magnitude
local LookAhead = math.clamp(
Distance / math.max(WalkSpeed + Velocity.Magnitude, 1),
CONFIG.AutoGetOpenOpponentMinLookAhead,
CONFIG.AutoGetOpenOpponentMaxLookAhead
)
local IntentVelocity = MoveDirection.Magnitude > 0.01
and MoveDirection.Unit * WalkSpeed or Vector3.zero
local Facing = Vector3.new(Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z)
local FacingVelocity = Facing.Magnitude > 0.01 and Facing.Unit * WalkSpeed * 0.12
or Vector3.zero
local PredictedVelocity = Velocity * 0.62 + IntentVelocity * 0.38 + FacingVelocity
local StateType = PlayerHumanoid:GetState()
if StateType == Enum.HumanoidStateType.Jumping
or StateType == Enum.HumanoidStateType.Freefall then
PredictedVelocity = Velocity
end
return Root.Position + PredictedVelocity * LookAhead
end

