if not (Frame and Size and typeof(Position) == 'Vector3') then return false end
local Local = Frame:PointToObjectSpace(Position)
Margin = tonumber(Margin) or 0
return math.abs(Local.X) <= Size.X * 0.5 + Margin
and math.abs(Local.Z) <= Size.Z * 0.5 + Margin
and math.abs(Local.Y) <= math.max(30, Size.Y * 0.5 + Margin)
end

