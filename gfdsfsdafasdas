        lib:_tween(box, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceRaised })
    end))
    self.Janitor:Add(hit.MouseLeave:Connect(function()
        lib:_tween(box, MOTION.Fast, { BackgroundColor3 = lib.Theme.SurfaceAlt })
    end))
