-- Shared drag helper: reports normalised (x, y) inside a frame while held.
local function bindDrag(janitor, hit, target, onMove)
    local dragging = false
    local function report(position)
        local origin, size = target.AbsolutePosition, target.AbsoluteSize
        onMove(
            clamp((position.X - origin.X) / math.max(size.X, 1), 0, 1),
            clamp((position.Y - origin.Y) / math.max(size.Y, 1), 0, 1)
        )
    end
    janitor:Add(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            report(input.Position)
        end
    end))
    janitor:Add(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            report(input.Position)
        end
    end))
    janitor:Add(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

-- Shared popup helper: floats a panel in the overlay under an anchor widget
-- and closes it when anything else is clicked.
local function makePopup(section, anchor, width, height)
    local lib = section.Library

    local blocker = create("TextButton", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, Visible = false, ZIndex = 500, Parent = lib.Overlay,
    })

    local panel = create("Frame", {
        Size = UDim2.fromOffset(width, 0), BackgroundColor3 = lib.Theme.SurfaceRaised,
        BorderSizePixel = 0, ClipsDescendants = true, Visible = false,
        ZIndex = 501, Parent = lib.Overlay,
    }, { corner(3), stroke(lib.Theme.Border) })
    lib:_bind(panel, "BackgroundColor3", "SurfaceRaised")

    local open = false
    local function place()
        local origin = lib.Overlay.AbsolutePosition
        local pos, size = anchor.AbsolutePosition, anchor.AbsoluteSize
        local x = math.max(origin.X + 6, pos.X + size.X - width)
        local y = pos.Y + size.Y + 4
        if y + height > origin.Y + lib.Overlay.AbsoluteSize.Y - 6 then
            y = pos.Y - height - 4
        end
        panel.Position = UDim2.fromOffset(x - origin.X, y - origin.Y)
    end

    local popup = {}
    function popup:IsOpen() return open end
    function popup:SetOpen(state)
        if state and lib.OpenDropdown then
            local other = lib.OpenDropdown
            lib.OpenDropdown = nil
            other(false)
        end
        open = state
        lib.OpenDropdown = state and function(v) popup:SetOpen(v) end or nil
        blocker.Visible = state
        if state then
            panel.Visible = true
            place()
            panel.Size = UDim2.fromOffset(width, 0)
            lib:_tween(panel, MOTION.Normal, { Size = UDim2.fromOffset(width, height) })
        else
            lib:_tween(panel, MOTION.Fast, { Size = UDim2.fromOffset(width, 0) })
            task.delay(0.2, function() if not open then panel.Visible = false end end)
        end
    end
    function popup:Toggle() self:SetOpen(not open) end

    section.Janitor:Add(blocker.MouseButton1Click:Connect(function() popup:SetOpen(false) end))
    section.Janitor:Add(RunService.RenderStepped:Connect(function()
        if open then place() end
    end))

    popup.Panel = panel
    return popup
end

-- Colour picker: saturation/value field, hue strip, live hex entry.
function Section:AddColorPicker(id, options)
