State.BallAssist.AntiReachLostAt = Now
State.BallAssist.AntiReachCounterUntil = Now + Window
State.BallAssist.AntiReachCounterAttempts = 0
State.BallAssist.AntiReachCounters =
(State.BallAssist.AntiReachCounters or 0) + 1
end

function State.BallAssist.WatchAntiReachLoss(Character)
