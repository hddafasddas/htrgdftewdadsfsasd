function State.Movement.IsInMatch()
local Now = os.clock()
if Now - State.Movement.MatchCheckAt < 0.5 then return State.Movement.MatchCached end
State.Movement.MatchCheckAt = Now

local InMatch = safe_get_attribute(LP, 'Ingame') == true
or safe_get_attribute(LP, 'InGame') == true
or safe_get_attribute(LP, 'InMatch') == true

if not InMatch and safe_find(Workspace, 'Court') then InMatch = true end

if not InMatch then
local Character = LP.Character
local Basketball = Character and safe_find(Character, 'Basketball')
local GameFolder = Basketball and safe_find(Basketball, '[GAME]')
local CurrentGame = GameFolder and safe_find(GameFolder, 'CurrentGame')
if CurrentGame and safe_is_a(CurrentGame, 'ObjectValue') and CurrentGame.Value then InMatch = true end
end

if not InMatch then
local Courts = safe_find(Workspace, 'Courts')
if Courts then
for _, Court in ipairs(Courts:GetChildren()) do
local CourtPlayers = safe_find(Court, '_CourtPlayers')
local Settings = safe_find(Court, '_CourtSettings')
local Started = Settings and safe_find(Settings, 'Started')
local IsStarted = Started and ((safe_is_a(Started, 'BoolValue') and Started.Value == true)
or safe_get_attribute(Started, 'Value') == true)
if CourtPlayers and IsStarted then
for _, Slot in ipairs(CourtPlayers:GetChildren()) do
if safe_is_a(Slot, 'ObjectValue') and Slot.Value == LP then
InMatch = true
break
end
end
end
if InMatch then break end
end
end
end

State.Movement.MatchCached = InMatch
return InMatch
end

function State.Movement.ApplyWalkSpeed(DeltaTime)
if not State.Movement.WalkSpeedEnabled then return end
local _, HumanoidObject, Root = State.Movement.GetRig()
if not (HumanoidObject and Root) or HumanoidObject.Health <= 0 then return end

local Value = State.Movement.WalkSpeedValue
if CONFIG.SpeedProfiles and not State.Movement.IsInMatch() then Value = CONFIG.OutOfMatchSpeed end
Value = math.clamp(tonumber(Value) or 32, 1, 250)

local Direction = HumanoidObject.MoveDirection
local Horizontal = Vector3.new(Direction.X, 0, Direction.Z)
if Horizontal.Magnitude <= 0.001 then return end

local Method = State.Movement.SpeedMethod or 'CFrame Step'

if Method == 'WalkSpeed Property' then
-- Simplest approach: set the Humanoid WalkSpeed directly. Works on
-- every executor and requires no per-frame repositioning.
if HumanoidObject.WalkSpeed ~= Value then
pcall(function() HumanoidObject.WalkSpeed = Value end)
end
return
end

if Method == 'Humanoid MoveTo' then
-- Uses the Humanoid MoveTo API to steer the character toward a point
-- offset ahead in the current movement direction.
local Target = Root.Position + Horizontal.Unit * (Value * 0.016)
pcall(function() HumanoidObject:MoveTo(Target) end)
return
end

if Method == 'Assembly Velocity' then
-- Directly assign horizontal velocity while preserving gravity / Y.
local CurrentVelocity = Root.AssemblyLinearVelocity
Root.AssemblyLinearVelocity = Vector3.new(
Horizontal.Unit.X * Value,
CurrentVelocity.Y,
Horizontal.Unit.Z * Value)
return
end

-- Default: CFrame Step — reposition the root each frame.
local StepTime = math.clamp(tonumber(DeltaTime) or (1 / 60), 0, 0.10)
Root.CFrame = Root.CFrame + Horizontal.Unit * (Value * StepTime)
end

function State.Movement.SetWalkSpeed(Enabled)
State.Movement.WalkSpeedEnabled = Enabled == true
CONFIG.WalkSpeed = State.Movement.WalkSpeedEnabled
end

function State.Movement.SetWalkSpeedValue(Value)
Value = math.clamp(tonumber(Value) or 32, 1, 250)
State.Movement.WalkSpeedValue = Value
CONFIG.WalkSpeedValue = Value
State.Movement.ApplyWalkSpeed()
end

