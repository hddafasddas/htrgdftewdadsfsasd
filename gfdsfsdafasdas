local GetLegitTweenTarget
GetLegitTweenTarget = WYNF_JIT_MAX(function()
if not HumanoidRootPart then return nil end
local Rim, Distance = FindConfiguredGoal()

-- FindConfiguredGoal intentionally rejects scoring goals beyond the normal
-- shot table's range. Legit camera movement should still happen on every
-- attempt, so resolve the same goal again without that range gate.
if not Rim then
if CONFIG.AimTargetMode == 'Nearest Goal' then
Rim, Distance = FindNearestGoalUnscoped()
else
Rim = FindPlayerScoringGoal(LP)
if Rim then
Distance = GetHorizontalDistance(HumanoidRootPart.Position, Rim.Position)
else
Rim, Distance = FindNearestGoalUnscoped()
end
end
end
if not Rim then return nil end

local Power = State.PowerBypass.GetEffectivePower()
-- Calibrated shot-table coverage must not decide whether the camera flicks.
local FormulaTarget = GetFormulaTarget(Rim, Power)
if FormulaTarget then return FormulaTarget end

-- If the selected power cannot physically reach a distant rim, retry at the
-- maximum legal power. This still uses the exact ballistic formula.
local MaximumPower = tonumber(CONFIG.FormulaArcMaxPower) or 85
if Power ~= MaximumPower then
FormulaTarget = GetFormulaTarget(Rim, MaximumPower)
if FormulaTarget then return FormulaTarget end
end

-- Truly unreachable geometry has no exact root. Keep the camera behavior
-- consistent by scanning the same trajectory equation and selecting the
-- angle whose formula height comes closest to the rim. The shot may remain
-- out of range, but the visible formula-driven flick always occurs.
local Character = LP.Character
local Head = Character and safe_find(Character, 'Head')
if not Head then return nil end
local Delta = Rim.Position - Head.Position
local Flat = Vector3.new(Delta.X, 0, Delta.Z)
if Flat.Magnitude <= 0.0001 then return nil end
local BestAngle, BestError = math.rad(45), math.huge
for Index = 0, 72 do
local Angle = math.rad(2 + 76 * (Index / 72))
local Height = EvaluateFormulaHeight(
Angle, Flat.Magnitude, MaximumPower, Workspace.Gravity)
local Error = math.abs(Height - Delta.Y)
if Error < BestError then
BestAngle, BestError = Angle, Error
end
end
local Direction = Flat.Unit * math.cos(BestAngle)
+ Vector3.new(0, math.sin(BestAngle), 0)
return Head.Position + Direction * 1000
end)

local function IsManualCameraAimActive()
