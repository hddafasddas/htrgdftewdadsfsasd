function State.AutoGetOpen.ClampAutoGetOpenToCourt(Court, Position, Y)
local Floor = State.AutoGetOpen.GetAutoGetOpenFloor(Court)
if not Floor then return Vector3.new(Position.X, Y, Position.Z) end
local LocalPoint = Floor.CFrame:PointToObjectSpace(Position)
local HalfX = math.max(2, Floor.Size.X * 0.5 - 5.5)
local HalfZ = math.max(2, Floor.Size.Z * 0.5 - 5.5)
LocalPoint = Vector3.new(
math.clamp(LocalPoint.X, -HalfX, HalfX),
0,
math.clamp(LocalPoint.Z, -HalfZ, HalfZ)
)
local WorldPoint = Floor.CFrame:PointToWorldSpace(LocalPoint)
return Vector3.new(WorldPoint.X, Y, WorldPoint.Z)
end

function State.AutoGetOpen.GetAutoGetOpenBounds(Court, Position, Y)
local Floor = State.AutoGetOpen.GetAutoGetOpenFloor(Court)
if not Floor then return true, Vector3.new(Position.X, Y, Position.Z), 20 end
local LocalPoint = Floor.CFrame:PointToObjectSpace(Position)
local HardHalfX = math.max(2, Floor.Size.X * 0.5 - 1.25)
local HardHalfZ = math.max(2, Floor.Size.Z * 0.5 - 1.25)
local SafeHalfX = math.max(2, Floor.Size.X * 0.5 - 6)
local SafeHalfZ = math.max(2, Floor.Size.Z * 0.5 - 6)
local Inside = math.abs(LocalPoint.X) <= HardHalfX
and math.abs(LocalPoint.Z) <= HardHalfZ
local EdgeClearance = math.min(
SafeHalfX - math.abs(LocalPoint.X),
SafeHalfZ - math.abs(LocalPoint.Z)
)
local RecoveryLocal = Vector3.new(
math.clamp(LocalPoint.X, -SafeHalfX, SafeHalfX),
0,
math.clamp(LocalPoint.Z, -SafeHalfZ, SafeHalfZ)
)
local RecoveryWorld = Floor.CFrame:PointToWorldSpace(RecoveryLocal)
return Inside, Vector3.new(RecoveryWorld.X, Y, RecoveryWorld.Z), EdgeClearance
end

