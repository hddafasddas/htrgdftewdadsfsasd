local Properties = Instance.new('TextChatMessageProperties')
local Name = LP:GetAttribute('DisguiseName') or LP.Name
local NameColor = LP:GetAttribute('NameColor') or Color3.fromRGB(200, 200, 200)
Properties.PrefixText = string.format("%s<b><font color='rgb(%d,%d,%d)'>%s:</font></b>",
Extra, math.round(NameColor.R * 255), math.round(NameColor.G * 255),
math.round(NameColor.B * 255), Name)
Properties.Text = Message.Text or ''
return Properties
end
