end)
end
State.BallStudio.OriginalColor[Part] = nil
end
State.BallStudio.Tracked = nil
end

-- Release detection: the ball leaves the hand, so the trail lights up for the
-- live flight only, and the shot sound fires exactly once on release.
function State.BallStudio.Update()
if not CONFIG.BallStudioEnabled then return end
local Ball = GetLocalBallHandle()
local Character = LP.Character
local Holding = (Character and Character:FindFirstChild('Basketball')) ~= nil
if Ball and Ball ~= State.BallStudio.Tracked then
State.BallStudio.Tracked = Ball
State.BallStudio.WatchBall(Ball)
State.BallStudio.StyleTrail(State.BallStudio.EnsureTrail(Ball))
State.BallStudio.LastSkinAt = 0
end
local Now = os.clock()
if State.BallStudio.Holding and not Holding then
State.BallStudio.FlightUntil = Now
+ math.clamp(tonumber(CONFIG.BallTrailDuration) or 4, 0.2, 20)
State.BallStudio.PlayShotSound(Ball)
end
State.BallStudio.Holding = Holding
if CONFIG.CustomBallEnabled and Now - State.BallStudio.LastSkinAt >= 0.25 then
State.BallStudio.LastSkinAt = Now
for _, Part in ipairs(State.BallStudio.Targets()) do
State.BallStudio.ApplyBall(Part)
end
elseif not CONFIG.CustomBallEnabled and next(State.BallStudio.Proxies) ~= nil then
for Part in pairs(State.BallStudio.Proxies) do
State.BallStudio.DropProxy(Part)
end
end
if Ball then
local Trail = Ball:FindFirstChild('SilverSurferTrail')
if Trail and Trail:IsA('Trail') then
local Speed = Ball.AssemblyLinearVelocity.Magnitude
local ShouldShow = CONFIG.BallFlightTrail == true
and not Holding
and Now < State.BallStudio.FlightUntil
and Speed >= math.max(0, tonumber(CONFIG.BallTrailMinSpeed) or 8)
if ShouldShow ~= Trail.Enabled then
if ShouldShow then State.BallStudio.StyleTrail(Trail) end
Trail.Enabled = ShouldShow
end
end
end
if Now - State.BallStudio.LastTintAt >= 0.35 then
State.BallStudio.LastTintAt = Now
pcall(State.BallStudio.TintCosmetics)
end
end

GiveSignal(RunService.RenderStepped:Connect(function()
if not (State.Active and CONFIG.BallStudioEnabled) then return end
local Now = os.clock()
local VerifyAppearance = Now - State.BallStudio.LastProxyVerifyAt >= 0.25
if VerifyAppearance then State.BallStudio.LastProxyVerifyAt = Now end
if next(State.BallStudio.Proxies) ~= nil then
pcall(State.BallStudio.SyncProxies, VerifyAppearance)
end
if Now - State.BallStudio.LastUpdateAt < (1 / 30) then return end
State.BallStudio.LastUpdateAt = Now
pcall(State.BallStudio.Update)
end))

