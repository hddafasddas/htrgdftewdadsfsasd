    function API:SetHeadRideManualOverride(value)
        cfg.headRideManualOverride = value == true
    end
    -- Live status for the UI: which assignment adaptive picked and what the
    -- ride is currently doing.
    function API:GetDefenseStatus()
        return {
            AdaptiveState = st.adaptiveState,
            AdaptiveMode = st.adaptiveMode,
            TargetName = st.adaptiveTarget and st.adaptiveTarget.Name or nil,
            HeadRideStatus = st.headRideStatus,
            Mounted = st.headRideMounted,
        }
    end
    function API:SetCutoffDepth(value)
        cfg.cutoffDepth = math.clamp(tonumber(value) or 4, 1, 12)
    end
    function API:SetCutoffLead(value)
        cfg.cutoffLead = math.clamp(tonumber(value) or 25, 0, 100)
    end
    function API:SetCutoffBias(value)
        cfg.cutoffBias = math.clamp(tonumber(value) or 45, 0, 100)
    end
    function API:SetCutoffClampCourt(value)
        cfg.cutoffClampCourt = value == true
    end
    function API:SetCutoffCourtInset(value)
        cfg.cutoffCourtInset = math.clamp(tonumber(value) or 6, 0, 40)
    end
    function API:SetAutoBody(value)
        cfg.autoBody = value == true
        if not cfg.autoBody then restoreAutoRotate() end
    end
    function API:SetAutoBodyOnlyHolding(value)
        cfg.autoBodyOnlyHolding = value == true
    end
    function API:SetAutoBodyRange(value)
        cfg.autoBodyRange = math.clamp(tonumber(value) or 28, 6, 60)
    end
    function API:SetAutoBodySmoothness(value)
        cfg.autoBodySmoothness = math.clamp(tonumber(value) or 12, 1, 30)
    end
    function API:SetAutoBodyMaxDefenders(value)
        cfg.autoBodyMaxDefenders = math.clamp(
            math.floor((tonumber(value) or 4) + 0.5),
            1,
            8
        )
    end
    function API:SetAutoHandSwitch(value)
        cfg.autoHandSwitch = value == true
        if not cfg.autoHandSwitch then resetHandSwitchState() end
    end
    function API:SetHandSwitchCooldown(value)
        cfg.handSwitchCooldown = math.clamp(tonumber(value) or 0.45, 0.20, 1)
    end
    function API:SetHandSwitchCamera(value)
        cfg.handSwitchCamera = value == true
    end
    function API:SetHandSwitchCourt(value)
        cfg.handSwitchCourt = value == true
    end
    function API:SetHandSwitchSensitivity(value)
        cfg.handSwitchSensitivity = math.clamp(tonumber(value) or 0.16, 0.05, 0.60)
    end
    function API:Destroy()
        cfg.enabled = false
        saveMovementStyle(true)
        local character = LocalPlayer.Character
        restoreAutoRotate()
        stopMoving(character and character:FindFirstChildOfClass("Humanoid"))
        connection:Destroy()
    end

    return API
end

local function launchShowcase()
    local UI = Aureate.new({ Name = "SILVER SURFER", ToggleKey = Enum.KeyCode.RightShift })


    local function silentNotify(text)
        local lower = string.lower(tostring(text))
        local kind = "Success"
        if string.find(lower, "fail") or string.find(lower, "unavail") or string.find(lower, "missing") then
            kind = "Error"
        elseif string.find(lower, "off") or string.find(lower, "blocked") then
            kind = "Warning"
        end
        UI:Notify({
            Title = "Silent aim",
            Content = tostring(text),
            Type = kind,
            Duration = 3,
        })
    end

    local hoopzEngine = nil
    local swishEngine = nil
    local dropOffsEngine = nil
    local rooftop2Engine = nil
    local activeEngine = nil
    local activeGame = nil

    local function destroyEngine(engine)
        if engine and engine.Destroy then
            pcall(function() engine:Destroy() end)
        end
    end

    local function controlValue(id, fallback)
        local control = UI.Options[id]
        if control and control.Value ~= nil then return control.Value end
        return fallback
    end

    local function getEngine(name)
        if name == "Swish" then
            if not swishEngine then swishEngine = createSwishSilentAim(silentNotify) end
            return swishEngine
        elseif name == "Drop Offs" then
            if not dropOffsEngine then
                dropOffsEngine = createDropOffsSilentAim(silentNotify)
            end
            return dropOffsEngine
        elseif name == "Rooftop 2" then
            if not rooftop2Engine then
                rooftop2Engine = createRooftop2SilentAim(silentNotify)
            end
            return rooftop2Engine
        end
        if not hoopzEngine then hoopzEngine = createHoopzSilentAim(silentNotify) end
        return hoopzEngine
    end

    local function syncEngineSettings(engine)
        if not engine then return end
        local shoot = controlValue("shoot_mode", "Click")
        local arc = controlValue("silent_arc", "High")
        if engine.SetShootMode then engine:SetShootMode(shoot) end
        if engine.SetArcMode then engine:SetArcMode(arc) end
        if engine.SetPower and UI.Options.silent_power then
            engine:SetPower(UI.Options.silent_power.Value)
        end
        if engine.SetVerticalBoost and UI.Options.silent_boost then
            engine:SetVerticalBoost(UI.Options.silent_boost.Value)
        end
        if engine.SetMaxDistance and UI.Options.silent_distance then
            engine:SetMaxDistance(UI.Options.silent_distance.Value)
        end
        if engine.SetTargetHoop and UI.Options.swish_hoop then
            engine:SetTargetHoop(UI.Options.swish_hoop.Value)
        end
        if engine.SetArcTrim and UI.Options.silent_trim then
            engine:SetArcTrim(UI.Options.silent_trim.Value)
        end
        if engine.SetAutoPower and UI.Options.swish_autopower then
            engine:SetAutoPower(UI.Options.swish_autopower.Value)
        end
        if engine.SetAutoPowerPreference and UI.Options.swish_power_pref then
            engine:SetAutoPowerPreference(UI.Options.swish_power_pref.Value)
        end
        if engine.SetFullcourtBypass and UI.Options.swish_fullcourt then
            engine:SetFullcourtBypass(UI.Options.swish_fullcourt.Value)
        end
        if engine.SetMinPower and UI.Options.swish_minpower then
            engine:SetMinPower(UI.Options.swish_minpower.Value)
        end
        if engine.SetForceScore and UI.Options.swish_force_score then
            engine:SetForceScore(UI.Options.swish_force_score.Value)
        end
    end

    local function setActiveGame(name, silent)
        name = (name == "Swish" and "Swish")
            or (name == "Drop Offs" and "Drop Offs")
            or (name == "Rooftop 2" and "Rooftop 2") or "Hoopz"
        local enabled = UI.Options.silent and UI.Options.silent.Value == true

        -- Tear down the previous engine before installing the other game's
        -- hooks. This prevents both hook stacks from competing in one VM.
        if activeEngine and activeGame ~= name then
            destroyEngine(activeEngine)
            if activeGame == "Swish" then
                swishEngine = nil
            elseif activeGame == "Drop Offs" then
                dropOffsEngine = nil
            elseif activeGame == "Rooftop 2" then
                rooftop2Engine = nil
            else
                hoopzEngine = nil
            end
            activeEngine = nil
        elseif activeEngine and activeEngine.SetEnabled then
            activeEngine:SetEnabled(false)
        end

        activeGame = name
        activeEngine = getEngine(name)
        if not activeEngine then
            if not silent then
                silentNotify(name .. " silent aim unavailable in this place")
            end
            return false
        end
        syncEngineSettings(activeEngine)
        if enabled then activeEngine:SetEnabled(true) end
        if not silent then
            silentNotify("Game: " .. name)
        end
        return true
    end

    local function refreshShotVariants()
        if activeEngine and activeEngine.RefreshVariants then
            pcall(function() activeEngine:RefreshVariants() end)
        end
    end

    -- Replace the old Hoopz-only no-jump action with one release path shared by
    -- Hoopz, Swish, Drop Offs and Rooftop 2.
    local function fireUniversalNoJump()
        if CONFIG.NoJumpEnabled ~= true then
            silentNotify('Enable No Jump Shot first')
            return false
        end
        if not (UI.Options.silent and UI.Options.silent.Value == true) then
            silentNotify('Enable silent aim before using No Jump Shot')
            return false
        end

        local engine = activeEngine or getEngine(activeGame)
        if not engine then
            silentNotify('No silent aim engine is ready')
            return false
        end
        if engine.IsReady and not engine:IsReady() then
            silentNotify(activeGame .. ' silent aim is not ready')
            return false
        end

        local character = Players.LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass('Humanoid')
        local root = character and character:FindFirstChild('HumanoidRootPart')
        if not (humanoid and root) then
            silentNotify('Character is not ready')
            return false
        end
        if humanoid.FloorMaterial == Enum.Material.Air then
            silentNotify('No Jump Shot requires you to be grounded')
            return false
        end

        local originalMode = controlValue('shoot_mode', 'Click')
        if engine.SetEnabled then engine:SetEnabled(true) end
        if engine.SetShootMode then engine:SetShootMode('Click') end
        refreshShotVariants()

        State.NoJump.Generation = (State.NoJump.Generation or 0) + 1
        local generation = State.NoJump.Generation
        State.NoJump.Active = true
        State.NoJump.SyntheticInput = true
        State.NoJump.LockToGround(root, humanoid, generation)

        task.spawn(function()
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                humanoid.Jump = true
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end)

            local frames = math.max(math.floor(tonumber(CONFIG.NoJumpArmFrames) or 4), 2)
            for _ = 1, frames do RunService.RenderStepped:Wait() end

            local fired = false
            local click = EXECUTOR_CAPABILITIES.mouse1click
            if type(click) == 'function' then fired = pcall(click) end
            if not fired then
                local camera = workspace.CurrentCamera
                local position = UserInputService:GetMouseLocation()
                fired = pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(position.X, position.Y, 0, true, game, 0)
                    RunService.RenderStepped:Wait()
                    VirtualInputManager:SendMouseButtonEvent(position.X, position.Y, 0, false, game, 0)
                end)
            end

            pcall(function()
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            end)
            task.delay(0.12, function()
                if engine and engine.SetShootMode then engine:SetShootMode(originalMode) end
                if State.NoJump.Generation == generation then
                    State.NoJump.SyntheticInput = false
                end
            end)
            if not fired then silentNotify('Native shot input was unavailable') end
        end)
        return true
    end
    State.NoJump.Fire = fireUniversalNoJump

    UI.Janitor:Add(function()
        local seen = {}
        for _, engine in ipairs({ activeEngine, hoopzEngine, swishEngine, dropOffsEngine, rooftop2Engine }) do
            if engine and not seen[engine] then
                seen[engine] = true
                destroyEngine(engine)
            end
        end
        activeEngine, hoopzEngine, swishEngine, dropOffsEngine, rooftop2Engine = nil, nil, nil, nil, nil
    end)

    --== working visual systems ==============================================
    -- These are normal client-side Roblox instances. They do not depend on a
    -- Drawing API, and every connection/instance is owned by UI.Janitor.

    local lightingOriginal = {
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        GlobalShadows = Lighting.GlobalShadows,
        FogEnd = Lighting.FogEnd,
        ExposureCompensation = Lighting.ExposureCompensation,
    }
    local fullbrightEnabled = false
    local lightingGuard = false
    local lightingChanged

    local function optionValue(id, fallback)
        local control = UI.Options[id]
        if control and control.Value ~= nil then return control.Value end
        return fallback
    end

    local function applyFullbright()
        if not fullbrightEnabled or lightingGuard then return end
        lightingGuard = true
        Lighting.Brightness = optionValue("brightness", 2)
        Lighting.ClockTime = optionValue("time_of_day", 14)
        local ambient = optionValue("ambient", Color3.fromRGB(180, 180, 180))
        Lighting.Ambient = ambient
        Lighting.OutdoorAmbient = ambient
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.ExposureCompensation = 0.35
        lightingGuard = false
    end

    local function setFullbright(state)
        fullbrightEnabled = state == true
        if lightingChanged then lightingChanged:Disconnect(); lightingChanged = nil end
        if fullbrightEnabled then
            applyFullbright()
            -- Games often rewrite Lighting every frame or when an area loads.
            -- Reapply only after an actual external change.
            lightingChanged = Lighting.Changed:Connect(function()
                if fullbrightEnabled and not lightingGuard then
                    task.defer(applyFullbright)
                end
            end)
        else
            lightingGuard = true
            for property, value in pairs(lightingOriginal) do
                pcall(function() Lighting[property] = value end)
            end
            lightingGuard = false
        end
    end

    UI.Janitor:Add(function()
        fullbrightEnabled = false
        if lightingChanged then lightingChanged:Disconnect(); lightingChanged = nil end
        for property, value in pairs(lightingOriginal) do
            pcall(function() Lighting[property] = value end)
        end
    end)

    -- ESP uses Highlight + BillboardGui for 3D markers and a rotated Frame for
    -- tracers. It follows respawns, respects distance/team filters, and removes
    -- every marker when disabled or when the library unloads.
    local espLayer = create("Frame", {
        Name = "ESP_Layer", Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, ZIndex = 180, Parent = UI.Gui,
    })
    local espEntries = {}

    local function removeEntry(player)
        local entry = espEntries[player]
        if not entry then return end
        for _, object in ipairs({ entry.Highlight, entry.Billboard, entry.Tracer, entry.Box }) do
            if object then object:Destroy() end
        end
        espEntries[player] = nil
    end

    local function makeCorner(parent, anchor, position, size)
        return create("Frame", {
            AnchorPoint = anchor, Position = position, Size = size,
            BackgroundColor3 = Color3.fromRGB(212, 169, 55), BorderSizePixel = 0,
            ZIndex = 184, Parent = parent,
        })
    end

    local function makeEntry(player, character)
        removeEntry(player)
        local root = character:FindFirstChild("HumanoidRootPart")
        local head = character:FindFirstChild("Head") or root
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not root or not head or not humanoid then return nil end

        -- A subtle 3D glow complements the actual screen-space box.
        local highlight = create("Highlight", {
            Name = "AureateESP", Adornee = character,
            DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
            FillTransparency = 1, OutlineTransparency = 0.72,
            Enabled = false, Parent = Workspace,
        })

        local billboard = create("BillboardGui", {
            Name = "AureateInfo", Adornee = head,
            Size = UDim2.fromOffset(170, 42), StudsOffset = Vector3.new(0, 3.25, 0),
            AlwaysOnTop = true, LightInfluence = 0, Enabled = false,
            Parent = character,
        })
        local nameLabel = create("TextLabel", {
            Size = UDim2.new(1, 0, 0, 17), BackgroundTransparency = 1,
            Font = FONT, TextSize = 13, TextStrokeTransparency = 0.25,
            TextStrokeColor3 = Color3.new(0, 0, 0), TextColor3 = Color3.new(1, 1, 1),
            Text = player.DisplayName, Parent = billboard,
        })
        local healthBack = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 21),
            Size = UDim2.fromOffset(92, 7), BackgroundColor3 = Color3.fromRGB(16, 16, 18),
            BorderSizePixel = 0, Parent = billboard,
        }, { corner(2), stroke(Color3.fromRGB(42, 42, 46)) })
        local healthFill = create("Frame", {
            Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(122, 194, 138),
            BorderSizePixel = 0, Parent = healthBack,
        }, { corner(2) })
        local distanceLabel = create("TextLabel", {
            Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, 0, 0, 12),
            BackgroundTransparency = 1, Font = FONT, TextSize = 11,
            TextStrokeTransparency = 0.35, TextStrokeColor3 = Color3.new(0, 0, 0),
            TextColor3 = Color3.fromRGB(212, 169, 55), Text = "", Parent = billboard,
        })
        local tracer = create("Frame", {
            Name = "Tracer_" .. player.Name, AnchorPoint = Vector2.new(0, 0.5),
            Size = UDim2.fromOffset(0, 1), BackgroundColor3 = Color3.fromRGB(212, 169, 55),
            BorderSizePixel = 0, Visible = false, ZIndex = 181, Parent = espLayer,
        })

        -- Full/Round use UIStroke; Corner uses eight short line segments.
        local box = create("Frame", {
            Name = "Box_" .. player.Name, BackgroundTransparency = 1,
            BorderSizePixel = 0, Visible = false, ZIndex = 183, Parent = espLayer,
        }, {
            create("UICorner", { CornerRadius = UDim.new(0, 0) }),
            create("UIStroke", { Color = Color3.fromRGB(212, 169, 55), Thickness = 2 }),
        })
        local boxStroke = box:FindFirstChildOfClass("UIStroke")
        local boxRound = box:FindFirstChildOfClass("UICorner")
        local corners = {
            makeCorner(box, Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.new(0.28, 0, 0, 2)),
            makeCorner(box, Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.new(0, 2, 0.28, 0)),
            makeCorner(box, Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.new(0.28, 0, 0, 2)),
            makeCorner(box, Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.new(0, 2, 0.28, 0)),
            makeCorner(box, Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.new(0.28, 0, 0, 2)),
            makeCorner(box, Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.new(0, 2, 0.28, 0)),
            makeCorner(box, Vector2.new(1, 1), UDim2.fromScale(1, 1), UDim2.new(0.28, 0, 0, 2)),
            makeCorner(box, Vector2.new(1, 1), UDim2.fromScale(1, 1), UDim2.new(0, 2, 0.28, 0)),
        }

        local entry = {
            Character = character, Root = root, Head = head, Humanoid = humanoid,
            Highlight = highlight, Billboard = billboard, Name = nameLabel,
            HealthBack = healthBack, HealthFill = healthFill,
            Distance = distanceLabel, Tracer = tracer, Box = box,
            BoxStroke = boxStroke, BoxRound = boxRound, Corners = corners,
        }
        espEntries[player] = entry
        return entry
    end

    local function setLine(line, from, to, thickness)
        local delta = to - from
        line.Position = UDim2.fromOffset(from.X, from.Y)
        line.Size = UDim2.fromOffset(delta.Magnitude, thickness)
        line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
    end

    local originalCameraFov = Workspace.CurrentCamera and Workspace.CurrentCamera.FieldOfView or 70
    local function applyCameraFov(value)
        local camera = Workspace.CurrentCamera
        if camera then camera.FieldOfView = clamp(tonumber(value) or 70, 30, 120) end
    end

    -- Roblox's camera scripts (and many games) rewrite FieldOfView during the
    -- camera render step. Apply the selected value one priority later so the
    -- Camera FOV slider remains authoritative instead of being overwritten.
    local cameraFovBinding = "AureateCameraFOV_" .. HttpService:GenerateGUID(false)
    RunService:BindToRenderStep(cameraFovBinding, Enum.RenderPriority.Camera.Value + 1, function()
        applyCameraFov(optionValue("camera_fov", originalCameraFov))
    end)
    UI.Janitor:Add(function()
        RunService:UnbindFromRenderStep(cameraFovBinding)
        local camera = Workspace.CurrentCamera
        if camera then camera.FieldOfView = originalCameraFov end
    end)

    local WORLD_PRESETS = {
        ["Midnight"] = { Brightness = 0.8, Time = 0, Ambient = Color3.fromRGB(38, 45, 72) },
        ["Golden hour"] = { Brightness = 2.6, Time = 17.5, Ambient = Color3.fromRGB(190, 130, 72) },
        ["Overcast"] = { Brightness = 1.5, Time = 12, Ambient = Color3.fromRGB(145, 150, 158) },
        ["Neon"] = { Brightness = 3.2, Time = 22, Ambient = Color3.fromRGB(105, 58, 160) },
        ["Desert"] = { Brightness = 3.5, Time = 14, Ambient = Color3.fromRGB(205, 164, 104) },
    }
    local function applyWorldPreset(name)
        local preset = WORLD_PRESETS[name]
        if not preset then return end
        if UI.Options.brightness then UI.Options.brightness:SetValue(preset.Brightness) end
        if UI.Options.time_of_day then UI.Options.time_of_day:SetValue(preset.Time) end
        if UI.Options.ambient then UI.Options.ambient:SetValue(preset.Ambient) end
        if UI.Options.fullbright then UI.Options.fullbright:SetValue(true) else setFullbright(true) end
        UI:Notify({ Title = name, Content = "World preset applied.", Type = "Success", Duration = 2 })
    end

    local progressClock = 0
    local espConnection = RunService.RenderStepped:Connect(function(dt)
        local camera = Workspace.CurrentCamera
        local localPlayer = Players.LocalPlayer
        local localCharacter = localPlayer and localPlayer.Character
        local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
        if not camera or not localPlayer then return end

        local enabled = optionValue("esp_enabled", false)
        if not enabled then
            for player in pairs(espEntries) do removeEntry(player) end
            return
        end
        local maxDistance = optionValue("distance", 1500)
        local teamCheck = optionValue("team_check", false)
        local showNames = optionValue("names", true)
        local showHealth = optionValue("health", true)
        local showBoxes = optionValue("box", true)
        local showTracers = optionValue("tracers", false)
        local boxColour = optionValue("esp_colour", Color3.fromRGB(212, 169, 55))
        local nameColour = optionValue("name_colour", Color3.fromRGB(237, 234, 227))
        local style = optionValue("esp_style", "Corner")
        local thickness = optionValue("esp_thickness", 2)

        local inset = GuiService:GetGuiInset()
        local visibleCount, totalCount = 0, 0

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= localPlayer then
                totalCount = totalCount + 1
                local character = player.Character
                local entry = espEntries[player]
                if character and (not entry or entry.Character ~= character
                    or not entry.Root.Parent or not entry.Humanoid.Parent) then
                    entry = makeEntry(player, character)
                end

                if entry then
                    local distance = localRoot and (entry.Root.Position - localRoot.Position).Magnitude or math.huge
                    local alive = entry.Humanoid.Health > 0
                    local teammate = teamCheck and localPlayer.Team ~= nil and player.Team == localPlayer.Team
                    local visible = enabled and alive and not teammate and distance <= maxDistance
                    local rootPoint, onScreen = camera:WorldToViewportPoint(entry.Root.Position)
                    local screenVisible = visible and onScreen and rootPoint.Z > 0
                    if screenVisible then visibleCount = visibleCount + 1 end

                    entry.Billboard.Enabled = visible and (showNames or showHealth)
                    entry.Name.Visible = showNames
                    entry.HealthBack.Visible = showHealth
                    entry.Distance.Visible = showNames
                    entry.Name.Text = player.DisplayName .. "  [" .. player.Name .. "]"
                    entry.Name.TextColor3 = nameColour
                    entry.Distance.TextColor3 = boxColour
                    entry.Distance.Text = tostring(math.floor(distance + 0.5)) .. " studs"
                    local hp = clamp(entry.Humanoid.Health / math.max(entry.Humanoid.MaxHealth, 1), 0, 1)
                    entry.HealthFill.Size = UDim2.new(hp, 0, 1, 0)
                    entry.HealthFill.BackgroundColor3 = Color3.fromHSV(hp * 0.33, 0.82, 0.9)

                    entry.Highlight.Enabled = screenVisible and showBoxes
                    entry.Highlight.FillColor = boxColour
                    entry.Highlight.OutlineColor = boxColour

                    -- Project a character-sized rectangle into screen space.
                    local extents = entry.Character:GetExtentsSize()
                    local top = camera:WorldToViewportPoint(entry.Root.Position + Vector3.new(0, extents.Y * 0.55, 0))
                    local bottom = camera:WorldToViewportPoint(entry.Root.Position - Vector3.new(0, extents.Y * 0.55, 0))
                    local boxHeight = math.max(math.abs(bottom.Y - top.Y), 18)
                    local boxWidth = math.max(boxHeight * 0.56, 12)
                    -- WorldToViewportPoint is measured from the physical
                    -- viewport, while this ScreenGui starts below the top-bar
                    -- inset (IgnoreGuiInset=false). Convert to local GUI space
                    -- or every overlay is drawn one inset too far down/right.
                    local rootGui = Vector2.new(rootPoint.X - inset.X, rootPoint.Y - inset.Y)
                    local topGuiY = top.Y - inset.Y
                    local bottomGuiY = bottom.Y - inset.Y
                    entry.Box.Visible = screenVisible and showBoxes
                    entry.Box.Position = UDim2.fromOffset(rootGui.X - boxWidth / 2, (topGuiY + bottomGuiY) / 2 - boxHeight / 2)
                    entry.Box.Size = UDim2.fromOffset(boxWidth, boxHeight)
                    entry.BoxStroke.Enabled = style ~= "Corner"
                    entry.BoxStroke.Thickness = thickness
                    entry.BoxStroke.Color = boxColour
                    entry.BoxRound.CornerRadius = UDim.new(0, style == "Round" and 7 or 0)
                    for index, line in ipairs(entry.Corners) do
                        line.Visible = style == "Corner"
                        line.BackgroundColor3 = boxColour
                        if index % 2 == 1 then
                            line.Size = UDim2.new(0.28, 0, 0, thickness)
                        else
