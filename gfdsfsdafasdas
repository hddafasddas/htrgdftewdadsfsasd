function State.AutoDunk.Begin(Target)
if State.AutoDunk.InProgress then return false end
local Key = State.AutoDunk.GetKeyCode()
if not Key then
State.AutoDunkStatus = 'NO DUNK KEY'
return false
end
if not State.AutoDunk.PrepareRandomOwnedDunk() then return false end

State.AutoDunk.InProgress = true
State.AutoDunk.HeldKey = Key
State.AutoDunk.StartedAt = os.clock()
State.AutoDunk.LastAttempt = State.AutoDunk.StartedAt
State.AutoDunk.Target = Target
State.AutoDunkStatus = 'HOLDING ' .. tostring(State.AutoDunk.HeldKey or State.AutoDunk.GetKeyCode())
StopLegitAimTween()
SilentAim.ClearActorAim()

State.AutoDunk.SendingInput = true
local Ok = pcall(function()
VirtualInputManager:SendKeyEvent(true, Key, false, game)
end)
State.AutoDunk.SendingInput = false
if not Ok then
State.AutoDunk.ReleaseKey()
State.AutoDunkStatus = 'INPUT FAILED'
return false
end
return true
end

function State.AutoDunk.UpdateBinding()
pcall(function() RunService:UnbindFromRenderStep(State.AutoDunk.BindName) end)
State.AutoDunk.ReleaseKey()
State.AutoDunk.Target = nil
State.AutoDunk.TargetDistance = math.huge
