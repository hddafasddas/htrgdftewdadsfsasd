    tab.Window, tab.Library, tab.Name, tab.Sections = self, lib, name, {}

    local width = TextService:GetTextSize(name, TEXT, FONT, Vector2.new(600, 20)).X + 22
    local button = create("TextButton", {
        Name = name, Size = UDim2.fromOffset(width, 23), AutoButtonColor = false,
        BackgroundColor3 = lib.Theme.SurfaceAlt, BackgroundTransparency = 1,
        BorderSizePixel = 0, Font = FONT, TextSize = TEXT,
        TextColor3 = lib.Theme.TextMuted, Text = name, Parent = self.TabList,
    }, { corner(2) })
    lib:_bind(button, "BackgroundColor3", "SurfaceAlt")

    local edge = create("UIStroke", {
        Color = lib.Theme.Border, Thickness = 1, Transparency = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = button,
    })
    local underline = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0),
        Size = UDim2.new(0, 0, 0, 1), BackgroundColor3 = lib.Theme.Gold,
        BorderSizePixel = 0, Parent = button,
    })
    lib:_bind(underline, "BackgroundColor3", "Gold")

    local page = create("ScrollingFrame", {
        Name = name .. "Page", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
        BorderSizePixel = 0, ScrollBarThickness = 2,
        ScrollBarImageColor3 = lib.Theme.GoldDark,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
        Visible = false, Parent = self.Content,
    })
    local columns = create("Frame", {
        Size = UDim2.new(1, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = page,
    })
    -- Three balanced columns keep tall feature sets on one screen, and the
    -- scale below shrinks a page only when it would otherwise need scrolling.
    local columnScale = create("UIScale", { Scale = 1, Parent = columns })
    local left = create("Frame", {
        Size = UDim2.new(1 / 3, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Parent = columns,
    }, { list(8) })
    local middle = create("Frame", {
        Position = UDim2.new(1 / 3, 3, 0, 0), Size = UDim2.new(1 / 3, -6, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = columns,
    }, { list(8) })
    local right = create("Frame", {
        Position = UDim2.new(2 / 3, 6, 0, 0), Size = UDim2.new(1 / 3, -6, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = columns,
    }, { list(8) })

    tab.Button, tab.Edge, tab.Underline = button, edge, underline
    tab.Page, tab.Left, tab.Middle, tab.Right = page, left, middle, right
    tab.Columns, tab.ColumnScale = columns, columnScale
    tab.ColumnFrames = { left, middle, right }
    table.insert(self.Tabs, tab)

    self.Janitor:Add(button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            lib:_tween(button, MOTION.Fast, { BackgroundTransparency = 0.4, TextColor3 = lib.Theme.Text })
        end
    end))
    self.Janitor:Add(button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            lib:_tween(button, MOTION.Fast, { BackgroundTransparency = 1, TextColor3 = lib.Theme.TextMuted })
        end
    end))
    self.Janitor:Add(button.MouseButton1Click:Connect(function() self:SelectTab(tab) end))

    if not self.ActiveTab then self:SelectTab(tab) end
    return tab
end

function Window:SelectTab(selected)
    if self.ActiveTab == selected then return end
    local lib = self.Library
    for _, tab in ipairs(self.Tabs) do
        local active = tab == selected
        tab.Page.Visible = active
        lib:_tween(tab.Button, MOTION.Fast, {
            BackgroundTransparency = active and 0 or 1,
            TextColor3 = active and lib.Theme.GoldBright or lib.Theme.TextMuted,
        })
        lib:_tween(tab.Edge, MOTION.Fast, { Transparency = active and 0 or 1 })
        lib:_tween(tab.Underline, MOTION.Normal, { Size = UDim2.new(active and 1 or 0, 0, 0, 1) })
        if active then
            tab.Page.CanvasPosition = Vector2.zero
            tab.Page.Position = UDim2.fromOffset(4, 0)
            lib:_tween(tab.Page, MOTION.Fast, { Position = UDim2.fromOffset(0, 0) })
        end
    end
    self.ActiveTab = selected
    self:AutoFitTabs()
end

-- Rebalances every page across its three columns and scales the page down
-- just enough that the tallest column fits, so no tab needs scrolling.
function Window:AutoFitTabs()
    for _, tab in ipairs(self.Tabs) do
        if tab.ColumnFrames and tab.ColumnScale then
            local previous = tab.ColumnScale.Scale
            if previous <= 0 then previous = 1 end

            local heights = { 0, 0, 0 }
            for order, section in ipairs(tab.Sections) do
                if section.Frame.Visible then
                    local height = section.Frame.AbsoluteSize.Y / previous
                    if height < 12 then height = ((section.Order or 1) * 27) + 34 end
                    local target = 1
                    for index = 2, #tab.ColumnFrames do
                        if heights[index] < heights[target] - 0.5 then target = index end
                    end
                    section.Frame.LayoutOrder = order
                    if section.Frame.Parent ~= tab.ColumnFrames[target] then
                        section.Frame.Parent = tab.ColumnFrames[target]
                    end
                    heights[target] = heights[target] + height + 8
                end
            end

            local tallest = 0
            for _, value in ipairs(heights) do
                if value > tallest then tallest = value end
            end

            local available = tab.Page.AbsoluteSize.Y - 6
            local fit = 1
            if tallest > 4 and available > 60 then
                fit = math.clamp(available / tallest, 0.42, 1)
            end

            tab.ColumnScale.Scale = fit
            tab.Columns.AutomaticSize = Enum.AutomaticSize.None
            tab.Columns.Size = UDim2.new(1 / fit, -6 / fit, 0, tallest)
            tab.Page.ScrollBarThickness = (fit > 0.4201) and 0 or 2
        end
    end
end

--== search animation =======================================================

-- Per-instance animation bookkeeping. Weak keys so rows that get destroyed
-- do not pin their state here forever.
local MOTION_STATE = setmetatable({}, { __mode = "k" })

local COLLAPSE_IN = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local COLLAPSE_OUT = TweenInfo.new(0.13, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local function motionState(object)
    local state = MOTION_STATE[object]
    if not state then
        state = { Serial = 0, Shown = object.Visible }
        MOTION_STATE[object] = state
    end
    return state
end

-- Collapses an object along one axis instead of blinking it out, so filtering
-- reads as the list rearranging itself. Every call bumps a serial, which is
-- what stops a fast typist from leaving a half-finished tween behind.
local function collapse(lib, object, visible, stagger, axis)
    local state = motionState(object)
    state.Serial = state.Serial + 1
    local serial = state.Serial

    if not state.Size then
        object.ClipsDescendants = true
        -- Measure once layout has actually run, so automatically sized rows
        -- collapse from their real height rather than from zero.
        if object.AutomaticSize ~= Enum.AutomaticSize.None then
            state.Auto = object.AutomaticSize
            state.Size = UDim2.new(
                object.Size.X.Scale, object.Size.X.Offset,
                object.Size.Y.Scale, math.max(object.AbsoluteSize.Y, 1)
            )
        else
            state.Size = object.Size
        end
    end

    local full = state.Size
    local flat
    if axis == "X" then
        flat = UDim2.new(0, 0, full.Y.Scale, full.Y.Offset)
    else
        flat = UDim2.new(full.X.Scale, full.X.Offset, 0, 0)
    end

    if visible then
        if state.Shown and object.Visible then return end
        state.Shown = true
        if state.Auto then object.AutomaticSize = Enum.AutomaticSize.None end
        object.Size = flat
        object.Visible = true

        local function grow()
            if MOTION_STATE[object] ~= state or state.Serial ~= serial then return end
            if not object.Parent then return end
            lib:_tween(object, COLLAPSE_IN, { Size = full })
            -- Hand height back to the layout once the tween has landed, so
            -- wrapped labels can still resize themselves afterwards.
            if state.Auto then
                task.delay(lib.MotionEnabled and 0.24 or 0, function()
                    if state.Serial == serial and state.Shown and object.Parent then
                        object.AutomaticSize = state.Auto
                    end
                end)
            end
        end

        if stagger and stagger > 0 and lib.MotionEnabled then
            task.delay(stagger, grow)
        else
            grow()
        end
    else
        if not state.Shown and not object.Visible then return end
        state.Shown = false
        if state.Auto then object.AutomaticSize = Enum.AutomaticSize.None end
        lib:_tween(object, COLLAPSE_OUT, { Size = flat })
        task.delay(lib.MotionEnabled and 0.14 or 0, function()
            if state.Serial == serial and not state.Shown then
                object.Visible = false
            end
        end)
    end
end

-- Sections stay mounted until their rows have finished collapsing, otherwise
-- the box would vanish out from under the animation.
local function fadeSection(lib, frame, visible)
    local state = motionState(frame)
    state.Serial = state.Serial + 1
    local serial = state.Serial

    if visible then
        state.Shown = true
        frame.Visible = true
    else
        state.Shown = false
        task.delay(lib.MotionEnabled and 0.15 or 0, function()
            if state.Serial == serial and not state.Shown then
                frame.Visible = false
            end
        end)
    end
end

local function fadeText(lib, object, visible)
    local state = motionState(object)
    state.Serial = state.Serial + 1
    local serial = state.Serial

    if visible then
        if state.Shown and object.Visible then return end
        state.Shown = true
        object.Visible = true
        object.TextTransparency = 1
        lib:_tween(object, MOTION.Normal, { TextTransparency = 0 })
    else
        if not state.Shown and not object.Visible then return end
        state.Shown = false
        lib:_tween(object, MOTION.Fast, { TextTransparency = 1 })
        task.delay(lib.MotionEnabled and 0.11 or 0, function()
            if state.Serial == serial and not state.Shown then
                object.Visible = false
            end
        end)
    end
end

-- Filters every indexed control across every tab against the query. Rows,
-- sections and tab buttons that do not match collapse away, so the window
-- animates down to just the matches instead of merely narrowing the tabs.
function Window:ApplySearch(query)
    query = string.lower(tostring(query or ""))
    query = query:match("^%s*(.-)%s*$") or ""
    local searching = query ~= ""
    local wasSearching = self.SearchQuery ~= ""
    self.SearchQuery = query

    -- Remember where the user was before searching, then return there when
    -- the query is cleared instead of leaving the interface on a random tab.
    if searching and not wasSearching then
        self.SearchReturnTab = self.ActiveTab
    end

    local sectionHits, tabHits, matches = {}, {}, 0
    for _, entry in ipairs(self.SearchIndex) do
        local matched = not searching
            or (not entry.Static and string.find(entry.Text, query, 1, true) ~= nil)
        entry.Match = matched

        if matched and not entry.Static then
            sectionHits[entry.Section] = true
            tabHits[entry.Tab] = true
            matches = matches + 1
        end

        -- Search used to animate Size and AutomaticSize. That fought the
        -- responsive page scaler and could leave rows at zero height. Search
        -- now changes visibility only, which is deterministic and reversible.
        for _, row in ipairs(entry.Rows) do
            local state = MOTION_STATE[row]
            if state then
                state.Serial = state.Serial + 1
                state.Shown = matched
                if state.Size then row.Size = state.Size end
                if state.Auto then row.AutomaticSize = state.Auto end
            end
            row.Visible = matched
        end
    end

    local firstHit
    for _, tab in ipairs(self.Tabs) do
        for _, section in ipairs(tab.Sections) do
            local visible = (not searching) or sectionHits[section] == true
            local state = MOTION_STATE[section.Frame]
            if state then
                state.Serial = state.Serial + 1
                state.Shown = visible
            end
            section.Frame.Visible = visible
        end

        local visible = (not searching) or tabHits[tab] == true
        local buttonState = MOTION_STATE[tab.Button]
        if buttonState then
            buttonState.Serial = buttonState.Serial + 1
            buttonState.Shown = visible
            if buttonState.Size then tab.Button.Size = buttonState.Size end
            if buttonState.Auto then tab.Button.AutomaticSize = buttonState.Auto end
        end
        tab.Button.Visible = visible
        if visible and not firstHit then firstHit = tab end
    end

    if searching and firstHit and not tabHits[self.ActiveTab] then
        self:SelectTab(firstHit)
    elseif not searching and self.SearchReturnTab then
        local returnTab = self.SearchReturnTab
        self.SearchReturnTab = nil
        self:SelectTab(returnTab)
    end

    if self.SearchClear then
        self.SearchClear.Visible = searching
        self.SearchClear.TextTransparency = searching and 0 or 1
    end

    if self.SearchEmpty then
        local show = searching and matches == 0
        self.SearchEmpty.Visible = show
        self.SearchEmpty.TextTransparency = show and 0 or 1
        self.SearchEmpty.Position = UDim2.fromOffset(0, 24)
    end

    if self.SearchCount then
        if not searching then
            self.SearchCount.Text = "ctrl+f"
        elseif matches == 1 then
            self.SearchCount.Text = "1 result"
        else
            self.SearchCount.Text = matches .. " results"
        end
        self.SearchCount.TextTransparency = 0
    end

    -- Wait one layout pass for AutomaticSize to settle, then recompute all
    -- three-column scales from the rows that are actually visible.
    self.SearchGeneration = (self.SearchGeneration or 0) + 1
    local generation = self.SearchGeneration
    task.defer(function()
        if self.SearchGeneration ~= generation then return end
        task.wait()
        if self.SearchGeneration == generation and self.AutoFitTabs then
            self:AutoFitTabs()
        end
    end)
end

