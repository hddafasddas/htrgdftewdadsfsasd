local Root = Character and safe_find(Character, 'HumanoidRootPart')
local CourtCFrame = State.Extras.GetTravelObjectCFrame(Court)
local Pads = safe_find(Court, '_CourtPads') or safe_find(Court, 'CourtPads')
if not (CourtCFrame and Pads) then return CourtCFrame end

local BestPadCFrame, BestDistance = nil, math.huge
for _, Pad in ipairs(Pads:GetChildren()) do
local PadCFrame = State.Extras.GetTravelObjectCFrame(safe_find(Pad, 'Center') or Pad)
if PadCFrame then
local Distance = Root and (Root.Position - PadCFrame.Position).Magnitude or 0
if Distance < BestDistance then
BestDistance, BestPadCFrame = Distance, PadCFrame
end
end
end
if not BestPadCFrame then return CourtCFrame end

local Away = Vector3.new(
BestPadCFrame.Position.X - CourtCFrame.Position.X,
0,
BestPadCFrame.Position.Z - CourtCFrame.Position.Z
)
if Away.Magnitude < 0.1 then
Away = Vector3.new(BestPadCFrame.LookVector.X, 0, BestPadCFrame.LookVector.Z)
end
if Away.Magnitude < 0.1 then Away = Vector3.new(0, 0, 1) end
Away = Away.Unit
local Arrival = BestPadCFrame.Position + Away * 8
return CFrame.lookAt(Arrival, Vector3.new(
BestPadCFrame.Position.X, Arrival.Y, BestPadCFrame.Position.Z
))
end

function State.Extras.GetSafeCityArrival(City)
if not City then return nil end
local Parts = {}
if safe_is_a(City, 'BasePart') then table.insert(Parts, City) end
for _, Descendant in ipairs(City:GetDescendants()) do
if safe_is_a(Descendant, 'BasePart') then table.insert(Parts, Descendant) end
end
if #Parts == 0 then return State.Extras.GetTravelObjectCFrame(City) end

local Minimum = Vector3.new(math.huge, math.huge, math.huge)
local Maximum = Vector3.new(-math.huge, -math.huge, -math.huge)
for _, Part in ipairs(Parts) do
local Half = Part.Size * 0.5
local Position = Part.Position
Minimum = Vector3.new(
math.min(Minimum.X, Position.X - Half.X),
math.min(Minimum.Y, Position.Y - Half.Y),
math.min(Minimum.Z, Position.Z - Half.Z)
)
Maximum = Vector3.new(
math.max(Maximum.X, Position.X + Half.X),
math.max(Maximum.Y, Position.Y + Half.Y),
math.max(Maximum.Z, Position.Z + Half.Z)
)
end

local Center = (Minimum + Maximum) * 0.5
local RayOrigin = Vector3.new(Center.X, Maximum.Y + 150, Center.Z)
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude
RayParams.FilterDescendantsInstances = LP.Character and { LP.Character } or {}
RayParams.IgnoreWater = false
local Hit = Workspace:Raycast(
RayOrigin,
Vector3.new(0, -math.max(600, Maximum.Y - Minimum.Y + 300), 0),
RayParams
)
if Hit then
return CFrame.new(Hit.Position, Hit.Position + Vector3.new(0, 0, -1))
end

local HighestPart = Parts[1]
for _, Part in ipairs(Parts) do
if Part.Position.Y + Part.Size.Y * 0.5 > HighestPart.Position.Y + HighestPart.Size.Y * 0.5 then
HighestPart = Part
end
end
return HighestPart.CFrame + Vector3.new(0, HighestPart.Size.Y * 0.5, 0)
end

