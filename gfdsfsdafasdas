    end))
    win.Janitor:Add(UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            local target = startPos + UDim2.fromOffset(delta.X, delta.Y)
            root.Position, shadow.Position = target, target
        end
    end))

    win.Root, win.Shadow, win.Scale = root, shadow, scale
    win.TabList, win.Content = tabList, content

    -- search wiring ------------------------------------------------------
    win.SearchIndex, win.SearchQuery = {}, ""
    win.SearchBox, win.SearchCount = searchBox, searchCount
    win.SearchEmpty, win.SearchClear = searchEmpty, searchClear

    win.Janitor:Add(searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        win:ApplySearch(searchBox.Text)
    end))
    -- Focus lights the whole assembly at once: border, magnifier and the
    -- underline sweeping out from the centre.
    win.Janitor:Add(searchBox.Focused:Connect(function()
        self:_tween(searchStroke, MOTION.Fast, {
            Color = self.Theme.Gold, Thickness = 1.4,
        })
        self:_tween(searchUnderline, MOTION.Normal, { Size = UDim2.new(1, 0, 0, 1) })
        self:_tween(glassStroke, MOTION.Fast, { Color = self.Theme.Gold })
        self:_tween(glassHandle, MOTION.Fast, { BackgroundColor3 = self.Theme.Gold })
    end))
    win.Janitor:Add(searchBox.FocusLost:Connect(function()
        self:_tween(searchStroke, MOTION.Fast, {
            Color = self.Theme.BorderSoft, Thickness = 1,
        })
        self:_tween(searchUnderline, MOTION.Normal, { Size = UDim2.new(0, 0, 0, 1) })
        self:_tween(glassStroke, MOTION.Fast, { Color = self.Theme.TextDim })
        self:_tween(glassHandle, MOTION.Fast, { BackgroundColor3 = self.Theme.TextDim })
    end))
    win.Janitor:Add(searchClear.MouseButton1Click:Connect(function()
        searchBox.Text = ""
        searchBox:ReleaseFocus()
    end))
    win.Janitor:Add(searchClear.MouseEnter:Connect(function()
        self:_tween(searchClear, MOTION.Fast, {
            BackgroundTransparency = 0, TextColor3 = self.Theme.Text,
        })
    end))
    win.Janitor:Add(searchClear.MouseLeave:Connect(function()
        self:_tween(searchClear, MOTION.Fast, {
            BackgroundTransparency = 1, TextColor3 = self.Theme.TextMuted,
        })
    end))

    -- Ctrl+F focuses the box, Escape clears it. Both are ignored while the
    -- window is hidden so they never swallow the key in-game.
    win.Janitor:Add(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or not win.Visible then return end
        if input.KeyCode == Enum.KeyCode.F
            and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
                or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
            searchBox:CaptureFocus()
        elseif input.KeyCode == Enum.KeyCode.Escape
            and win.SearchQuery ~= "" then
            searchBox.Text = ""
            searchBox:ReleaseFocus()
        end
    end))
    table.insert(self.Windows, win)
    win:SetVisible(options.AutoShow ~= false)
    return win
end

function Window:SetVisible(visible)
    self.Visible = visible
    local lib = self.Library
    if visible then
        self.Root.Visible, self.Shadow.Visible = true, true
        self.Root.BackgroundTransparency = 1
        self.Scale.Scale = (self.FitScale or 1) * 0.985
        lib:_tween(self.Root, MOTION.Normal, { BackgroundTransparency = 0 })
        lib:_tween(self.Scale, MOTION.Normal, { Scale = self.FitScale or 1 })
        lib:_tween(self.Shadow, MOTION.Normal, { ImageTransparency = 0.4 })
    else
        lib:_tween(self.Root, MOTION.Fast, { BackgroundTransparency = 1 })
        lib:_tween(self.Scale, MOTION.Fast, { Scale = (self.FitScale or 1) * 0.985 })
        lib:_tween(self.Shadow, MOTION.Fast, { ImageTransparency = 1 })
        task.delay(lib.MotionEnabled and 0.12 or 0, function()
            if not self.Visible then self.Root.Visible, self.Shadow.Visible = false, false end
        end)
    end
end

function Window:Destroy()
    self.Janitor:Clean()
    if self.Root then self.Root:Destroy() end
    if self.Shadow then self.Shadow:Destroy() end
end

