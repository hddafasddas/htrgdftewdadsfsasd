function State.AutoMix.GetCameraBasis(Root)
local Camera = Workspace.CurrentCamera
local Look = Camera and Camera.CFrame.LookVector or (Root and Root.CFrame.LookVector) or Vector3.zAxis
local Right = Camera and Camera.CFrame.RightVector or (Root and Root.CFrame.RightVector) or Vector3.xAxis
local Forward = Vector3.new(Look.X, 0, Look.Z)
local Side = Vector3.new(Right.X, 0, Right.Z)
if Forward.Magnitude <= 0.001 and Root then Forward = Vector3.new(Root.CFrame.LookVector.X, 0, Root.CFrame.LookVector.Z) end
if Side.Magnitude <= 0.001 and Root then Side = Vector3.new(Root.CFrame.RightVector.X, 0, Root.CFrame.RightVector.Z) end
if Forward.Magnitude > 0.001 then Forward = Forward.Unit end
if Side.Magnitude > 0.001 then Side = Side.Unit end
return Forward, Side
end

function State.AutoMix.ApplyShiftLockSpin(Root, Target)
if not Root or not Root.Parent or Root.Anchored then return end
local Forward = State.AutoMix.GetCameraBasis(Root)
if Forward.Magnitude <= 0.001 then return end
-- Rebuild from camera yaw every frame. Shift lock may rewrite root yaw, so an
-- incremental rotation alone would be lost before the next rendered frame.
local Position = Root.Position
Root.CFrame = CFrame.lookAt(Position, Position + Forward) * CFrame.Angles(0, Target or 0, 0)
end

