if Candidate then
local CandidateXZ = Vector3.new(Candidate.Position.X, 0, Candidate.Position.Z)
local Distance = (CandidateXZ - OriginXZ).Magnitude
if Distance < BestDistance then
Goal, BestDistance = Candidate, Distance
end
end
end
end

