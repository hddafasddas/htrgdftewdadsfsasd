State.BallAssist.ColliderOriginalCanCollide[Part] = nil
end

function State.BallAssist.RestoreColliderTouch(Part)
local Original = State.BallAssist.ColliderOriginalCanTouch[Part]
if Original ~= nil and Part and Part.Parent then
pcall(function() Part.CanTouch = Original end)
end
State.BallAssist.ColliderOriginalCanTouch[Part] = nil
end

function State.BallAssist.RestoreBallColliders()
local RestoreParts = {}
for Part in pairs(State.BallAssist.ColliderOriginalCanCollide) do
RestoreParts[Part] = true
end
for Part in pairs(State.BallAssist.ColliderOriginalCanTouch) do
RestoreParts[Part] = true
end
for Part in pairs(RestoreParts) do
State.BallAssist.RestoreColliderCollision(Part)
State.BallAssist.RestoreColliderTouch(Part)
end
table.clear(State.BallAssist.ColliderOriginalCanCollide)
table.clear(State.BallAssist.ColliderOriginalCanTouch)
State.BallAssist.ColliderManagedCount = 0
end

function State.BallAssist.ApplyColliderState(Part, ForceCollision, ForceTouch)
if not (Part and Part.Parent and Part:IsA('BasePart')) then return end

if ForceCollision then
if State.BallAssist.ColliderOriginalCanCollide[Part] == nil then
State.BallAssist.ColliderOriginalCanCollide[Part] = Part.CanCollide
end
if not Part.CanCollide then Part.CanCollide = true end
else
State.BallAssist.RestoreColliderCollision(Part)
end

if ForceTouch then
if State.BallAssist.ColliderOriginalCanTouch[Part] == nil then
State.BallAssist.ColliderOriginalCanTouch[Part] = Part.CanTouch
end
if not Part.CanTouch then Part.CanTouch = true end
else
State.BallAssist.RestoreColliderTouch(Part)
end
end

function State.BallAssist.GetBallHolder(Object)
if not Object then return nil end
for _, Player in ipairs(Players:GetPlayers()) do
local Character = Player.Character
if Character then
local Ok, IsHeld = pcall(function()
return Object:IsDescendantOf(Character)
end)
if Ok and IsHeld then return Player end
end
end
return nil
end

function State.BallAssist.CollectColliderParts()
local Parts = {}
local Containers = {}

local function AddPart(Part)
if Part and Part:IsA('BasePart') then Parts[Part] = true end
end

local function AddContainer(Container)
if not Container or Containers[Container] then return end
Containers[Container] = true
if Container:IsA('BasePart') then AddPart(Container) end
for _, Object in ipairs(Container:GetDescendants()) do
if Object:IsA('BasePart') then AddPart(Object) end
end
end

for _, Ball in ipairs(CollectionService:GetTagged('BallHandle')) do
AddPart(Ball)
AddContainer(State.BallAssist.GetBasketballContainer(Ball))
end
for Candidate in pairs(State.BallAssist.Candidates) do
if Candidate and Candidate.Parent then
AddPart(Candidate)
AddContainer(State.BallAssist.GetBasketballContainer(Candidate))
end
end
for _, Player in ipairs(Players:GetPlayers()) do
local Character = Player.Character
AddContainer(Character and safe_find(Character, 'Basketball'))
end
for _, Object in ipairs(Workspace:GetChildren()) do
if Object.Name == 'Basketball' then AddContainer(Object) end
end
return Parts
end

function State.BallAssist.ProtectColliderBall(Ball, Now)
if not State.BallAssist.ColliderEnabled or not Ball then return end
Now = tonumber(Now) or os.clock()
local Grace = math.clamp(
tonumber(State.BallAssist.ColliderPossessionGrace) or 0.8, 0.2, 2)
local ProtectedUntil = Now + Grace
local Container = State.BallAssist.GetBasketballContainer(Ball)
local function Protect(Part)
if not (Part and Part:IsA('BasePart')) then return end
State.BallAssist.ColliderProtectedUntil[Part] = math.max(
State.BallAssist.ColliderProtectedUntil[Part] or 0,
ProtectedUntil)
State.BallAssist.RestoreColliderCollision(Part)
end

Protect(Ball)
if Container then
for _, Object in ipairs(Container:GetDescendants()) do
Protect(Object)
end
end
end

function State.BallAssist.StepBallColliders(ForceScan)
local Now = os.clock()
local HasLocalBall = State.BallAssist.HasLocalBall()
if State.BallAssist.ColliderLastLocalPossession == nil then
State.BallAssist.ColliderLastLocalPossession = HasLocalBall
elseif State.BallAssist.ColliderLastLocalPossession ~= HasLocalBall then
State.BallAssist.ColliderLastLocalPossession = HasLocalBall
State.BallAssist.ColliderGraceUntil = Now + math.clamp(
tonumber(State.BallAssist.ColliderPossessionGrace) or 0.8, 0.2, 2)
State.BallAssist.ColliderLastScanAt = 0
end

if not State.BallAssist.ColliderEnabled then
if next(State.BallAssist.ColliderOriginalCanCollide) ~= nil
or next(State.BallAssist.ColliderOriginalCanTouch) ~= nil then
State.BallAssist.RestoreBallColliders()
end
State.BallAssist.ColliderStatus = 'OFF'
return
end

local Interval = math.clamp(
tonumber(State.BallAssist.ColliderScanInterval) or 0.3, 0.1, 1)
if not ForceScan and Now - State.BallAssist.ColliderLastScanAt < Interval then
return
end
State.BallAssist.ColliderLastScanAt = Now

local Character = LP.Character
local LocalBasketball = Character and safe_find(Character, 'Basketball')
if LocalBasketball then
local Grace = math.clamp(
tonumber(State.BallAssist.ColliderPossessionGrace) or 0.8, 0.2, 2)
local ProtectedUntil = Now + Grace
local function RestoreLocalPart(Part)
if not (Part and Part:IsA('BasePart')) then return end
State.BallAssist.ColliderProtectedUntil[Part] = ProtectedUntil
State.BallAssist.RestoreColliderCollision(Part)
State.BallAssist.RestoreColliderTouch(Part)
end
RestoreLocalPart(LocalBasketball)
for _, Object in ipairs(LocalBasketball:GetDescendants()) do
RestoreLocalPart(Object)
end
end

local ManagedCount = 0
for Part in pairs(State.BallAssist.CollectColliderParts()) do
if Part and Part.Parent then
local Holder = State.BallAssist.GetBallHolder(Part)
local ProtectedUntil = State.BallAssist.ColliderProtectedUntil[Part] or 0
local Protected = ProtectedUntil > Now
if not Protected and ProtectedUntil > 0 then
State.BallAssist.ColliderProtectedUntil[Part] = nil
end
if Holder == LP or Protected then
State.BallAssist.ApplyColliderState(Part, false, Holder ~= LP)
elseif Holder then
State.BallAssist.ApplyColliderState(Part, false, true)
ManagedCount += 1
else
State.BallAssist.ApplyColliderState(
Part, State.BallAssist.IsLooseBall(Part), true)
ManagedCount += 1
end
end
end

State.BallAssist.ColliderManagedCount = ManagedCount
if Now < State.BallAssist.ColliderGraceUntil then
State.BallAssist.ColliderStatus = 'POSSESSION GRACE'
elseif ManagedCount > 0 then
State.BallAssist.ColliderStatus = 'ACTIVE'
else
State.BallAssist.ColliderStatus = 'WAITING FOR BALL'
end
end

function State.BallAssist.TryTouch(Ball, TouchPart, AllowNudge)
if not (Ball and TouchPart and Ball.Parent and TouchPart.Parent) then return false end
local Now = os.clock()
local Previous = State.BallAssist.LastTouchAt[Ball] or 0
if Now - Previous < State.BallAssist.TouchCooldown then return false end
State.BallAssist.LastTouchAt[Ball] = Now
State.BallAssist.ProtectColliderBall(Ball, Now)

local Method = State.BallAssist.BallReachMethod or 'firetouchinterest'

if Method == 'Touched Event' then
-- Connect to the ball Touched event locally and nudge the ball in range.
local Connection
Connection = Ball.Touched:Connect(function(Hit)
if Hit == TouchPart then
Connection:Disconnect()
end
end)
pcall(function()
local Offset = TouchPart.Position - Ball.Position
if Offset.Magnitude > 0.01 then
Ball.AssemblyLinearVelocity = Offset.Unit * math.min(80, 24 + Offset.Magnitude * 8)
end
end)
task.delay(0.5, function() pcall(function() Connection:Disconnect() end) end)
return true
end

if Method == 'GetPartsInPart' then
-- Use spatial overlap query to detect contact and nudge the ball.
pcall(function()
local Overlap = OverlapParams.new()
Overlap.FilterType = Enum.RaycastFilterType.Include
Overlap.FilterDescendantsInstances = { Ball }
local Parts = Workspace:GetPartsInPart(TouchPart, Overlap)
if #Parts > 0 then
local Offset = TouchPart.Position - Ball.Position
if Offset.Magnitude > 0.01 then
Ball.AssemblyLinearVelocity = Offset.Unit * math.min(80, 24 + Offset.Magnitude * 8)
end
end
end)
return true
end

if Method == 'Size Enlarge' then
-- Temporarily enlarge the local hitbox to increase touch range.
pcall(function()
local OriginalSize = TouchPart.Size
TouchPart.Size = OriginalSize + Vector3.new(2, 2, 2)
task.delay(0.1, function()
if TouchPart and TouchPart.Parent then
TouchPart.Size = OriginalSize
end
end)
end)
return true
end

-- Default: firetouchinterest (executor touch synthesis).
if type(firetouchinterest) == 'function' then
local Success = pcall(function()
firetouchinterest(TouchPart, Ball, 0)
task.defer(function()
if Ball and Ball.Parent and TouchPart and TouchPart.Parent then
pcall(firetouchinterest, TouchPart, Ball, 1)
end
end)
end)
if Success then return true end
end

if AllowNudge then
pcall(function()
local Offset = TouchPart.Position - Ball.Position
if Offset.Magnitude > 0.01 then
Ball.AssemblyLinearVelocity = Offset.Unit * math.min(80, 24 + Offset.Magnitude * 8)
end
end)
end
return false
end

function State.BallAssist.StepHeldReach(ReachRadius)
if not State.BallAssist.ReachEnabled then return end
local LocalCharacter = LP.Character
if not LocalCharacter then return end

for _, TargetPlayer in ipairs(Players:GetPlayers()) do
local TargetCharacter = TargetPlayer ~= LP and TargetPlayer.Character or nil
local TargetHumanoid = TargetCharacter and TargetCharacter:FindFirstChildOfClass('Humanoid')
local TargetTorso = TargetCharacter and (
safe_find(TargetCharacter, 'Torso')
or safe_find(TargetCharacter, 'UpperTorso')
or safe_find(TargetCharacter, 'HumanoidRootPart')
)

if TargetCharacter and TargetHumanoid and TargetHumanoid.Health > 0 and TargetTorso then
local TouchPart, Distance = State.BallAssist.GetNearestLocalPart(TargetTorso)
if TouchPart and Distance and Distance <= ReachRadius then
local Seen = {}
for _, Child in ipairs(TargetCharacter:GetChildren()) do
if Child:IsA('Tool') or Child:IsA('Folder')
or (Child:IsA('Model') and Child.Name == 'Basketball') then
for _, Object in ipairs(Child:GetDescendants()) do
if State.BallAssist.IsBallPart(Object) and not Seen[Object] then
Seen[Object] = true
State.BallAssist.TryTouch(Object, TouchPart, false)
end
end
elseif State.BallAssist.IsBallPart(Child) and not Seen[Child] then
Seen[Child] = true
State.BallAssist.TryTouch(Child, TouchPart, false)
end
end
end
end
end
end

function State.BallAssist.Step(DeltaTime)
if not State.Active or not (State.BallAssist.ReachEnabled or State.BallAssist.MagEnabled) then return end
local Now = os.clock()
local RunReachScan = State.BallAssist.ReachEnabled
and Now - (State.BallAssist.ReachScanAt or 0) >= 0.075
if RunReachScan then State.BallAssist.ReachScanAt = Now end
local MagActive = State.BallAssist.MagEnabled
and (not CONFIG.BallMagHoldMode or State.BallAssist.MagHoldActive == true)
if not MagActive and not RunReachScan then return end

local HasLocalBall = State.BallAssist.HasLocalBall()

local Character = LP.Character
local HumanoidObject = Character and safe_find(Character, 'Humanoid')
local Root = Character and safe_find(Character, 'HumanoidRootPart')
if not (HumanoidObject and Root) or HumanoidObject.Health <= 0 then return end

local ReachRadius = math.clamp(tonumber(State.BallAssist.ReachRadius) or 10, 2, 30)
local MagRadius = math.clamp(tonumber(State.BallAssist.MagRadius) or 35, 4, 80)
local MagSpeed = math.clamp(tonumber(State.BallAssist.MagSpeed) or 85, 10, 200)
State.BallAssist.SmartReachActive = false
if CONFIG.SmartReach then
local NearestDefender = math.huge
for _, OtherPlayer in ipairs(Players:GetPlayers()) do
if OtherPlayer ~= LP and OtherPlayer.Character then
local OtherRoot = safe_find(OtherPlayer.Character, 'HumanoidRootPart')
if OtherRoot then
local DefenderDistance = (OtherRoot.Position - Root.Position).Magnitude
if DefenderDistance < NearestDefender then NearestDefender = DefenderDistance end
end
end
end
if NearestDefender <= (tonumber(CONFIG.SmartReachDistance) or 14) then
State.BallAssist.SmartReachActive = true
ReachRadius = math.min(ReachRadius, 8)
MagRadius = math.min(MagRadius, 12)
MagSpeed = math.min(MagSpeed, 60)
end
end
local Target = Root.Position + Root.CFrame.LookVector * 1.25 + Vector3.new(0, 0.15, 0)

if RunReachScan then State.BallAssist.StepHeldReach(ReachRadius) end

for Ball in pairs(State.BallAssist.Candidates) do
if not (Ball and Ball.Parent) then
State.BallAssist.Candidates[Ball] = nil
elseif State.BallAssist.IsLooseBall(Ball)
and (not HasLocalBall or State.BallAssist.IsPracticeBall(Ball)) then
local Offset = Target - Ball.Position
local Distance = Offset.Magnitude

if MagActive and Distance <= MagRadius and Distance > 0.05
and State.BallAssist.CanDirectMove(Ball) then
local Method = State.BallAssist.BallMagMethod or 'Assembly Linear Velocity'
pcall(function()
if Method == 'CFrame Pull' then
-- Directly lerp the ball toward the target without velocity.
local Alpha = math.clamp((tonumber(DeltaTime) or 0) * 8, 0, 0.32)
local Rotation = Ball.CFrame - Ball.CFrame.Position
Ball.CFrame = CFrame.new(Ball.Position:Lerp(Target, Alpha)) * Rotation
Ball.AssemblyAngularVelocity = Vector3.zero
elseif Method == 'BodyVelocity' then
-- Attach a BodyVelocity to the ball for constraint-based pull.
local Existing = Ball:FindFirstChild('GEBallMagVelocity')
if not Existing then
Existing = Instance.new('BodyVelocity')
Existing.Name = 'GEBallMagVelocity'
Existing.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
Existing.Parent = Ball
end
Existing.Velocity = Offset.Unit * math.min(MagSpeed, math.max(20, Distance * 7))
Ball.AssemblyAngularVelocity *= 0.35
else
-- Default: Assembly Linear Velocity.
local PullVelocity = Offset.Unit * math.min(MagSpeed, math.max(20, Distance * 7))
Ball.AssemblyLinearVelocity = PullVelocity
Ball.AssemblyAngularVelocity *= 0.35

local Alpha = math.clamp((tonumber(DeltaTime) or 0) * 8, 0, 0.32)
local Rotation = Ball.CFrame - Ball.CFrame.Position
Ball.CFrame = CFrame.new(Ball.Position:Lerp(Target, Alpha)) * Rotation
end
end)
end

if RunReachScan and Distance <= ReachRadius then
State.BallAssist.TryTouch(Ball, Root, true)
elseif MagActive and Distance <= math.max(4.5, ReachRadius) then
State.BallAssist.TryTouch(Ball, Root, true)
end
end
end
end

function State.BallAssist.SetReach(Enabled)
State.BallAssist.ReachEnabled = Enabled == true
CONFIG.BallReach = State.BallAssist.ReachEnabled
State.BallAssist.ReachScanAt = 0
end

function State.BallAssist.SetReachRadius(Value)
Value = math.clamp(tonumber(Value) or 10, 2, 30)
State.BallAssist.ReachRadius = Value
CONFIG.BallReachRadius = Value
end

function State.BallAssist.SetAntiReach(Enabled)
State.BallAssist.AntiReachEnabled = Enabled == true
CONFIG.AntiReach = State.BallAssist.AntiReachEnabled
if not State.BallAssist.AntiReachEnabled then
State.BallAssist.ResetAntiReachRuntime()
else
State.BallAssist.AntiReachStatus = 'IDLE'
State.BallAssist.AntiReachNoStealRequestedAt = 0
State.BallAssist.AntiReachNoStealCheckedAt = 0
State.BallAssist.AntiReachNoStealCachedStatus = 'IDLE'
pcall(State.BallAssist.StepAntiReach)
end
end

function State.BallAssist.SetMag(Enabled)
State.BallAssist.MagEnabled = Enabled == true
CONFIG.BallMag = State.BallAssist.MagEnabled
end

function State.BallAssist.SetMagRadius(Value)
Value = math.clamp(tonumber(Value) or 35, 4, 80)
State.BallAssist.MagRadius = Value
CONFIG.BallMagRadius = Value
end

function State.BallAssist.SetMagSpeed(Value)
Value = math.clamp(tonumber(Value) or 85, 10, 200)
State.BallAssist.MagSpeed = Value
CONFIG.BallMagSpeed = Value
end

function State.BallAssist.SetBallColliders(Enabled)
State.BallAssist.ColliderEnabled = Enabled == true
CONFIG.BallColliders = State.BallAssist.ColliderEnabled
State.BallAssist.ColliderLastScanAt = 0
State.BallAssist.ColliderLastLocalPossession = nil
if State.BallAssist.ColliderEnabled then
State.BallAssist.ColliderStatus = 'SCANNING'
State.BallAssist.DiscoverExistingCandidates()
pcall(State.BallAssist.StepBallColliders, true)
else
State.BallAssist.ColliderStatus = 'OFF'
State.BallAssist.RestoreBallColliders()
table.clear(State.BallAssist.ColliderProtectedUntil)
end
end

function State.BallAssist.SetColliderScanInterval(Value)
Value = math.clamp(tonumber(Value) or 0.3, 0.1, 1)
State.BallAssist.ColliderScanInterval = Value
CONFIG.BallColliderScanInterval = Value
State.BallAssist.ColliderLastScanAt = 0
end

function State.BallAssist.SetColliderPossessionGrace(Value)
Value = math.clamp(tonumber(Value) or 0.8, 0.2, 2)
State.BallAssist.ColliderPossessionGrace = Value
CONFIG.BallColliderPossessionGrace = Value
end

function State.BallAssist.ArmTipOff()
if not (State.Active and State.BallAssist.TipOffEnabled) then return end
State.BallAssist.TipOffArmed = true
State.BallAssist.TipOffArmedAt = os.clock()
State.BallAssist.TipOffEndsAt = 0
State.BallAssist.TipOffBallSeen = false
State.BallAssist.TipOffLastJumpAt = 0
State.BallAssist.TipOffStatus = 'ARMED'
State.BallAssist.DiscoverExistingCandidates()
end

function State.BallAssist.ResetTipOff(Status)
if State.Runtime then State.Runtime.ReleaseMovement('TipOff') end
State.BallAssist.TipOffArmed = false
State.BallAssist.TipOffArmedAt = 0
State.BallAssist.TipOffBallSeen = false
State.BallAssist.TipOffEndsAt = 0
State.BallAssist.TipOffLastJumpAt = 0
State.BallAssist.TipOffStatus = Status
or (State.BallAssist.TipOffEnabled and 'WAITING FOR MATCH' or 'OFF')
end

function State.BallAssist.SetTipOff(Enabled)
State.BallAssist.TipOffEnabled = Enabled == true
CONFIG.AutoTipOff = State.BallAssist.TipOffEnabled
State.BallAssist.ResetTipOff()
end

function State.BallAssist.GetTipOffBall(Root)
local BestBall, BestDistance
for Ball in pairs(State.BallAssist.Candidates) do
if Ball and Ball.Parent and State.BallAssist.IsLooseBall(Ball)
and not State.BallAssist.IsPracticeBall(Ball) then
local Distance = (Ball.Position - Root.Position).Magnitude
if not BestDistance or Distance < BestDistance then
BestBall, BestDistance = Ball, Distance
end
end
end
return BestBall, BestDistance
end

function State.BallAssist.StepTipOff()
local InMatch = safe_get_attribute(LP, 'Ingame') == true
or State.Movement.IsInMatch()
if InMatch and not State.BallAssist.TipOffLastMatchState then
State.BallAssist.ArmTipOff()
elseif not InMatch and State.BallAssist.TipOffLastMatchState then
State.BallAssist.ResetTipOff()
end
State.BallAssist.TipOffLastMatchState = InMatch

if not (State.BallAssist.TipOffEnabled and State.BallAssist.TipOffArmed) then return end
if not InMatch then return end
if State.BallAssist.HasLocalBall() then
State.BallAssist.ResetTipOff('WON TIP OFF')
return
end
local Now = os.clock()
if State.BallAssist.TipOffBallSeen then
if State.BallAssist.TipOffEndsAt > 0 and Now >= State.BallAssist.TipOffEndsAt then
State.BallAssist.ResetTipOff('TIP OFF ENDED')
return
end
else
local Grace = math.clamp(tonumber(CONFIG.AutoTipOffArmGrace) or 25, 5, 60)
if Now - State.BallAssist.TipOffArmedAt >= Grace then
State.BallAssist.ResetTipOff('NO TIP OFF BALL')
return
end
end

local Character = LP.Character
local HumanoidObject = Character and safe_find(Character, 'Humanoid')
local Root = Character and safe_find(Character, 'HumanoidRootPart')
if not (HumanoidObject and Root) or HumanoidObject.Health <= 0
or HumanoidObject.PlatformStand then return end

local Ball, Distance = State.BallAssist.GetTipOffBall(Root)
if not Ball then
if State.BallAssist.TipOffBallSeen then
State.BallAssist.TipOffStatus = 'BALL GONE'
else
State.BallAssist.TipOffStatus = 'COUNTDOWN | WAITING FOR BALL'
end
return
end

if not State.BallAssist.TipOffBallSeen then
State.BallAssist.TipOffBallSeen = true
State.BallAssist.TipOffEndsAt = Now
+ math.clamp(tonumber(CONFIG.AutoTipOffWindow) or 7, 2, 12)
end

local ApproachDistance = math.clamp(
tonumber(CONFIG.AutoTipOffApproachDistance) or 38, 12, 60)
local Flight = math.clamp((Ball.Position.Y - Root.Position.Y) / math.max(8, math.abs(Ball.AssemblyLinearVelocity.Y) + 8), 0, 0.7)
local Predicted = Ball.Position + Ball.AssemblyLinearVelocity * Flight + Vector3.new(0, -Workspace.Gravity * Flight * Flight * 0.5, 0)
local Horizontal = Vector3.new(Predicted.X - Root.Position.X, 0, Predicted.Z - Root.Position.Z)
if Distance <= ApproachDistance and Horizontal.Magnitude > 0.7 then
if State.Runtime.AcquireMovement('TipOff') then HumanoidObject:Move(Horizontal.Unit, false) end
end

local CatchRadius = math.clamp(
tonumber(CONFIG.AutoTipOffCatchRadius) or 9, 4, 15)
if Distance <= CatchRadius then
State.BallAssist.TryTouch(Ball, Root, false)
end

local JumpDistance = math.clamp(
tonumber(CONFIG.AutoTipOffJumpDistance) or 10, 5, 18)
local BallHeight = Ball.Position.Y - Root.Position.Y
if Horizontal.Magnitude <= JumpDistance and BallHeight >= 1.5
and os.clock() - State.BallAssist.TipOffLastJumpAt >= 0.45
and HumanoidObject.FloorMaterial ~= Enum.Material.Air then
HumanoidObject.Jump = true
pcall(function()
HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)
end)
State.BallAssist.TipOffLastJumpAt = os.clock()
State.BallAssist.TipOffStatus = 'JUMPING FOR BALL'
else
State.BallAssist.TipOffStatus = string.format('CHASING | %.1f', Distance)
end
end

State.BallAssist.DiscoverExistingCandidates()

local Signals = {}
local function GiveSignal(connection)
table.insert(Signals, connection)
return connection
end

local function BindLocalBallColliderSafety(Character)
if not Character then return end
GiveSignal(Character.ChildAdded:Connect(function(Object)
if Object.Name ~= 'Basketball'
and not (Object:IsA('BasePart')
and CollectionService:HasTag(Object, 'BallHandle')) then
return
end
if not State.BallAssist.ColliderEnabled then return end

local Now = os.clock()
State.BallAssist.ColliderGraceUntil = Now + math.clamp(
tonumber(State.BallAssist.ColliderPossessionGrace) or 0.8, 0.2, 2)
State.BallAssist.ColliderLastLocalPossession = true
State.BallAssist.ColliderLastScanAt = 0
task.defer(function()
if State.Active and State.BallAssist.ColliderEnabled then
pcall(State.BallAssist.StepBallColliders, true)
end
end)
end))
end

BindLocalBallColliderSafety(LP.Character)

State.BallAssist.TipOffLastMatchState = State.Movement.IsInMatch()
GiveSignal(LP:GetAttributeChangedSignal('Ingame'):Connect(function()
local Ingame = safe_get_attribute(LP, 'Ingame') == true
State.BallAssist.TipOffLastMatchState = Ingame
if Ingame then
State.BallAssist.ArmTipOff()
else
State.BallAssist.ResetTipOff()
end
end))

GiveSignal(UserInputService.JumpRequest:Connect(function()
if not (State.Active and State.Movement.InfiniteJumpEnabled) then return end
local _, HumanoidObject = State.Movement.GetRig()
if HumanoidObject and HumanoidObject.Health > 0 and not HumanoidObject.Sit then
local Method = State.Movement.InfiniteJumpMethod or 'JumpRequest'
if Method == 'ChangeState' then
-- Directly fire the Humanoid state machine.
pcall(function()
HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping)
end)
elseif Method == 'Key Simulation' then
-- Simulate a Space keypress where the executor exposes input functions.
if type(keypress) == 'function' and type(keyrelease) == 'function' then
pcall(function()
keypress(Enum.KeyCode.Space)
task.delay(0.05, function()
pcall(keyrelease, Enum.KeyCode.Space)
end)
end)
else
pcall(function()
VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
task.delay(0.05, function()
VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end)
end)
end
else
-- Default: set Jump property and fire ChangeState.
HumanoidObject.Jump = true
pcall(function() HumanoidObject:ChangeState(Enum.HumanoidStateType.Jumping) end)
end
end
end))

GiveSignal(RunService.Stepped:Connect(WYNF_JIT(function()
if State.Active and State.Movement.NoclipEnabled then
pcall(State.Movement.ApplyNoclip)
end
end)))

GiveSignal(RunService.Heartbeat:Connect(WYNF_JIT(function(DeltaTime)
if not State.Active then return end
if State.Movement.WalkSpeedEnabled then pcall(State.Movement.ApplyWalkSpeed, DeltaTime) end
if State.Movement.JumpPowerEnabled then pcall(State.Movement.ApplyJumpPower) end
if State.Movement.AirWalkEnabled then pcall(State.Movement.RefreshAirWalk) end
if State.Movement.BodyCollidersEnabled
or next(State.Movement.BodyColliderOriginals) ~= nil then
