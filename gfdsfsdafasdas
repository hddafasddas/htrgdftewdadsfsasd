function State.AutoOffense.EvaluateCutoff(Root, DefenderRoot, Forward)
local Now = os.clock()
if not (Root and DefenderRoot and Forward) then
return Now < State.AutoOffense.TurnAroundUntil
end

local Offset = DefenderRoot.Position - Root.Position
local Flat = Vector3.new(Offset.X, 0, Offset.Z)
local Distance = Flat.Magnitude
if Distance < 0.05 then return Now < State.AutoOffense.TurnAroundUntil end
local Direction = Flat.Unit

local Closing = 0
local Ok, Velocity = pcall(function() return DefenderRoot.AssemblyLinearVelocity end)
if Ok and typeof(Velocity) == 'Vector3' then
Closing = Vector3.new(Velocity.X, 0, Velocity.Z):Dot(-Direction)
end
State.AutoOffense.LastClosing = Closing

-- The turn-around distance is not a fixed radius: it grows with how fast the
-- defender is actually closing on us, so a sprinting defender trips it early
-- while a stationary or retreating one lets us keep working.
local Base = State.AutoOffense.CutoffDistance
local Lead = math.max(0, Closing) * State.AutoOffense.CutoffClosingLead
local Effective = Base + math.min(Lead, Base)
if Closing < 0 then
Effective = math.max(Base * 0.55, Effective + Closing * 0.18)
end
State.AutoOffense.EffectiveCutoff = Effective

local Facing = Direction:Dot(Forward) >= State.AutoOffense.CutoffDot
local InLane = Distance <= Effective and Facing
local ClosingTrip = InLane and Distance > Base
local Shielded = safe_get_attribute(LP, 'NoSteal')
local StealPosition = not Shielded
and Distance <= math.max(State.AutoOffense.StealThreatDistance, Effective * 0.8)
and Closing >= State.AutoOffense.CutoffClosingSpeed

if InLane or StealPosition then
State.AutoOffense.TurnAroundUntil = Now + State.AutoOffense.TurnAroundHold
State.AutoOffense.CutoffReason = InLane
and (ClosingTrip and 'CLOSING' or 'CUT OFF')
or 'STEAL THREAT'
return true
end

if Now < State.AutoOffense.TurnAroundUntil then return true end
State.AutoOffense.CutoffReason = nil
return false
end

function State.AutoOffense.GetBallSideSign(Root, Right)
if Root and Right then
local Basketball = GetHeldBasketballModel(LP)
local Ball = Basketball and safe_find(Basketball, 'Ball')
if Ball then
local Side = (Ball.Position - Root.Position):Dot(Right)
if math.abs(Side) > 0.2 then return Side > 0 and 1 or -1 end
end
end
local Hand = State.AutoBody.CurrentHand
if Hand == 'R' then return 1 end
if Hand == 'L' then return -1 end
