local function GetLocalBallHandle()
local Now = os.clock()
State.Cosmetics.Runtime.LastBallResolveAt = Now
local Character = LP.Character
if Character then
local Root = Character:FindFirstChild('HumanoidRootPart')
local Basketball = Character:FindFirstChild('Basketball')
if Basketball then
-- Prefer the ball inside our own held tool. The previous nearest-ball scan
-- could select every nearby player's handle and skin all of them.
local Held = State.BallAssist.GetCanonicalBallPart(Basketball)
if Held then
State.Cosmetics.Runtime.LastBall = Held
State.Cosmetics.Runtime.LastLocalBallSeenAt = Now
return Held
end
end

-- Keep the released local shot skinned briefly while it is in flight. This
-- path is only armed by actually holding a ball first, so joining near a court
-- cannot accidentally claim somebody else's ball.
local LastHeldAt = State.Cosmetics.Runtime.LastLocalBallSeenAt or 0
if Root and Now - LastHeldAt <= 4 then
local Cached = State.Cosmetics.Runtime.LastBall
if Cached and Cached.Parent and not Cached:IsDescendantOf(Character) then
local OwnedByOther = false
for _, Player in ipairs(Players:GetPlayers()) do
if Player ~= LP and Player.Character and Cached:IsDescendantOf(Player.Character) then
OwnedByOther = true
break
end
end
if not OwnedByOther then return Cached end
end
local Closest, ClosestDistance
for _, Ball in ipairs(CollectionService:GetTagged('BallHandle')) do
if Ball:IsA('BasePart') and Ball.Parent then
local OwnedByOther = false
for _, Player in ipairs(Players:GetPlayers()) do
if Player ~= LP and Player.Character and Ball:IsDescendantOf(Player.Character) then
OwnedByOther = true
break
end
end
if not OwnedByOther then
local Distance = (Ball.Position - Root.Position).Magnitude
if Distance <= 35 and (not ClosestDistance or Distance < ClosestDistance) then
Closest, ClosestDistance = Ball, Distance
end
end
end
end
if Closest then
State.Cosmetics.Runtime.LastBall = Closest
return Closest
end
end
end
State.Cosmetics.Runtime.LastBall = nil
return nil
end

