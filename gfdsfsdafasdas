function State.AutoBody.RepulsionDirection(Root)
local Now = os.clock()
if State.AutoBody.RepulsionRoot == Root
and Now - State.AutoBody.RepulsionCachedAt < 0.08 then
return State.AutoBody.RepulsionCache
end

local Range = math.max(4, tonumber(CONFIG.AutoBodyRange) or 25)
local Total = Vector3.new()
local Count = 0
local SharedOpponents = State.CourtContext and State.CourtContext.Get().Opponents or Players:GetPlayers()
for _, Player in ipairs(SharedOpponents) do
if IsGuardOpponent(Player) then
local TargetRoot = GetAutoBodyTargetRig(Player)
if TargetRoot then
local Offset = Root.Position - TargetRoot.Position
local Flat = Vector3.new(Offset.X, 0, Offset.Z)
local Distance = Flat.Magnitude
if Distance > 0.05 and Distance <= Range then
Total = Total + Flat.Unit * (1 / math.max(Distance, 1) ^ 1.5)
Count += 1
end
end
end
end
State.AutoBody.RepulsionRoot = Root
State.AutoBody.RepulsionCachedAt = Now
State.AutoBody.RepulsionCache =
Count > 0 and Total.Magnitude > 0.001 and Total.Unit or nil
return State.AutoBody.RepulsionCache
end

function State.AutoBody.SolveFacing(Root, TargetRoot, Away)
local Direction = Away.Unit
if CONFIG.AutoBodyMultiDefender then
local Blended = State.AutoBody.RepulsionDirection(Root)
if Blended then Direction = Blended end
end

local Mode = CONFIG.AutoBodyMode or 'Shield'
local RimWeight = math.clamp(
(tonumber(CONFIG.AutoBodyRimBlend) or 35) / 100, 0, 1)
if Mode == 'Square Up' then
RimWeight = 1
elseif Mode == 'Drive Lane' then
RimWeight = math.max(RimWeight, 0.75)
end

if RimWeight > 0 then
local RimPosition = State.AutoBody.GetRimPosition()
if RimPosition then
local ToRim = Vector3.new(
RimPosition.X - Root.Position.X,
0,
RimPosition.Z - Root.Position.Z
)
if ToRim.Magnitude > 0.05 then
local Mixed = Direction * (1 - RimWeight)
+ ToRim.Unit * RimWeight
if Mixed.Magnitude > 0.05 then Direction = Mixed.Unit end
end
end
end
return Direction
end

function State.AutoBody.SolveTurnRate(Distance, Root, TargetRoot)
local Rate = math.max(1, tonumber(CONFIG.AutoBodySmoothness) or 18)
local Now = os.clock()
local Closing = 0

if Root and TargetRoot then
local Offset = Root.Position - TargetRoot.Position
local Flat = Vector3.new(Offset.X, 0, Offset.Z)
if Flat.Magnitude > 0.05 then
local Ok, Velocity = pcall(function()
return TargetRoot.AssemblyLinearVelocity
end)
if Ok and typeof(Velocity) == 'Vector3' then
Closing = Vector3.new(Velocity.X, 0, Velocity.Z):Dot(Flat.Unit)
end
end
end
State.AutoBody.ClosingSpeed = Closing

if CONFIG.AutoBodyAdaptiveSmoothing then
local Proximity = math.clamp((14 - Distance) / 10, 0, 1)
local Pressure = math.clamp(Closing / 18, 0, 1)
Rate = Rate * (1 + Proximity * 2 + Pressure)
end

if CONFIG.AutoBodyPanicPivot then
local PanicRange = math.max(2, tonumber(CONFIG.AutoBodyPanicRange) or 6)
local Shielded = safe_get_attribute(LP, 'NoSteal')
if not Shielded and Distance <= PanicRange and Closing >= 5 then
State.AutoBody.PanicUntil = Now + 0.35
end
if (State.AutoBody.PanicUntil or 0) > Now then
Rate = math.max(Rate, 70)
State.AutoBody.Status = 'PANIC PIVOT'
end
end
return Rate
end

