function Section:AddToggle(id, options)
    options = options or {}
    local lib = self.Library
    local row = self:_row(18)

    local box = create("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(14, 14), BackgroundColor3 = lib.Theme.SurfaceAlt,
        BorderSizePixel = 0, Parent = row,
    }, { corner(2), stroke(lib.Theme.BorderSoft) })
    lib:_bind(box, "BackgroundColor3", "SurfaceAlt")

    local fill = create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(0, 0), BackgroundColor3 = lib.Theme.Gold,
        BorderSizePixel = 0, Parent = box,
    }, { corner(1) })
    lib:_bind(fill, "BackgroundColor3", "Gold")

