State.ArcPowerMemory = {}
function State.SelectBestAutoPower(Distance, CurrentPower)
local ArcMemory = State.ArcPowerMemory[CONFIG.SilentMode == 'Low' and 'Low' or 'High']
if ArcMemory and ArcMemory.Power and ArcMemory.Power <= 85
and os.clock() - (ArcMemory.At or 0) < 240 then
local ArcMin = MinRangeForPower[ArcMemory.Power]
local ArcMax = MaxRangeForPower[ArcMemory.Power]
if ArcMin and ArcMax and Distance >= ArcMin and Distance <= ArcMax then
return ArcMemory.Power
end
end
local BestPower
for Power, Maximum in pairs(MaxRangeForPower) do
local Minimum = MinRangeForPower[Power]
if Power <= 85 and Minimum and Distance >= Minimum and Distance <= Maximum then
if BestPower == nil
or (CONFIG.AutoPowerPreference == 'Highest' and Power > BestPower)
or (CONFIG.AutoPowerPreference == 'Lowest' and Power < BestPower)
or (CONFIG.AutoPowerPreference == 'Closest Current'
and math.abs(Power - CurrentPower) < math.abs(BestPower - CurrentPower)) then
BestPower = Power
end
end
end
return BestPower
end

