local function SetRangeScreenTint(InRange)
InRange = CONFIG.RangeScreenTintEnabled and InRange == true
if not InRange and not RangeScreenTint.Group then return end
if InRange and not InitializeRangeScreenTint() then return end
if RangeScreenTint.TargetVisible == InRange then return end

