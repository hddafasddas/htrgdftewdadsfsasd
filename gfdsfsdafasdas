RangeScreenTint.Serial += 1
local Serial = RangeScreenTint.Serial
CancelRangeScreenTintTween()

local Group = RangeScreenTint.Group
local Correction = RangeScreenTint.ColorCorrection
if not (Group and Group.Parent and Correction and Correction.Parent) then return end

if InRange then
Group.Visible = true
Correction.Enabled = true

local Settled = math.clamp(
tonumber(CONFIG.RangeScreenTintTransparency) or 0.12,
0.02,
0.64
)
local Entry = math.max(0, Settled - 0.10)
local InTime = math.max(0.01, tonumber(CONFIG.RangeScreenTintInTime) or 0.08)
local SettleTime = math.max(0.01, tonumber(CONFIG.RangeScreenTintSettleTime) or 0.10)

RangeScreenTint.GroupTween = TweenService:Create(
Group,
TweenInfo.new(InTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
{ GroupTransparency = Entry }
)
RangeScreenTint.CorrectionTween = TweenService:Create(
Correction,
TweenInfo.new(InTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
{
Saturation = -1,
Contrast = 0.16,
Brightness = -0.035,
TintColor = Color3.fromRGB(244, 240, 228),
}
)
RangeScreenTint.GroupTween:Play()
RangeScreenTint.CorrectionTween:Play()

task.delay(InTime, function()
if RangeScreenTint.Serial ~= Serial or not RangeScreenTint.TargetVisible then return end
if not (Group and Group.Parent and Correction and Correction.Parent) then return end
CancelRangeScreenTintTween()
RangeScreenTint.GroupTween = TweenService:Create(
Group,
TweenInfo.new(SettleTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
{ GroupTransparency = Settled }
)
RangeScreenTint.CorrectionTween = TweenService:Create(
Correction,
TweenInfo.new(SettleTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
{
Saturation = -0.94,
Contrast = 0.12,
Brightness = -0.02,
TintColor = Color3.fromRGB(250, 246, 235),
}
)
RangeScreenTint.GroupTween:Play()
RangeScreenTint.CorrectionTween:Play()
end)
else
local OutTime = math.max(0.01, tonumber(CONFIG.RangeScreenTintOutTime) or 0.14)
